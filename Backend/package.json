{
  "name": "kadiwa-ecommerce-backend",
  "version": "1.0.0",
  "description": "E-commerce backend for Kadiwa",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "seed:samples:on": "set SEED_SAMPLE_PRODUCTS=1 && node scripts/seed.js",
    "seed:samples:off": "set SEED_SAMPLE_PRODUCTS=0 && node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "unify:products": "node scripts/unifyProductsTables.js",
    "create:views": "node scripts/createStoreViews.js",
    "inspect:xlsx": "node scripts/inspectXLSXHeaders.js",
    "cleanup:samples": "node scripts/removeSampleProducts.js",
    "import:store1": "node scripts/importProductsFromJSON.js --storeName \"Store 1\" --file scripts/products_store1.json",
    "import:csv:store1": "node scripts/importProductsFromCSV.js --storeName \"Store 1\" --file scripts/products_store1.csv",
    "import:xlsx:store1": "node scripts/importProductsFromXLSX.js --storeName \"Store 1\" --file scripts/products_store1.xlsx",
    "stock:add:all": "node scripts/bulkAddStock.js --inc=20",
    "stock:add:store": "node scripts/bulkAddStock.js --inc=20 --store=%STORE_ID%",
    "stock:set:all": "node scripts/bulkAddStock.js --set=20",
    "stock:set:store": "node scripts/bulkAddStock.js --set=20 --store=%STORE_ID%",
    "stores:add-coords": "node scripts/addStoreCoordinatesColumns.js",
    "stores:rename": "node scripts/renameStoreNames.js",
    "stores:set-coords": "node scripts/setStoreCoordinates.js --storeId=%STORE_ID% --lat=%LAT% --lng=%LNG%",
    "pos:create-store3-user": "node scripts/createStore3PosUser.js",
    "stores:add-delivery-service": "node scripts/addStoreDeliveryServiceColumns.js",
    "customers:add-addresses": "node scripts/addCustomerAddressesColumns.js",
    "orders:add-shipping": "node scripts/addOrdersShippingMethodColumn.js",
    "orders:add-payment": "node scripts/addOrdersPaymentMethodColumn.js",
    "orders:add-delivery-fee": "node scripts/addOrdersDeliveryFeeColumn.js",
    "orders:add-preferred-delivery-date": "node scripts/addOrdersPreferredDeliveryDateColumn.js",
    "orders:add-gcash-payment": "node scripts/addGcashPaymentColumns.js",
    "orders:update-status-enum": "node scripts/updateOrdersStatusEnum.js",
    "admin:create-reports-table": "node scripts/createAdminReportsTable.js",
    "admin:reports:add-file-cols": "node scripts/addAdminReportsFileColumns.js",
    "products:add-image-column": "node scripts/addProductsImageColumn.js",
    "products:add-market-price": "node scripts/addProductsMarketPriceColumn.js",
    "cash:create-table": "node scripts/addCashTransactionsTable.js",
    "rewards:store3:create-tables": "node scripts/addStore3SavingsRewardsTables.js",
    "rewards:points:create-tables": "node scripts/addRewardPointsTables.js",
    "notifications:create-tables": "node scripts/addNotificationTables.js",
    "integrity:create-tables": "node scripts/addDataIntegrityTables.js",
    "quantities:add-decimals": "node scripts/addDecimalQuantities.js"
  },
  "keywords": [
    "ecommerce",
    "nodejs",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
