# Local MySQL (XAMPP)
# - Start MySQL in XAMPP Control Panel.
# - Open http://localhost/phpmyadmin → create database: kadiwa_db (utf8mb4_unicode_ci).
# - Import schema: database/schema.sql OR database/hostinger_import.sql (pick one; avoid running both).
# Default XAMPP: user root, password empty. If you set a MySQL password for root, put it in DB_PASSWORD.
#
# Production note:
# - On Vercel, use your remote MySQL host or DATABASE_URL, not localhost.
# - If your MySQL provider requires TLS, set DB_SSL=true.

PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kadiwa_db
JWT_SECRET=your_jwt_secret_key_change_this_in_production
DB_SSL=false
# Optional on hosted databases:
# DATABASE_URL=mysql://user:password@host:3306/database_name
# Windows local:
# ML_PYTHON_EXECUTABLE=C:\path\to\kadiwa\ml\.venv\Scripts\python.exe
# Linux VPS:
# ML_PYTHON_EXECUTABLE=/var/www/kadiwa/ml/.venv/bin/python
# If unset/missing, Backend falls back to ml/.venv then system python.
ML_PYTHON_EXECUTABLE=
# Continuous learning: retrain from delivered orders
# ML_RETRAIN_INTERVAL_MS=86400000
# ML_RETRAIN_MIN_INTERVAL_MS=21600000

# Optional: set default store owner id for imports
# STORE_OWNER_ID=1
