{"ast":null,"code":"import api from '../../services/api';\nfunction debounce(fn, delay = 400) {\n  let t;\n  return (...args) => {\n    clearTimeout(t);\n    t = setTimeout(() => fn(...args), delay);\n  };\n}\nexport default {\n  name: 'StoreProducts',\n  data() {\n    return {\n      q: '',\n      items: [],\n      page: 1,\n      pageSize: 25\n    };\n  },\n  created() {\n    this.fetch();\n    this.debouncedFetch = debounce(this.fetch, 400);\n  },\n  computed: {\n    sorted() {\n      return [...this.items].sort((a, b) => String(a.name || '').localeCompare(String(b.name || '')));\n    },\n    totalPages() {\n      return Math.max(1, Math.ceil(this.sorted.length / this.pageSize));\n    },\n    paginated() {\n      const start = (this.page - 1) * this.pageSize;\n      return this.sorted.slice(start, start + this.pageSize);\n    }\n  },\n  watch: {\n    pageSize() {\n      this.page = 1;\n    }\n  },\n  methods: {\n    async fetch() {\n      const {\n        data\n      } = await api.get('/store/products', {\n        params: {\n          q: this.q || undefined\n        }\n      });\n      this.items = data;\n    },\n    prevPage() {\n      if (this.page > 1) this.page--;\n    },\n    nextPage() {\n      if (this.page < this.totalPages) this.page++;\n    },\n    formatDateTime(value) {\n      if (!value) return '—';\n      const parsed = new Date(value);\n      if (Number.isNaN(parsed.getTime())) return '—';\n      return parsed.toLocaleString();\n    }\n  }\n};","map":{"version":3,"names":["api","debounce","fn","delay","t","args","clearTimeout","setTimeout","name","data","q","items","page","pageSize","created","fetch","debouncedFetch","computed","sorted","sort","a","b","String","localeCompare","totalPages","Math","max","ceil","length","paginated","start","slice","watch","methods","get","params","undefined","prevPage","nextPage","formatDateTime","value","parsed","Date","Number","isNaN","getTime","toLocaleString"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\store\\Products.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>Products • List</h2>\r\n\r\n    <div class=\"toolbar\">\r\n      <input v-model=\"q\" @input=\"debouncedFetch\" placeholder=\"Search products...\" />\r\n    </div>\r\n\r\n    <div class=\"pager\">\r\n      <div class=\"left\">Showing {{ paginated.length }} of {{ sorted.length }} items</div>\r\n      <div class=\"right\">\r\n        <label>Per page\r\n          <select v-model.number=\"pageSize\">\r\n            <option :value=\"10\">10</option>\r\n            <option :value=\"25\">25</option>\r\n            <option :value=\"50\">50</option>\r\n            <option :value=\"100\">100</option>\r\n          </select>\r\n        </label>\r\n        <button class=\"btn\" :disabled=\"page===1\" @click=\"prevPage\">Prev</button>\r\n        <span class=\"page\">Page {{ page }} / {{ totalPages }}</span>\r\n        <button class=\"btn\" :disabled=\"page===totalPages\" @click=\"nextPage\">Next</button>\r\n      </div>\r\n    </div>\r\n\r\n    <table class=\"table\">\r\n      <thead>\r\n        <tr>\r\n          <th>Name</th>\r\n          <th>Description</th>\r\n          <th>Price</th>\r\n          <th>Stock</th>\r\n          <th>Status</th>\r\n          <th>Last Changed</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"p in paginated\" :key=\"p.id\">\r\n          <td>{{ p.name }}</td>\r\n          <td class=\"desc\">{{ p.description || '—' }}</td>\r\n          <td>₱{{ Number(p.price).toFixed(2) }}</td>\r\n          <td>{{ Number(p.stock || 0) }}</td>\r\n          <td>{{ p.status }}</td>\r\n          <td>{{ formatDateTime(p.updated_at) }}</td>\r\n        </tr>\r\n        <tr v-if=\"sorted.length === 0\">\r\n          <td colspan=\"6\" class=\"empty\">No products</td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\n\r\nfunction debounce(fn, delay=400) { let t; return (...args)=>{ clearTimeout(t); t=setTimeout(()=>fn(...args), delay);} }\r\n\r\nexport default {\r\n  name: 'StoreProducts',\r\n  data() {\r\n    return { q: '', items: [], page: 1, pageSize: 25 }\r\n  },\r\n  created() {\r\n    this.fetch();\r\n    this.debouncedFetch = debounce(this.fetch, 400);\r\n  },\r\n  computed: {\r\n    sorted() {\r\n      return [...this.items].sort((a,b)=> String(a.name||'').localeCompare(String(b.name||'')))\r\n    },\r\n    totalPages(){\r\n      return Math.max(1, Math.ceil(this.sorted.length / this.pageSize))\r\n    },\r\n    paginated(){\r\n      const start = (this.page - 1) * this.pageSize\r\n      return this.sorted.slice(start, start + this.pageSize)\r\n    }\r\n  },\r\n  watch: {\r\n    pageSize(){ this.page = 1 }\r\n  },\r\n  methods: {\r\n    async fetch() {\r\n      const { data } = await api.get('/store/products', { params: { q: this.q || undefined } })\r\n      this.items = data\r\n    },\r\n    prevPage(){ if(this.page>1) this.page-- },\r\n    nextPage(){ if(this.page<this.totalPages) this.page++ },\r\n    formatDateTime(value) {\r\n      if (!value) return '—'\r\n      const parsed = new Date(value)\r\n      if (Number.isNaN(parsed.getTime())) return '—'\r\n      return parsed.toLocaleString()\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.toolbar { display:flex; gap:8px; margin-bottom:12px; }\r\n.table { width:100%; border-collapse:collapse; background:#fff; border-radius:8px; overflow:hidden; box-shadow:0 4px 14px rgba(56,92,35,.08);} \r\n.table th,.table td{ padding:10px 12px; border-bottom:1px solid #e6eddc; }\r\n.table th{ background:#f4f8ee; text-align:left }\r\n.desc{ color:#48603b; max-width:420px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis }\r\n.pager{ display:flex; justify-content:space-between; align-items:center; margin: 10px 0 }\r\n.pager .right{ display:flex; gap:8px; align-items:center }\r\n.btn{ padding:6px 10px; border:1px solid #cddbb9; background:#f8fbf4; border-radius:6px; cursor:pointer }\r\n.btn:disabled{ opacity:.5; cursor:not-allowed }\r\n.page{ min-width:120px; text-align:center; display:inline-block }\r\n.empty { text-align:center; color:#6f7d67; }\r\ninput{ border:1px solid #cddbb9; border-radius:6px; padding:8px; background:#fff }\r\n</style>\r\n"],"mappings":"AAsDA,OAAOA,GAAE,MAAO,oBAAmB;AAEnC,SAASC,QAAQA,CAACC,EAAE,EAAEC,KAAK,GAAC,GAAG,EAAE;EAAE,IAAIC,CAAC;EAAE,OAAO,CAAC,GAAGC,IAAI,KAAG;IAAEC,YAAY,CAACF,CAAC,CAAC;IAAEA,CAAC,GAACG,UAAU,CAAC,MAAIL,EAAE,CAAC,GAAGG,IAAI,CAAC,EAAEF,KAAK,CAAC;EAAC;AAAE;AAEtH,eAAe;EACbK,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MAAEC,CAAC,EAAE,EAAE;MAAEC,KAAK,EAAE,EAAE;MAAEC,IAAI,EAAE,CAAC;MAAEC,QAAQ,EAAE;IAAG;EACnD,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,KAAK,CAAC,CAAC;IACZ,IAAI,CAACC,cAAa,GAAIf,QAAQ,CAAC,IAAI,CAACc,KAAK,EAAE,GAAG,CAAC;EACjD,CAAC;EACDE,QAAQ,EAAE;IACRC,MAAMA,CAAA,EAAG;MACP,OAAO,CAAC,GAAG,IAAI,CAACP,KAAK,CAAC,CAACQ,IAAI,CAAC,CAACC,CAAC,EAACC,CAAC,KAAIC,MAAM,CAACF,CAAC,CAACZ,IAAI,IAAE,EAAE,CAAC,CAACe,aAAa,CAACD,MAAM,CAACD,CAAC,CAACb,IAAI,IAAE,EAAE,CAAC,CAAC;IAC1F,CAAC;IACDgB,UAAUA,CAAA,EAAE;MACV,OAAOC,IAAI,CAACC,GAAG,CAAC,CAAC,EAAED,IAAI,CAACE,IAAI,CAAC,IAAI,CAACT,MAAM,CAACU,MAAK,GAAI,IAAI,CAACf,QAAQ,CAAC;IAClE,CAAC;IACDgB,SAASA,CAAA,EAAE;MACT,MAAMC,KAAI,GAAI,CAAC,IAAI,CAAClB,IAAG,GAAI,CAAC,IAAI,IAAI,CAACC,QAAO;MAC5C,OAAO,IAAI,CAACK,MAAM,CAACa,KAAK,CAACD,KAAK,EAAEA,KAAI,GAAI,IAAI,CAACjB,QAAQ;IACvD;EACF,CAAC;EACDmB,KAAK,EAAE;IACLnB,QAAQA,CAAA,EAAE;MAAE,IAAI,CAACD,IAAG,GAAI;IAAE;EAC5B,CAAC;EACDqB,OAAO,EAAE;IACP,MAAMlB,KAAKA,CAAA,EAAG;MACZ,MAAM;QAAEN;MAAK,IAAI,MAAMT,GAAG,CAACkC,GAAG,CAAC,iBAAiB,EAAE;QAAEC,MAAM,EAAE;UAAEzB,CAAC,EAAE,IAAI,CAACA,CAAA,IAAK0B;QAAU;MAAE,CAAC;MACxF,IAAI,CAACzB,KAAI,GAAIF,IAAG;IAClB,CAAC;IACD4B,QAAQA,CAAA,EAAE;MAAE,IAAG,IAAI,CAACzB,IAAI,GAAC,CAAC,EAAE,IAAI,CAACA,IAAI,EAAC;IAAE,CAAC;IACzC0B,QAAQA,CAAA,EAAE;MAAE,IAAG,IAAI,CAAC1B,IAAI,GAAC,IAAI,CAACY,UAAU,EAAE,IAAI,CAACZ,IAAI,EAAC;IAAE,CAAC;IACvD2B,cAAcA,CAACC,KAAK,EAAE;MA