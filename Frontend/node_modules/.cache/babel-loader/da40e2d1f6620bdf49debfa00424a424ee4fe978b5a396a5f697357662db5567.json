{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nimport \"core-js/modules/esnext.json.parse.js\";\nimport api from '../../services/api';\nexport default {\n  data() {\n    return {\n      currentEmail: '',\n      emailForm: {\n        email: '',\n        current_password: ''\n      },\n      f: {\n        current_password: '',\n        new_password: '',\n        confirm_password: ''\n      },\n      savingEmail: false,\n      savingPass: false\n    };\n  },\n  async created() {\n    try {\n      const {\n        data\n      } = await api.get('/store/account/me');\n      this.currentEmail = data?.email || '';\n      this.emailForm.email = data?.email || '';\n    } catch (err) {\n      console.error('Failed to load account', err);\n    }\n  },\n  methods: {\n    async changeEmail() {\n      this.savingEmail = true;\n      try {\n        const {\n          data\n        } = await api.put('/store/account/email', this.emailForm);\n        this.currentEmail = data.user?.email || this.emailForm.email;\n        this.emailForm.email = this.currentEmail;\n        this.emailForm.current_password = '';\n        const stored = JSON.parse(localStorage.getItem('user') || '{}');\n        localStorage.setItem('user', JSON.stringify({\n          ...stored,\n          email: this.currentEmail\n        }));\n        alert('Email updated');\n      } catch (err) {\n        alert(err.response?.data?.message || err.response?.data?.errors?.map(e => e.msg).join(', ') || 'Failed to update email');\n      } finally {\n        this.savingEmail = false;\n      }\n    },\n    async changePass() {\n      if (this.f.new_password !== this.f.confirm_password) {\n        alert('New password and confirmation do not match');\n        return;\n      }\n      this.savingPass = true;\n      try {\n        await api.put('/store/account/password', {\n          current_password: this.f.current_password,\n          new_password: this.f.new_password\n        });\n        alert('Password updated');\n        this.f = {\n          current_password: '',\n          new_password: '',\n          confirm_password: ''\n        };\n      } catch (err) {\n        alert(err.response?.data?.message || err.response?.data?.errors?.map(e => e.msg).join(', ') || 'Failed to update password');\n      } finally {\n        this.savingPass = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","data","currentEmail","emailForm","email","current_password","f","new_password","confirm_password","savingEmail","savingPass","created","get","err","console","error","methods","changeEmail","put","user","stored","JSON","parse","localStorage","getItem","setItem","stringify","alert","response","message","errors","map","e","msg","join","changePass"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\store\\AccountSecurity.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>Account • Security</h2>\r\n    <nav class=\"account-tabs\" aria-label=\"Account sections\">\r\n      <router-link :to=\"{ name: 'StoreAccountProfile' }\">Profile</router-link>\r\n      <router-link :to=\"{ name: 'StoreAccountSecurity' }\">Security</router-link>\r\n      <router-link :to=\"{ name: 'StoreAccountLocation' }\">Maps</router-link>\r\n    </nav>\r\n\r\n    <form class=\"form\" @submit.prevent=\"changeEmail\">\r\n      <h3>Change Email</h3>\r\n      <label>Current Email<input type=\"email\" :value=\"currentEmail\" disabled /></label>\r\n      <label>New Email<input type=\"email\" v-model=\"emailForm.email\" required /></label>\r\n      <label>Current Password<input type=\"password\" v-model=\"emailForm.current_password\" required /></label>\r\n      <button type=\"submit\" :disabled=\"savingEmail\">{{ savingEmail ? 'Updating...' : 'Update Email' }}</button>\r\n    </form>\r\n\r\n    <form class=\"form\" @submit.prevent=\"changePass\">\r\n      <h3>Change Password</h3>\r\n      <label>Current Password<input type=\"password\" v-model=\"f.current_password\" required /></label>\r\n      <label>New Password<input type=\"password\" v-model=\"f.new_password\" minlength=\"6\" required /></label>\r\n      <label>Confirm New Password<input type=\"password\" v-model=\"f.confirm_password\" minlength=\"6\" required /></label>\r\n      <button type=\"submit\" :disabled=\"savingPass\">{{ savingPass ? 'Updating...' : 'Update Password' }}</button>\r\n    </form>\r\n\r\n    <div class=\"forgot\">\r\n      <h3>Forgot Password</h3>\r\n      <p>For now, contact admin to reset. We can add email OTP later.</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../../services/api'\r\nexport default {\r\n  data() {\r\n    return {\r\n      currentEmail: '',\r\n      emailForm: { email: '', current_password: '' },\r\n      f: { current_password: '', new_password: '', confirm_password: '' },\r\n      savingEmail: false,\r\n      savingPass: false\r\n    }\r\n  },\r\n  async created() {\r\n    try {\r\n      const { data } = await api.get('/store/account/me')\r\n      this.currentEmail = data?.email || ''\r\n      this.emailForm.email = data?.email || ''\r\n    } catch (err) {\r\n      console.error('Failed to load account', err)\r\n    }\r\n  },\r\n  methods: {\r\n    async changeEmail() {\r\n      this.savingEmail = true\r\n      try {\r\n        const { data } = await api.put('/store/account/email', this.emailForm)\r\n        this.currentEmail = data.user?.email || this.emailForm.email\r\n        this.emailForm.email = this.currentEmail\r\n        this.emailForm.current_password = ''\r\n        const stored = JSON.parse(localStorage.getItem('user') || '{}')\r\n        localStorage.setItem('user', JSON.stringify({ ...stored, email: this.currentEmail }))\r\n        alert('Email updated')\r\n      } catch (err) {\r\n        alert(err.response?.data?.message || err.response?.data?.errors?.map(e => e.msg).join(', ') || 'Failed to update email')\r\n      } finally {\r\n        this.savingEmail = false\r\n      }\r\n    },\r\n    async changePass() {\r\n      if (this.f.new_password !== this.f.confirm_password) {\r\n        alert('New password and confirmation do not match')\r\n        return\r\n      }\r\n      this.savingPass = true\r\n      try {\r\n        await api.put('/store/account/password', {\r\n          current_password: this.f.current_password,\r\n          new_password: this.f.new_password\r\n        })\r\n        alert('Password updated')\r\n        this.f = { current_password: '', new_password: '', confirm_password: '' }\r\n      } catch (err) {\r\n        alert(err.response?.data?.message || err.response?.data?.errors?.map(e => e.msg).join(', ') || 'Failed to update password')\r\n      } finally {\r\n        this.savingPass = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n.account-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 14px}\r\n.account-tabs a{text-decoration:none;color:#355e2a;font-weight:700;font-size:13px;padding:8px 12px;border-radius:999px;border:1px solid #cddbb9;background:#fff}\r\n.account-tabs a.router-link-active{color:#fff;background:linear-gradient(135deg,#7CB342,#4E7D32);border-color:transparent}\r\n.form{display:grid;gap:10px;background:#fff;padding:12px;border-radius:8px;box-shadow:0 4px 14px rgba(56,92,35,.08);max-width:420px;margin-bottom:16px}\r\nlabel{display:flex;flex-direction:column;gap:6px}\r\ninput{padding:8px;border:1px solid #cddbb9;border-radius:6px}\r\ninput:disabled{background:#f3f6ef;color:#5f7256}\r\n.forgot{margin-top:16px;color:#48603b}\r\nh3{margin:0 0 4px;color:#355e2a;font-size:15px}\r\nbutton{background:linear-gradient(135deg,#7CB342,#4E7D32);color:#fff;border:none;padding:9px 12px;border-radius:6px;cursor:pointer}\r\nbutton:disabled{opacity:.7;cursor:default}\r\n@media (max-width: 640px){\r\n  .form{max-width:100%}\r\n}\r\n</style>\r\n"],"mappings":";;;;AAgCA,OAAOA,GAAE