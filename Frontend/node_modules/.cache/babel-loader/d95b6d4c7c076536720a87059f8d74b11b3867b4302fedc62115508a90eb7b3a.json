{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport api from '../../services/api';\nexport default {\n  name: 'AdminStores',\n  data() {\n    return {\n      stores: [],\n      q: '',\n      posUsersCountByStore: {}\n    };\n  },\n  computed: {\n    filteredStores() {\n      const q = String(this.q || '').toLowerCase().trim();\n      if (!q) return this.stores;\n      return this.stores.filter(s => String(s.store_name || '').toLowerCase().includes(q) || String(s.full_name || '').toLowerCase().includes(q) || String(s.email || '').toLowerCase().includes(q));\n    }\n  },\n  async created() {\n    const {\n      data\n    } = await api.get('/admin/stores');\n    this.stores = data;\n    await this.refreshPosUserCounts();\n  },\n  methods: {\n    async refreshPosUserCounts() {\n      const map = {};\n      for (const s of this.stores) {\n        try {\n          const {\n            data\n          } = await api.get(`/admin/stores/${s.id}/pos-users`);\n          map[s.id] = Array.isArray(data) ? data.length : 0;\n        } catch (_) {\n          map[s.id] = 0;\n        }\n      }\n      this.posUsersCountByStore = map;\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","stores","q","posUsersCountByStore","computed","filteredStores","String","toLowerCase","trim","filter","s","store_name","includes","full_name","email","created","get","refreshPosUserCounts","methods","map","id","Array","isArray","length","_"],"sources":["/var/www/kadiwa/Frontend/src/views/admin/Stores.vue"],"sourcesContent":["<template>\r\n  <div class=\"stores-page\">\r\n    <div class=\"head\">\r\n      <h2>Stores Management</h2>\r\n      <input v-model=\"q\" class=\"search\" placeholder=\"Search store, owner, email\" />\r\n    </div>\r\n\r\n    <div class=\"table-wrap\">\r\n    <table class=\"table\">\r\n      <thead>\r\n        <tr>\r\n          <th>Store Name</th>\r\n          <th>Owner</th>\r\n          <th>Email</th>\r\n          <th>Phone</th>\r\n          <th>Status</th>\r\n          <th>POS Users</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"s in filteredStores\" :key=\"s.id\">\r\n          <td>{{ s.store_name }}</td>\r\n          <td>{{ s.full_name }}</td>\r\n          <td>{{ s.email }}</td>\r\n          <td>{{ s.phone || '—' }}</td>\r\n          <td>{{ s.status }}</td>\r\n          <td>{{ posUsersCountByStore[s.id] || 0 }}</td>\r\n        </tr>\r\n        <tr v-if=\"filteredStores.length===0\"><td colspan=\"6\" class=\"empty\">No stores</td></tr>\r\n      </tbody>\r\n    </table>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../../services/api'\r\nexport default {\r\n  name: 'AdminStores',\r\n  data(){\r\n    return{\r\n      stores:[],\r\n      q:'',\r\n      posUsersCountByStore:{},\r\n    }\r\n  },\r\n  computed:{\r\n    filteredStores(){\r\n      const q = String(this.q || '').toLowerCase().trim()\r\n      if(!q) return this.stores\r\n      return this.stores.filter(s =>\r\n        String(s.store_name || '').toLowerCase().includes(q) ||\r\n        String(s.full_name || '').toLowerCase().includes(q) ||\r\n        String(s.email || '').toLowerCase().includes(q)\r\n      )\r\n    }\r\n  },\r\n  async created(){\r\n    const {data} = await api.get('/admin/stores')\r\n    this.stores = data\r\n    await this.refreshPosUserCounts()\r\n  },\r\n  methods:{\r\n    async refreshPosUserCounts(){\r\n      const map = {}\r\n      for(const s of this.stores){\r\n        try{\r\n          const { data } = await api.get(`/admin/stores/${s.id}/pos-users`)\r\n          map[s.id] = Array.isArray(data) ? data.length : 0\r\n        }catch(_){\r\n          map[s.id] = 0\r\n        }\r\n      }\r\n      this.posUsersCountByStore = map\r\n    }\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n.stores-page{display:grid;gap:12px}\r\n.head{display:flex;justify-content:space-between;align-items:center;gap:10px}\r\n.head h2{margin:0}\r\n.search{min-height:36px;border:1px solid #cddbb9;border-radius:10px;padding:0 10px;background:#fff;min-width:0;width:100%;max-width:100%}\r\n.table-wrap{max-height:520px;overflow:auto;border-radius:14px;border:1px solid #deead0;background:#fff;box-shadow:0 10px 24px rgba(56,92,35,.1)}\r\n.table{width:100%;border-collapse:collapse}\r\n.table thead th{position:sticky;top:0;background:#f4f8ee;z-index:2}\r\n.table th,.table td{padding:10px 12px;border-bottom:1px solid #e6eddc;text-align:left}\r\n.table tbody tr:hover{background:rgba(124,179,66,.1)}\r\n.empty{text-align:center;color:#6f7d67}\r\n.btn{padding:6px 10px;border:1px solid #cddbb9;background:#f8fbf4;border-radius:6px;cursor:pointer}\r\n.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:50}\r\n.modal{position:fixed;z-index:60;inset:50% auto auto 50%;transform:translate(-50%,-50%);width:min(860px,calc(100vw - 24px));max-height:80vh;overflow:auto;background:#fff;border-radius:12px;padding:12px;box-shadow:0 12px 34px rgba(0,0,0,.25)}\r\n.create-form{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-bottom:10px}\r\n.create-form input{border:1px solid #cddbb9;border-radius:8px;padding:8px 10px;background:#fff}\r\n.modal-actions{display:flex;justify-content:flex-end;margin-top:10px}\r\n@media (max-width: 900px){.create-form{grid-template-columns:1fr}}\r\n\n/* mobile-dashboard-fix */\n.table-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}\n.table-wrap .table, table.table{width:100%}\n@media (max-width: 640px){\n  .toolbar,.filters,.head,.section-head,.graph-head,.forecast-tools,.reports-header,.form{flex-wrap:wrap}\n  .toolbar,.filters,.head,.section-head{display:flex;gap:8px}\n  .toolbar input,.search-input,input[type=\"search\"],.search{min-width:0!important;width:100%;max-width:100%}\n  .table-wrap .table, table.table{min-width:560px}\n  .btn,button.primary,button.save-btn{min-height:40px}\n  .barangay-row{flex-direction:column;align-items:stretch!important}\n  .map{height:260px!important}\n  .details-grid{grid-template-columns:1fr!important}\n  .card,.form{max-width:100%}\n}\n</style>\r\n"],"mappings":";;AAmCA,OAAOA,GAAE,MAAO,oBAAmB;AACnC,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,IAAIA,CAAA,EAAE;IACJ,OAAM;MACJC,MAAM,EAAC,EAAE;MACTC,CAAC,EAAC,EAAE;MACJC,oBAAoB,EAAC,CAAC;IACxB;EACF,CAAC;EACDC,QAAQ,EAAC;IACPC,cAAcA,CAAA,EAAE;MACd,MAAMH,CAAA,GAAII,MAAM,CAAC,IAAI,CAACJ,CAAA,IAAK,EAAE,CAAC,CAACK,WAAW,CAAC,CAAC,CAACC,IAAI,CAAC;MAClD,IAAG,CAACN,CAAC,EAAE,OAAO,IAAI,CAACD,MAAK;MACxB,OAAO,IAAI,CAACA,MAAM,CAACQ,MAAM,CAACC,CAAA,IACxBJ,MAAM,CAACI,CAAC,CAACC,UAAS,IAAK,EAAE,CAAC,CAACJ,WAAW,CAAC,CAAC,CAACK,QAAQ,CAACV,CAAC,KACnDI,MAAM,CAACI,CAAC,CAACG,SAAQ,IAAK,EAAE,CAAC,CAACN,WAAW,CAAC,CAAC,CAACK,QAAQ,CAACV,CAAC,KAClDI,MAAM,CAACI,CAAC,CAACI,KAAI,IAAK,EAAE,CAAC,CAACP,WAAW,CAAC,CAAC,CAACK,QAAQ,CAACV,CAAC,CAChD;IACF;EACF,CAAC;EACD,MAAMa,OAAOA,CAAA,EAAE;IACb,MAAM;MAACf;IAAI,IAAI,MAAMF,GAAG,CAACkB,GAAG,CAAC,eAAe;IAC5C,IAAI,CAACf,MAAK,GAAID,IAAG;IACjB,MAAM,IAAI,CAACiB,oBAAoB,CAAC;EAClC,CAAC;EACDC,OAAO,EAAC;IACN,MAAMD,oBAAoBA,CAAA,EAAE;MAC1B,MAAME,GAAE,GAAI,CAAC;MACb,KAAI,MAAMT,CAAA,IAAK,IAAI,CAACT,MAAM,EAAC;QACzB,IAAG;UACD,MAAM;YAAED;UAAK,IAAI,MAAMF,GAAG,CAACkB,GAAG,CAAC,iBAAiBN,CAAC,CAACU,EAAE,YAAY;UAChED,GAAG,CAACT,CAAC,CAACU,EAAE,IAAIC,KAAK,CAACC,OAAO,CAACtB,IAAI,IAAIA,IAAI,CAACuB,MAAK,GAAI;QAClD,CAAC,QAAMC,CAAC,EAAC;UACPL,GAAG,CAACT,CAAC,CAACU,EAAE,IAAI;QACd;MACF;MACA,IAAI,CAACjB,oBAAmB,GAAIgB,GAAE;IAChC;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}