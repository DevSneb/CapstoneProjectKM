{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nimport api from '../services/api';\nimport { readAuth } from '../services/authStorage';\nexport default {\n  name: 'CustomerSettings',\n  data() {\n    return {\n      form: {\n        full_name: '',\n        phone: '',\n        address: ''\n      },\n      currentEmail: '',\n      emailForm: {\n        email: '',\n        current_password: ''\n      },\n      passwordForm: {\n        current_password: '',\n        new_password: '',\n        confirm_password: ''\n      },\n      saving: false,\n      savingEmail: false,\n      savingPassword: false\n    };\n  },\n  async created() {\n    const {\n      user\n    } = readAuth('customer');\n    if (user) {\n      this.form.full_name = user.full_name || '';\n      this.form.phone = user.phone || '';\n      this.form.address = user.address || '';\n      this.currentEmail = user.email || '';\n      this.emailForm.email = user.email || '';\n    }\n    await this.loadProfile();\n  },\n  methods: {\n    async loadProfile() {\n      try {\n        const {\n          data\n        } = await api.get('/customer/account/profile');\n        const user = data?.user;\n        if (!user) return;\n        this.form.full_name = user.full_name || '';\n        this.form.phone = user.phone || '';\n        this.form.address = user.address || '';\n        this.currentEmail = user.email || '';\n        this.emailForm.email = user.email || '';\n        this.$store.commit('SET_USER', user);\n        localStorage.setItem('user', JSON.stringify(user));\n      } catch (err) {\n        console.error('Failed to load profile', err);\n      }\n    },\n    async save() {\n      this.saving = true;\n      try {\n        const {\n          data\n        } = await api.put('/customer/account/profile', this.form);\n        const {\n          token\n        } = readAuth('customer');\n        this.$store.dispatch('login', {\n          user: data.user,\n          token\n        });\n        alert('Profile updated');\n      } catch (err) {\n        alert(err.response?.data?.message || 'Failed to save');\n      } finally {\n        this.saving = false;\n      }\n    },\n    async saveEmail() {\n      this.savingEmail = true;\n      try {\n        const {\n          data\n        } = await api.put('/customer/account/email', {\n          email: this.emailForm.email,\n          current_password: this.emailForm.current_password\n        });\n        const {\n          token\n        } = readAuth('customer');\n        this.$store.dispatch('login', {\n          user: data.user,\n          token\n        });\n        this.currentEmail = data.user.email || '';\n        this.emailForm.email = data.user.email || '';\n        this.emailForm.current_password = '';\n        alert('Email updated');\n      } catch (err) {\n        const msg = err.response?.data?.message || err.response?.data?.errors?.map(e => e.msg).join(', ') || 'Failed to update email';\n        alert(msg);\n      } finally {\n        this.savingEmail = false;\n      }\n    },\n    async savePassword() {\n      if (this.passwordForm.new_password !== this.passwordForm.confirm_password) {\n        alert('New password and confirmation do not match');\n        return;\n      }\n      this.savingPassword = true;\n      try {\n        await api.put('/customer/account/password', {\n          current_password: this.passwordForm.current_password,\n          new_password: this.passwordForm.new_password\n        });\n        this.passwordForm = {\n          current_password: '',\n          new_password: '',\n          confirm_password: ''\n        };\n        alert('Password updated');\n      } catch (err) {\n        const msg = err.response?.data?.message || err.response?.data?.errors?.map(e => e.msg).join(', ') || 'Failed to update password';\n        alert(msg);\n      } finally {\n        this.savingPassword = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","readAuth","name","data","form","full_name","phone","address","currentEmail","emailForm","email","current_password","passwordForm","new_password","confirm_password","saving","savingEmail","savingPassword","created","user","loadProfile","methods","get","$store","commit","localStorage","setItem","JSON","stringify","err","console","error","save","put","token","dispatch","alert","response","message","saveEmail","msg","errors","map","e","join","savePassword"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\CustomerSettings.vue"],"sourcesContent":["<template>\r\n  <div class=\"page\">\r\n    <h2>Settings • Profile</h2>\r\n    <form class=\"form\" @submit.prevent=\"save\">\r\n      <label>Full name\r\n        <input v-model=\"form.full_name\" required />\r\n      </label>\r\n      <label>Phone\r\n        <input v-model=\"form.phone\" />\r\n      </label>\r\n      <label>Address\r\n        <textarea v-model=\"form.address\" rows=\"3\"></textarea>\r\n      </label>\r\n      <button :disabled=\"saving\">{{ saving ? 'Saving...' : 'Save' }}</button>\r\n    </form>\r\n\r\n    <h2 class=\"section-title\">Change Email</h2>\r\n    <form class=\"form\" @submit.prevent=\"saveEmail\">\r\n      <label>Current Email\r\n        <input :value=\"currentEmail\" type=\"email\" disabled />\r\n      </label>\r\n      <label>New Email\r\n        <input v-model=\"emailForm.email\" type=\"email\" required />\r\n      </label>\r\n      <label>Current Password\r\n        <input v-model=\"emailForm.current_password\" type=\"password\" required />\r\n      </label>\r\n      <button :disabled=\"savingEmail\">{{ savingEmail ? 'Updating...' : 'Update Email' }}</button>\r\n    </form>\r\n\r\n    <h2 class=\"section-title\">Change Password</h2>\r\n    <form class=\"form\" @submit.prevent=\"savePassword\">\r\n      <label>Current Password\r\n        <input v-model=\"passwordForm.current_password\" type=\"password\" required />\r\n      </label>\r\n      <label>New Password\r\n        <input v-model=\"passwordForm.new_password\" type=\"password\" minlength=\"6\" required />\r\n      </label>\r\n      <label>Confirm New Password\r\n        <input v-model=\"passwordForm.confirm_password\" type=\"password\" minlength=\"6\" required />\r\n      </label>\r\n      <button :disabled=\"savingPassword\">{{ savingPassword ? 'Updating...' : 'Update Password' }}</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../services/api'\r\nimport { readAuth } from '../services/authStorage'\r\nexport default {\r\n  name: 'CustomerSettings',\r\n  data() {\r\n    return {\r\n      form: { full_name: '', phone: '', address: '' },\r\n      currentEmail: '',\r\n      emailForm: { email: '', current_password: '' },\r\n      passwordForm: { current_password: '', new_password: '', confirm_password: '' },\r\n      saving: false,\r\n      savingEmail: false,\r\n      savingPassword: false\r\n    }\r\n  },\r\n  async created() {\r\n    const { user } = readAuth('customer')\r\n    if (user) {\r\n      this.form.full_name = user.full_name || ''\r\n      this.form.phone = user.phone || ''\r\n      this.form.address = user.address || ''\r\n      this.currentEmail = user.email || ''\r\n      this.emailForm.email = user.email || ''\r\n    }\r\n    await this.loadProfile()\r\n  },\r\n  methods: {\r\n    async loadProfile() {\r\n      try {\r\n        const { data } = await api.get('/customer/account/profile')\r\n        const user = data?.user\r\n        if (!user) return\r\n        this.form.full_name = user.full_name || ''\r\n        this.form.phone = user.phone || ''\r\n        this.form.address = user.address || ''\r\n        this.currentEmail = user.email || ''\r\n        this.emailForm.email = user.email || ''\r\n        this.$store.commit('SET_USER', user)\r\n        localStorage.setItem('user', JSON.stringify(user))\r\n      } catch (err) {\r\n        console.error('Failed to load profile', err)\r\n      }\r\n    },\r\n    async save() {\r\n      this.saving = true\r\n      try {\r\n        const { data } = await api.put('/customer/account/profile', this.form)\r\n        const { token } = readAuth('customer')\r\n        this.$store.dispatch('login', { user: data.user, token })\r\n        alert('Profile updated')\r\n      } catch (err) {\r\n        alert(err.response?.data?.message || 'Failed to save')\r\n      } finally {\r\n        this.saving = false\r\n      }\r\n    },\r\n    async saveEmail() {\r\n      this.savingEmail = true\r\n      try {\r\n        const { data } = await api.put('/customer/account/email', {\r\n          email: this.emailForm.email,\r\n          current_password: this.emailForm.current_password\r\n        })\r\n        const { token } = readAuth('customer')\r\n        this.$store.dispatch('login', { user: data.user, token })\r\n        this.currentEmail = data.user.email || ''\r\n        this.emailForm.email = data.user.email || ''\r\n        this.emailForm.current_password = ''\r\n        alert('Email updated')\r\n      } catch (err) {\r\n        const msg = err.response?.data?.message\r\n          || err.response?.data?.errors?.map(e => e.msg).join(', ')\r\n          || 'Failed to update email'\r\n        alert(msg)\r\n      } finally {\r\n        this.savingEmail = false\r\n      }\r\n    },\r\n    async savePassword() {\r\n      if (this.passwordForm.new_password !== this.passwordForm.confirm_password) {\r\n        alert('New password and confirmation do not match')\r\n        return\r\n      }\r\n      this.savingPassword = true\r\n      try {\r\n        await api.put('/customer/account/password', {\r\n          current_password: this.passwordForm.current_password,\r\n          new_password: this.passwordForm.new_password\r\n        })\r\n        this.passwordForm = { current_password: '', new_password: '', confirm_password: '' }\r\n        alert('Password updated')\r\n      } catch (err) {\r\n        const msg = err.response?.data?.message\r\n          || err.response?.data?.errors?.map(e => e.msg).join(', ')\r\n          || 'Failed to update password'\r\n        alert(msg)\r\n      } finally {\r\n        this.savingPassword = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n.page{padding:20px}\r\n.section-title{margin-top:28px}\r\n.form{display:flex;flex-direction:column;gap:10px;max-width:480px}\r\ninput,textarea{width:100%;padding:10px;border:1px solid #ddd;border-radius:6px}\r\ninput:disabled{background:#f5f5f5;color:#666}\r\nbutton{padding:10px;border:1px solid #ddd;background:#fff;border-radius:6px;cursor:pointer;align-self:flex-start}\r\n@media (max-width: 640px){\r\n  .page{padding:12px}\r\n  .form{max-width:100%}\r\n  button{width:100%;align-self:stretch;min-height:44px}\r\n}\r\n</style>\r\n"],"mappings":";;;AA8CA,OAAOA,GAAE,MAAO,iBAAgB;AAChC,SAASC,QAAO,QAAS,yBAAwB;AACjD,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QAAEC,SAAS,EAAE,EAAE;QAAEC,KAAK,EAAE,EAAE;QAAEC,OAAO,EAAE;MAAG,CAAC;MAC/CC,YAAY,EAAE,EAAE;MAChBC,SAAS,EAAE;QAAEC,KAAK,EAAE,EAAE;QAAEC,gBAAgB,EAAE;MAAG,CAAC;MAC9CC,YAAY,EAAE;QAAED,gBAAgB,EAAE,EAAE;QAAEE,YAAY,EAAE,EAAE;QAAEC,gBAAgB,EAAE;MAAG,CAAC;MAC9EC,MAAM,EAAE,KAAK;MACbC,WAAW,EAAE,KAAK;MAClBC,cAAc,EAAE;IAClB;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM;MAAEC;IAAK,IAAIlB,QAAQ,CAAC,UAAU;IACpC,IAAIkB,IAAI,EAAE;MACR,IAAI,CAACf,IAAI,CAACC,SAAQ,GAAIc,IAAI,CAACd,SAAQ,IAAK,EAAC;MACzC,IAAI,CAACD,IAAI,CAACE,KAAI,GAAIa,IAAI,CAACb,KAAI,IAAK,EAAC;MACjC,IAAI,CAACF,IAAI,CAACG,OAAM,GAAIY,IAAI,CAACZ,OAAM,IAAK,EAAC;MACrC,IAAI,CAACC,YAAW,GAAIW,IAAI,CAACT,KAAI,IAAK,EAAC;MACnC,IAAI,CAACD,SAAS,CAACC,KAAI,GAAIS,IAAI,CAACT,KAAI,IAAK,EAAC;IACxC;IACA,MAAM,IAAI,CAACU,WAAW,CAAC;EACzB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,WAAWA,CAAA,EAAG;MAClB,IAAI;QACF,MAAM;UAAEjB;QAAK,IAAI,MAAMH,GAAG,CAACsB,GAAG,CAAC,2BAA2B;QAC1D,MAAMH,IAAG,GAAIhB,IAAI,EAAEgB,IAAG;QACtB,IAAI,CAACA,IAAI,EAAE;QACX,