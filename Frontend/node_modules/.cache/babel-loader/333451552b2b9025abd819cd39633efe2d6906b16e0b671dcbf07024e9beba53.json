{"ast":null,"code":"import { createElementVNode as _createElementVNode, renderList as _renderList, Fragment as _Fragment, openBlock as _openBlock, createElementBlock as _createElementBlock, toDisplayString as _toDisplayString } from \"vue\";\nconst _hoisted_1 = {\n  class: \"table\"\n};\nconst _hoisted_2 = [\"onClick\"];\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", null, [_cache[1] || (_cache[1] = _createElementVNode(\"h2\", null, \"Features Management\", -1)), _cache[2] || (_cache[2] = _createElementVNode(\"p\", null, \"Manage which features are enabled for your store.\", -1)), _createElementVNode(\"table\", _hoisted_1, [_cache[0] || (_cache[0] = _createElementVNode(\"thead\", null, [_createElementVNode(\"tr\", null, [_createElementVNode(\"th\", null, \"Feature\"), _createElementVNode(\"th\", null, \"Enabled\"), _createElementVNode(\"th\", null, \"Action\")])], -1)), _createElementVNode(\"tbody\", null, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($data.features, f => {\n    return _openBlock(), _createElementBlock(\"tr\", {\n      key: f\n    }, [_createElementVNode(\"td\", null, _toDisplayString($data.labels[f] || f), 1), _createElementVNode(\"td\", null, _toDisplayString($options.isEnabled(f) ? 'Yes' : 'No'), 1), _createElementVNode(\"td\", null, [_createElementVNode(\"button\", {\n      class: \"btn\",\n      onClick: $event => $options.toggleFeature(f)\n    }, _toDisplayString($options.isEnabled(f) ? 'Disable' : 'Enable'), 9, _hoisted_2)])]);\n  }), 128))])])]);\n}","map":{"version":3,"names":["class","_createElementBlock","_createElementVNode","_hoisted_1","_Fragment","_renderList","$data","features","f","key","_toDisplayString","labels","$options","isEnabled","onClick","$event","toggleFeature","_hoisted_2"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\store\\FeaturesManagement.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>Features Management</h2>\r\n    <p>Manage which features are enabled for your store.</p>\r\n\r\n    <table class=\"table\">\r\n      <thead>\r\n        <tr><th>Feature</th><th>Enabled</th><th>Action</th></tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"f in features\" :key=\"f\">\r\n          <td>{{ labels[f] || f }}</td>\r\n          <td>{{ isEnabled(f) ? 'Yes' : 'No' }}</td>\r\n          <td>\r\n            <button class=\"btn\" @click=\"toggleFeature(f)\">\r\n              {{ isEnabled(f) ? 'Disable' : 'Enable' }}\r\n            </button>\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\nexport default {\r\n  name: 'StoreFeaturesManagement',\r\n  data() {\r\n    return {\r\n      features: [],\r\n      featureFlags: {},\r\n      labels: {\r\n        products: 'Products',\r\n        orders: 'Orders',\r\n        inventory: 'Inventory',\r\n        customers: 'Customers',\r\n        reports: 'Reports',\r\n        cashflow: 'Cash Flow',\r\n        cashflow2: 'Cash Flow 2',\r\n        forecasting: 'Forecasting',\r\n        logistics: 'Delivery Service',\r\n        notifications: 'Notifications',\r\n        pos: 'POS'\r\n      }\r\n    }\r\n  },\r\n  async created() {\r\n    await this.loadFeatures()\r\n  },\r\n  methods: {\r\n    async loadFeatures() {\r\n      try {\r\n        const { data } = await api.get('/store/features/me')\r\n        this.featureFlags = data?.features || {}\r\n        this.features = Object.keys(this.featureFlags)\r\n      } catch (err) {\r\n        console.error(err)\r\n        this.featureFlags = {}\r\n        this.features = []\r\n      }\r\n    },\r\n    isEnabled(featureKey) {\r\n      return this.featureFlags[featureKey] !== false\r\n    },\r\n    async toggleFeature(featureKey) {\r\n      const nextEnabled = !this.isEnabled(featureKey)\r\n      try {\r\n        await api.put('/store/features/me', { feature_key: featureKey, enabled: nextEnabled })\r\n        this.featureFlags[featureKey] = nextEnabled\r\n      } catch (err) {\r\n        alert('Failed to update feature')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.table{width:100%;border-collapse:collapse;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 4px 14px rgba(56,92,35,.08)}\r\n.table th,.table td{padding:10px 12px;border-bottom:1px solid #e6eddc;text-align:left}\r\n.table th{background:#f4f8ee}\r\n.btn{padding:6px 10px;border:1px solid #cddbb9;background:#f8fbf4;border-radius:6px;cursor:pointer}\r\n</style>"],"mappings":";;EAKWA,KAAK,EAAC;AAAO;;;uBAJtBC,mBAAA,CAoBM,c,0BAnBJC,mBAAA,CAA4B,YAAxB,qBAAmB,Q,0BACvBA,mBAAA,CAAwD,WAArD,mDAAiD,QAEpDA,mBAAA,CAeQ,SAfRC,UAeQ,G,0BAdND,mBAAA,CAEQ,gBADNA,mBAAA,CAAwD,aAApDA,mBAAA,CAAgB,YAAZ,SAAO,GAAKA,mBAAA,CAAgB,YAAZ,SAAO,GAAKA,mBAAA,CAAe,YAAX,QAAM,E,UAEhDA,mBAAA,CAUQ,iB,kBATND,mBAAA,CAQKG,SAAA,QAAAC,WAAA,CARWC,KAAA,CAAAC,QAAQ,EAAbC,CAAC;yBAAZP,mBAAA,CAQK;MARsBQ,GAAG,EAAED;IAAC,IAC/BN,mBAAA,CAA6B,YAAAQ,gBAAA,CAAtBJ,KAAA,CAAAK,MAAM,CAACH,CAAC,KAAKA,CAAC,OACrBN,mBAAA,CAA0C,YAAAQ,gBAAA,CAAnCE,QAAA,CAAAC,SAAS,CAACL,CAAC,uBAClBN,mBAAA,CAIK,aAHHA,mBAAA,CAES;MAFDF,KAAK,EAAC,KAAK;MAAEc,OAAK,EAAAC,MAAA,IAAEH,QAAA,CAAAI,aAAa,CAACR,CAAC;wBACtCI,QAAA,CAAAC,SAAS,CAACL,CAAC,8BAAAS,UAAA,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}