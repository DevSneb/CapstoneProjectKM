{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport api from '../../services/api';\nexport default {\n  name: 'StoreForecasting',\n  data() {\n    return {\n      forecastHorizon: 7,\n      forecastLoading: false,\n      forecastError: '',\n      forecastWarning: '',\n      forecastRows: [],\n      analytics: null,\n      productTrends: [],\n      trendDays: 30,\n      trendsLoading: false,\n      trendsError: ''\n    };\n  },\n  computed: {\n    minForecast() {\n      if (!this.forecastRows.length) return 0;\n      return Math.min(...this.forecastRows.map(row => Number(row.value || 0)));\n    },\n    maxForecast() {\n      if (!this.forecastRows.length) return 0;\n      return Math.max(...this.forecastRows.map(row => Number(row.value || 0)));\n    },\n    chartPoints() {\n      if (!this.forecastRows.length) return '0,180 720,180';\n      return this.forecastRows.map(row => `${this.pointX(row.dayIndex)},${this.pointY(row.value)}`).join(' ');\n    },\n    levelCounts() {\n      return this.forecastRows.reduce((acc, row) => {\n        const key = String(row.level || '').toLowerCase();\n        if (key === 'low') acc.low += 1;\n        if (key === 'mid') acc.mid += 1;\n        if (key === 'high') acc.high += 1;\n        return acc;\n      }, {\n        low: 0,\n        mid: 0,\n        high: 0\n      });\n    }\n  },\n  created() {\n    this.fetchForecast();\n    this.fetchProductTrends();\n  },\n  methods: {\n    levelClass(level) {\n      return String(level || '').toLowerCase();\n    },\n    classifyLevel(value) {\n      const min = this.minForecast;\n      const max = this.maxForecast;\n      const range = Math.max(1, max - min);\n      const lowCutoff = min + range / 3;\n      const highCutoff = min + 2 * range / 3;\n      if (value <= lowCutoff) return 'Low';\n      if (value >= highCutoff) return 'High';\n      return 'Mid';\n    },\n    pointX(dayIndex) {\n      const count = Math.max(1, this.forecastRows.length);\n      const step = count > 1 ? 680 / (count - 1) : 680;\n      return 20 + (dayIndex - 1) * step;\n    },\n    pointY(value) {\n      const min = this.minForecast;\n      const max = this.maxForecast;\n      const range = Math.max(1, max - min);\n      const normalized = (Number(value || 0) - min) / range;\n      return 190 - normalized * 160;\n    },\n    formatQuantity(value) {\n      return Number(value || 0).toLocaleString(undefined, {\n        minimumFractionDigits: 0,\n        maximumFractionDigits: 3\n      });\n    },\n    async fetchProductTrends() {\n      this.trendsLoading = true;\n      this.trendsError = '';\n      try {\n        const {\n          data\n        } = await api.get('/store/reports/product-trends', {\n          params: {\n            days: this.trendDays\n          }\n        });\n        this.productTrends = Array.isArray(data?.trends) ? data.trends : [];\n      } catch (err) {\n        this.productTrends = [];\n        this.trendsError = err.response?.data?.message || 'Failed to load product trends';\n      } finally {\n        this.trendsLoading = false;\n      }\n    },\n    async fetchForecast() {\n      this.forecastLoading = true;\n      this.forecastError = '';\n      this.forecastWarning = '';\n      try {\n        const {\n          data\n        } = await api.get('/store/reports/forecast', {\n          params: {\n            horizon: this.forecastHorizon\n          }\n        });\n        this.analytics = data?.analytics || null;\n        if (data?.warning) {\n          this.forecastWarning = `Forecast used fallback mode: ${data.warning}`;\n        }\n        const values = Array.isArray(data?.forecast) ? data.forecast : [];\n        const baseRows = values.map((value, index) => ({\n          dayIndex: index + 1,\n          value: Number(value || 0)\n        }));\n        this.forecastRows = baseRows.map(row => ({\n          ...row,\n          level: this.classifyLevel(row.value)\n        }));\n      } catch (err) {\n        this.forecastRows = [];\n        this.analytics = null;\n        this.forecastError = err.response?.data?.message || 'Failed to load forecast';\n      } finally {\n        this.forecastLoading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","forecastHorizon","forecastLoading","forecastError","forecastWarning","forecastRows","analytics","productTrends","trendDays","trendsLoading","trendsError","computed","minForecast","length","Math","min","map","row","Number","value","maxForecast","max","chartPoints","pointX","dayIndex","pointY","join","levelCounts","reduce","acc","key","String","level","toLowerCase","low","mid","high","created","fetchForecast","fetchProductTrends","methods","levelClass","classifyLevel","range","lowCutoff","highCutoff","count","step","normalized","formatQuantity","toLocaleString","undefined","minimumFractionDigits","maximumFractionDigits","get","params","days","Array","isArray","trends","err","response","message","horizon","warning","values","forecast","baseRows","index"],"sources":["C:\\Users\\Admin\\Documents\\CapstoneProject\\kadiwa\\Frontend\\src\\views\\store\\Forecasting.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>Sales Forecasting</h2>\r\n\r\n    <div class=\"forecast-tools\">\r\n      <label>Forecast Days\r\n        <select v-model.number=\"forecastHorizon\">\r\n          <option :value=\"3\">3</option>\r\n          <option :value=\"7\">7</option>\r\n          <option :value=\"14\">14</option>\r\n          <option :value=\"30\">30</option>\r\n        </select>\r\n      </label>\r\n      <button class=\"primary\" @click=\"fetchForecast\" :disabled=\"forecastLoading\">\r\n        {{ forecastLoading ? 'Loading...' : 'Run Forecast' }}\r\n      </button>\r\n    </div>\r\n\r\n    <div v-if=\"forecastError\" class=\"forecast-error\">{{ forecastError }}</div>\r\n    <div v-if=\"forecastWarning\" class=\"forecast-warning\">{{ forecastWarning }}</div>\r\n\r\n    <div v-if=\"analytics\" class=\"analytics-summary\">\r\n      <div><span>90-day average</span><strong>₱{{ Number(analytics.average_daily_sales || 0).toFixed(2) }}</strong></div>\r\n      <div><span>Last 7-day average</span><strong>₱{{ Number(analytics.recent_7_day_average || 0).toFixed(2) }}</strong></div>\r\n      <div><span>Sales trend</span><strong :class=\"`trend-${analytics.trend}`\">{{ analytics.trend }}</strong></div>\r\n      <div><span>Zero-sales days</span><strong>{{ analytics.zero_sales_days || 0 }}</strong></div>\r\n    </div>\r\n\r\n    <div v-if=\"forecastRows.length\" class=\"graph-card\">\r\n      <div class=\"graph-head\">\r\n        <strong>Forecast Trend</strong>\r\n        <div class=\"legend\">\r\n          <span class=\"dot low\"></span> Low\r\n          <span class=\"dot mid\"></span> Mid\r\n          <span class=\"dot high\"></span> High\r\n        </div>\r\n      </div>\r\n      <svg class=\"line-chart\" viewBox=\"0 0 720 220\" preserveAspectRatio=\"none\" role=\"img\" aria-label=\"Forecast line chart\">\r\n        <polyline :points=\"chartPoints\" fill=\"none\" stroke=\"#4E7D32\" stroke-width=\"3\" stroke-linecap=\"round\" />\r\n        <circle v-for=\"row in forecastRows\" :key=\"`dot-${row.dayIndex}`\" :cx=\"pointX(row.dayIndex)\" :cy=\"pointY(row.value)\" r=\"4\" :class=\"['dot-point', levelClass(row.level)]\" />\r\n      </svg>\r\n    </div>\r\n\r\n    <div v-if=\"forecastRows.length\" class=\"level-summary\">\r\n      <span class=\"badge low\">Low: {{ levelCounts.low }}</span>\r\n      <span class=\"badge mid\">Mid: {{ levelCounts.mid }}</span>\r\n      <span class=\"badge high\">High: {{ levelCounts.high }}</span>\r\n    </div>\r\n\r\n    <section class=\"trend-card\">\r\n      <div class=\"graph-head\">\r\n        <div>\r\n          <strong>Product Trends</strong>\r\n          <p class=\"trend-caption\">Delivered sales: latest {{ trendDays }} days vs previous {{ trendDays }} days</p>\r\n        </div>\r\n        <span v-if=\"trendsLoading\" class=\"trend-caption\">Loading...</span>\r\n      </div>\r\n      <div v-if=\"trendsError\" class=\"forecast-error\">{{ trendsError }}</div>\r\n      <div v-else-if=\"productTrends.length\" class=\"table-wrap\">\r\n        <table class=\"table trends-table\">\r\n          <thead><tr><th>Product</th><th>Qty Sold</th><th>Revenue</th><th>Previous Qty</th><th>Trend</th></tr></thead>\r\n          <tbody>\r\n            <tr v-for=\"trend in productTrends\" :key=\"trend.product_id\">\r\n              <td>{{ trend.product_name }}</td>\r\n              <td>{{ formatQuantity(trend.current_quantity) }}</td>\r\n              <td>₱{{ Number(trend.current_revenue).toFixed(2) }}</td>\r\n              <td>{{ formatQuantity(trend.previous_quantity) }}</td>\r\n              <td>\r\n                <span class=\"trend-pill\" :class=\"trend.trend\">\r\n                  {{ trend.trend === 'up' ? '↑' : trend.trend === 'down' ? '↓' : '→' }}\r\n                  {{ Math.abs(Number(trend.trend_percent || 0)).toFixed(1) }}%\r\n                </span>\r\n              </td>\r\n            </tr>\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n      <p v-else class=\"empty trend-empty\">No delivered product sales found for this period.</p>\r\n    </section>\r\n\r\n    <div v-if=\"forecastRows.length\" class=\"table-wrap\">\r\n      <table class=\"table\">\r\n        <thead><tr><th>Day</th><th>Predicted Sales</th><th>Sales Level</th></tr></thead>\r\n        <tbody>\r\n          <tr v-for=\"row in forecastRows\" :key=\"row.dayIndex\">\r\n            <td>Day {{ row.dayIndex }}</td>\r\n            <td>₱{{ Number(row.value).toFixed(2) }}</td>\r\n            <td><span class=\"badge\" :class=\"levelClass(row.level)\">{{ row.level }}</span></td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n    <div v-else class=\"empty\">No forecast yet. Click Run Forecast.</div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\n\r\nexport default {\r\n  name: 'StoreForecasting',\r\n  data() {\r\n    return {\r\n      forecastHorizon: 7,\r\n      forecastLoading: false,\r\n      forecastError: '',\r\n      forecastWarning: '',\r\n      forecastRows: [],\r\n      analytics: null,\r\n      productTrends: [],\r\n      trendDays: 30,\r\n      trendsLoading: false,\r\n      trendsError: ''\r\n    }\r\n  },\r\n  computed: {\r\n    minForecast() {\r\n      if (!this.forecastRows.length) return 0\r\n      return Math.min(...this.forecastRows.map(row => Number(row.value || 0)))\r\n    },\r\n    maxForecast() {\r\n      if (!this.forecastRows.length) return 0\r\n      return Math.max(...this.forecastRows.map(row => Number(row.value || 0)))\r\n    },\r\n    chartPoints() {\r\n      if (!this.forecastRows.length) return '0,180 720,180'\r\n      return this.forecastRows.map(row => `${this.pointX(row.dayIndex)},${this.pointY(row.value)}`).join(' ')\r\n    },\r\n    levelCounts() {\r\n      return this.forecastRows.reduce((acc, row) => {\r\n        const key = String(row.level || '').toLowerCase()\r\n        if (key === 'low') acc.low += 1\r\n        if (key === 'mid') acc.mid += 1\r\n        if (key === 'high') acc.high += 1\r\n        return acc\r\n      }, { low: 0, mid: 0, high: 0 })\r\n    }\r\n  },\r\n  created() {\r\n    this.fetchForecast()\r\n    this.fetchProductTrends()\r\n  },\r\n  methods: {\r\n    levelClass(level) {\r\n      return String(level || '').toLowerCase()\r\n    },\r\n    classifyLevel(value) {\r\n      const min = this.minForecast\r\n      const max = this.maxForecast\r\n      const range = Math.max(1, max - min)\r\n      const lowCutoff = min + range / 3\r\n      const highCutoff = min + (2 * range) / 3\r\n      if (value <= lowCutoff) return 'Low'\r\n      if (value >= highCutoff) return 'High'\r\n      return 'Mid'\r\n    },\r\n    pointX(dayIndex) {\r\n      const count = Math.max(1, this.forecastRows.length)\r\n      const step = count > 1 ? 680 / (count - 1) : 680\r\n      return 20 + (dayIndex - 1) * step\r\n    },\r\n    pointY(value) {\r\n      const min = this.minForecast\r\n      const max = this.maxForecast\r\n      const range = Math.max(1, max - min)\r\n      const normalized = (Number(value || 0) - min) / range\r\n      return 190 - normalized * 160\r\n    },\r\n    formatQuantity(value) {\r\n      return Number(value || 0).toLocaleString(undefined, {\r\n        minimumFractionDigits: 0,\r\n        maximumFractionDigits: 3\r\n      })\r\n    },\r\n    async fetchProductTrends() {\r\n      this.trendsLoading = true\r\n      this.trendsError = ''\r\n      try {\r\n        const { data } = await api.get('/store/reports/product-trends', {\r\n          params: { days: this.trendDays }\r\n        })\r\n        this.productTrends = Array.isArray(data?.trends) ? data.trends : []\r\n      } catch (err) {\r\n        this.productTrends = []\r\n        this.trendsError = err.response?.data?.message || 'Failed to load product trends'\r\n      } finally {\r\n        this.trendsLoading = false\r\n      }\r\n    },\r\n    async fetchForecast() {\r\n      this.forecastLoading = true\r\n      this.forecastError = ''\r\n      this.forecastWarning = ''\r\n      try {\r\n        const { data } = await api.get('/store/reports/forecast', {\r\n          params: { horizon: this.forecastHorizon }\r\n        })\r\n\r\n        this.analytics = data?.analytics || null\r\n        if (data?.warning) {\r\n          this.forecastWarning = `Forecast used fallback mode: ${data.warning}`\r\n        }\r\n\r\n        const values = Array.isArray(data?.forecast) ? data.forecast : []\r\n        const baseRows = values.map((value, index) => ({\r\n          dayIndex: index + 1,\r\n          value: Number(value || 0)\r\n        }))\r\n        this.forecastRows = baseRows.map(row => ({\r\n          ...row,\r\n          level: this.classifyLevel(row.value)\r\n        }))\r\n      } catch (err) {\r\n        this.forecastRows = []\r\n        this.analytics = null\r\n        this.forecastError = err.response?.data?.message || 'Failed to load forecast'\r\n      } finally {\r\n        this.forecastLoading = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.table{ width:100%; background:#fff; border-collapse:collapse; border-radius:8px; overflow:hidden; box-shadow:0 4px 14px rgba(56,92,35,.08) }\r\n.table th,.table td{ padding:10px 12px; border-bottom:1px solid #e6eddc }\r\n.table th{ background:#f4f8ee }\r\n.empty{ text-align:center; color:#6f7d67 }\r\n.primary{ background:linear-gradient(135deg,#7CB342,#4E7D32); color:#fff; border:none; padding:8px 12px; border-radius:6px; cursor:pointer }\r\n.forecast-tools{ display:flex; gap:10px; align-items:center; margin:10px 0 }\r\n.forecast-tools select{ border:1px solid #cddbb9; border-radius:6px; padding:7px 10px; background:#fff }\r\n.forecast-error{ color:#b91c1c; margin-bottom:8px }\r\n.forecast-warning{ color:#92400e; margin-bottom:8px }\r\n.analytics-summary{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; margin-bottom:10px }\r\n.analytics-summary>div{ background:#fff; border:1px solid #e3ecd6; border-radius:8px; padding:10px }\r\n.analytics-summary span{ display:block; color:#6f7d67; font-size:12px }\r\n.analytics-summary strong{ display:block; margin-top:4px; color:#315322; text-transform:capitalize }\r\n.trend-up{ color:#166534!important }\r\n.trend-down{ color:#991b1b!important }\r\n.graph-card{ background:#fff; border:1px solid #e3ecd6; border-radius:10px; padding:10px; margin-bottom:10px }\r\n.trend-card{ background:#fff; border:1px solid #e3ecd6; border-radius:10px; padding:10px; margin:0 0 10px }\r\n.graph-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:8px }\r\n.trend-caption{ margin:4px 0 0; color:#6f7d67; font-size:12px }\r\n.trends-table th,.trends-table td{ white-space:nowrap }\r\n.trend-pill{ display:inline-block; min-width:64px; padding:4px 8px; border-radius:999px; text-align:center; font-size:12px; font-weight:700 }\r\n.trend-pill.up{ background:rgba(22,163,74,.15); color:#166534 }\r\n.trend-pill.down{ background:rgba(220,38,38,.14); color:#991b1b }\r\n.trend-pill.stable{ background:rgba(107,114,128,.14); color:#4b5563 }\r\n.trend-empty{ margin:8px 0 0 }\r\n.legend{ display:flex; align-items:center; gap:10px; color:#5f7256; font-size:12px }\r\n.line-chart{ width:100%; height:220px; background:#f8fbf4; border-radius:8px; border:1px solid #e6eddc }\r\n.dot{ width:10px; height:10px; border-radius:50%; display:inline-block; margin-right:4px }\r\n.dot.low{ background:#dc2626 }\r\n.dot.mid{ background:#ca8a04 }\r\n.dot.high{ background:#16a34a }\r\n.dot-point.low{ fill:#dc2626 }\r\n.dot-point.mid{ fill:#ca8a04 }\r\n.dot-point.high{ fill:#16a34a }\r\n.level-summary{ display:flex; gap:8px; margin:8px 0 10px }\r\n.badge{ display:inline-block; border-radius:999px; padding:4px 10px; font-size:12px; font-weight:700 }\r\n.badge.low{ background:rgba(220,38,38,.15); color:#991b1b }\r\n.badge.mid{ background:rgba(202,138,4,.2); color:#854d0e }\r\n.badge.high{ background:rgba(22,163,74,.18); color:#166534 }\r\n\r\n/* mobile-dashboard-fix */\r\n.table-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}\r\n.table-wrap .table, table.table{width:100%}\r\n@media (max-width: 640px){\r\n  .analytics-summary{grid-template-columns:repeat(2,minmax(0,1fr))}\r\n  .toolbar,.filters,.head,.section-head,.graph-head,.forecast-tools,.reports-header,.form{flex-wrap:wrap}\r\n  .toolbar,.filters,.head,.section-head{display:flex;gap:8px}\r\n  .toolbar input,.search-input,input[type=\"search\"],.search{min-width:0!important;width:100%;max-width:100%}\r\n  .table-wrap .table, table.table{min-width:560px}\r\n  .btn,button.primary,button.save-btn{min-height:40px}\r\n  .barangay-row{flex-direction:column;align-items:stretch!important}\r\n  .map{height:260px!important}\r\n  .details-grid{grid-template-columns:1fr!important}\r\n  .card,.form{max-width:100%}\r\n}\r\n</style>\r\n"],"mappings":";;;AAiGA,OAAOA,GAAE,MAAO,oBAAmB;AAEnC,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,eAAe,EAAE,CAAC;MAClBC,eAAe,EAAE,KAAK;MACtBC,aAAa,EAAE,EAAE;MACjBC,eAAe,EAAE,EAAE;MACnBC,YAAY,EAAE,EAAE;MAChBC,SAAS,EAAE,IAAI;MACfC,aAAa,EAAE,EAAE;MACjBC,SAAS,EAAE,EAAE;MACbC,aAAa,EAAE,KAAK;MACpBC,WAAW,EAAE;IACf;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,IAAI,CAAC,IAAI,CAACP,YAAY,CAACQ,MAAM,EAAE,OAAO;MACtC,OAAOC,IAAI,CAACC,GAAG,CAAC,GAAG,IAAI,CAACV,YAAY,CAACW,GAAG,CAACC,GAAE,IAAKC,MAAM,CAACD,GAAG,CAACE,KAAI,IAAK,CAAC,CAAC,CAAC;IACzE,CAAC;IACDC,WAAWA,CAAA,EAAG;MACZ,IAAI,CAAC,IAAI,CAACf,YAAY,CAACQ,MAAM,EAAE,OAAO;MACtC,OAAOC,IAAI,CAACO,GAAG,CAAC,GAAG,IAAI,CAAChB,YAAY,CAACW,GAAG,CAACC,GAAE,IAAKC,MAAM,CAACD,GAAG,CAACE,KAAI,IAAK,CAAC,CAAC,CAAC;IACzE,CAAC;IACDG,WAAWA,CAAA,EAAG;MACZ,IAAI,CAAC,IAAI,CAACjB,YAAY,CAACQ,MAAM,EAAE,OAAO,eAAc;MACpD,OAAO,IAAI,CAACR,YAAY,CAACW,GAAG,CAACC,GAAE,IAAK,GAAG,IAAI,CAACM,MAAM,CAACN,GAAG,CAACO,QAAQ,CAAC,IAAI,IAAI,CAACC,MAAM,CAACR,GAAG,CAACE,KAAK,CAAC,EAAE,CAAC,CAACO,IAAI,CAAC,GAAG;IACxG,CAAC;IACDC,WAAWA,CAAA,EAAG;MACZ,OAAO,IAAI,CAACtB,YAAY,CAACuB,MAAM,CAAC,CAACC,GAAG,EAAEZ,GAAG,KAAK;QAC5C,MAAMa,GAAE,GAAIC,MAAM,CAACd,GAAG,CAACe,KAAI,IAAK,EAAE,CAAC,CAACC,WAAW,CAAC;QAChD,IAAIH,GAAE,KAAM,KAAK,EAAED,GAAG,CAACK,GAAE,IAAK;QAC9B,IAAIJ,GAAE,KAAM,KAAK,EAAED,GAAG,CAACM,GAAE,IAAK;QAC9B,IAAIL,GAAE,KAAM,MAAM,EAAED,GAAG,CAACO,IAAG,IAAK;QAChC,OAAOP,GAAE;MACX,CAAC,EAAE;QAAEK,GAAG,EAAE,CAAC;QAAEC,GAAG,EAAE,CAAC;QAAEC,IAAI,EAAE;MAAE,CAAC;IAChC;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,aAAa,CAAC;IACnB,IAAI,CAACC,kBAAkB,CAAC;EAC1B,CAAC;EACDC,OAAO,EAAE;IACPC,UAAUA,CAACT,KAAK,EAAE;MAChB,OAAOD,MAAM,CAACC,KAAI,IAAK,EAAE,CAAC,CAACC,WAAW,CAAC;IACzC,CAAC;IACDS,aAAaA,CAACvB,KAAK,EAAE;MACnB,MAAMJ,GAAE,GAAI,IAAI,CAACH,WAAU;MAC3B,MAAMS,GAAE,GAAI,IAAI,CAACD,WAAU;MAC3B,MAAMuB,KAAI,GAAI7B,IAAI,CAACO,GAAG,CAAC,CAAC,EAAEA,GAAE,GAAIN,GAAG;MACnC,MAAM6B,SAAQ,GAAI7B,GAAE,GAAI4B,KAAI,GAAI;MAChC,MAAME,UAAS,GAAI9B