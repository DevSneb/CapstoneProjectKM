{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport api from '../../services/api';\nimport InventoryTable from './_InventoryTable.vue';\nconst UNIT_OPTIONS = ['PC/S', 'KG/S', 'LT/S'];\nconst CATEGORY_OPTIONS = ['LOWLAND', 'HIGHLAND', 'FRUITS', 'RICE', 'EGGS (pc)', 'SEAFOOD', 'PORK', 'BEEF', 'CHICKEN', 'OTHER PRODUCTS'];\nexport default {\n  components: {\n    InventoryTable\n  },\n  data() {\n    return {\n      unitOptions: UNIT_OPTIONS,\n      categoryOptions: CATEGORY_OPTIONS,\n      showAddForm: false,\n      form: {\n        name: '',\n        price: null,\n        stock: null,\n        unit: '',\n        unit_other: '',\n        category: '',\n        category_other: '',\n        description: '',\n        status: 'active',\n        image_data_url: null\n      }\n    };\n  },\n  methods: {\n    async onImageSelected(event) {\n      const file = event.target?.files?.[0];\n      if (!file) {\n        this.form.image_data_url = null;\n        return;\n      }\n      if (!file.type.startsWith('image/')) {\n        alert('Please select a valid image file.');\n        event.target.value = '';\n        this.form.image_data_url = null;\n        return;\n      }\n      if (file.size > 2 * 1024 * 1024) {\n        alert('Image is too large. Maximum size is 2MB.');\n        event.target.value = '';\n        this.form.image_data_url = null;\n        return;\n      }\n      this.form.image_data_url = await this.readAsDataUrl(file);\n    },\n    readAsDataUrl(file) {\n      return new Promise((resolve, reject) => {\n        const reader = new FileReader();\n        reader.onload = () => resolve(reader.result);\n        reader.onerror = () => reject(new Error('Failed to read image file'));\n        reader.readAsDataURL(file);\n      });\n    },\n    async createProduct() {\n      try {\n        const resolvedUnit = this.form.unit === '__other__' ? (this.form.unit_other || '').trim() : this.form.unit;\n        const resolvedCategory = this.form.category === '__other__' ? (this.form.category_other || '').trim() : this.form.category;\n        const finalUnit = resolvedUnit;\n        const finalCategory = resolvedCategory;\n        if (!finalUnit) {\n          alert('Please select a unit or specify one in Others.');\n          return;\n        }\n        if (!finalCategory) {\n          alert('Please select a category or specify one in Others.');\n          return;\n        }\n        await api.post('/store/products', {\n          name: this.form.name,\n          price: Number(this.form.price),\n          stock: Number(this.form.stock || 0),\n          unit: finalUnit,\n          category: finalCategory,\n          description: this.form.description || null,\n          status: this.form.status,\n          image_data_url: this.form.image_data_url || null\n        });\n        this.form = {\n          name: '',\n          price: null,\n          stock: null,\n          unit: '',\n          unit_other: '',\n          category: '',\n          category_other: '',\n          description: '',\n          status: 'active',\n          image_data_url: null\n        };\n        this.showAddForm = false;\n        if (this.$refs.inventoryTable?.refreshRows) {\n          await this.$refs.inventoryTable.refreshRows();\n        }\n      } catch (err) {\n        const backendErrors = err.response?.data?.errors;\n        const backendMessage = Array.isArray(backendErrors) && backendErrors.length ? backendErrors.map(e => e.msg).join(', ') : err.response?.data?.message;\n        alert(backendMessage || 'Failed to add product');\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","InventoryTable","UNIT_OPTIONS","CATEGORY_OPTIONS","components","data","unitOptions","categoryOptions","showAddForm","form","name","price","stock","unit","unit_other","category","category_other","description","status","image_data_url","methods","onImageSelected","event","file","target","files","type","