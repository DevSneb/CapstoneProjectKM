f=\"form.category === '__other__'\"\r\n\t\t\t\tv-model.trim=\"form.category_other\"\r\n\t\t\t\tplaceholder=\"Specify category\"\r\n\t\t\t\trequired\r\n\t\t\t/>\r\n\t\t\t<input type=\"file\" accept=\"image/*\" @change=\"onImageSelected\" />\r\n\t\t\t<small class=\"hint\">Optional image (PNG/JPG/WEBP/GIF, max 2MB)</small>\r\n\t\t\t<select v-model=\"form.status\">\r\n\t\t\t\t<option value=\"active\">active</option>\r\n\t\t\t\t<option value=\"inactive\">inactive</option>\r\n\t\t\t</select>\r\n\t\t\t<textarea v-model.trim=\"form.description\" placeholder=\"Description\" required></textarea>\r\n\t\t\t<button class=\"btn save\" type=\"submit\">Save Product</button>\r\n\t\t</form>\r\n\r\n\t\t<inventory-table ref=\"inventoryTable\" mode=\"all\"/>\r\n\t</div>\r\n</template>\r\n<script>\r\nimport api from '../../services/api'\r\nimport InventoryTable from './_InventoryTable.vue'\r\nconst UNIT_OPTIONS = ['PC/S', 'KG/S', 'LT/S']\r\nconst CATEGORY_OPTIONS = ['LOWLAND', 'HIGHLAND', 'FRUITS', 'RICE', 'EGGS (pc)', 'SEAFOOD', 'PORK', 'BEEF', 'CHICKEN', 'OTHER PRODUCTS']\r\nexport default {\r\n\tcomponents:{ InventoryTable },\r\n\tdata() {\r\n\t\treturn {\r\n\t\t\tunitOptions: UNIT_OPTIONS,\r\n\t\t\tcategoryOptions: CATEGORY_OPTIONS,\r\n\t\t\tshowAddForm: false,\r\n\t\t\tform: {\r\n\t\t\t\tname: '',\r\n\t\t\t\tprice: null,\r\n\t\t\t\tstock: null,\r\n\t\t\t\tunit: '',\r\n\t\t\t\tunit_other: '',\r\n\t\t\t\tcategory: '',\r\n\t\t\t\tcategory_other: '',\r\n\t\t\t\tdescription: '',\r\n\t\t\t\tstatus: 'active',\r\n\t\t\t\timage_data_url: null\r\n\t\t\t}\r\n\t\t}\r\n\t},\r\n\tmethods: {\r\n\t\tasync onImageSelected(event) {\r\n\t\t\tconst file = event.target?.files?.[0]\r\n\t\t\tif (!file) {\r\n\t\t\t\tthis.form.image_data_url = null\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tif (!file.type.startsWith('image/')) {\r\n\t\t\t\talert('Please select a valid image file.')\r\n\t\t\t\tevent.target.value = ''\r\n\t\t\t\tthis.form.image_data_url = null\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tif (file.size > 2 * 1024 * 1024) {\r\n\t\t\t\talert('Image is too large. Maximum size is 2MB.')\r\n\t\t\t\tevent.target.value = ''\r\n\t\t\t\tthis.form.image_data_url = null\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tthis.form.image_data_url = await this.readAsDataUrl(file)\r\n\t\t},\r\n\t\treadAsDataUrl(file) {\r\n\t\t\treturn new Promise((resolve, reject) => {\r\n\t\t\t\tconst reader = new FileReader()\r\n\t\t\t\treader.onload = () => resolve(reader.result)\r\n\t\t\t\treader.onerror = () => reject(new Error('Failed to read image file'))\r\n\t\t\t\treader.readAsDataURL(file)\r\n\t\t\t})\r\n\t\t},\r\n\t\tasync createProduct() {\r\n\t\t\ttry {\r\n\t\t\t\tconst resolvedUnit = this.form.unit === '__other__' ? (this.form.unit_other || '').trim() : this.form.unit\r\n\t\t\t\tconst resolvedCategory = this.form.category === '__other__' ? (this.form.category_other || '').trim() : this.form.category\r\n\t\t\t\tconst finalUnit = resolvedUnit\r\n\t\t\t\tconst finalCategory = resolvedCategory\r\n\t\t\t\tif (!finalUnit) {\r\n\t\t\t\t\talert('Please select a unit or specify one in Others.')\r\n\t\t\t\t\treturn\r\n\t\t\t\t}\r\n\t\t\t\tif (!finalCategory) {\r\n\t\t\t\t\talert('Please select a category or specify one in Others.')\r\n\t\t\t\t\treturn\r\n\t\t\t\t}\r\n\t\t\t\tawait api.post('/store/products', {\r\n\t\t\t\t\tname: this.form.name,\r\n\t\t\t\t\tprice: Number(this.form.price),\r\n\t\t\t\t\tstock: Number(this.form.stock || 0),\r\n\t\t\t\t\tunit: finalUnit,\r\n\t\t\t\t\tcategory: finalCategory,\r\n\t\t\t\t\tdescription: this.form.description || null,\r\n\t\t\t\t\tstatus: this.form.status,\r\n\t\t\t\t\timage_data_url: this.form.image_data_url || null\r\n\t\t\t\t})\r\n\r\n\t\t\t\tthis.form = {\r\n\t\t\t\t\tname: '',\r\n\t\t\t\t\tprice: null,\r\n\t\t\t\t\tstock: null,\r\n\t\t\t\t\tunit: '',\r\n\t\t\t\t\tunit_other: '',\r\n\t\t\t\t\tcategory: '',\r\n\t\t\t\t\tcategory_other: '',\r\n\t\t\t\t\tdescription: '',\r\n\t\t\t\t\tstatus: 'active',\r\n\t\t\t\t\timage_data_url: null\r\n\t\t\t\t}\r\n\t\t\t\tthis.showAddForm = false\r\n\t\t\t\tif (this.$refs.inventoryTable?.refreshRows) {\r\n\t\t\t\t\tawait this.$refs.inventoryTable.refreshRows()\r\n\t\t\t\t}\r\n\t\t\t} catch (err) {\r\n\t\t\t\tconst backendErrors = err.response?.data?.errors\r\n\t\t\t\tconst backendMessage = Array.isArray(backendErrors) && backendErrors.length\r\n\t\t\t\t\t? backendErrors.map((e) => e.msg).join(', ')\r\n\t\t\t\t\t: err.response?.data?.message\r\n\t\t\t\talert(backendMessage || 'Failed to add product')\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.toolbar { margin-bottom: 10px; }\r\n.form {\r\n\tdisplay: grid;\r\n\tgrid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\r\n\tgap: 8px;\r\n\tmargin-bottom: 12px;\r\n\tbackground: #fff;\r\n\tborder-radius: 8px;\r\n\tpadding: 12px;\r\n\tbox-shadow: 0 4px 14px rgba(56,92,35,.08);\r\n}\r\ntextarea {\r\n\tgrid-column: 1 / -1;\r\n\tmin-height: 78px;\r\n}\r\ninput, select, textarea {\r\n\tborder: 1px solid #cddbb9;\r\n\tborder-radius: 6px;\r\n\tpadding: 8px;\r\n\tbackground: #fff;\r\n}\r\n.hint {\r\n\tgrid-column: 1 / -1;\r\n\tcolor: #6f7d67;\r\n\tfont-size: 12px;\r\n\tmargin-top: -2px;\r\n}\r\n.btn {\r\n\tbackground: #f8fbf4;\r\n\tborder: 1px solid #cddbb9;\r\n\tborder-radius: 6px;\r\n\tpadding: 8px 12px;\r\n\tcursor: pointer;\r\n}\r\n.save {\r\n\tjustify-self: start;\r\n\tcolor: #fff;\r\n\tborder: none;\r\n\tbackground: linear-gradient(135deg,#7CB342,#4E7D32);\r\n}\r\n</style>\r\n"],"mappings":";;AAkDA,OAAOA,GAAE,MAAO,oBAAmB;AACnC,OAAOC,cAAa,MAAO,uBAAsB;AACjD,MAAMC,YAAW,GAAI,CAAC,MAAM,EAAE,MAAM,EAAE,MAAM;AAC5C,MAAMC,gBAAe,GAAI,CAAC,SAAS,EAAE,UAAU,EAAE,QAAQ,EAAE,MAAM,EAAE,WAAW,EAAE,SAAS,EAAE,MAAM,EAAE,MAAM,EAAE,SAAS,EAAE,gBAAgB;AACtI,eAAe;EACdC,UAAU,EAAC;IAAEH;EAAe,CAAC;EAC7BI,IAAIA,CAAA,EAAG;IACN,OAAO;MACNC,WAAW,EAAEJ,YAAY;MACzBK,eAAe,EAAEJ,gBAAgB;MACjCK,WAAW,EAAE,KAAK;MAClBC,IAAI,EAAE;QACLC,IAAI,EAAE,EAAE;QACRC,KAAK,EAAE,IAAI;QACXC,KAAK,EAAE,IAAI;QACXC,IAAI,EAAE,EAAE;QACRC,UAAU,EAAE,EAAE;QACdC,QAAQ,EAAE,EAAE;QACZC,cAA