{"ast":null,"code":"import api from '../../services/api';\nexport default {\n  name: 'AdminHousehold',\n  data() {\n    return {\n      rows: [],\n      q: '',\n      sortField: 'name',\n      sortDir: 'asc',\n      loading: false,\n      fetchTimer: null\n    };\n  },\n  computed: {\n    orderLabelAsc() {\n      return this.sortField === 'buyer' ? 'No deliveries → Repeated' : 'A–Z';\n    },\n    orderLabelDesc() {\n      return this.sortField === 'buyer' ? 'Repeated → No deliveries' : 'Z–A';\n    },\n    sortedRows() {\n      const list = [...this.rows];\n      const cmpStr = (a, b) => String(a ?? '').localeCompare(String(b ?? ''), undefined, {\n        sensitivity: 'base',\n        numeric: true\n      });\n      const buyerRank = r => {\n        switch (r.buyer_type) {\n          case 'none':\n            return 0;\n          case 'new':\n            return 1;\n          case 'repeated':\n            return 2;\n          default:\n            return 0;\n        }\n      };\n      const asc = this.sortDir === 'asc';\n      const tieName = (a, b) => cmpStr(a.full_name, b.full_name);\n      if (this.sortField === 'name') {\n        list.sort((a, b) => asc ? cmpStr(a.full_name, b.full_name) : cmpStr(b.full_name, a.full_name));\n      } else if (this.sortField === 'address') {\n        list.sort((a, b) => {\n          const c = asc ? cmpStr(a.display_address, b.display_address) : cmpStr(b.display_address, a.display_address);\n          return c || tieName(a, b);\n        });\n      } else {\n        list.sort((a, b) => {\n          const d = asc ? buyerRank(a) - buyerRank(b) : buyerRank(b) - buyerRank(a);\n          return d || tieName(a, b);\n        });\n      }\n      return list;\n    }\n  },\n  async created() {\n    await this.fetchHousehold();\n  },\n  beforeUnmount() {\n    clearTimeout(this.fetchTimer);\n  },\n  methods: {\n    badgeClass(row) {\n      switch (row.buyer_type) {\n        case 'repeated':\n          return 'repeated';\n        case 'new':\n          return 'new';\n        default:\n          return 'none';\n      }\n    },\n    debouncedFetch() {\n      clearTimeout(this.fetchTimer);\n      this.fetchTimer = setTimeout(() => this.fetchHousehold(), 300);\n    },\n    async fetchHousehold() {\n      this.loading = true;\n      try {\n        const {\n          data\n        } = await api.get('/admin/household', {\n          params: this.q.trim() ? {\n            q: this.q.trim()\n          } : {}\n        });\n        this.rows = Array.isArray(data) ? data : [];\n      } catch (err) {\n        console.error(err);\n        this.rows = [];\n        alert(err.response?.data?.message || 'Failed to load household data');\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","rows","q","sortField","sortDir","loading","fetchTimer","computed","orderLabelAsc","orderLabelDesc","sortedRows","list","cmpStr","a","b","String","localeCompare","undefined","sensitivity","numeric","buyerRank","r","buyer_type","asc","tieName","full_name","sort","c","display_address","d","created","fetchHousehold","beforeUnmount","clearTimeout","methods","badgeClass","row","debouncedFetch","setTimeout","get","params","trim","Array","isArray","err","console","error","alert","response","message"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\admin\\Household.vue"],"sourcesContent":["<template>\r\n  <div class=\"household-page\">\r\n    <div class=\"head\">\r\n      <h2>Household</h2>\r\n      <p class=\"sub\">Registered customers — names, addresses, and purchase history summary.</p>\r\n      <div class=\"toolbar\">\r\n        <input v-model=\"q\" class=\"search\" placeholder=\"Search name, email, phone, or address\" @input=\"debouncedFetch\" />\r\n        <div class=\"sort-row\">\r\n          <label class=\"sort-label\">\r\n            <span class=\"sort-heading\">Sort by</span>\r\n            <select v-model=\"sortField\" class=\"sort-select\">\r\n              <option value=\"name\">Name</option>\r\n              <option value=\"address\">Address</option>\r\n              <option value=\"buyer\">Buyer type</option>\r\n            </select>\r\n          </label>\r\n          <label class=\"sort-label\">\r\n            <span class=\"sort-heading\">Order</span>\r\n            <select v-model=\"sortDir\" class=\"sort-select\">\r\n              <option value=\"asc\">{{ orderLabelAsc }}</option>\r\n              <option value=\"desc\">{{ orderLabelDesc }}</option>\r\n            </select>\r\n          </label>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"table-wrap\">\r\n      <table class=\"table\">\r\n        <thead>\r\n          <tr>\r\n            <th>Name</th>\r\n            <th>Address</th>\r\n            <th>Buyer type</th>\r\n            <th>Delivered orders</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"row in sortedRows\" :key=\"row.id\">\r\n            <td class=\"name-cell\">\r\n              <div class=\"nm\">{{ row.full_name }}</div>\r\n              <div class=\"meta muted-sm\">{{ row.email }}<template v-if=\"row.phone\"> · {{ row.phone }}</template></div>\r\n            </td>\r\n            <td class=\"addr\">{{ row.display_address }}</td>\r\n            <td>\r\n              <span class=\"badge\" :class=\"badgeClass(row)\">{{ row.buyer_label }}</span>\r\n            </td>\r\n            <td>{{ row.delivered_order_count }}</td>\r\n          </tr>\r\n          <tr v-if=\"sortedRows.length === 0 && !loading\">\r\n            <td colspan=\"4\" class=\"empty\">No customers match your search.</td>\r\n          </tr>\r\n          <tr v-if=\"loading\">\r\n            <td colspan=\"4\" class=\"empty\">Loading…</td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <p class=\"footnote\">\r\n      <strong>New buyer</strong> = exactly one delivered order.&nbsp;\r\n      <strong>Repeated buyer</strong> = two or more delivered orders.&nbsp;\r\n      <strong>No deliveries yet</strong> = registered but no completed delivery.\r\n      For <strong>Buyer type</strong>, order runs from no deliveries → new → repeated (ascending) or the reverse (descending).\r\n    </p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\n\r\nexport default {\r\n  name: 'AdminHousehold',\r\n  data() {\r\n    return {\r\n      rows: [],\r\n      q: '',\r\n      sortField: 'name',\r\n      sortDir: 'asc',\r\n      loading: false,\r\n      fetchTimer: null\r\n    }\r\n  },\r\n  computed: {\r\n    orderLabelAsc() {\r\n      return this.sortField === 'buyer' ? 'No deliveries → Repeated' : 'A–Z'\r\n    },\r\n    orderLabelDesc() {\r\n      return this.sortField === 'buyer' ? 'Repeated → No deliveries' : 'Z–A'\r\n    },\r\n    sortedRows() {\r\n      const list = [...this.rows]\r\n      const cmpStr = (a, b) =>\r\n        String(a ?? '').localeCompare(String(b ?? ''), undefined, { sensitivity: 'base', numeric: true })\r\n      const buyerRank = (r) => {\r\n        switch (r.buyer_type) {\r\n          case 'none':\r\n            return 0\r\n          case 'new':\r\n            return 1\r\n          case 'repeated':\r\n            return 2\r\n          default:\r\n            return 0\r\n        }\r\n      }\r\n      const asc = this.sortDir === 'asc'\r\n\r\n      const tieName = (a, b) => cmpStr(a.full_name, b.full_name)\r\n\r\n      if (this.sortField === 'name') {\r\n        list.sort((a, b) => (asc ? cmpStr(a.full_name, b.full_name) : cmpStr(b.full_name, a.full_name)))\r\n      } else if (this.sortField === 'address') {\r\n        list.sort((a, b) => {\r\n          const c = asc ? cmpStr(a.display_address, b.display_address) : cmpStr(b.display_address, a.display_address)\r\n          return c || tieName(a, b)\r\n        })\r\n      } else {\r\n        list.sort((a, b) => {\r\n          const d = asc ? buyerRank(a) - buyerRank(b) : buyerRank(b) - buyerRank(a)\r\n          return d || tieName(a, b)\r\n        })\r\n      }\r\n      return list\r\n    }\r\n  },\r\n  async created() {\r\n    await this.fetchHousehold()\r\n  },\r\n  beforeUnmount() {\r\n    clearTimeout(this.fetchTimer)\r\n  },\r\n  methods: {\r\n    badgeClass(row) {\r\n      switch (row.buyer_type) {\r\n        case 'repeated':\r\n          return 'repeated'\r\n        case 'new':\r\n          return 'new'\r\n        default:\r\n          return 'none'\r\n      }\r\n    },\r\n    debouncedFetch() {\r\n      clearTimeout(this.fetchTimer)\r\n      this.fetchTimer = setTimeout(() => this.fetchHousehold(), 300)\r\n    },\r\n    async fetchHousehold() {\r\n      this.loading = true\r\n      try {\r\n        const { data } = await api.get('/admin/household', {\r\n          params: this.q.trim() ? { q: this.q.trim() } : {}\r\n        })\r\n        this.rows = Array.isArray(data) ? data : []\r\n      } catch (err) {\r\n        console.error(err)\r\n        this.rows = []\r\n        alert(err.response?.data?.message || 'Failed to load household data')\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.household-page {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.head {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: flex-end;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n\r\n.head h2 {\r\n  margin: 0;\r\n  flex: 1 1 100%;\r\n}\r\n\r\n.sub {\r\n  margin: 0;\r\n  flex: 1 1 100%;\r\n  color: #6f7d67;\r\n  font-size: 14px;\r\n}\r\n\r\n.toolbar {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: flex-end;\r\n  gap: 12px;\r\n  flex: 1 1 100%;\r\n}\r\n\r\n.search {\r\n  min-height: 36px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 10px;\r\n  padding: 0 10px;\r\n  background: #fff;\r\n  min-width: min(280px, 100%);\r\n  flex: 1 1 220px;\r\n}\r\n\r\n.sort-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  align-items: flex-end;\r\n}\r\n\r\n.sort-label {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  min-width: 160px;\r\n}\r\n\r\n.sort-heading {\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: #5f7256;\r\n}\r\n\r\n.sort-select {\r\n  min-height: 36px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 10px;\r\n  padding: 0 10px;\r\n  background: #fff;\r\n  font-size: 14px;\r\n  color: #1f2d16;\r\n  cursor: pointer;\r\n}\r\n\r\n.table-wrap {\r\n  max-height: 560px;\r\n  overflow: auto;\r\n  border-radius: 14px;\r\n  border: 1px solid #deead0;\r\n  background: #fff;\r\n  box-shadow: 0 10px 24px rgba(56, 92, 35, 0.1);\r\n}\r\n\r\n.table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.table thead th {\r\n  position: sticky;\r\n  top: 0;\r\n  background: #f4f8ee;\r\n  z-index: 2;\r\n}\r\n\r\n.table th,\r\n.table td {\r\n  padding: 10px 12px;\r\n  border-bottom: 1px solid #e6eddc;\r\n  text-align: left;\r\n  vertical-align: top;\r\n}\r\n\r\n.table tbody tr:hover {\r\n  background: rgba(124, 179, 66, 0.08);\r\n}\r\n\r\n.name-cell .nm {\r\n  font-weight: 600;\r\n  color: #1f2d16;\r\n}\r\n\r\n.muted-sm {\r\n  font-size: 12px;\r\n  color: #6f7d67;\r\n}\r\n\r\n.addr {\r\n  max-width: 420px;\r\n  line-height: 1.35;\r\n  font-size: 13px;\r\n}\r\n\r\n.badge {\r\n  display: inline-block;\r\n  padding: 4px 10px;\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n}\r\n\r\n.badge.new {\r\n  background: rgba(236, 201, 75, 0.35);\r\n  color: #5c4810;\r\n}\r\n\r\n.badge.repeated {\r\n  background: rgba(124, 179, 66, 0.35);\r\n  color: #2d4718;\r\n}\r\n\r\n.badge.none {\r\n  background: rgba(148, 163, 184, 0.25);\r\n  color: #475569;\r\n}\r\n\r\n.empty {\r\n  text-align: center;\r\n  color: #6f7d67;\r\n}\r\n\r\n.footnote {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  color: #5f7256;\r\n  line-height: 1.45;\r\n}\r\n\n/* mobile-dashboard-fix */\n.table-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}\n.table-wrap .table, table.table{width:100%}\n@media (max-width: 640px){\n  .toolbar,.filters,.head,.section-head,.graph-head,.forecast-tools,.reports-header,.form{flex-wrap:wrap}\n  .toolbar,.filters,.head,.section-head{display:flex;gap:8px}\n  .toolbar input,.search-input,input[type=\"search\"],.search{min-width:0!important;width:100%;max-width:100%}\n  .table-wrap .table, table.table{min-width:560px}\n  .btn,button.primary,button.save-btn{min-height:40px}\n  .barangay-row{flex-direction:column;align-items:stretch!important}\n  .map{height:260px!important}\n  .details-grid{grid-template-columns:1fr!important}\n  .card,.form{max-width:100%}\n}\n</style>\r\n"],"mappings":"AAqEA,OAAOA,GAAE,MAAO,oBAAmB;AAEnC,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,EAAE;MACRC,CAAC,EAAE,EAAE;MACLC,SAAS,EAAE,MAAM;MACjBC,OAAO,EAAE,KAAK;MACdC,OAAO,EAAE,KAAK;MACdC,UAAU,EAAE;IACd;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,aAAaA,CAAA,EAAG;MACd,OAAO,IAAI,CAACL,SAAQ,KAAM,OAAM,GAAI,0BAAyB,GAAI,KAAI;IACvE,CAAC;IACDM,cAAcA,CAAA,EAAG;MACf,OAAO,IAAI,CAACN,SAAQ,KAAM,OAAM,GAAI,0BAAyB,GAAI,KAAI;IACvE,CAAC;IACDO,UAAUA,CAAA,EAAG;MACX,MAAMC,IAAG,GAAI,CAAC,GAAG,IAAI,CAACV,IAAI;MAC1B,MAAMW,MAAK,GAAIA,CAACC,CAAC,EAAEC,CAAC,KAClBC,MAAM,CAACF,CAAA,IAAK,EAAE,CAAC,CAACG,aAAa,CAACD,MAAM,CAACD,CAAA,IAAK,EAAE,CAAC,EAAEG,SAAS,EAAE;QAAEC,WAAW,EAAE,MAAM;QAAEC,OAAO,EAAE;MAAK,CAAC;MAClG,MAAMC,SAAQ,GAAKC,CAAC,IAAK;QACvB,QAAQA,CAAC,CAACC,UAAU;UAClB,KAAK,MAAM;YACT,OAAO;UACT,KAAK,KAAK;YACR,OAAO;UACT,KAAK,UAAU;YACb,OAAO;UACT;YACE,OAAO;QACX;MACF;MACA,MAAMC,GAAE,GAAI,IAAI,CAACnB,OAAM,KAAM,KAAI;MAEjC,MAAMoB,OAAM,GAAIA,CAACX,CAAC,EAAEC,CAAC,KAAKF,MAAM,CAACC,CAAC,CAACY,SAAS,EAAEX,CAAC,CAACW,SAAS;MAEzD,IAAI,IAAI,CAACtB,SAAQ,KAAM,MAAM,EAAE;QAC7BQ,IAAI,CAACe,IAAI,CAAC,CAACb,CAAC,EAAEC,CAAC,KAAMS,GAAE,GAAIX,MAAM,CAACC,CAAC,CAACY,SAAS,EAAEX,CAAC,CAACW,SAAS,IAAIb,MAAM,CAACE,CAAC,CAACW,SAAS,EAAEZ,CAAC,CAACY,SAAS,CAAE;MACjG,OAAO,IAAI,IAAI,CAACtB,SAAQ,KAAM,SAAS,EAAE;QACvCQ,IAAI,CAACe,IAAI,CAAC,CAACb,CAAC,EAAEC,CAAC,KAAK;UACl