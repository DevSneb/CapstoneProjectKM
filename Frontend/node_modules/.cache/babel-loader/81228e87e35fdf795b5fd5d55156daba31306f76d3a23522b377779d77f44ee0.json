{"ast":null,"code":"import api from '../../services/api';\nconst DEFAULT_FORM = {\n  enabled: true,\n  earn_pesos_per_point: 20,\n  redeem_peso_per_point: 1,\n  max_redeem_percent: 100,\n  min_order_amount_to_earn: 0,\n  customer_note: 'Earn points on delivered orders and redeem them as checkout discounts.'\n};\nexport default {\n  name: 'StoreRewards',\n  data() {\n    return {\n      form: {\n        ...DEFAULT_FORM\n      },\n      defaults: {\n        ...DEFAULT_FORM\n      },\n      loading: false,\n      saving: false,\n      loadError: ''\n    };\n  },\n  async created() {\n    await this.load();\n  },\n  methods: {\n    async load() {\n      this.loading = true;\n      this.loadError = '';\n      try {\n        const {\n          data\n        } = await api.get('/store/rewards/settings');\n        if (data?.defaults) this.defaults = {\n          ...DEFAULT_FORM,\n          ...data.defaults\n        };\n        if (data?.settings) {\n          this.form = {\n            enabled: data.settings.enabled !== false,\n            earn_pesos_per_point: Number(data.settings.earn_pesos_per_point ?? 20),\n            redeem_peso_per_point: Number(data.settings.redeem_peso_per_point ?? 1),\n            max_redeem_percent: Number(data.settings.max_redeem_percent ?? 100),\n            min_order_amount_to_earn: Number(data.settings.min_order_amount_to_earn ?? 0),\n            customer_note: data.settings.customer_note || DEFAULT_FORM.customer_note\n          };\n        }\n      } catch (err) {\n        console.error(err);\n        this.loadError = err?.response?.data?.message || 'Failed to load reward settings';\n      } finally {\n        this.loading = false;\n      }\n    },\n    resetDefaults() {\n      this.form = {\n        ...this.defaults\n      };\n    },\n    async save() {\n      this.saving = true;\n      try {\n        const payload = {\n          enabled: !!this.form.enabled,\n          earn_pesos_per_point: Math.max(1, Math.floor(Number(this.form.earn_pesos_per_point) || 1)),\n          redeem_peso_per_point: Math.max(0.01, Number(this.form.redeem_peso_per_point) || 0.01),\n          max_redeem_percent: Math.min(100, Math.max(0, Number(this.form.max_redeem_percent) || 0)),\n          min_order_amount_to_earn: Math.max(0, Number(this.form.min_order_amount_to_earn) || 0),\n          customer_note: String(this.form.customer_note || '').slice(0, 255)\n        };\n        const {\n          data\n        } = await api.put('/store/rewards/settings', payload);\n        if (data?.settings) {\n          this.form.enabled = data.settings.enabled !== false;\n          this.form.earn_pesos_per_point = Number(data.settings.earn_pesos_per_point);\n          this.form.redeem_peso_per_point = Number(data.settings.redeem_peso_per_point);\n          this.form.max_redeem_percent = Number(data.settings.max_redeem_percent);\n          this.form.min_order_amount_to_earn = Number(data.settings.min_order_amount_to_earn);\n          this.form.customer_note = data.settings.customer_note || '';\n        }\n        alert('Reward conditions saved');\n      } catch (err) {\n        alert(err?.response?.data?.message || 'Failed to save reward settings');\n      } finally {\n        this.saving = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","DEFAULT_FORM","enabled","earn_pesos_per_point","redeem_peso_per_point","max_redeem_percent","min_order_amount_to_earn","customer_note","name","data","form","defaults","loading","saving","loadError","created","load","methods","get","settings","Number","err","console","error","response","message","resetDefaults","save","payload","Math","max","floor","min","String","slice","put","alert"],"sources":["/var/www/kadiwa/Frontend/src/views/store/Rewards.vue"],"sourcesContent":["<template>\r\n  <div class=\"rewards-page\">\r\n    <header class=\"head\">\r\n      <div>\r\n        <h2>Rewards</h2>\r\n        <p class=\"lede\">Set how customers earn and redeem points when buying from your store.</p>\r\n      </div>\r\n    </header>\r\n\r\n    <div v-if=\"loadError\" class=\"notice error\">{{ loadError }}</div>\r\n\r\n    <form class=\"form card\" @submit.prevent=\"save\">\r\n      <label class=\"toggle-row\">\r\n        <span>\r\n          <strong>Enable rewards for this store</strong>\r\n          <small>When off, customers cannot earn or redeem points on your orders.</small>\r\n        </span>\r\n        <input type=\"checkbox\" v-model=\"form.enabled\" />\r\n      </label>\r\n\r\n      <fieldset :disabled=\"!form.enabled\" class=\"rules\">\r\n        <label>\r\n          Pesos spent to earn 1 point\r\n          <input type=\"number\" min=\"1\" step=\"1\" v-model.number=\"form.earn_pesos_per_point\" required />\r\n          <small>Example: 20 means ₱20 spent = 1 point after delivery.</small>\r\n        </label>\r\n\r\n        <label>\r\n          Peso value of 1 point at checkout\r\n          <input type=\"number\" min=\"0.01\" step=\"0.01\" v-model.number=\"form.redeem_peso_per_point\" required />\r\n          <small>Example: 1 means 1 point = ₱1 discount.</small>\r\n        </label>\r\n\r\n        <label>\r\n          Max redeem percent of order\r\n          <input type=\"number\" min=\"0\" max=\"100\" step=\"1\" v-model.number=\"form.max_redeem_percent\" required />\r\n          <small>Example: 50 means points can cover up to half of the order total.</small>\r\n        </label>\r\n\r\n        <label>\r\n          Minimum order amount to earn points (₱)\r\n          <input type=\"number\" min=\"0\" step=\"0.01\" v-model.number=\"form.min_order_amount_to_earn\" required />\r\n          <small>Delivered orders below this amount earn 0 points.</small>\r\n        </label>\r\n\r\n        <label>\r\n          Customer-facing note\r\n          <textarea v-model.trim=\"form.customer_note\" maxlength=\"255\" rows=\"3\" placeholder=\"Shown near checkout rewards info\"></textarea>\r\n        </label>\r\n      </fieldset>\r\n\r\n      <div class=\"preview card-inner\">\r\n        <h3>Preview</h3>\r\n        <ul>\r\n          <li v-if=\"!form.enabled\">Rewards are <strong>disabled</strong> for this store.</li>\r\n          <template v-else>\r\n            <li>Earn <strong>1 pt</strong> per <strong>₱{{ Number(form.earn_pesos_per_point || 0) }}</strong> on delivered orders.</li>\r\n            <li>Redeem <strong>1 pt = ₱{{ Number(form.redeem_peso_per_point || 0).toFixed(2) }}</strong> off at checkout.</li>\r\n            <li>Points can cover up to <strong>{{ Number(form.max_redeem_percent || 0) }}%</strong> of the order.</li>\r\n            <li v-if=\"Number(form.min_order_amount_to_earn) > 0\">\r\n              Minimum delivered total to earn: <strong>₱{{ Number(form.min_order_amount_to_earn).toFixed(2) }}</strong>\r\n            </li>\r\n          </template>\r\n        </ul>\r\n      </div>\r\n\r\n      <div class=\"actions\">\r\n        <button type=\"button\" class=\"ghost\" @click=\"resetDefaults\" :disabled=\"saving\">Reset defaults</button>\r\n        <button type=\"submit\" class=\"primary\" :disabled=\"saving || loading\">\r\n          {{ saving ? 'Saving…' : 'Save conditions' }}\r\n        </button>\r\n      </div>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\n\r\nconst DEFAULT_FORM = {\r\n  enabled: true,\r\n  earn_pesos_per_point: 20,\r\n  redeem_peso_per_point: 1,\r\n  max_redeem_percent: 100,\r\n  min_order_amount_to_earn: 0,\r\n  customer_note: 'Earn points on delivered orders and redeem them as checkout discounts.'\r\n}\r\n\r\nexport default {\r\n  name: 'StoreRewards',\r\n  data() {\r\n    return {\r\n      form: { ...DEFAULT_FORM },\r\n      defaults: { ...DEFAULT_FORM },\r\n      loading: false,\r\n      saving: false,\r\n      loadError: ''\r\n    }\r\n  },\r\n  async created() {\r\n    await this.load()\r\n  },\r\n  methods: {\r\n    async load() {\r\n      this.loading = true\r\n      this.loadError = ''\r\n      try {\r\n        const { data } = await api.get('/store/rewards/settings')\r\n        if (data?.defaults) this.defaults = { ...DEFAULT_FORM, ...data.defaults }\r\n        if (data?.settings) {\r\n          this.form = {\r\n            enabled: data.settings.enabled !== false,\r\n            earn_pesos_per_point: Number(data.settings.earn_pesos_per_point ?? 20),\r\n            redeem_peso_per_point: Number(data.settings.redeem_peso_per_point ?? 1),\r\n            max_redeem_percent: Number(data.settings.max_redeem_percent ?? 100),\r\n            min_order_amount_to_earn: Number(data.settings.min_order_amount_to_earn ?? 0),\r\n            customer_note: data.settings.customer_note || DEFAULT_FORM.customer_note\r\n          }\r\n        }\r\n      } catch (err) {\r\n        console.error(err)\r\n        this.loadError = err?.response?.data?.message || 'Failed to load reward settings'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    resetDefaults() {\r\n      this.form = { ...this.defaults }\r\n    },\r\n    async save() {\r\n      this.saving = true\r\n      try {\r\n        const payload = {\r\n          enabled: !!this.form.enabled,\r\n          earn_pesos_per_point: Math.max(1, Math.floor(Number(this.form.earn_pesos_per_point) || 1)),\r\n          redeem_peso_per_point: Math.max(0.01, Number(this.form.redeem_peso_per_point) || 0.01),\r\n          max_redeem_percent: Math.min(100, Math.max(0, Number(this.form.max_redeem_percent) || 0)),\r\n          min_order_amount_to_earn: Math.max(0, Number(this.form.min_order_amount_to_earn) || 0),\r\n          customer_note: String(this.form.customer_note || '').slice(0, 255)\r\n        }\r\n        const { data } = await api.put('/store/rewards/settings', payload)\r\n        if (data?.settings) {\r\n          this.form.enabled = data.settings.enabled !== false\r\n          this.form.earn_pesos_per_point = Number(data.settings.earn_pesos_per_point)\r\n          this.form.redeem_peso_per_point = Number(data.settings.redeem_peso_per_point)\r\n          this.form.max_redeem_percent = Number(data.settings.max_redeem_percent)\r\n          this.form.min_order_amount_to_earn = Number(data.settings.min_order_amount_to_earn)\r\n          this.form.customer_note = data.settings.customer_note || ''\r\n        }\r\n        alert('Reward conditions saved')\r\n      } catch (err) {\r\n        alert(err?.response?.data?.message || 'Failed to save reward settings')\r\n      } finally {\r\n        this.saving = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.rewards-page {\r\n  display: grid;\r\n  gap: 14px;\r\n  max-width: 720px;\r\n}\r\n.head h2 { margin: 0 0 4px; }\r\n.lede {\r\n  margin: 0;\r\n  color: #5f6c55;\r\n  font-size: 0.95rem;\r\n}\r\n.notice {\r\n  padding: 10px 12px;\r\n  border-radius: 10px;\r\n  background: #fff4f2;\r\n  color: #9b2c2c;\r\n  border: 1px solid #f0c2ba;\r\n}\r\n.card {\r\n  background: #fff;\r\n  border: 1px solid #d9e8ca;\r\n  border-radius: 14px;\r\n  padding: 16px;\r\n  box-shadow: 0 10px 24px rgba(56, 92, 35, 0.08);\r\n}\r\n.form { display: grid; gap: 14px; }\r\n.toggle-row {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 10px 12px;\r\n  border-radius: 12px;\r\n  background: #f4f8ef;\r\n}\r\n.toggle-row small {\r\n  display: block;\r\n  margin-top: 4px;\r\n  color: #5f6c55;\r\n  font-weight: 400;\r\n}\r\n.toggle-row input {\r\n  width: 22px;\r\n  height: 22px;\r\n  flex-shrink: 0;\r\n}\r\n.rules {\r\n  border: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n.rules:disabled {\r\n  opacity: 0.55;\r\n}\r\nlabel {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  font-weight: 600;\r\n  color: #24301f;\r\n}\r\nlabel small {\r\n  font-weight: 400;\r\n  color: #5f6c55;\r\n}\r\ninput[type=\"number\"],\r\ntextarea {\r\n  padding: 10px 12px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 10px;\r\n  font: inherit;\r\n  min-height: 44px;\r\n}\r\n.preview {\r\n  background: #f7faf3;\r\n  border-radius: 12px;\r\n  padding: 12px 14px;\r\n}\r\n.preview h3 {\r\n  margin: 0 0 8px;\r\n  font-size: 0.95rem;\r\n}\r\n.preview ul {\r\n  margin: 0;\r\n  padding-left: 18px;\r\n  display: grid;\r\n  gap: 4px;\r\n  color: #355e2a;\r\n}\r\n.actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  justify-content: flex-end;\r\n}\r\n.primary,\r\n.ghost {\r\n  min-height: 44px;\r\n  border-radius: 10px;\r\n  padding: 10px 14px;\r\n  cursor: pointer;\r\n  font-weight: 600;\r\n}\r\n.primary {\r\n  border: none;\r\n  color: #fff;\r\n  background: linear-gradient(135deg, #7CB342, #4E7D32);\r\n}\r\n.ghost {\r\n  background: transparent;\r\n  border: 1px solid #cddbb9;\r\n  color: #355e2a;\r\n}\r\n@media (max-width: 640px) {\r\n  .rewards-page { max-width: 100%; }\r\n  .toggle-row {\r\n    align-items: flex-start;\r\n  }\r\n  .actions {\r\n    flex-direction: column-reverse;\r\n  }\r\n  .actions .primary,\r\n  .actions .ghost {\r\n    width: 100%;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AA6EA,OAAOA,GAAE,MAAO,oBAAmB;AAEnC,MAAMC,YAAW,GAAI;EACnBC,OAAO,EAAE,IAAI;EACbC,oBAAoB,EAAE,EAAE;EACxBC,qBAAqB,EAAE,CAAC;EACxBC,kBAAkB,EAAE,GAAG;EACvBC,wBAAwB,EAAE,CAAC;EAC3BC,aAAa,EAAE;AACjB;AAEA,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QAAE,GAAGT;MAAa,CAAC;MACzBU,QAAQ,EAAE;QAAE,GAAGV;MAAa,CAAC;MAC7BW,OAAO,EAAE,KAAK;MACdC,MAAM,EAAE,KAAK;MACbC,SAAS,EAAE;IACb;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,IAAI,CAAC;EAClB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,IAAIA,CAAA,EAAG;MACX,IAAI,CAACJ,OAAM,GAAI,IAAG;MAClB,IAAI,CAACE,SAAQ,GAAI,EAAC;MAClB,IAAI;QACF,MAAM;UAAEL;QAAK,IAAI,MAAMT,GAAG,CAACkB,GAAG,CAAC,yBAAyB;QACxD,IAAIT,IAAI,EAAEE,QAAQ,EAAE,IAAI,CAACA,QAAO,GAAI;UAAE,GAAGV,YAAY;UAAE,GAAGQ,IAAI,CAACE;QAAS;QACxE,IAAIF,IAAI,EAAEU,QAAQ,EAAE;UAClB,IAAI,CAACT,IAAG,GAAI;YACVR,OAAO,EAAEO,IAAI,CAACU,QAAQ,CAACjB,OAAM,KAAM,KAAK;YACxCC,oBAAoB,EAAEiB,MAAM,CAACX,IAAI,CAACU,QAAQ,CAAChB,oBAAmB,IAAK,EAAE,CAAC;YACtE