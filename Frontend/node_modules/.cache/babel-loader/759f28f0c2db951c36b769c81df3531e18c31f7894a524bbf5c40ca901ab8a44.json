{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nimport api from '../services/api';\nimport { readAuth } from '../services/authStorage';\nimport { BARANGAYS, splitAddress, joinAddress } from '../constants/barangays';\nexport default {\n  name: 'CustomerSettings',\n  data() {\n    return {\n      barangays: BARANGAYS,\n      form: {\n        full_name: '',\n        phone: '',\n        address: ''\n      },\n      barangay: '',\n      street: '',\n      errors: {\n        full_name: '',\n        phone: '',\n        barangay: ''\n      },\n      currentEmail: '',\n      emailForm: {\n        email: '',\n        current_password: ''\n      },\n      passwordForm: {\n        current_password: '',\n        new_password: '',\n        confirm_password: ''\n      },\n      saving: false,\n      savingEmail: false,\n      savingPassword: false\n    };\n  },\n  async created() {\n    const {\n      user\n    } = readAuth('customer');\n    if (user) {\n      this.applyUser(user);\n    }\n    await this.loadProfile();\n  },\n  methods: {\n    applyUser(user) {\n      this.form.full_name = user.full_name || '';\n      this.form.phone = user.phone || '';\n      this.form.address = user.address || '';\n      this.currentEmail = user.email || '';\n      this.emailForm.email = user.email || '';\n      const parts = splitAddress(user.address);\n      this.barangay = parts.barangay;\n      this.street = parts.details;\n    },\n    async loadProfile() {\n      try {\n        const {\n          data\n        } = await api.get('/customer/account/profile');\n        const user = data?.user;\n        if (!user) return;\n        this.applyUser(user);\n        this.$store.commit('SET_USER', user);\n        localStorage.setItem('user', JSON.stringify(user));\n      } catch (err) {\n        console.error('Failed to load profile', err);\n      }\n    },\n    validateProfile() {\n      this.errors = {\n        full_name: '',\n        phone: '',\n        barangay: ''\n      };\n      let ok = true;\n      if (!String(this.form.full_name || '').trim()) {\n        this.errors.full_name = 'Full name is required.';\n        ok = false;\n      }\n      const phone = String(this.form.phone || '').trim();\n      if (!phone) {\n        this.errors.phone = 'Phone is required.';\n        ok = false;\n      } else if (!/^09\\d{9}$/.test(phone.replace(/\\D/g, ''))) {\n        this.errors.phone = 'Phone must be 11 digits and start with 09.';\n        ok = false;\n      }\n      if (!this.barangay) {\n        this.errors.barangay = 'Please select your barangay.';\n        ok = false;\n      }\n      return ok;\n    },\n    async save() {\n      if (!this.validateProfile()) return;\n      this.saving = true;\n      try {\n        this.form.address = joinAddress(this.barangay, this.street);\n        const {\n          data\n        } = await api.put('/customer/account/profile', this.form);\n        const {\n          token\n        } = readAuth('customer');\n        this.$store.dispatch('login', {\n          user: data.user,\n          token\n        });\n        this.applyUser(data.user);\n        alert('Profile updated');\n      } catch (err) {\n        alert(err.response?.data?.message || 'Failed to save');\n      } finally {\n        this.saving = false;\n      }\n    },\n    async saveEmail() {\n      this.savingEmail = true;\n      try {\n        const {\n          data\n        } = await api.put('/customer/account/email', {\n          email: this.emailForm.email,\n          current_password: this.emailForm.current_password\n        });\n        const {\n          token\n        } = readAuth('customer');\n        this.$store.dispatch('login', {\n          user: data.user,\n          token\n        });\n        this.currentEmail = data.user.email || '';\n        this.emailForm.email = data.user.email || '';\n        this.emailForm.current_password = '';\n        alert('Email updated');\n      } catch (err) {\n        const msg = err.response?.data?.message || err.response?.data?.errors?.map(e => e.msg).join(', ') || 'Failed to update email';\n        alert(msg);\n      } finally {\n        this.savingEmail = false;\n      }\n    },\n    async savePassword() {\n      if (this.passwordForm.new_password !== this.passwordForm.confirm_password) {\n        alert('New password and confirmation do not match');\n        return;\n      }\n      this.savingPassword = true;\n      try {\n        await api.put('/customer/account/password', {\n          current_password: this.passwordForm.current_password,\n          new_password: this.passwordForm.new_password\n        });\n        this.passwordForm = {\n          current_password: '',\n          new_password: '',\n          confirm_password: ''\n        };\n        alert('Password updated');\n      } catch (err) {\n        const msg = err.response?.data?.message || err.response?.data?.errors?.map(e => e.msg).join(', ') || 'Failed to update password';\n        alert(msg);\n      } finally {\n        this.savingPassword = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","readAuth","BARANGAYS","splitAddress","joinAddress","name","data","barangays","form","full_name","phone","address","barangay","street","errors","currentEmail","emailForm","email","current_password","passwordForm","new_password","confirm_password","saving","savingEmail","savingPassword","created","user","applyUser","loadProfile","methods","parts","details","get","$store","commit","localStorage","setItem","JSON","stringify","err","console","error","validateProfile","ok","String","trim","test","replace","save","put","token","dispatch","alert","response","message","saveEmail","msg","map","e","join","savePassword"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\CustomerSettings.vue"],"sourcesContent":["<template>\r\n  <div class=\"page\">\r\n    <h2>Settings • Profile</h2>\r\n    <form class=\"form\" @submit.prevent=\"save\" novalidate>\r\n      <label>Full name\r\n        <input v-model.trim=\"form.full_name\" required />\r\n        <small v-if=\"errors.full_name\" class=\"field-error\">{{ errors.full_name }}</small>\r\n      </label>\r\n      <label>Phone\r\n        <input v-model.trim=\"form.phone\" placeholder=\"09XXXXXXXXX\" />\r\n        <small v-if=\"errors.phone\" class=\"field-error\">{{ errors.phone }}</small>\r\n      </label>\r\n      <label>Barangay\r\n        <select v-model=\"barangay\" required>\r\n          <option disabled value=\"\">Select barangay</option>\r\n          <option v-for=\"b in barangays\" :key=\"b\" :value=\"b\">{{ b }}</option>\r\n        </select>\r\n        <small v-if=\"errors.barangay\" class=\"field-error\">{{ errors.barangay }}</small>\r\n      </label>\r\n      <label>Street / landmark (optional)\r\n        <input v-model.trim=\"street\" placeholder=\"Street, house no., landmark\" />\r\n      </label>\r\n      <button :disabled=\"saving\">{{ saving ? 'Saving...' : 'Save' }}</button>\r\n    </form>\r\n\r\n    <h2 class=\"section-title\">Change Email</h2>\r\n    <form class=\"form\" @submit.prevent=\"saveEmail\">\r\n      <label>Current Email\r\n        <input :value=\"currentEmail\" type=\"email\" disabled />\r\n      </label>\r\n      <label>New Email\r\n        <input v-model=\"emailForm.email\" type=\"email\" required />\r\n      </label>\r\n      <label>Current Password\r\n        <input v-model=\"emailForm.current_password\" type=\"password\" required />\r\n      </label>\r\n      <button :disabled=\"savingEmail\">{{ savingEmail ? 'Updating...' : 'Update Email' }}</button>\r\n    </form>\r\n\r\n    <h2 class=\"section-title\">Change Password</h2>\r\n    <form class=\"form\" @submit.prevent=\"savePassword\">\r\n      <label>Current Password\r\n        <input v-model=\"passwordForm.current_password\" type=\"password\" required />\r\n      </label>\r\n      <label>New Password\r\n        <input v-model=\"passwordForm.new_password\" type=\"password\" minlength=\"6\" required />\r\n      </label>\r\n      <label>Confirm New Password\r\n        <input v-model=\"passwordForm.confirm_password\" type=\"password\" minlength=\"6\" required />\r\n      </label>\r\n      <button :disabled=\"savingPassword\">{{ savingPassword ? 'Updating...' : 'Update Password' }}</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../services/api'\r\nimport { readAuth } from '../services/authStorage'\r\nimport { BARANGAYS, splitAddress, joinAddress } from '../constants/barangays'\r\n\r\nexport default {\r\n  name: 'CustomerSettings',\r\n  data() {\r\n    return {\r\n      barangays: BARANGAYS,\r\n      form: { full_name: '', phone: '', address: '' },\r\n      barangay: '',\r\n      street: '',\r\n      errors: { full_name: '', phone: '', barangay: '' },\r\n      currentEmail: '',\r\n      emailForm: { email: '', current_password: '' },\r\n      passwordForm: { current_password: '', new_password: '', confirm_password: '' },\r\n      saving: false,\r\n      savingEmail: false,\r\n      savingPassword: false\r\n    }\r\n  },\r\n  async created() {\r\n    const { user } = readAuth('customer')\r\n    if (user) {\r\n      this.applyUser(user)\r\n    }\r\n    await this.loadProfile()\r\n  },\r\n  methods: {\r\n    applyUser(user) {\r\n      this.form.full_name = user.full_name || ''\r\n      this.form.phone = user.phone || ''\r\n      this.form.address = user.address || ''\r\n      this.currentEmail = user.email || ''\r\n      this.emailForm.email = user.email || ''\r\n      const parts = splitAddress(user.address)\r\n      this.barangay = parts.barangay\r\n      this.street = parts.details\r\n    },\r\n    async loadProfile() {\r\n      try {\r\n        const { data } = await api.get('/customer/account/profile')\r\n        const user = data?.user\r\n        if (!user) return\r\n        this.applyUser(user)\r\n        this.$store.commit('SET_USER', user)\r\n        localStorage.setItem('user', JSON.stringify(user))\r\n      } catch (err) {\r\n        console.error('Failed to load profile', err)\r\n      }\r\n    },\r\n    validateProfile() {\r\n      this.errors = { full_name: '', phone: '', barangay: '' }\r\n      let ok = true\r\n      if (!String(this.form.full_name || '').trim()) {\r\n        this.errors.full_name = 'Full name is required.'\r\n        ok = false\r\n      }\r\n      const phone = String(this.form.phone || '').trim()\r\n      if (!phone) {\r\n        this.errors.phone = 'Phone is required.'\r\n        ok = false\r\n      } else if (!/^09\\d{9}$/.test(phone.replace(/\\D/g, ''))) {\r\n        this.errors.phone = 'Phone must be 11 digits and start with 09.'\r\n        ok = false\r\n      }\r\n      if (!this.barangay) {\r\n        this.errors.barangay = 'Please select your barangay.'\r\n        ok = false\r\n      }\r\n      return ok\r\n    },\r\n    async save() {\r\n      if (!this.validateProfile()) return\r\n      this.saving = true\r\n      try {\r\n        this.form.address = joinAddress(this.barangay, this.street)\r\n        const { data } = await api.put('/customer/account/profile', this.form)\r\n        const { token } = readAuth('customer')\r\n        this.$store.dispatch('login', { user: data.user, token })\r\n        this.applyUser(data.user)\r\n        alert('Profile updated')\r\n      } catch (err) {\r\n        alert(err.response?.data?.message || 'Failed to save')\r\n      } finally {\r\n        this.saving = false\r\n      }\r\n    },\r\n    async saveEmail() {\r\n      this.savingEmail = true\r\n      try {\r\n        const { data } = await api.put('/customer/account/email', {\r\n          email: this.emailForm.email,\r\n          current_password: this.emailForm.current_password\r\n        })\r\n        const { token } = readAuth('customer')\r\n        this.$store.dispatch('login', { user: data.user, token })\r\n        this.currentEmail = data.user.email || ''\r\n        this.emailForm.email = data.user.email || ''\r\n        this.emailForm.current_password = ''\r\n        alert('Email updated')\r\n      } catch (err) {\r\n        const msg = err.response?.data?.message\r\n          || err.response?.data?.errors?.map(e => e.msg).join(', ')\r\n          || 'Failed to update email'\r\n        alert(msg)\r\n      } finally {\r\n        this.savingEmail = false\r\n      }\r\n    },\r\n    async savePassword() {\r\n      if (this.passwordForm.new_password !== this.passwordForm.confirm_password) {\r\n        alert('New password and confirmation do not match')\r\n        return\r\n      }\r\n      this.savingPassword = true\r\n      try {\r\n        await api.put('/customer/account/password', {\r\n          current_password: this.passwordForm.current_password,\r\n          new_password: this.passwordForm.new_password\r\n        })\r\n        this.passwordForm = { current_password: '', new_password: '', confirm_password: '' }\r\n        alert('Password updated')\r\n      } catch (err) {\r\n        const msg = err.response?.data?.message\r\n          || err.response?.data?.errors?.map(e => e.msg).join(', ')\r\n          || 'Failed to update password'\r\n        alert(msg)\r\n      } finally {\r\n        this.savingPassword = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n.page { max-width: 560px; }\r\n.section-title { margin-top: 28px; }\r\n.form {\r\n  display: grid;\r\n  gap: 12px;\r\n  background: #fff;\r\n  padding: 14px;\r\n  border-radius: 10px;\r\n  box-shadow: 0 4px 14px rgba(56,92,35,.08);\r\n  margin-bottom: 8px;\r\n}\r\nlabel { display: grid; gap: 6px; font-weight: 600; color: #355e2a; font-size: 13px; }\r\ninput, select, textarea {\r\n  padding: 10px 12px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 8px;\r\n  font-weight: 500;\r\n  min-height: 42px;\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  background: #fff;\r\n}\r\n.field-error { color: #b42318; font-weight: 500; font-size: 12px; }\r\nbutton {\r\n  background: linear-gradient(135deg,#7CB342,#4E7D32);\r\n  color: #fff;\r\n  border: none;\r\n  padding: 11px 14px;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  font-weight: 700;\r\n  min-height: 44px;\r\n}\r\nbutton:disabled { opacity: .7; cursor: default; }\r\n@media (max-width: 640px) {\r\n  .page { max-width: 100%; }\r\n  input, select { font-size: 16px; min-height: 44px; }\r\n}\r\n</style>\r\n"],"mappings":";;;AAuDA,OAAOA,GAAE,MAAO,iBAAgB;AAChC,SAASC,QAAO,QAAS,yBAAwB;AACjD,SAASC,SAAS,EAAEC,YAAY,EAAEC,WAAU,QAAS,wBAAuB;AAE5E,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAEL,SAAS;MACpBM,IAAI,EAAE;QAAEC,SAAS,EAAE,EAAE;QAAEC,KAAK,EAAE,EAAE;QAAEC,OAAO,EAAE;MAAG,CAAC;MAC/CC,QAAQ,EAAE,EAAE;MACZC,MAAM,EAAE,EAAE;MACVC,MAAM,EAAE;QAAEL,SAAS,EAAE,EAAE;QAAEC,KAAK,EAAE,EAAE;QAAEE,QAAQ,EAAE;MAAG,CAAC;MAClDG,YAAY,EAAE,EAAE;MAChBC,SAAS,EAAE;QAAEC,KAAK,EAAE,EAAE;QAAEC,gBAAgB,EAAE;MAAG,CAAC;MAC9CC,YAAY,EAAE;QAAED,gBAAgB,EAAE,EAAE;QAAEE,YAAY,EAAE,EAAE;QAAEC,gBAAgB,EAAE;MAAG,CAAC;MAC9EC,MAAM,EAAE,KAAK;MACbC,WAAW,EAAE,KAAK;MAClBC,cAAc,EAAE;IAClB;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM;MAAEC;IAAK,IAAIzB,QAAQ,CAAC,UAAU;IACpC,IAAIyB,IAAI,EAAE;MACR,IAAI,CAACC,SAAS,CAACD,IAAI;IACrB;IACA,MAAM,IAAI,CAACE,WAAW,CAAC;EACzB,CAAC;EACDC,OAAO,EAAE;IACPF,SAASA,CAACD,IAAI,EAAE;MACd,IAAI,CAAClB,IAAI,CAACC,SAAQ,GAAIiB,IAAI,CAACjB,SAAQ,IAAK,EAAC;MACzC,IAAI,CAACD,IAAI,CAACE,KAAI,GAAIgB,IAAI,CAAChB,KAAI,IAAK,EAAC;MACjC,IAAI,CAACF,IAAI,CAACG,OAAM,GAAIe,IAAI,CAACf,OAAM,IAAK,EAAC;MACrC,IAAI,CAACI,YAAW,GAAIW,IAAI,CAACT,KAAI,IAAK,EAAC;MACnC,IAAI,CAACD,SAAS,CAACC,KAAI,GAAIS,IAAI,CAACT,KAAI,IAAK,EAAC;MACtC,MAAMa,KAAI,GAAI3B,YAAY,CAACuB,IAAI,CAACf,OAAO;MACvC,IAAI,CAACC,QAAO,GAAIkB,KAAK,CAAClB,QAAO;MAC7B,IAAI,CAACC,MAAK,GAAIiB,KAAK,CAACC,OAAM;IAC5B,CAAC;IACD,MAAMH,WAAWA,CAAA,EAAG;MAClB,IAAI;QACF,MAAM;UAAEtB;QAAK,IAAI,MAAMN,GAAG,CAACgC,GAAG,CAAC,2BAA2B;QAC1D,MAAMN,IAAG,GAAIpB,IAAI,EAAEoB,IAAG;QACtB,IAAI,CAACA,IAAI,EAAE;QACX,IAAI