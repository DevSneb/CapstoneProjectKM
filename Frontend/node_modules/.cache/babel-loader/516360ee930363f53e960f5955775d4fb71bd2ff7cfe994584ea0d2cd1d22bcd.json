{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport api from '../services/api';\nexport default {\n  name: 'CustomerRegister',\n  data() {\n    return {\n      formData: {\n        username: '',\n        email: '',\n        password: '',\n        full_name: '',\n        phone: '',\n        address: ''\n      },\n      error: '',\n      success: '',\n      loading: false,\n      agreedToTerms: false,\n      showTerms: false\n    };\n  },\n  methods: {\n    async handleRegister() {\n      this.error = '';\n      this.success = '';\n      if (!this.agreedToTerms) {\n        this.error = 'Please agree to the Terms and Conditions and Data Privacy policy.';\n        return;\n      }\n      this.loading = true;\n      try {\n        const response = await api.post('/customer/auth/register', this.formData);\n        this.success = response.data.message;\n\n        // Clear form\n        this.formData = {\n          username: '',\n          email: '',\n          password: '',\n          full_name: '',\n          phone: '',\n          address: ''\n        };\n        this.agreedToTerms = false;\n\n        // Redirect to login after 2 seconds\n        setTimeout(() => {\n          this.$router.push('/customer/login');\n        }, 2000);\n      } catch (err) {\n        let message = err.response?.data?.message;\n        if (!message && Array.isArray(err.response?.data?.errors)) {\n          message = err.response.data.errors.map(error => error.msg).join('; ');\n        }\n        this.error = message || 'Registration failed. Please try again.';\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","formData","username","email","password","full_name","phone","address","error","success","loading","agreedToTerms","showTerms","methods","handleRegister","response","post","message","setTimeout","$router","push","err","Array","isArray","errors","map","msg","join"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\CustomerRegister.vue"],"sourcesContent":["<template>\r\n  <div class=\"register-container\">\r\n    <div class=\"register-box\">\r\n      <div class=\"register-header\">\r\n        <h1>Kadiwa E-Commerce</h1>\r\n        <h2>Customer Registration</h2>\r\n      </div>\r\n\r\n      <form @submit.prevent=\"handleRegister\" class=\"register-form\">\r\n        <div v-if=\"error\" class=\"error-message\">{{ error }}</div>\r\n        <div v-if=\"success\" class=\"success-message\">{{ success }}</div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"username\">Username *</label>\r\n          <input\r\n            type=\"text\"\r\n            id=\"username\"\r\n            v-model=\"formData.username\"\r\n            placeholder=\"Choose a username\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"email\">Email *</label>\r\n          <input\r\n            type=\"email\"\r\n            id=\"email\"\r\n            v-model=\"formData.email\"\r\n            placeholder=\"Enter your email\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"password\">Password *</label>\r\n          <input\r\n            type=\"password\"\r\n            id=\"password\"\r\n            v-model=\"formData.password\"\r\n            placeholder=\"Create a password (min 6 characters)\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"full_name\">Full Name *</label>\r\n          <input\r\n            type=\"text\"\r\n            id=\"full_name\"\r\n            v-model=\"formData.full_name\"\r\n            placeholder=\"Enter your full name\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"phone\">Phone</label>\r\n          <input\r\n            type=\"tel\"\r\n            id=\"phone\"\r\n            v-model=\"formData.phone\"\r\n            placeholder=\"Enter your phone number\"\r\n          />\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"address\">Address</label>\r\n          <textarea\r\n            id=\"address\"\r\n            v-model=\"formData.address\"\r\n            placeholder=\"Enter your address\"\r\n            rows=\"3\"\r\n          ></textarea>\r\n        </div>\r\n\r\n        <div class=\"consent-group\">\r\n          <label class=\"consent-label\" for=\"agree_terms\">\r\n            <input\r\n              id=\"agree_terms\"\r\n              type=\"checkbox\"\r\n              v-model=\"agreedToTerms\"\r\n            />\r\n            <span>\r\n              I agree to the\r\n              <button type=\"button\" class=\"link-btn\" @click=\"showTerms = true\">Terms and Conditions</button>\r\n              and\r\n              <button type=\"button\" class=\"link-btn\" @click=\"showTerms = true\">Data Privacy policy</button>.\r\n            </span>\r\n          </label>\r\n        </div>\r\n\r\n        <button type=\"submit\" class=\"register-btn\" :disabled=\"loading\">\r\n          {{ loading ? 'Registering...' : 'Register' }}\r\n        </button>\r\n      </form>\r\n\r\n      <div class=\"links\">\r\n        <p>Already have an account? <router-link to=\"/customer/login\">Login here</router-link></p>\r\n      </div>\r\n\r\n      <div v-if=\"showTerms\">\r\n        <div class=\"modal-backdrop\" @click=\"showTerms = false\"></div>\r\n        <div class=\"terms-modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Terms and Conditions\">\r\n          <h3>Terms and Conditions & Data Privacy</h3>\r\n          <div class=\"terms-body\">\r\n            <p>By creating an account, you agree to use Kadiwa E-Commerce responsibly and provide accurate information.</p>\r\n            <p>Your account credentials are your responsibility. Keep your password secure and do not share access with others.</p>\r\n            <p>We collect the registration details you provide (such as name, email, phone, and address) to create and manage your account and process your orders.</p>\r\n            <p>Your data is used only for platform operations, customer service, and transaction records. We do not sell your personal data.</p>\r\n            <p>You may request updates to your profile details through your account settings or by contacting support.</p>\r\n          </div>\r\n          <div class=\"modal-actions\">\r\n            <button type=\"button\" class=\"register-btn\" @click=\"showTerms = false\">Close</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../services/api'\r\n\r\nexport default {\r\n  name: 'CustomerRegister',\r\n  data() {\r\n    return {\r\n      formData: {\r\n        username: '',\r\n        email: '',\r\n        password: '',\r\n        full_name: '',\r\n        phone: '',\r\n        address: ''\r\n      },\r\n      error: '',\r\n      success: '',\r\n      loading: false,\r\n      agreedToTerms: false,\r\n      showTerms: false\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n      this.error = ''\r\n      this.success = ''\r\n\r\n      if (!this.agreedToTerms) {\r\n        this.error = 'Please agree to the Terms and Conditions and Data Privacy policy.'\r\n        return\r\n      }\r\n\r\n      this.loading = true\r\n\r\n      try {\r\n        const response = await api.post('/customer/auth/register', this.formData)\r\n        this.success = response.data.message\r\n        \r\n        // Clear form\r\n        this.formData = {\r\n          username: '',\r\n          email: '',\r\n          password: '',\r\n          full_name: '',\r\n          phone: '',\r\n          address: ''\r\n        }\r\n        this.agreedToTerms = false\r\n\r\n        // Redirect to login after 2 seconds\r\n        setTimeout(() => {\r\n          this.$router.push('/customer/login')\r\n        }, 2000)\r\n      } catch (err) {\r\n        let message = err.response?.data?.message\r\n        if (!message && Array.isArray(err.response?.data?.errors)) {\r\n          message = err.response.data.errors.map(error => error.msg).join('; ')\r\n        }\r\n        this.error = message || 'Registration failed. Please try again.'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.register-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);\r\n  padding: 20px;\r\n}\r\n\r\n.register-box {\r\n  background: white;\r\n  padding: 40px;\r\n  border-radius: 10px;\r\n  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);\r\n  width: 100%;\r\n  max-width: 500px;\r\n}\r\n\r\n.register-header {\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.register-header h1 {\r\n  color: #f5576c;\r\n  margin-bottom: 10px;\r\n  font-size: 28px;\r\n}\r\n\r\n.register-header h2 {\r\n  color: #666;\r\n  font-size: 20px;\r\n  font-weight: normal;\r\n}\r\n\r\n.error-message {\r\n  background: #fee;\r\n  color: #c33;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n  margin-bottom: 15px;\r\n  text-align: center;\r\n}\r\n\r\n.success-message {\r\n  background: #efe;\r\n  color: #3c3;\r\n  padding: 10px;\r\n  border-radius: 5px;\r\n  margin-bottom: 15px;\r\n  text-align: center;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n  color: #333;\r\n  font-weight: 500;\r\n}\r\n\r\n.form-group input,\r\n.form-group textarea {\r\n  width: 100%;\r\n  padding: 12px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 5px;\r\n  font-size: 14px;\r\n  transition: border-color 0.3s;\r\n}\r\n\r\n.form-group input:focus,\r\n.form-group textarea:focus {\r\n  outline: none;\r\n  border-color: #f5576c;\r\n}\r\n\r\n.form-group textarea {\r\n  resize: vertical;\r\n}\r\n\r\n.consent-group {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.consent-label {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 8px;\r\n  color: #333;\r\n  font-size: 14px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.consent-label input[type=\"checkbox\"] {\r\n  width: auto;\r\n  margin-top: 2px;\r\n}\r\n\r\n.link-btn {\r\n  background: none;\r\n  border: none;\r\n  color: #f5576c;\r\n  text-decoration: underline;\r\n  padding: 0;\r\n  margin: 0;\r\n  cursor: pointer;\r\n  font: inherit;\r\n}\r\n\r\n.modal-backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(0, 0, 0, 0.45);\r\n  z-index: 1000;\r\n}\r\n\r\n.terms-modal {\r\n  position: fixed;\r\n  z-index: 1001;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  width: min(560px, calc(100vw - 24px));\r\n  max-height: 80vh;\r\n  overflow: auto;\r\n  background: #fff;\r\n  border-radius: 10px;\r\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);\r\n  padding: 18px;\r\n}\r\n\r\n.terms-modal h3 {\r\n  margin: 0 0 12px;\r\n  color: #333;\r\n}\r\n\r\n.terms-body {\r\n  color: #444;\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.modal-actions {\r\n  margin-top: 14px;\r\n}\r\n\r\n.register-btn {\r\n  width: 100%;\r\n  padding: 12px;\r\n  background: #f5576c;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  font-size: 16px;\r\n  cursor: pointer;\r\n  transition: background 0.3s;\r\n}\r\n\r\n.register-btn:hover:not(:disabled) {\r\n  background: #e04357;\r\n}\r\n\r\n.register-btn:disabled {\r\n  opacity: 0.6;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.links {\r\n  margin-top: 20px;\r\n  text-align: center;\r\n  color: #666;\r\n}\r\n\r\n.links p {\r\n  margin: 10px 0;\r\n}\r\n\r\n.links a {\r\n  color: #f5576c;\r\n  text-decoration: none;\r\n  font-weight: 500;\r\n}\r\n\r\n.links a:hover {\r\n  text-decoration: underline;\r\n}\r\n</style>\r\n"],"mappings":";;;AA0HA,OAAOA,GAAE,MAAO,iBAAgB;AAEhC,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE;QACRC,QAAQ,EAAE,EAAE;QACZC,KAAK,EAAE,EAAE;QACTC,QAAQ,EAAE,EAAE;QACZC,SAAS,EAAE,EAAE;QACbC,KAAK,EAAE,EAAE;QACTC,OAAO,EAAE;MACX,CAAC;MACDC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE,EAAE;MACXC,OAAO,EAAE,KAAK;MACdC,aAAa,EAAE,KAAK;MACpBC,SAAS,EAAE;IACb;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACrB,IAAI,CAACN,KAAI,GAAI,EAAC;MACd,IAAI,CAACC,OAAM,GAAI,EAAC;MAEhB,IAAI,CAAC,IAAI,CAACE,aAAa,EAAE;QACvB,IAAI,CAACH,KAAI,GAAI,mEAAkE;QAC/E;MACF;MAEA,IAAI,CAACE,OAAM,GAAI,IAAG;MAElB,IAAI;QACF,MAAMK,QAAO,GAAI,MAAMjB,GAAG,CAACkB,IAAI,CAAC,yBAAyB,EAAE,IAAI,CAACf,QAAQ;QACxE,IAAI,CAACQ,OAAM,GAAIM,QAAQ,CAACf,IAAI,CAACiB,OAAM;;QAEnC;QACA,IAAI,CAAChB,QAAO,GAAI;UACdC,QAAQ,EAAE,EAAE;UACZC,KAAK,EAAE,EAAE;UACTC,QAAQ,EAAE,EAAE;UACZC,SAAS,EAAE,EAAE;UACbC,KAAK,EAAE,EAAE;UACTC,OAAO,EAAE;QACX;QACA,IAAI,CAACI,aAAY,GAAI,KAAI;;QAEzB;QACAO,UAAU,CAAC,MAAM;UACf,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,iBAAiB;QACrC,CAAC,EAAE,IAAI;MACT,EAAE,OAAOC,GAAG,EAAE;QACZ,IAAIJ,OAAM,GAAII,GAAG,CAACN,QAAQ,EAAEf,IAAI,EAAEiB,OAAM;QACxC,IAAI,CAACA,OAAM,IAAKK,KAAK,CAACC,OAAO,CAACF,GAAG,CAACN,QAAQ,EAAEf,IAAI,EAAEwB,MAAM,CAAC,EAAE;UACzDP,OAAM,GAAII,GAAG,CAACN,QAAQ,CAACf,IAAI,CAACwB,MAAM,CAACC,GAAG,CAACjB,KAAI,IAAKA,KAAK,CAACkB,GAAG,CAAC,CAACC,IAAI,CAAC,IAAI;QACtE;QACA,IAAI,CAACnB,KAAI,GAAIS,OAAM,IAAK,wCAAuC;MACjE,UAAU;QACR,IAAI,CAACP,OAAM,GAAI,KAAI;MACrB;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}