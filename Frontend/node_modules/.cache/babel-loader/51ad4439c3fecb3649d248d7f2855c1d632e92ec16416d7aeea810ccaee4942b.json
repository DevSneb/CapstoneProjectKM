{"ast":null,"code":"import api from '../../services/api';\nexport default {\n  name: 'AdminHousehold',\n  data() {\n    return {\n      rows: [],\n      q: '',\n      sortBy: 'name_asc',\n      loading: false,\n      fetchTimer: null\n    };\n  },\n  computed: {\n    sortedRows() {\n      const list = [...this.rows];\n      const cmpStr = (a, b) => String(a ?? '').localeCompare(String(b ?? ''), undefined, {\n        sensitivity: 'base',\n        numeric: true\n      });\n      const buyerRank = r => {\n        switch (r.buyer_type) {\n          case 'none':\n            return 0;\n          case 'new':\n            return 1;\n          case 'repeated':\n            return 2;\n          default:\n            return 0;\n        }\n      };\n      switch (this.sortBy) {\n        case 'name_desc':\n          list.sort((a, b) => cmpStr(b.full_name, a.full_name));\n          break;\n        case 'address_asc':\n          list.sort((a, b) => cmpStr(a.display_address, b.display_address) || cmpStr(a.full_name, b.full_name));\n          break;\n        case 'address_desc':\n          list.sort((a, b) => cmpStr(b.display_address, a.display_address) || cmpStr(a.full_name, b.full_name));\n          break;\n        case 'buyer_asc':\n          list.sort((a, b) => buyerRank(a) - buyerRank(b) || cmpStr(a.full_name, b.full_name));\n          break;\n        case 'buyer_desc':\n          list.sort((a, b) => buyerRank(b) - buyerRank(a) || cmpStr(a.full_name, b.full_name));\n          break;\n        case 'name_asc':\n        default:\n          list.sort((a, b) => cmpStr(a.full_name, b.full_name));\n      }\n      return list;\n    }\n  },\n  async created() {\n    await this.fetchHousehold();\n  },\n  beforeUnmount() {\n    clearTimeout(this.fetchTimer);\n  },\n  methods: {\n    badgeClass(row) {\n      switch (row.buyer_type) {\n        case 'repeated':\n          return 'repeated';\n        case 'new':\n          return 'new';\n        default:\n          return 'none';\n      }\n    },\n    debouncedFetch() {\n      clearTimeout(this.fetchTimer);\n      this.fetchTimer = setTimeout(() => this.fetchHousehold(), 300);\n    },\n    async fetchHousehold() {\n      this.loading = true;\n      try {\n        const {\n          data\n        } = await api.get('/admin/household', {\n          params: this.q.trim() ? {\n            q: this.q.trim()\n          } : {}\n        });\n        this.rows = Array.isArray(data) ? data : [];\n      } catch (err) {\n        console.error(err);\n        this.rows = [];\n        alert(err.response?.data?.message || 'Failed to load household data');\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","rows","q","sortBy","loading","fetchTimer","computed","sortedRows","list","cmpStr","a","b","String","localeCompare","undefined","sensitivity","numeric","buyerRank","r","buyer_type","sort","full_name","display_address","created","fetchHousehold","beforeUnmount","clearTimeout","methods","badgeClass","row","debouncedFetch","setTimeout","get","params","trim","Array","isArray","err","console","error","alert","response","message"],"sources":["C:\\Users\\Nicole\\Downloads\\CapstoneProject (19)\\CapstoneProject\\Frontend\\src\\views\\admin\\Household.vue"],"sourcesContent":["<template>\r\n  <div class=\"household-page\">\r\n    <div class=\"head\">\r\n      <h2>Household</h2>\r\n      <p class=\"sub\">Registered customers — names, addresses, and purchase history summary.</p>\r\n      <div class=\"toolbar\">\r\n        <input v-model=\"q\" class=\"search\" placeholder=\"Search name, email, phone, or address\" @input=\"debouncedFetch\" />\r\n        <label class=\"sort-label\">\r\n          <span class=\"sort-heading\">Sort</span>\r\n          <select v-model=\"sortBy\" class=\"sort-select\">\r\n            <option value=\"name_asc\">Name (A–Z)</option>\r\n            <option value=\"name_desc\">Name (Z–A)</option>\r\n            <option value=\"address_asc\">Address (A–Z)</option>\r\n            <option value=\"address_desc\">Address (Z–A)</option>\r\n            <option value=\"buyer_asc\">Buyer type (No deliveries → New → Repeated)</option>\r\n            <option value=\"buyer_desc\">Buyer type (Repeated → New → No deliveries)</option>\r\n          </select>\r\n        </label>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"table-wrap\">\r\n      <table class=\"table\">\r\n        <thead>\r\n          <tr>\r\n            <th>Name</th>\r\n            <th>Address</th>\r\n            <th>Buyer type</th>\r\n            <th>Delivered orders</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"row in sortedRows\" :key=\"row.id\">\r\n            <td class=\"name-cell\">\r\n              <div class=\"nm\">{{ row.full_name }}</div>\r\n              <div class=\"meta muted-sm\">{{ row.email }}<template v-if=\"row.phone\"> · {{ row.phone }}</template></div>\r\n            </td>\r\n            <td class=\"addr\">{{ row.display_address }}</td>\r\n            <td>\r\n              <span class=\"badge\" :class=\"badgeClass(row)\">{{ row.buyer_label }}</span>\r\n            </td>\r\n            <td>{{ row.delivered_order_count }}</td>\r\n          </tr>\r\n          <tr v-if=\"sortedRows.length === 0 && !loading\">\r\n            <td colspan=\"4\" class=\"empty\">No customers match your search.</td>\r\n          </tr>\r\n          <tr v-if=\"loading\">\r\n            <td colspan=\"4\" class=\"empty\">Loading…</td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <p class=\"footnote\">\r\n      <strong>New buyer</strong> = exactly one delivered order.&nbsp;\r\n      <strong>Repeated buyer</strong> = two or more delivered orders.&nbsp;\r\n      <strong>No deliveries yet</strong> = registered but no completed delivery.\r\n    </p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\n\r\nexport default {\r\n  name: 'AdminHousehold',\r\n  data() {\r\n    return {\r\n      rows: [],\r\n      q: '',\r\n      sortBy: 'name_asc',\r\n      loading: false,\r\n      fetchTimer: null\r\n    }\r\n  },\r\n  computed: {\r\n    sortedRows() {\r\n      const list = [...this.rows]\r\n      const cmpStr = (a, b) =>\r\n        String(a ?? '').localeCompare(String(b ?? ''), undefined, { sensitivity: 'base', numeric: true })\r\n      const buyerRank = (r) => {\r\n        switch (r.buyer_type) {\r\n          case 'none':\r\n            return 0\r\n          case 'new':\r\n            return 1\r\n          case 'repeated':\r\n            return 2\r\n          default:\r\n            return 0\r\n        }\r\n      }\r\n      switch (this.sortBy) {\r\n        case 'name_desc':\r\n          list.sort((a, b) => cmpStr(b.full_name, a.full_name))\r\n          break\r\n        case 'address_asc':\r\n          list.sort((a, b) => cmpStr(a.display_address, b.display_address) || cmpStr(a.full_name, b.full_name))\r\n          break\r\n        case 'address_desc':\r\n          list.sort((a, b) => cmpStr(b.display_address, a.display_address) || cmpStr(a.full_name, b.full_name))\r\n          break\r\n        case 'buyer_asc':\r\n          list.sort(\r\n            (a, b) => buyerRank(a) - buyerRank(b) || cmpStr(a.full_name, b.full_name)\r\n          )\r\n          break\r\n        case 'buyer_desc':\r\n          list.sort(\r\n            (a, b) => buyerRank(b) - buyerRank(a) || cmpStr(a.full_name, b.full_name)\r\n          )\r\n          break\r\n        case 'name_asc':\r\n        default:\r\n          list.sort((a, b) => cmpStr(a.full_name, b.full_name))\r\n      }\r\n      return list\r\n    }\r\n  },\r\n  async created() {\r\n    await this.fetchHousehold()\r\n  },\r\n  beforeUnmount() {\r\n    clearTimeout(this.fetchTimer)\r\n  },\r\n  methods: {\r\n    badgeClass(row) {\r\n      switch (row.buyer_type) {\r\n        case 'repeated':\r\n          return 'repeated'\r\n        case 'new':\r\n          return 'new'\r\n        default:\r\n          return 'none'\r\n      }\r\n    },\r\n    debouncedFetch() {\r\n      clearTimeout(this.fetchTimer)\r\n      this.fetchTimer = setTimeout(() => this.fetchHousehold(), 300)\r\n    },\r\n    async fetchHousehold() {\r\n      this.loading = true\r\n      try {\r\n        const { data } = await api.get('/admin/household', {\r\n          params: this.q.trim() ? { q: this.q.trim() } : {}\r\n        })\r\n        this.rows = Array.isArray(data) ? data : []\r\n      } catch (err) {\r\n        console.error(err)\r\n        this.rows = []\r\n        alert(err.response?.data?.message || 'Failed to load household data')\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.household-page {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.head {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: flex-end;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n\r\n.head h2 {\r\n  margin: 0;\r\n  flex: 1 1 100%;\r\n}\r\n\r\n.sub {\r\n  margin: 0;\r\n  flex: 1 1 100%;\r\n  color: #6f7d67;\r\n  font-size: 14px;\r\n}\r\n\r\n.search {\r\n  min-height: 36px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 10px;\r\n  padding: 0 10px;\r\n  background: #fff;\r\n  min-width: min(380px, 100%);\r\n}\r\n\r\n.table-wrap {\r\n  max-height: 560px;\r\n  overflow: auto;\r\n  border-radius: 14px;\r\n  border: 1px solid #deead0;\r\n  background: #fff;\r\n  box-shadow: 0 10px 24px rgba(56, 92, 35, 0.1);\r\n}\r\n\r\n.table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.table thead th {\r\n  position: sticky;\r\n  top: 0;\r\n  background: #f4f8ee;\r\n  z-index: 2;\r\n}\r\n\r\n.table th,\r\n.table td {\r\n  padding: 10px 12px;\r\n  border-bottom: 1px solid #e6eddc;\r\n  text-align: left;\r\n  vertical-align: top;\r\n}\r\n\r\n.table tbody tr:hover {\r\n  background: rgba(124, 179, 66, 0.08);\r\n}\r\n\r\n.name-cell .nm {\r\n  font-weight: 600;\r\n  color: #1f2d16;\r\n}\r\n\r\n.muted-sm {\r\n  font-size: 12px;\r\n  color: #6f7d67;\r\n}\r\n\r\n.addr {\r\n  max-width: 420px;\r\n  line-height: 1.35;\r\n  font-size: 13px;\r\n}\r\n\r\n.badge {\r\n  display: inline-block;\r\n  padding: 4px 10px;\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n}\r\n\r\n.badge.new {\r\n  background: rgba(236, 201, 75, 0.35);\r\n  color: #5c4810;\r\n}\r\n\r\n.badge.repeated {\r\n  background: rgba(124, 179, 66, 0.35);\r\n  color: #2d4718;\r\n}\r\n\r\n.badge.none {\r\n  background: rgba(148, 163, 184, 0.25);\r\n  color: #475569;\r\n}\r\n\r\n.empty {\r\n  text-align: center;\r\n  color: #6f7d67;\r\n}\r\n\r\n.footnote {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  color: #5f7256;\r\n  line-height: 1.45;\r\n}\r\n</style>\r\n"],"mappings":"AA8DA,OAAOA,GAAE,MAAO,oBAAmB;AAEnC,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,EAAE;MACRC,CAAC,EAAE,EAAE;MACLC,MAAM,EAAE,UAAU;MAClBC,OAAO,EAAE,KAAK;MACdC,UAAU,EAAE;IACd;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAUA,CAAA,EAAG;MACX,MAAMC,IAAG,GAAI,CAAC,GAAG,IAAI,CAACP,IAAI;MAC1B,MAAMQ,MAAK,GAAIA,CAACC,CAAC,EAAEC,CAAC,KAClBC,MAAM,CAACF,CAAA,IAAK,EAAE,CAAC,CAACG,aAAa,CAACD,MAAM,CAACD,CAAA,IAAK,EAAE,CAAC,EAAEG,SAAS,EAAE;QAAEC,WAAW,EAAE,MAAM;QAAEC,OAAO,EAAE;MAAK,CAAC;MAClG,MAAMC,SAAQ,GAAKC,CAAC,IAAK;QACvB,QAAQA,CAAC,CAACC,UAAU;UAClB,KAAK,MAAM;YACT,OAAO;UACT,KAAK,KAAK;YACR,OAAO;UACT,KAAK,UAAU;YACb,OAAO;UACT;YACE,OAAO;QACX;MACF;MACA,QAAQ,IAAI,CAAChB,MAAM;QACjB,KAAK,WAAW;UACdK,IAAI,CAACY,IAAI,CAAC,CAACV,CAAC,EAAEC,CAAC,KAAKF,MAAM,CAACE,CAAC,CAACU,SAAS,EAAEX,CAAC,CAACW,SAAS,CAAC;UACpD;QACF,KAAK,aAAa;UAChBb,IAAI,CAACY,IAAI,CAAC,CAACV,CAAC,EAAEC,CAAC,KAAKF,MAAM,CAACC,CAAC,CAACY,eAAe,EAAEX,CAAC,CAACW,eAAe,KAAKb,MAAM,CAACC,CAAC,CAACW,SAAS,EAAEV,CAAC,CAACU,SAAS,CAAC;UACpG;QACF,KAAK,cAAc;UACjBb,IAAI,CAACY,IAAI,CAAC,CAACV,CAAC,EAAEC,CAAC,KAAKF,MAAM,CAACE,CAAC,CAACW,eAAe,EAAEZ,CAAC,CAACY,eAAe,KAAKb,MAAM,CAACC,CAAC,CAACW,SAAS,EAAEV,CAAC,CAACU,SAAS,CAAC;UACpG;QACF,KAAK,WAAW;UACdb,IAAI,CAACY,IAAI,CACP,C