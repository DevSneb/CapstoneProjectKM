{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.every.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport api from '../services/api';\nexport default {\n  name: 'CustomerCart',\n  data() {\n    return {\n      loading: false\n    };\n  },\n  computed: {\n    cart() {\n      return this.$store.state.cart;\n    },\n    total() {\n      return this.cart.reduce((s, i) => s + i.unit_price * i.quantity, 0);\n    },\n    derivedStoreId() {\n      if (!this.cart.length) return 0;\n      const id = this.cart[0].store_owner_id;\n      if (this.cart.every(i => i.store_owner_id === id)) return id;\n      return 0;\n    }\n  },\n  methods: {\n    fmt(v) {\n      const n = Number(v);\n      return isFinite(n) ? n.toFixed(2) : '0.00';\n    },\n    update(it) {\n      this.$store.dispatch('updateCartItem', {\n        product_id: it.product_id,\n        quantity: it.quantity\n      });\n    },\n    remove(it) {\n      this.$store.dispatch('updateCartItem', {\n        product_id: it.product_id,\n        quantity: 0\n      });\n    },\n    async checkout() {\n      if (!this.derivedStoreId) {\n        alert('Cart must contain items from one store');\n        return;\n      }\n      this.loading = true;\n      try {\n        const items = this.cart.map(i => ({\n          product_id: i.product_id,\n          quantity: i.quantity\n        }));\n        const {\n          data\n        } = await api.post('/customer/orders', {\n          items\n        });\n        alert('Order created: #' + data.id);\n        this.$store.dispatch('clearCart');\n      } catch (err) {\n        alert(err.response?.data?.message || 'Checkout failed');\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","loading","computed","cart","$store","state","total","reduce","s","i","unit_price","quantity","derivedStoreId","length","id","store_owner_id","every","methods","fmt","v","n","Number","isFinite","toFixed","update","it","dispatch","product_id","remove","checkout","alert","items","map","post","err","response","message"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\CustomerCart.vue"],"sourcesContent":["<template>\r\n  <div class=\"page\">\r\n    <h2>Cart</h2>\r\n    <table class=\"table\">\r\n      <thead><tr><th>Item</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th><th></th></tr></thead>\r\n      <tbody>\r\n        <tr v-for=\"it in cart\" :key=\"it.product_id\">\r\n          <td>{{ it.name }}</td>\r\n          <td><input type=\"number\" min=\"0\" v-model.number=\"it.quantity\" @change=\"update(it)\"/></td>\r\n          <td>₱{{ fmt(it.unit_price) }}</td>\r\n          <td>₱{{ fmt(it.unit_price * it.quantity) }}</td>\r\n          <td><button @click=\"remove(it)\">Remove</button></td>\r\n        </tr>\r\n        <tr v-if=\"cart.length===0\"><td colspan=\"5\" class=\"empty\">No items</td></tr>\r\n      </tbody>\r\n    </table>\r\n    <div class=\"summary\" v-if=\"cart.length\">\r\n      <div>Total: ₱{{ fmt(total) }}</div>\r\n      <div>Store: {{ derivedStoreId || '—' }}</div>\r\n      <button @click=\"checkout\" :disabled=\"loading || !derivedStoreId\">{{ loading?'Processing...':'Checkout' }}</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../services/api'\r\nexport default{\r\n  name:'CustomerCart',\r\n  data(){return{ loading:false}},\r\n  computed:{\r\n    cart(){ return this.$store.state.cart },\r\n    total(){ return this.cart.reduce((s,i)=>s+i.unit_price*i.quantity,0) },\r\n    derivedStoreId(){\r\n      if(!this.cart.length) return 0\r\n      const id = this.cart[0].store_owner_id\r\n      if(this.cart.every(i=>i.store_owner_id===id)) return id\r\n      return 0\r\n    }\r\n  },\r\n  methods:{\r\n    fmt(v){ const n=Number(v); return isFinite(n)?n.toFixed(2):'0.00' },\r\n    update(it){ this.$store.dispatch('updateCartItem', { product_id: it.product_id, quantity: it.quantity }) },\r\n    remove(it){ this.$store.dispatch('updateCartItem', { product_id: it.product_id, quantity: 0 }) },\r\n    async checkout(){\r\n      if(!this.derivedStoreId){ alert('Cart must contain items from one store'); return }\r\n      this.loading = true\r\n      try{\r\n        const items = this.cart.map(i=>({ product_id: i.product_id, quantity: i.quantity }))\r\n        const { data } = await api.post('/customer/orders', { items })\r\n        alert('Order created: #' + data.id)\r\n        this.$store.dispatch('clearCart')\r\n      }catch(err){ alert(err.response?.data?.message || 'Checkout failed') }\r\n      finally{ this.loading=false }\r\n    }\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n.page{padding:20px}\r\n.table{width:100%;background:#fff;border-collapse:collapse;border-radius:8px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.06)}\r\n.table th,.table td{padding:10px 12px;border-bottom:1px solid #eee}\r\n.table th{background:#fafafa;text-align:left}\r\n.empty{text-align:center;color:#999}\r\n.summary{margin-top:12px;display:flex;gap:12px;align-items:center}\r\nbutton{padding:8px 10px;border:1px solid #ddd;background:#fff;border-radius:6px;cursor:pointer}\r\n</style>\r\n"],"mappings":";;;;AAwBA,OAAOA,GAAE,MAAO,iBAAgB;AAChC,eAAc;EACZC,IAAI,EAAC,cAAc;EACnBC,IAAIA,CAAA,EAAE;IAAC,OAAM;MAAEC,OAAO,EAAC;IAAK,CAAC;EAAA,CAAC;EAC9BC,QAAQ,EAAC;IACPC,IAAIA,CAAA,EAAE;MAAE,OAAO,IAAI,CAACC,MAAM,CAACC,KAAK,CAACF,IAAG;IAAE,CAAC;IACvCG,KAAKA,CAAA,EAAE;MAAE,OAAO,IAAI,CAACH,IAAI,CAACI,MAAM,CAAC,CAACC,CAAC,EAACC,CAAC,KAAGD,CAAC,GAACC,CAAC,CAACC,UAAU,GAACD,CAAC,CAACE,QAAQ,EAAC,CAAC;IAAE,CAAC;IACtEC,cAAcA,CAAA,EAAE;MACd,IAAG,CAAC,IAAI,CAACT,IAAI,CAACU,MAAM,EAAE,OAAO;MAC7B,MAAMC,EAAC,GAAI,IAAI,CAACX,IAAI,CAAC,CAAC,CAAC,CAACY,cAAa;MACrC,IAAG,IAAI,CAACZ,IAAI,CAACa,KAAK,CAACP,CAAC,IAAEA,CAAC,CAACM,cAAc,KAAGD,EAAE,CAAC,EAAE,OAAOA,EAAC;MACtD,OAAO;IACT;EACF,CAAC;EACDG,OAAO,EAAC;IA