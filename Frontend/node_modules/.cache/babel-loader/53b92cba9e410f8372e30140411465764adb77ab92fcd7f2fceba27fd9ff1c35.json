{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport api from '../../services/api';\nconst debounce = (fn, d = 400) => {\n  let t;\n  return (...a) => {\n    clearTimeout(t);\n    t = setTimeout(() => fn(...a), d);\n  };\n};\nexport default {\n  name: 'AdminMarketPrices',\n  data() {\n    return {\n      stores: [],\n      rows: [],\n      draft: {},\n      storeOwnerId: '',\n      q: '',\n      page: 1,\n      pageSize: 20,\n      total: 0,\n      loading: false,\n      savingId: null,\n      message: '',\n      isError: false,\n      debouncedFetch: null\n    };\n  },\n  computed: {\n    totalPages() {\n      return Math.max(1, Math.ceil(this.total / this.pageSize));\n    },\n    withMarketCount() {\n      return this.rows.filter(r => Number(r.market_price) > 0).length;\n    },\n    missingMarketCount() {\n      return this.rows.filter(r => !(Number(r.market_price) > 0)).length;\n    }\n  },\n  async created() {\n    this.debouncedFetch = debounce(() => {\n      this.page = 1;\n      this.fetch();\n    }, 400);\n    await this.loadStores();\n    await this.fetch();\n  },\n  methods: {\n    async loadStores() {\n      try {\n        const {\n          data\n        } = await api.get('/admin/stores');\n        this.stores = data || [];\n      } catch (e) {\n        this.stores = [];\n      }\n    },\n    onFilterChange() {\n      this.page = 1;\n      this.fetch();\n    },\n    async fetch() {\n      this.loading = true;\n      this.message = '';\n      try {\n        const params = {\n          page: this.page,\n          pageSize: this.pageSize\n        };\n        if (this.storeOwnerId) params.storeOwnerId = this.storeOwnerId;\n        if (this.q) params.q = this.q;\n        const {\n          data\n        } = await api.get('/admin/market-prices', {\n          params\n        });\n        this.rows = data.rows || [];\n        this.total = data.total || 0;\n        this.page = data.page || this.page;\n        this.pageSize = data.pageSize || this.pageSize;\n        const next = {};\n        for (const r of this.rows) {\n          next[r.id] = r.market_price == null || r.market_price === '' ? '' : Number(r.market_price);\n        }\n        this.draft = next;\n      } catch (e) {\n        this.rows = [];\n        this.total = 0;\n        this.isError = true;\n        this.message = e?.response?.data?.message || 'Failed to load market prices';\n      } finally {\n        this.loading = false;\n      }\n    },\n    onDraft(id, value) {\n      this.draft = {\n        ...this.draft,\n        [id]: value\n      };\n    },\n    hasMarket(p) {\n      return p.market_price != null && p.market_price !== '' && Number.isFinite(Number(p.market_price));\n    },\n    savings(p) {\n      const market = Number(this.draft[p.id]);\n      const kadiwa = Number(p.price || 0);\n      if (!Number.isFinite(market) || market <= 0) return null;\n      return market - kadiwa;\n    },\n    async save(p) {\n      const raw = this.draft[p.id];\n      const market_price = raw === '' || raw === null || raw === undefined ? null : Number(raw);\n      if (market_price !== null && (!Number.isFinite(market_price) || market_price < 0)) {\n        this.isError = true;\n        this.message = 'Enter a valid market price';\n        return;\n      }\n      this.savingId = p.id;\n      this.message = '';\n      try {\n        const {\n          data\n        } = await api.put(`/admin/market-prices/${p.id}`, {\n          market_price\n        });\n        const row = data.row;\n        this.rows = this.rows.map(r => r.id === p.id ? row : r);\n        this.draft = {\n          ...this.draft,\n          [p.id]: row.market_price == null ? '' : Number(row.market_price)\n        };\n        this.isError = false;\n        this.message = `Saved market price for ${row.name}`;\n      } catch (e) {\n        this.isError = true;\n        this.message = e?.response?.data?.message || 'Failed to save market price';\n      } finally {\n        this.savingId = null;\n      }\n    },\n    async clear(p) {\n      this.draft = {\n        ...this.draft,\n        [p.id]: ''\n      };\n      await this.save({\n        ...p,\n        market_price: null\n      });\n    },\n    prev() {\n      if (this.page > 1) {\n        this.page -= 1;\n        this.fetch();\n      }\n    },\n    next() {\n      if (this.page < this.totalPages) {\n        this.page += 1;\n        this.fetch();\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","debounce","fn","d","t","a","clearTimeout","setTimeout","name","data","stores","rows","draft","storeOwnerId","q","page","pageSize","total","loading","savingId","message","isError","debouncedFetch","computed","totalPages","Math","max","ceil","withMarketCount","filter","r","Number","market_price","length","missingMarketCount","created","fetch","loadStores","methods","get","e","onFilterChange","params","next","id","response","onDraft","value","hasMarket","p","isFinite","savings","market","kadiwa","price","save","raw","undefined","put","row","map","clear","prev"],"sources":["C:\\Users\\Admin\\Documents\\CapstoneProject\\kadiwa\\Frontend\\src\\views\\admin\\MarketPrices.vue"],"sourcesContent":["<template>\r\n  <div class=\"market-page\">\r\n    <div class=\"head\">\r\n      <div>\r\n        <h2>Market Prices</h2>\r\n        <p class=\"sub\">Set AMAD market prices for products from every Kadiwa store. Customers see this beside the store’s Kadiwa price.</p>\r\n      </div>\r\n      <div class=\"controls\">\r\n        <label>Store\r\n          <select v-model=\"storeOwnerId\" @change=\"onFilterChange\">\r\n            <option value=\"\">All Stores</option>\r\n            <option v-for=\"s in stores\" :key=\"s.id\" :value=\"s.id\">{{ s.store_name }}</option>\r\n          </select>\r\n        </label>\r\n        <label>Search\r\n          <input v-model=\"q\" @input=\"debouncedFetch\" placeholder=\"Product / category\" />\r\n        </label>\r\n        <button class=\"secondary\" @click=\"fetch\" :disabled=\"loading\">Refresh</button>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"summary\">\r\n      <article class=\"sum-card\">\r\n        <span>Products</span>\r\n        <strong>{{ total }}</strong>\r\n      </article>\r\n      <article class=\"sum-card\">\r\n        <span>With Market Price</span>\r\n        <strong>{{ withMarketCount }}</strong>\r\n      </article>\r\n      <article class=\"sum-card\">\r\n        <span>Missing Market Price</span>\r\n        <strong>{{ missingMarketCount }}</strong>\r\n      </article>\r\n    </div>\r\n\r\n    <div class=\"table-wrap\">\r\n      <table class=\"table\">\r\n        <thead>\r\n          <tr>\r\n            <th>Store</th>\r\n            <th>Product</th>\r\n            <th>Category</th>\r\n            <th>Unit</th>\r\n            <th>Kadiwa Price</th>\r\n            <th>Market Price</th>\r\n            <th>Savings</th>\r\n            <th>Action</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"p in rows\" :key=\"p.id\">\r\n            <td data-label=\"Store\">{{ p.store_name }}</td>\r\n            <td data-label=\"Product\">{{ p.name }}</td>\r\n            <td data-label=\"Category\">{{ p.category || '—' }}</td>\r\n            <td data-label=\"Unit\">{{ p.unit || '—' }}</td>\r\n            <td data-label=\"Kadiwa Price\">₱{{ Number(p.price || 0).toFixed(2) }}</td>\r\n            <td data-label=\"Market Price\">\r\n              <input\r\n                class=\"inline\"\r\n                type=\"number\"\r\n                min=\"0\"\r\n                step=\"0.01\"\r\n                :value=\"draft[p.id]\"\r\n                @input=\"onDraft(p.id, $event.target.value)\"\r\n                placeholder=\"0.00\"\r\n              />\r\n            </td>\r\n            <td data-label=\"Savings\">\r\n              <span v-if=\"savings(p) != null\" :class=\"savings(p) >= 0 ? 'up' : 'down'\">\r\n                {{ savings(p) >= 0 ? '↓' : '↑' }} ₱{{ Math.abs(savings(p)).toFixed(2) }}\r\n              </span>\r\n              <span v-else class=\"muted\">—</span>\r\n            </td>\r\n            <td data-label=\"Action\">\r\n              <div class=\"actions\">\r\n                <button class=\"primary\" :disabled=\"savingId === p.id\" @click=\"save(p)\">\r\n                  {{ savingId === p.id ? 'Saving…' : 'Save' }}\r\n                </button>\r\n                <button class=\"ghost\" :disabled=\"savingId === p.id || !hasMarket(p)\" @click=\"clear(p)\">Clear</button>\r\n              </div>\r\n            </td>\r\n          </tr>\r\n          <tr v-if=\"!loading && rows.length === 0\">\r\n            <td colspan=\"8\" class=\"empty\">No products found</td>\r\n          </tr>\r\n          <tr v-if=\"loading\">\r\n            <td colspan=\"8\" class=\"empty\">Loading…</td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div class=\"pagination\">\r\n      <button @click=\"prev\" :disabled=\"page <= 1 || loading\">Prev</button>\r\n      <span>Page {{ page }} of {{ totalPages }}</span>\r\n      <button @click=\"next\" :disabled=\"page >= totalPages || loading\">Next</button>\r\n    </div>\r\n\r\n    <p v-if=\"message\" class=\"toast\" :class=\"{ error: isError }\">{{ message }}</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\n\r\nconst debounce = (fn, d = 400) => {\r\n  let t\r\n  return (...a) => {\r\n    clearTimeout(t)\r\n    t = setTimeout(() => fn(...a), d)\r\n  }\r\n}\r\n\r\nexport default {\r\n  name: 'AdminMarketPrices',\r\n  data() {\r\n    return {\r\n      stores: [],\r\n      rows: [],\r\n      draft: {},\r\n      storeOwnerId: '',\r\n      q: '',\r\n      page: 1,\r\n      pageSize: 20,\r\n      total: 0,\r\n      loading: false,\r\n      savingId: null,\r\n      message: '',\r\n      isError: false,\r\n      debouncedFetch: null\r\n    }\r\n  },\r\n  computed: {\r\n    totalPages() {\r\n      return Math.max(1, Math.ceil(this.total / this.pageSize))\r\n    },\r\n    withMarketCount() {\r\n      return this.rows.filter((r) => Number(r.market_price) > 0).length\r\n    },\r\n    missingMarketCount() {\r\n      return this.rows.filter((r) => !(Number(r.market_price) > 0)).length\r\n    }\r\n  },\r\n  async created() {\r\n    this.debouncedFetch = debounce(() => {\r\n      this.page = 1\r\n      this.fetch()\r\n    }, 400)\r\n    await this.loadStores()\r\n    await this.fetch()\r\n  },\r\n  methods: {\r\n    async loadStores() {\r\n      try {\r\n        const { data } = await api.get('/admin/stores')\r\n        this.stores = data || []\r\n      } catch (e) {\r\n        this.stores = []\r\n      }\r\n    },\r\n    onFilterChange() {\r\n      this.page = 1\r\n      this.fetch()\r\n    },\r\n    async fetch() {\r\n      this.loading = true\r\n      this.message = ''\r\n      try {\r\n        const params = { page: this.page, pageSize: this.pageSize }\r\n        if (this.storeOwnerId) params.storeOwnerId = this.storeOwnerId\r\n        if (this.q) params.q = this.q\r\n        const { data } = await api.get('/admin/market-prices', { params })\r\n        this.rows = data.rows || []\r\n        this.total = data.total || 0\r\n        this.page = data.page || this.page\r\n        this.pageSize = data.pageSize || this.pageSize\r\n        const next = {}\r\n        for (const r of this.rows) {\r\n          next[r.id] = r.market_price == null || r.market_price === '' ? '' : Number(r.market_price)\r\n        }\r\n        this.draft = next\r\n      } catch (e) {\r\n        this.rows = []\r\n        this.total = 0\r\n        this.isError = true\r\n        this.message = e?.response?.data?.message || 'Failed to load market prices'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    onDraft(id, value) {\r\n      this.draft = { ...this.draft, [id]: value }\r\n    },\r\n    hasMarket(p) {\r\n      return p.market_price != null && p.market_price !== '' && Number.isFinite(Number(p.market_price))\r\n    },\r\n    savings(p) {\r\n      const market = Number(this.draft[p.id])\r\n      const kadiwa = Number(p.price || 0)\r\n      if (!Number.isFinite(market) || market <= 0) return null\r\n      return market - kadiwa\r\n    },\r\n    async save(p) {\r\n      const raw = this.draft[p.id]\r\n      const market_price = raw === '' || raw === null || raw === undefined ? null : Number(raw)\r\n      if (market_price !== null && (!Number.isFinite(market_price) || market_price < 0)) {\r\n        this.isError = true\r\n        this.message = 'Enter a valid market price'\r\n        return\r\n      }\r\n      this.savingId = p.id\r\n      this.message = ''\r\n      try {\r\n        const { data } = await api.put(`/admin/market-prices/${p.id}`, { market_price })\r\n        const row = data.row\r\n        this.rows = this.rows.map((r) => (r.id === p.id ? row : r))\r\n        this.draft = {\r\n          ...this.draft,\r\n          [p.id]: row.market_price == null ? '' : Number(row.market_price)\r\n        }\r\n        this.isError = false\r\n        this.message = `Saved market price for ${row.name}`\r\n      } catch (e) {\r\n        this.isError = true\r\n        this.message = e?.response?.data?.message || 'Failed to save market price'\r\n      } finally {\r\n        this.savingId = null\r\n      }\r\n    },\r\n    async clear(p) {\r\n      this.draft = { ...this.draft, [p.id]: '' }\r\n      await this.save({ ...p, market_price: null })\r\n    },\r\n    prev() {\r\n      if (this.page > 1) {\r\n        this.page -= 1\r\n        this.fetch()\r\n      }\r\n    },\r\n    next() {\r\n      if (this.page < this.totalPages) {\r\n        this.page += 1\r\n        this.fetch()\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.market-page { display: grid; gap: 12px; }\r\n.head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-end;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n.head h2 { margin: 0 0 4px; }\r\n.sub { margin: 0; color: #5f7256; font-size: 13px; max-width: 520px; }\r\n.controls { display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-end; }\r\nlabel { display: grid; gap: 4px; font-size: 12px; color: #5f7256; }\r\ninput, select {\r\n  min-height: 36px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 10px;\r\n  padding: 0 10px;\r\n  background: #fff;\r\n}\r\n.secondary, .primary, .ghost, .pagination button {\r\n  border-radius: 10px;\r\n  min-height: 36px;\r\n  padding: 0 12px;\r\n  cursor: pointer;\r\n}\r\n.secondary { border: 1px solid #cddbb9; background: #fff; color: #2f5a23; }\r\n.primary { border: none; background: #2f5a23; color: #fff; }\r\n.ghost { border: 1px solid #cddbb9; background: #fff; color: #5f7256; }\r\n.summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }\r\n.sum-card {\r\n  background: #fff;\r\n  border: 1px solid #deead0;\r\n  border-radius: 14px;\r\n  padding: 10px 12px;\r\n  box-shadow: 0 10px 24px rgba(56, 92, 35, 0.1);\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n.sum-card span { font-size: 12px; color: #5f7256; }\r\n.sum-card strong { font-size: 1.1rem; }\r\n.table-wrap {\r\n  max-height: 520px;\r\n  overflow: auto;\r\n  border: 1px solid #deead0;\r\n  border-radius: 14px;\r\n  background: #fff;\r\n  box-shadow: 0 10px 24px rgba(56, 92, 35, 0.1);\r\n}\r\n.table { width: 100%; border-collapse: collapse; }\r\n.table thead th { position: sticky; top: 0; background: #f4f8ee; z-index: 2; }\r\n.table th, .table td {\r\n  padding: 10px 12px;\r\n  border-bottom: 1px solid #e6eddc;\r\n  text-align: left;\r\n  font-size: 13px;\r\n}\r\n.inline {\r\n  width: 110px;\r\n  min-height: 34px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 8px;\r\n  padding: 0 8px;\r\n}\r\n.actions { display: flex; gap: 6px; flex-wrap: wrap; }\r\n.up { color: #1d7a3a; font-weight: 700; }\r\n.down { color: #b42318; font-weight: 700; }\r\n.muted, .empty { color: #6b7c62; }\r\n.pagination {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n}\r\n.toast {\r\n  margin: 0;\r\n  padding: 10px 12px;\r\n  border-radius: 10px;\r\n  background: #e8f6ea;\r\n  color: #1d5c2a;\r\n}\r\n.toast.error { background: #fdecec; color: #8a1f1f; }\r\n\r\n@media (max-width: 900px) {\r\n  .summary { grid-template-columns: 1fr; }\r\n  .table thead { display: none; }\r\n  .table, .table tbody, .table tr, .table td { display: block; width: 100%; }\r\n  .table tr {\r\n    padding: 12px;\r\n    border-bottom: 1px solid #e6eddc;\r\n  }\r\n  .table td {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    gap: 12px;\r\n    border: none;\r\n    padding: 6px 0;\r\n  }\r\n  .table td::before {\r\n    content: attr(data-label);\r\n    font-weight: 700;\r\n    color: #5f7256;\r\n  }\r\n  .inline { width: 120px; }\r\n  .actions { justify-content: flex-end; }\r\n  .pagination { justify-content: center; }\r\n}\r\n</style>\r\n"],"mappings":";;;AAwGA,OAAOA,GAAE,MAAO,oBAAmB;AAEnC,MAAMC,QAAO,GAAIA,CAACC,EAAE,EAAEC,CAAA,GAAI,GAAG,KAAK;EAChC,IAAIC,CAAA;EACJ,OAAO,CAAC,GAAGC,CAAC,KAAK;IACfC,YAAY,CAACF,CAAC;IACdA,CAAA,GAAIG,UAAU,CAAC,MAAML,EAAE,CAAC,GAAGG,CAAC,CAAC,EAAEF,CAAC;EAClC;AACF;AAEA,eAAe;EACbK,IAAI,EAAE,mBAAmB;EACzBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE,EAAE;MACVC,IAAI,EAAE,EAAE;MACRC,KAAK,EAAE,CAAC,CAAC;MACTC,YAAY,EAAE,EAAE;MAChBC,CAAC,EAAE,EAAE;MACLC,IAAI,EAAE,CAAC;MACPC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,CAAC;MACRC,OAAO,EAAE,KAAK;MACdC,QAAQ,EAAE,IAAI;MACdC,OAAO,EAAE,EAAE;MACXC,OAAO,EAAE,KAAK;MACdC,cAAc,EAAE;IAClB;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAUA,CAAA,EAAG;MACX,OAAOC,IAAI,CAACC,GAAG,CAAC,CAAC,EAAED,IAAI,CAACE,IAAI,CAAC,IAAI,CAACV,KAAI,GAAI,IAAI,CAACD,QAAQ,CAAC;IAC1D,CAAC;IACDY,eAAeA,CAAA,EAAG;MAChB,OAAO,IAAI,CAACjB,IAAI,CAACkB,MAAM,CAAEC,CAAC,IAAKC,MAAM,CAACD,CAAC,CAACE,YAAY,IAAI,CAAC,CAAC,CAACC,MAAK;IAClE,CAAC;IACDC,kBAAkBA,CAAA,EAAG;MAC