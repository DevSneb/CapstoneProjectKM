{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '../services/api';\nimport { bindKeyboardScroll } from '../utils/keyboardScroll';\nexport default {\n  name: 'AdminLogin',\n  data() {\n    return {\n      credentials: {\n        username: '',\n        password: ''\n      },\n      loginMode: 'admin',\n      showPassword: false,\n      showRegisterPassword: false,\n      error: '',\n      loading: false,\n      showRegisterForm: false,\n      unbindKeyboardScroll: null,\n      registerData: {\n        username: '',\n        email: '',\n        password: '',\n        full_name: '',\n        store_name: '',\n        phone: '',\n        address: ''\n      }\n    };\n  },\n  computed: {\n    loginModeLabel() {\n      if (this.loginMode === 'store_owner') return 'Store Owner';\n      if (this.loginMode === 'pos_user') return 'POS';\n      return 'Admin';\n    }\n  },\n  mounted() {\n    this.unbindKeyboardScroll = bindKeyboardScroll(this.$el);\n  },\n  beforeUnmount() {\n    if (this.unbindKeyboardScroll) this.unbindKeyboardScroll();\n  },\n  methods: {\n    async handleLogin() {\n      this.error = '';\n      this.loading = true;\n      try {\n        let endpoint = '/admin/auth/login/admin';\n        let redirectRoute = '/admin/dashboard';\n        if (this.loginMode === 'store_owner') {\n          endpoint = '/admin/auth/login/store-owner';\n          redirectRoute = '/store-owner/dashboard';\n        } else if (this.loginMode === 'pos_user') {\n          endpoint = '/pos/auth/login';\n          redirectRoute = '/pos/dashboard';\n        }\n        const response = await api.post(endpoint, this.credentials);\n        this.$store.dispatch('login', {\n          user: response.data.user,\n          token: response.data.token\n        });\n        const role = response.data.user?.role || (this.loginMode === 'store_owner' ? 'store_owner' : this.loginMode === 'pos_user' ? 'pos_user' : 'admin');\n        const {\n          recallPath\n        } = await import('../services/routeMemory');\n        this.$router.push(recallPath(role, redirectRoute));\n      } catch (err) {\n        this.error = err.response?.data?.message || 'Login failed. Please try again.';\n      } finally {\n        this.loading = false;\n      }\n    },\n    async handleRegister() {\n      try {\n        const response = await api.post('/admin/auth/register/store-owner', this.registerData);\n        alert(response.data.message);\n        this.showRegisterForm = false;\n        this.registerData = {\n          username: '',\n          email: '',\n          password: '',\n          full_name: '',\n          store_name: '',\n          phone: '',\n          address: ''\n        };\n      } catch (err) {\n        alert(err.response?.data?.message || 'Registration failed');\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","bindKeyboardScroll","name","data","credentials","username","password","loginMode","showPassword","showRegisterPassword","error","loading","showRegisterForm","unbindKeyboardScroll","registerData","email","full_name","store_name","phone","address","computed","loginModeLabel","mounted","$el","beforeUnmount","methods","handleLogin","endpoint","redirectRoute","response","post","$store","dispatch","user","token","role","recallPath","$router","push","err","message","handleRegister","alert"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\AdminLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-container\">\r\n    <div class=\"login-box\">\r\n      <div class=\"login-header\">\r\n        <div class=\"eyebrow\">Secure Access</div>\r\n        <h1>Kadiwa E-Commerce</h1>\r\n        <h2>{{ loginModeLabel }} Login</h2>\r\n        <p class=\"subtext\">Choose your account type and sign in.</p>\r\n      </div>\r\n\r\n      <div class=\"toggle-buttons\">\r\n        <button\r\n          :class=\"{ active: loginMode === 'admin' }\"\r\n          type=\"button\"\r\n          @click=\"loginMode = 'admin'\"\r\n        >\r\n          Admin\r\n        </button>\r\n        <button\r\n          :class=\"{ active: loginMode === 'store_owner' }\"\r\n          type=\"button\"\r\n          @click=\"loginMode = 'store_owner'\"\r\n        >\r\n          Store Owner\r\n        </button>\r\n        <button\r\n          :class=\"{ active: loginMode === 'pos_user' }\"\r\n          type=\"button\"\r\n          @click=\"loginMode = 'pos_user'\"\r\n        >\r\n          POS\r\n        </button>\r\n      </div>\r\n\r\n      <form @submit.prevent=\"handleLogin\" class=\"login-form\">\r\n        <div v-if=\"error\" class=\"error-message\">{{ error }}</div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"username\">Username</label>\r\n          <input\r\n            type=\"text\"\r\n            id=\"username\"\r\n            v-model=\"credentials.username\"\r\n            placeholder=\"Enter username\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"password\">Password</label>\r\n          <div class=\"password-field\">\r\n            <input\r\n              :type=\"showPassword ? 'text' : 'password'\"\r\n              id=\"password\"\r\n              v-model=\"credentials.password\"\r\n              placeholder=\"Enter password\"\r\n              required\r\n            />\r\n            <button\r\n              type=\"button\"\r\n              class=\"toggle-password\"\r\n              :aria-label=\"showPassword ? 'Hide password' : 'Show password'\"\r\n              @click=\"showPassword = !showPassword\"\r\n            >\r\n              {{ showPassword ? 'Hide' : 'Show' }}\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        <button type=\"submit\" class=\"login-btn\" :disabled=\"loading\">\r\n          {{ loading ? 'Logging in...' : 'Login' }}\r\n        </button>\r\n      </form>\r\n\r\n      <div class=\"links\">\r\n        <router-link to=\"/customer/login\">Customer Login</router-link>\r\n        <span v-if=\"loginMode === 'store_owner'\"> | </span>\r\n        <a\r\n          v-if=\"loginMode === 'store_owner'\"\r\n          href=\"#\"\r\n          @click.prevent=\"showRegisterForm = true\"\r\n        >\r\n          Register as Store Owner\r\n        </a>\r\n      </div>\r\n\r\n      <div v-if=\"showRegisterForm\" class=\"register-modal\">\r\n        <div class=\"modal-content\">\r\n          <h3>Store Owner Registration</h3>\r\n          <form @submit.prevent=\"handleRegister\">\r\n            <div class=\"form-group\">\r\n              <label>Username</label>\r\n              <input type=\"text\" v-model=\"registerData.username\" required />\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Email</label>\r\n              <input type=\"email\" v-model=\"registerData.email\" required />\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Password</label>\r\n              <div class=\"password-field\">\r\n                <input\r\n                  :type=\"showRegisterPassword ? 'text' : 'password'\"\r\n                  v-model=\"registerData.password\"\r\n                  required\r\n                />\r\n                <button\r\n                  type=\"button\"\r\n                  class=\"toggle-password\"\r\n                  :aria-label=\"showRegisterPassword ? 'Hide password' : 'Show password'\"\r\n                  @click=\"showRegisterPassword = !showRegisterPassword\"\r\n                >\r\n                  {{ showRegisterPassword ? 'Hide' : 'Show' }}\r\n                </button>\r\n              </div>\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Full Name</label>\r\n              <input type=\"text\" v-model=\"registerData.full_name\" required />\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Store Name</label>\r\n              <input type=\"text\" v-model=\"registerData.store_name\" required />\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Phone</label>\r\n              <input type=\"tel\" v-model=\"registerData.phone\" />\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Address</label>\r\n              <textarea v-model=\"registerData.address\"></textarea>\r\n            </div>\r\n            <div class=\"modal-buttons\">\r\n              <button type=\"submit\" class=\"btn-submit\">Register</button>\r\n              <button type=\"button\" @click=\"showRegisterForm = false\" class=\"btn-cancel\">Cancel</button>\r\n            </div>\r\n          </form>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../services/api'\r\nimport { bindKeyboardScroll } from '../utils/keyboardScroll'\r\n\r\nexport default {\r\n  name: 'AdminLogin',\r\n  data() {\r\n    return {\r\n      credentials: {\r\n        username: '',\r\n        password: ''\r\n      },\r\n      loginMode: 'admin',\r\n      showPassword: false,\r\n      showRegisterPassword: false,\r\n      error: '',\r\n      loading: false,\r\n      showRegisterForm: false,\r\n      unbindKeyboardScroll: null,\r\n      registerData: {\r\n        username: '',\r\n        email: '',\r\n        password: '',\r\n        full_name: '',\r\n        store_name: '',\r\n        phone: '',\r\n        address: ''\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    loginModeLabel() {\r\n      if (this.loginMode === 'store_owner') return 'Store Owner'\r\n      if (this.loginMode === 'pos_user') return 'POS'\r\n      return 'Admin'\r\n    }\r\n  },\r\n  mounted() {\r\n    this.unbindKeyboardScroll = bindKeyboardScroll(this.$el)\r\n  },\r\n  beforeUnmount() {\r\n    if (this.unbindKeyboardScroll) this.unbindKeyboardScroll()\r\n  },\r\n  methods: {\r\n    async handleLogin() {\r\n      this.error = ''\r\n      this.loading = true\r\n\r\n      try {\r\n        let endpoint = '/admin/auth/login/admin'\r\n        let redirectRoute = '/admin/dashboard'\r\n\r\n        if (this.loginMode === 'store_owner') {\r\n          endpoint = '/admin/auth/login/store-owner'\r\n          redirectRoute = '/store-owner/dashboard'\r\n        } else if (this.loginMode === 'pos_user') {\r\n          endpoint = '/pos/auth/login'\r\n          redirectRoute = '/pos/dashboard'\r\n        }\r\n\r\n        const response = await api.post(endpoint, this.credentials)\r\n        this.$store.dispatch('login', {\r\n          user: response.data.user,\r\n          token: response.data.token\r\n        })\r\n        const role = response.data.user?.role\r\n          || (this.loginMode === 'store_owner' ? 'store_owner' : this.loginMode === 'pos_user' ? 'pos_user' : 'admin')\r\n        const { recallPath } = await import('../services/routeMemory')\r\n        this.$router.push(recallPath(role, redirectRoute))\r\n      } catch (err) {\r\n        this.error = err.response?.data?.message || 'Login failed. Please try again.'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    async handleRegister() {\r\n      try {\r\n        const response = await api.post('/admin/auth/register/store-owner', this.registerData)\r\n        alert(response.data.message)\r\n        this.showRegisterForm = false\r\n        this.registerData = {\r\n          username: '',\r\n          email: '',\r\n          password: '',\r\n          full_name: '',\r\n          store_name: '',\r\n          phone: '',\r\n          address: ''\r\n        }\r\n      } catch (err) {\r\n        alert(err.response?.data?.message || 'Registration failed')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n\r\n<style scoped>\r\n.login-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: flex-start;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  background: radial-gradient(circle at 15% 15%, rgba(124, 179, 66, 0.3), transparent 45%),\r\n              radial-gradient(circle at 85% 85%, rgba(78, 125, 50, 0.26), transparent 42%),\r\n              linear-gradient(135deg, #edf5e2 0%, #d9e7c7 100%);\r\n  padding: max(20px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom));\r\n  position: relative;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.login-container::before,\r\n.login-container::after {\r\n  content: '';\r\n  position: absolute;\r\n  border-radius: 999px;\r\n  pointer-events: none;\r\n}\r\n\r\n.login-container::before {\r\n  width: 300px;\r\n  height: 300px;\r\n  background: rgba(124, 179, 66, 0.16);\r\n  top: -100px;\r\n  left: -90px;\r\n}\r\n\r\n.login-container::after {\r\n  width: 220px;\r\n  height: 220px;\r\n  background: rgba(53, 94, 42, 0.12);\r\n  right: -70px;\r\n  bottom: -60px;\r\n}\r\n\r\n.login-box {\r\n  background: rgba(255, 255, 255, 0.88);\r\n  backdrop-filter: blur(8px);\r\n  -webkit-backdrop-filter: blur(8px);\r\n  padding: 36px;\r\n  border-radius: 18px;\r\n  border: 1px solid rgba(205, 219, 185, 0.9);\r\n  box-shadow: 0 18px 40px rgba(56, 92, 35, 0.18);\r\n  width: 100%;\r\n  max-width: 430px;\r\n  position: relative;\r\n  z-index: 1;\r\n  margin: auto 0;\r\n}\r\n\r\n.login-header {\r\n  text-align: center;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.eyebrow {\r\n  display: inline-block;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n  color: #4E7D32;\r\n  background: #eaf2de;\r\n  border: 1px solid #d5e4bf;\r\n  border-radius: 999px;\r\n  padding: 4px 10px;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.login-header h1 {\r\n  color: #355e2a;\r\n  margin-bottom: 8px;\r\n  font-size: 30px;\r\n  line-height: 1.1;\r\n}\r\n\r\n.login-header h2 {\r\n  color: #5f7256;\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  margin: 0;\r\n}\r\n\r\n.subtext {\r\n  color: #6f7d67;\r\n  margin: 8px 0 0;\r\n  font-size: 13px;\r\n}\r\n\r\n.toggle-buttons {\r\n  display: flex;\r\n  gap: 8px;\r\n  margin-bottom: 16px;\r\n  background: #f4f8ee;\r\n  border: 1px solid #dce8cc;\r\n  border-radius: 12px;\r\n  padding: 4px;\r\n}\r\n\r\n.toggle-buttons button {\r\n  flex: 1;\r\n  padding: 10px 8px;\r\n  border: none;\r\n  background: transparent;\r\n  color: #355e2a;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.toggle-buttons button.active {\r\n  background: linear-gradient(135deg, #7CB342, #4E7D32);\r\n  color: white;\r\n  box-shadow: 0 6px 14px rgba(78, 125, 50, 0.26);\r\n}\r\n\r\n.error-message {\r\n  background: #fff1f1;\r\n  color: #b42318;\r\n  padding: 10px 12px;\r\n  border-radius: 10px;\r\n  border: 1px solid #f4c8c8;\r\n  margin-bottom: 15px;\r\n  text-align: center;\r\n  font-size: 13px;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 7px;\r\n  color: #355e2a;\r\n  font-weight: 600;\r\n  font-size: 13px;\r\n}\r\n\r\n.form-group input,\r\n.form-group textarea {\r\n  width: 100%;\r\n  padding: 12px 13px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 10px;\r\n  font-size: 14px;\r\n  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;\r\n  background: #fff;\r\n}\r\n\r\n.form-group input:focus,\r\n.form-group textarea:focus {\r\n  outline: none;\r\n  border-color: #7CB342;\r\n  box-shadow: 0 0 0 4px rgba(124, 179, 66, 0.2);\r\n}\r\n\r\n.password-field {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.password-field input {\r\n  width: 100%;\r\n  padding-right: 64px;\r\n}\r\n.toggle-password {\r\n  position: absolute;\r\n  right: 8px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  border: none;\r\n  background: transparent;\r\n  color: #4E7D32;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  padding: 6px 8px;\r\n  border