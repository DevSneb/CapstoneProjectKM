{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nimport \"core-js/modules/esnext.json.parse.js\";\nimport api from '../../services/api';\nexport default {\n  name: 'AdminAccountSettings',\n  data() {\n    return {\n      user: {},\n      emailForm: {\n        email: '',\n        current_password: ''\n      },\n      passwordForm: {\n        current_password: '',\n        new_password: '',\n        confirm_password: ''\n      },\n      savingEmail: false,\n      savingPassword: false\n    };\n  },\n  async created() {\n    await this.loadUser();\n  },\n  methods: {\n    async loadUser() {\n      const {\n        data\n      } = await api.get('/admin/account/me');\n      this.user = data;\n      this.emailForm.email = data.email || '';\n    },\n    async changeEmail() {\n      this.savingEmail = true;\n      try {\n        const {\n          data\n        } = await api.put('/admin/account/email', this.emailForm);\n        this.user = data.user || this.user;\n        this.emailForm.email = this.user.email || '';\n        this.emailForm.current_password = '';\n        const stored = JSON.parse(localStorage.getItem('user') || '{}');\n        localStorage.setItem('user', JSON.stringify({\n          ...stored,\n          email: this.user.email\n        }));\n        alert('Email updated');\n      } catch (err) {\n        alert(err.response?.data?.message || err.response?.data?.errors?.map(e => e.msg).join(', ') || 'Failed to update email');\n      } finally {\n        this.savingEmail = false;\n      }\n    },\n    async changePassword() {\n      if (this.passwordForm.new_password !== this.passwordForm.confirm_password) {\n        alert('New password and confirmation do not match');\n        return;\n      }\n      this.savingPassword = true;\n      try {\n        await api.put('/admin/account/password', {\n          current_password: this.passwordForm.current_password,\n          new_password: this.passwordForm.new_password\n        });\n        this.passwordForm = {\n          current_password: '',\n          new_password: '',\n          confirm_password: ''\n        };\n        alert('Password updated');\n      } catch (err) {\n        alert(err.response?.data?.message || err.response?.data?.errors?.map(e => e.msg).join(', ') || 'Failed to update password');\n      } finally {\n        this.savingPassword = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","user","emailForm","email","current_password","passwordForm","new_password","confirm_password","savingEmail","savingPassword","created","loadUser","methods","get","changeEmail","put","stored","JSON","parse","localStorage","getItem","setItem","stringify","alert","err","response","message","errors","map","e","msg","join","changePassword"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\admin\\AccountSettings.vue"],"sourcesContent":["<template>\r\n  <div class=\"settings-page\">\r\n    <h2>Account Settings</h2>\r\n    <div class=\"card\">\r\n      <div class=\"row\"><span>Username</span><strong>{{ user.username }}</strong></div>\r\n      <div class=\"row\"><span>Email</span><strong>{{ user.email }}</strong></div>\r\n      <div class=\"row\"><span>Full Name</span><strong>{{ user.full_name }}</strong></div>\r\n      <div class=\"row\"><span>Role</span><strong>{{ user.role }}</strong></div>\r\n    </div>\r\n\r\n    <form class=\"form\" @submit.prevent=\"changeEmail\">\r\n      <h3>Change Email</h3>\r\n      <label>New Email\r\n        <input v-model=\"emailForm.email\" type=\"email\" required />\r\n      </label>\r\n      <label>Current Password\r\n        <input v-model=\"emailForm.current_password\" type=\"password\" required />\r\n      </label>\r\n      <button type=\"submit\" :disabled=\"savingEmail\">{{ savingEmail ? 'Updating...' : 'Update Email' }}</button>\r\n    </form>\r\n\r\n    <form class=\"form\" @submit.prevent=\"changePassword\">\r\n      <h3>Change Password</h3>\r\n      <label>Current Password\r\n        <input v-model=\"passwordForm.current_password\" type=\"password\" required />\r\n      </label>\r\n      <label>New Password\r\n        <input v-model=\"passwordForm.new_password\" type=\"password\" minlength=\"6\" required />\r\n      </label>\r\n      <label>Confirm New Password\r\n        <input v-model=\"passwordForm.confirm_password\" type=\"password\" minlength=\"6\" required />\r\n      </label>\r\n      <button type=\"submit\" :disabled=\"savingPassword\">{{ savingPassword ? 'Updating...' : 'Update Password' }}</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../../services/api'\r\nexport default {\r\n  name: 'AdminAccountSettings',\r\n  data() {\r\n    return {\r\n      user: {},\r\n      emailForm: { email: '', current_password: '' },\r\n      passwordForm: { current_password: '', new_password: '', confirm_password: '' },\r\n      savingEmail: false,\r\n      savingPassword: false\r\n    }\r\n  },\r\n  async created() {\r\n    await this.loadUser()\r\n  },\r\n  methods: {\r\n    async loadUser() {\r\n      const { data } = await api.get('/admin/account/me')\r\n      this.user = data\r\n      this.emailForm.email = data.email || ''\r\n    },\r\n    async changeEmail() {\r\n      this.savingEmail = true\r\n      try {\r\n        const { data } = await api.put('/admin/account/email', this.emailForm)\r\n        this.user = data.user || this.user\r\n        this.emailForm.email = this.user.email || ''\r\n        this.emailForm.current_password = ''\r\n        const stored = JSON.parse(localStorage.getItem('user') || '{}')\r\n        localStorage.setItem('user', JSON.stringify({ ...stored, email: this.user.email }))\r\n        alert('Email updated')\r\n      } catch (err) {\r\n        alert(err.response?.data?.message || err.response?.data?.errors?.map(e => e.msg).join(', ') || 'Failed to update email')\r\n      } finally {\r\n        this.savingEmail = false\r\n      }\r\n    },\r\n    async changePassword() {\r\n      if (this.passwordForm.new_password !== this.passwordForm.confirm_password) {\r\n        alert('New password and confirmation do not match')\r\n        return\r\n      }\r\n      this.savingPassword = true\r\n      try {\r\n        await api.put('/admin/account/password', {\r\n          current_password: this.passwordForm.current_password,\r\n          new_password: this.passwordForm.new_password\r\n        })\r\n        this.passwordForm = { current_password: '', new_password: '', confirm_password: '' }\r\n        alert('Password updated')\r\n      } catch (err) {\r\n        alert(err.response?.data?.message || err.response?.data?.errors?.map(e => e.msg).join(', ') || 'Failed to update password')\r\n      } finally {\r\n        this.savingPassword = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n.settings-page{display:grid;gap:12px}\r\n.settings-page h2{margin:0}\r\n.card{background:#fff;border:1px solid #deead0;border-radius:14px;padding:16px;box-shadow:0 10px 24px rgba(56,92,35,.1);max-width:560px}\r\n.row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #e6eddc}\r\n.row:last-child{border-bottom:none}\r\n.row span{color:#5f7256;font-size:13px}\r\n.row strong{color:#2f5a23}\r\n.form{display:grid;gap:10px;background:#fff;border:1px solid #deead0;border-radius:14px;padding:16px;box-shadow:0 10px 24px rgba(56,92,35,.1);max-width:560px}\r\n.form h3{margin:0;color:#355e2a;font-size:15px}\r\nlabel{display:flex;flex-direction:column;gap:6px;color:#5f7256;font-size:13px}\r\ninput{padding:9px 10px;border:1px solid #cddbb9;border-radius:8px}\r\nbutton{justify-self:start;background:linear-gradient(135deg,#7CB342,#4E7D32);color:#fff;border:none;padding:9px 14px;border-radius:8px;cursor:pointer}\r\nbutton:disabled{opacity:.7;cursor:default}\r\n\n/* mobile-dashboard-fix */\n.table-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}\n.table-wrap .table, table.table{width:100%}\n@media (max-width: 640px){\n  .toolbar,.filters,.head,.section-head,.graph-head,.forecast-tools,.reports-header,.form{flex-wrap:wrap}\n  .toolbar,.filters,.head,.section-head{display:flex;gap:8px}\n  .toolbar input,.search-input,input[type=\"search\"],.search{min-width:0!important;width:100%;max-width:100%}\n  .table-wrap .table, table.table{min-width:560px}\n  .btn,button.primary,button.save-btn{min-height:40px}\n  .barangay-row{flex-direction:column;align-items:stretch!important}\n  .map{height:260px!important}\n  .details-grid{grid-template-columns:1fr!important}\n  .card,.form{max-width:100%}\n}\n</style>\r\n"],"mappings":";;;;AAqCA,OAAOA,GAAE,MAAO,oBAAmB;AACnC,eAAe;EACbC,IAAI,EAAE,sBAAsB;EAC5BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,CAAC,CAAC;MACRC,SAAS,EAAE;QAAEC,KAAK,EAAE,EAAE;QAAEC,gBAAgB,EAAE;MAAG,CAAC;MAC9CC,YAAY,EAAE;QAAED,gBAAgB,EAAE,EAAE;QAAEE,YAAY,EAAE,EAAE;QAAEC,gBAAgB,EAAE;MAAG,CAAC;MAC9EC,WAAW,EAAE,KAAK;MAClBC,cAAc,EAAE;IAClB;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,QAAQ,CAAC;EACtB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,QAAQA,CAAA,EAAG;MACf,MAAM;QAAEX;MAAK,IAAI,MAAMF,GAAG,CAACe,GAAG,CAAC,mBAAmB;MAClD,IAAI,CAACZ,IAAG,GAAID,IAAG;MACf,IAAI,CAACE,SAAS,CAACC,KAAI,GAAIH,IAAI,CAACG,KAAI,IAAK,EAAC;IACxC,CAAC;IACD,MAAMW,WAAWA,CAAA,EAAG;MAClB,IAAI,CAACN,WAAU,GAAI,IAAG;MACtB,IAAI;QACF,MAAM;UAAER;QAAK,IAAI,MAAMF,GAAG,CAACiB,GAAG,CAAC,sBAAsB,EAAE,IAAI,CAACb,SAAS;QACrE,IAAI,CAACD,IAAG,GAAID,IAAI,CAACC,IAAG,IAAK,IAAI,CAACA,IAAG;QACjC,IAAI,CAACC,SAAS,CAACC,KAAI,GAAI,IAAI,CAACF,IAAI,CAACE,KAAI,IAAK,EAAC;QAC3C,IAAI,CAACD,SAAS,CAACE,gBAAe,GAAI,EAAC;QACnC,MAAMY,MAAK,GAAIC,IAAI,CAACC,KAAK,CAACC,YAAY,CAACC,OAAO,CAAC,MAAM,KAAK,IAAI;QAC9DD,YAAY,CAACE,OAAO,CAAC,MAAM,EAAEJ,IAAI,CAACK,SAAS,CAAC;UAAE,GAAGN,MAAM;UAAEb,KAAK,EAAE,IAAI,CAACF,IAAI,CAACE;QAAM,CAAC,CAAC;QAClFoB,KAAK,CAAC,eAAe;MACvB,EAAE,OAAOC,GAAG,EAAE;QACZD,KAAK,CAACC,