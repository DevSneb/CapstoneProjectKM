{"ast":null,"code":"import api from '../services/api';\nexport default {\n  name: 'CustomerOrders',\n  data() {\n    return {\n      orders: []\n    };\n  },\n  async created() {\n    const {\n      data\n    } = await api.get('/customer/orders');\n    this.orders = data;\n  },\n  methods: {\n    fmt(v) {\n      const n = Number(v);\n      return isFinite(n) ? n.toFixed(2) : '0.00';\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","orders","created","get","methods","fmt","v","n","Number","isFinite","toFixed"],"sources":["C:\\Users\\Nicole\\Downloads\\CapstoneProject (19)\\CapstoneProject\\Frontend\\src\\views\\CustomerOrders.vue"],"sourcesContent":["<template>\r\n  <div class=\"page\">\r\n    <h2>My Orders</h2>\r\n    <table class=\"table\">\r\n      <thead><tr><th>#</th><th>Store</th><th>Status</th><th>Items</th><th>Total</th><th>Placed</th></tr></thead>\r\n      <tbody>\r\n        <tr v-for=\"o in orders\" :key=\"o.id\">\r\n          <td>#{{ o.id }}</td>\r\n          <td>{{ o.store_name }}</td>\r\n          <td>{{ o.status }}</td>\r\n          <td>{{ o.items_count }}</td>\r\n          <td>₱{{ fmt(o.total_amount) }}</td>\r\n          <td>{{ new Date(o.created_at).toLocaleString() }}</td>\r\n        </tr>\r\n        <tr v-if=\"orders.length===0\"><td colspan=\"6\" class=\"empty\">No orders</td></tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../services/api'\r\nexport default{ name:'CustomerOrders', data(){return{orders:[]}}, async created(){ const {data}=await api.get('/customer/orders'); this.orders=data }, methods:{ fmt(v){ const n=Number(v); return isFinite(n)?n.toFixed(2):'0.00' } } }\r\n</script>\r\n<style scoped>\r\n.page{padding:20px}\r\n.table{width:100%;background:#fff;border-collapse:collapse;border-radius:8px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.06)}\r\n.table th,.table td{padding:10px 12px;border-bottom:1px solid #eee}\r\n.table th{background:#fafafa;text-align:left}\r\n.empty{text-align:center;color:#999}\r\n</style>\r\n"],"mappings":"AAoBA,OAAOA,GAAE,MAAO,iBAAgB;AAChC,eAAc;EAAEC,IAAI,EAAC,gBAAgB;EAAEC,IAAIA,CAAA,EAAE;IAAC,OAAM;MAACC,MAAM,EAAC;IAAE,CAAC;EAAA,CAAC;EAAE,MAAMC,OAAOA,CAAA,EAAE;IAAE,MAAM;MAACF;IAAI,CAAC,GAAC,MAAMF,GAAG,CAACK,GAAG,CAAC,kBAAkB,CAAC;IAAE,IAAI,CAACF,MAAM,GAACD,IAAG;EAAE,CAAC;EAAEI,OAAO,EAAC;IAAEC,GAAGA,CAACC,CAAC,EAAC;MAAE,MAAMC,CAAC,GAACC,MAAM,CAACF,CAAC,CAAC;MAAE,OAAOG,QAAQ,CAACF,CAAC,CAAC,GAACA,CAAC,CAACG,OAAO,CAAC,CAAC,CAAC,GAAC,MAAK;IAAE;EAAE;AAAE","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}