{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/esnext.json.parse.js\";\nimport StorePOS from './store/POS.vue';\nexport default {\n  name: 'PosDashboard',\n  components: {\n    StorePOS\n  },\n  computed: {\n    user() {\n      return JSON.parse(localStorage.getItem('user') || '{}');\n    }\n  },\n  methods: {\n    handleLogout() {\n      this.$store.dispatch('logout');\n      this.$router.push('/admin/login');\n    }\n  }\n};","map":{"version":3,"names":["StorePOS","name","components","computed","user","JSON","parse","localStorage","getItem","methods","handleLogout","$store","dispatch","$router","push"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\frontend\\src\\views\\PosDashboard.vue"],"sourcesContent":["<template>\r\n  <div class=\"pos-shell\">\r\n    <header class=\"topbar\">\r\n      <div class=\"title-wrap\">\r\n        <span class=\"eyebrow\">Point of Sale</span>\r\n        <h2>{{ user.store_name || 'Store' }} POS</h2>\r\n        <p>{{ user.store_name || 'Jubilee Kadiwa' }} • POS Account</p>\r\n      </div>\r\n      <button class=\"logout-btn\" @click=\"handleLogout\">Logout</button>\r\n    </header>\r\n\r\n    <div class=\"content\">\r\n      <StorePOS />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport StorePOS from './store/POS.vue'\r\n\r\nexport default {\r\n  name: 'PosDashboard',\r\n  components: { StorePOS },\r\n  computed: {\r\n    user() {\r\n      return JSON.parse(localStorage.getItem('user') || '{}')\r\n    }\r\n  },\r\n  methods: {\r\n    handleLogout() {\r\n      this.$store.dispatch('logout')\r\n      this.$router.push('/admin/login')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.pos-shell {\r\n  min-height: 100vh;\r\n  padding: 20px;\r\n  background:\r\n    radial-gradient(circle at 0% 0%, rgba(124, 179, 66, 0.15), transparent 40%),\r\n    radial-gradient(circle at 100% 100%, rgba(76, 125, 50, 0.14), transparent 42%),\r\n    