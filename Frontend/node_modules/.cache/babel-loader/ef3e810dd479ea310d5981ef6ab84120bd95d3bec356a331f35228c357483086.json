{"ast":null,"code":"import api from '../../services/api';\nexport default {\n  name: 'AdminIntegrityRecords',\n  data() {\n    return {\n      saving: false,\n      verifying: false,\n      createdRecord: null,\n      verifyResult: null,\n      records: [],\n      verify: {\n        recordRef: '',\n        target: 'customer'\n      },\n      form: {\n        customer: {\n          name: '',\n          email: '',\n          address: ''\n        },\n        document: {\n          mime_type: 'text/plain',\n          filename: 'report.txt',\n          text: '',\n          content_base64: ''\n        }\n      }\n    };\n  },\n  created() {\n    this.loadRecords();\n  },\n  methods: {\n    async createRecord() {\n      this.saving = true;\n      this.createdRecord = null;\n      try {\n        const payload = {\n          customer: {\n            name: this.form.customer.name,\n            email: this.form.customer.email,\n            address: this.form.customer.address\n          },\n          document: {\n            filename: this.form.document.filename,\n            mime_type: this.form.document.mime_type,\n            text: this.form.document.mime_type === 'text/plain' ? this.form.document.text : undefined,\n            content_base64: this.form.document.mime_type === 'application/pdf' ? this.form.document.content_base64 : undefined\n          }\n        };\n        const {\n          data\n        } = await api.post('/admin/integrity/records', payload);\n        this.createdRecord = data;\n        this.verify.recordRef = data.record_ref || '';\n        await this.loadRecords();\n      } catch (err) {\n        alert(err?.response?.data?.message || 'Failed to create secured record');\n      } finally {\n        this.saving = false;\n      }\n    },\n    async verifyRecord() {\n      if (!this.verify.recordRef) return;\n      this.verifying = true;\n      this.verifyResult = null;\n      try {\n        const {\n          data\n        } = await api.get(`/admin/integrity/records/${encodeURIComponent(this.verify.recordRef)}/verify`, {\n          params: {\n            target: this.verify.target\n          }\n        });\n        this.verifyResult = data;\n      } catch (err) {\n        alert(err?.response?.data?.message || 'Failed to verify integrity');\n      } finally {\n        this.verifying = false;\n      }\n    },\n    async loadRecords() {\n      try {\n        const {\n          data\n        } = await api.get('/admin/integrity/records', {\n          params: {\n            limit: 50\n          }\n        });\n        this.records = Array.isArray(data) ? data : [];\n      } catch (err) {\n        console.error('Failed to load integrity records', err);\n      }\n    },\n    pickRecord(row) {\n      this.verify.recordRef = row.record_ref;\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","saving","verifying","createdRecord","verifyResult","records","verify","recordRef","target","form","customer","email","address","document","mime_type","filename","text","content_base64","created","loadRecords","methods","createRecord","payload","undefined","post","record_ref","err","alert","response","message","verifyRecord","get","encodeURIComponent","params","limit","Array","isArray","console","error","pickRecord","row"],"sources":["/var/www/kadiwa/Frontend/src/views/admin/IntegrityRecords.vue"],"sourcesContent":["<template>\r\n  <div class=\"integrity-page\">\r\n    <h2>Blockchain Integrity Records</h2>\r\n\r\n    <section class=\"panel\">\r\n      <h3>Create Secured Record</h3>\r\n      <form class=\"form\" @submit.prevent=\"createRecord\">\r\n        <label>\r\n          Customer Name\r\n          <input v-model=\"form.customer.name\" required placeholder=\"Customer full name\" />\r\n        </label>\r\n        <label>\r\n          Customer Email\r\n          <input v-model=\"form.customer.email\" type=\"email\" required placeholder=\"Customer email\" />\r\n        </label>\r\n        <label>\r\n          Customer Address\r\n          <input v-model=\"form.customer.address\" required placeholder=\"Customer address\" />\r\n        </label>\r\n\r\n        <label>\r\n          Document Type\r\n          <select v-model=\"form.document.mime_type\">\r\n            <option value=\"text/plain\">Text</option>\r\n            <option value=\"application/pdf\">PDF (Base64)</option>\r\n          </select>\r\n        </label>\r\n        <label>\r\n          Document Filename\r\n          <input v-model=\"form.document.filename\" required placeholder=\"report.txt or report.pdf\" />\r\n        </label>\r\n\r\n        <label v-if=\"form.document.mime_type==='text/plain'\" class=\"full\">\r\n          Document Text Content\r\n          <textarea v-model=\"form.document.text\" rows=\"5\" placeholder=\"Paste report text content\"></textarea>\r\n        </label>\r\n\r\n        <label v-else class=\"full\">\r\n          Document Base64 Content\r\n          <textarea v-model=\"form.document.content_base64\" rows=\"5\" placeholder=\"Paste PDF file base64 content\"></textarea>\r\n        </label>\r\n\r\n        <div class=\"actions full\">\r\n          <button :disabled=\"saving\">{{ saving ? 'Securing...' : 'Encrypt + Anchor' }}</button>\r\n        </div>\r\n      </form>\r\n\r\n      <div v-if=\"createdRecord\" class=\"result ok\">\r\n        Created: {{ createdRecord.record_ref }}\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"panel\">\r\n      <h3>Verify Integrity</h3>\r\n      <div class=\"verify-row\">\r\n        <input v-model=\"verify.recordRef\" placeholder=\"Record Ref (e.g. REC-...)\" />\r\n        <select v-model=\"verify.target\">\r\n          <option value=\"customer\">Customer Data</option>\r\n          <option value=\"document\">Document</option>\r\n        </select>\r\n        <button :disabled=\"verifying\" @click=\"verifyRecord\">{{ verifying ? 'Verifying...' : 'Verify' }}</button>\r\n      </div>\r\n      <div v-if=\"verifyResult\" class=\"result\" :class=\"verifyResult.is_valid ? 'ok' : 'warn'\">\r\n        {{ verifyResult.is_valid ? 'Valid integrity ✅' : 'Integrity mismatch ⚠️' }}\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"panel\">\r\n      <div class=\"section-head\">\r\n        <h3>Recent Records</h3>\r\n        <button class=\"secondary\" @click=\"loadRecords\">Refresh</button>\r\n      </div>\r\n      <div class=\"table-wrap\"><table class=\"table\">\r\n        <thead>\r\n          <tr>\r\n            <th>Record Ref</th>\r\n            <th>Customer Chain</th>\r\n            <th>Document Chain</th>\r\n            <th>Created</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"row in records\" :key=\"row.id\" @click=\"pickRecord(row)\" class=\"clickable\">\r\n            <td>{{ row.record_ref }}</td>\r\n            <td>{{ row.customer_provider }}{{ row.customer_tx_id ? ` (${row.customer_tx_id})` : '' }}</td>\r\n            <td>{{ row.document_provider }}{{ row.document_tx_id ? ` (${row.document_tx_id})` : '' }}</td>\r\n            <td>{{ new Date(row.created_at).toLocaleString() }}</td>\r\n          </tr>\r\n          <tr v-if=\"!records.length\"><td colspan=\"4\" class=\"empty\">No records yet</td></tr>\r\n        </tbody>\r\n      </table></div>\r\n    </section>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\n\r\nexport default {\r\n  name: 'AdminIntegrityRecords',\r\n  data() {\r\n    return {\r\n      saving: false,\r\n      verifying: false,\r\n      createdRecord: null,\r\n      verifyResult: null,\r\n      records: [],\r\n      verify: {\r\n        recordRef: '',\r\n        target: 'customer'\r\n      },\r\n      form: {\r\n        customer: {\r\n          name: '',\r\n          email: '',\r\n          address: ''\r\n        },\r\n        document: {\r\n          mime_type: 'text/plain',\r\n          filename: 'report.txt',\r\n          text: '',\r\n          content_base64: ''\r\n        }\r\n      }\r\n    }\r\n  },\r\n  created() {\r\n    this.loadRecords()\r\n  },\r\n  methods: {\r\n    async createRecord() {\r\n      this.saving = true\r\n      this.createdRecord = null\r\n      try {\r\n        const payload = {\r\n          customer: {\r\n            name: this.form.customer.name,\r\n            email: this.form.customer.email,\r\n            address: this.form.customer.address\r\n          },\r\n          document: {\r\n            filename: this.form.document.filename,\r\n            mime_type: this.form.document.mime_type,\r\n            text: this.form.document.mime_type === 'text/plain' ? this.form.document.text : undefined,\r\n            content_base64: this.form.document.mime_type === 'application/pdf' ? this.form.document.content_base64 : undefined\r\n          }\r\n        }\r\n\r\n        const { data } = await api.post('/admin/integrity/records', payload)\r\n        this.createdRecord = data\r\n        this.verify.recordRef = data.record_ref || ''\r\n        await this.loadRecords()\r\n      } catch (err) {\r\n        alert(err?.response?.data?.message || 'Failed to create secured record')\r\n      } finally {\r\n        this.saving = false\r\n      }\r\n    },\r\n    async verifyRecord() {\r\n      if (!this.verify.recordRef) return\r\n      this.verifying = true\r\n      this.verifyResult = null\r\n      try {\r\n        const { data } = await api.get(`/admin/integrity/records/${encodeURIComponent(this.verify.recordRef)}/verify`, {\r\n          params: { target: this.verify.target }\r\n        })\r\n        this.verifyResult = data\r\n      } catch (err) {\r\n        alert(err?.response?.data?.message || 'Failed to verify integrity')\r\n      } finally {\r\n        this.verifying = false\r\n      }\r\n    },\r\n    async loadRecords() {\r\n      try {\r\n        const { data } = await api.get('/admin/integrity/records', { params: { limit: 50 } })\r\n        this.records = Array.isArray(data) ? data : []\r\n      } catch (err) {\r\n        console.error('Failed to load integrity records', err)\r\n      }\r\n    },\r\n    pickRecord(row) {\r\n      this.verify.recordRef = row.record_ref\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.integrity-page{display:grid;gap:12px}\r\n.panel{background:#fff;border-radius:8px;padding:12px;box-shadow:0 4px 14px rgba(56,92,35,.08)}\r\nh2,h3{margin:0 0 8px}\r\n.form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}\r\n.form label{display:grid;gap:4px;font-size:12px;color:#5f6f53}\r\n.form .full{grid-column:1/-1}\r\n.verify-row{display:grid;grid-template-columns:1fr 180px auto;gap:8px}\r\n.table{width:100%;border-collapse:collapse}\r\n.table th,.table td{padding:8px;border-bottom:1px solid #e6eddc;text-align:left}\r\n.table th{background:#f4f8ee}\r\n.clickable{cursor:pointer}\r\n.clickable:hover td{background:#f7fbf1}\r\n.result{margin-top:8px;padding:8px;border-radius:6px;font-weight:600}\r\n.result.ok{background:#edf8e3;color:#2f5a23}\r\n.result.warn{background:#fff0ea;color:#8f3d1e}\r\n.section-head{display:flex;justify-content:space-between;align-items:center;gap:8px}\r\n.empty{text-align:center;color:#6f7d67}\r\ninput,select,textarea{border:1px solid #cddbb9;border-radius:6px;padding:8px;background:#fff}\r\nbutton{background:linear-gradient(135deg,#7CB342,#4E7D32);color:#fff;border:none;padding:8px 12px;border-radius:6px;cursor:pointer}\r\nbutton.secondary{background:#f8fbf4;color:#2f5a23;border:1px solid #cddbb9}\r\nbutton:disabled{opacity:.6;cursor:not-allowed}\r\n@media (max-width:900px){\r\n  .form{grid-template-columns:1fr}\r\n  .verify-row{grid-template-columns:1fr}\r\n}\r\n\n/* mobile-dashboard-fix */\n.table-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}\n.table-wrap .table, table.table{width:100%}\n@media (max-width: 640px){\n  .toolbar,.filters,.head,.section-head,.graph-head,.forecast-tools,.reports-header,.form{flex-wrap:wrap}\n  .toolbar,.filters,.head,.section-head{display:flex;gap:8px}\n  .toolbar input,.search-input,input[type=\"search\"],.search{min-width:0!important;width:100%;max-width:100%}\n  .table-wrap .table, table.table{min-width:560px}\n  .btn,button.primary,button.save-btn{min-height:40px}\n  .barangay-row{flex-direction:column;align-items:stretch!important}\n  .map{height:260px!important}\n  .details-grid{grid-template-columns:1fr!important}\n  .card,.form{max-width:100%}\n}\n</style>\r\n"],"mappings":"AAgGA,OAAOA,GAAE,MAAO,oBAAmB;AAEnC,eAAe;EACbC,IAAI,EAAE,uBAAuB;EAC7BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE,KAAK;MACbC,SAAS,EAAE,KAAK;MAChBC,aAAa,EAAE,IAAI;MACnBC,YAAY,EAAE,IAAI;MAClBC,OAAO,EAAE,EAAE;MACXC,MAAM,EAAE;QACNC,SAAS,EAAE,EAAE;QACbC,MAAM,EAAE;MACV,CAAC;MACDC,IAAI,EAAE;QACJC,QAAQ,EAAE;UACRX,IAAI,EAAE,EAAE;UACRY,KAAK,EAAE,EAAE;UACTC,OAAO,EAAE;QACX,CAAC;QACDC,QAAQ,EAAE;UACRC,SAAS,EAAE,YAAY;UACvBC,QAAQ,EAAE,YAAY;UACtBC,IAAI,EAAE,EAAE;UACRC,cAAc,EAAE;QAClB;MACF;IACF;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,WAAW,CAAC;EACnB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,YAAYA,CAAA,EAAG;MACnB,IAAI,CAACpB,MAAK,GAAI,IAAG;MACjB,IAAI,CAACE,aAAY,GAAI,IAAG;MACxB,IAAI;QACF,MAAMmB,OAAM,GAAI;UACdZ,QAAQ,EAAE;YACRX,IAAI,EAAE,IAAI,CAACU,IAAI,CAACC,QAAQ,CAACX,IAAI;YAC7BY,KAAK,EAAE,IAAI,CAACF,IAAI,CAACC,QAAQ,CAACC,KAAK;YAC/BC,OAAO,EAAE,IAAI,CAACH,IAAI,CAACC,QAAQ,CAACE;UAC9B,CAAC;UACDC,QAAQ,EAAE;YACRE,QAAQ,EAAE,IAAI,CAACN,IAAI,CAACI,QAAQ,CAACE,QAAQ;YACrCD,SAAS,EAAE,IAAI,CAACL,IAAI,CAACI,QAAQ,CAACC,SAAS;YACvCE,IAAI,EAAE,IAAI,CAACP,IAAI,CAACI,QAAQ,CAACC,SAAQ,KAAM,YAAW,GAAI,IAAI,CAACL,IAAI,CAACI,QAAQ,CAACG,IAAG,GAAIO,SAAS;YACzFN,cAAc,EAAE,IAAI,CAACR,IAAI,CAACI,QAAQ,CAACC,SAAQ,KAAM,iBAAgB,GAAI,IAAI,CAACL,IAAI,CAACI,QAAQ,CAACI,cAAa,GAAIM;UAC3G;QACF;QAEA,MAAM;UAAEvB;QAAK,IAAI,MAAMF,GAAG,CAAC0B,IAAI,CAAC,0BAA0B,EAAEF,OAAO;QACnE,IAAI,CAACnB,aAAY,GAAIH,IAAG;QACxB,IAAI,CAACM,MAAM,CAACC,SAAQ,GAAIP,IAAI,CAACyB,UAAS,IAAK,EAAC;QAC5C,MAAM,IAAI,CAACN,WAAW,CAAC;MACzB,EAAE,OAAOO,GAAG,EAAE;QACZC,KAAK,CAACD,GAAG,EAAEE,QAAQ,EAAE5B,IAAI,EAAE6B,OAAM,IAAK,iCAAiC;MACzE,UAAU;QACR,IAAI,CAAC5B,MAAK,GAAI,KAAI;MACpB;IACF,CAAC;IACD,MAAM6B,YAAYA,CAAA,EAAG;MACnB,IAAI,CAAC,IAAI,CAACxB,MAAM,CAACC,SAAS,EAAE;MAC5B,IAAI,CAACL,SAAQ,GAAI,IAAG;MACpB,IAAI,CAACE,YAAW,GAAI,IAAG;MACvB,IAAI;QACF,MAAM;UAAEJ;QAAK,IAAI,MAAMF,GAAG,CAACiC,GAAG,CAAC,4BAA4BC,kBAAkB,CAAC,IAAI,CAAC1B,MAAM,CAACC,SAAS,CAAC,SAAS,EAAE;UAC7G0B,MAAM,EAAE;YAAEzB,MAAM,EAAE,IAAI,CAACF,MAAM,CAACE;UAAO;QACvC,CAAC;QACD,IAAI,CAACJ,YAAW,GAAIJ,IAAG;MACzB,EAAE,OAAO0B,GAAG,EAAE;QACZC,KAAK,CAACD,GAAG,EAAEE,QAAQ,EAAE5B,IAAI,EAAE6B,OAAM,IAAK,4BAA4B;MACpE,UAAU;QACR,IAAI,CAAC3B,SAAQ,GAAI,KAAI;MACvB;IACF,CAAC;IACD,MAAMiB,WAAWA,CAAA,EAAG;MAClB,IAAI;QACF,MAAM;UAAEnB;QAAK,IAAI,MAAMF,GAAG,CAACiC,GAAG,CAAC,0BAA0B,EAAE;UAAEE,MAAM,EAAE;YAAEC,KAAK,EAAE;UAAG;QAAE,CAAC;QACpF,IAAI,CAAC7B,OAAM,GAAI8B,KAAK,CAACC,OAAO,CAACpC,IAAI,IAAIA,IAAG,GAAI,EAAC;MAC/C,EAAE,OAAO0B,GAAG,EAAE;QACZW,OAAO,CAACC,KAAK,CAAC,kCAAkC,EAAEZ,GAAG;MACvD;IACF,CAAC;IACDa,UAAUA,CAACC,GAAG,EAAE;MACd,IAAI,CAAClC,MAAM,CAACC,SAAQ,GAAIiC,GAAG,CAACf,UAAS;IACvC;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}