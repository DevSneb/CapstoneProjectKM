{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport api from '../../services/api';\nexport default {\n  name: 'StoreReports',\n  data() {\n    const today = new Date();\n    const to = today.toISOString().slice(0, 10);\n    const fromDate = new Date();\n    fromDate.setDate(today.getDate() - 30);\n    const from = fromDate.toISOString().slice(0, 10);\n    return {\n      from,\n      to,\n      period: 'monthly',\n      activeTab: 'overview',\n      daily: [],\n      orders: [],\n      latestSubmissionId: null\n    };\n  },\n  computed: {\n    formattedRange() {\n      if (!this.from && !this.to) return 'No range selected';\n      const start = this.from ? new Date(this.from).toLocaleDateString() : 'Start';\n      const end = this.to ? new Date(this.to).toLocaleDateString() : 'End';\n      return `${start} - ${end}`;\n    },\n    deliveredRevenue() {\n      return this.daily.filter(d => String(d.channel) === 'delivered').reduce((sum, d) => sum + Number(d.revenue || 0), 0);\n    },\n    pickupRevenue() {\n      return this.daily.filter(d => String(d.channel) === 'pickup').reduce((sum, d) => sum + Number(d.revenue || 0), 0);\n    }\n  },\n  created() {\n    this.fetchAll();\n  },\n  methods: {\n    channelLabel(channel) {\n      return String(channel) === 'pickup' ? 'Pickup' : 'Delivered';\n    },\n    setQuickRange(days) {\n      const end = new Date();\n      const start = new Date();\n      start.setDate(end.getDate() - days);\n      this.from = start.toISOString().slice(0, 10);\n      this.to = end.toISOString().slice(0, 10);\n      this.fetchAll();\n    },\n    async fetchAll() {\n      const params = {\n        from: this.from,\n        to: this.to\n      };\n      const dailyRes = await api.get('/store/reports/sales', {\n        params\n      });\n      this.daily = dailyRes.data || [];\n      const ordersRes = await api.get('/store/reports/orders', {\n        params\n      });\n      this.orders = ordersRes.data || [];\n    },\n    async generatePdfReport() {\n      try {\n        const res = await api.post('/store/reports/generate-pdf', {\n          period: this.period,\n          from: this.from,\n          to: this.to\n        }, {\n          responseType: 'blob'\n        });\n        const disposition = res.headers?.['content-disposition'] || '';\n        const match = disposition.match(/filename=\"?([^\";]+)\"?/i);\n        const filename = match && match[1] ? match[1] : `sales_report_${this.from}_to_${this.to}.pdf`;\n        const mimeType = res.headers?.['content-type'] || 'application/pdf';\n        const blob = new Blob([res.data], {\n          type: mimeType\n        });\n        const url = URL.createObjectURL(blob);\n        const anchor = document.createElement('a');\n        anchor.href = url;\n        anchor.download = filename;\n        anchor.click();\n        URL.revokeObjectURL(url);\n      } catch (err) {\n        alert(err.response?.data?.message || 'Failed to generate PDF report');\n      }\n    },\n    async downloadExcelForm() {\n      try {\n        const res = await api.get('/store/reports/da-excel-form', {\n          params: {\n            from: this.from,\n            to: this.to\n          },\n          responseType: 'blob'\n        });\n        const disposition = res.headers?.['content-disposition'] || '';\n        const m = disposition.match(/filename=\"?([^\";]+)\"?/i);\n        const filename = m && m[1] ? m[1] : `KADIWA-Sales-Report-Form_${new Date().toISOString().slice(0, 10)}.xlsx`;\n        const mimeType = res.headers?.['content-type'] || 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';\n        const blob = new Blob([res.data], {\n          type: mimeType\n        });\n        const url = URL.createObjectURL(blob);\n        const a = document.createElement('a');\n        a.href = url;\n        a.download = filename;\n        a.click();\n        URL.revokeObjectURL(url);\n      } catch (err) {\n        alert(err.response?.data?.message || 'Failed to download Excel form');\n      }\n    },\n    async submitReportToDa() {\n      if (!confirm('Are you sure you want to submit this report to DA? This will be recorded in the system.')) return;\n      try {\n        const {\n          data\n        } = await api.post('/store/reports/submit-to-da', {\n          period: this.period,\n          from: this.from,\n          to: this.to\n        });\n        alert('Report submitted to DA successfully! Submission ID: ' + data?.submission_id);\n      } catch (err) {\n        alert(err.response?.data?.message || 'Failed to submit report to DA');\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","today","Date","to","toISOString","slice","fromDate","setDate","getDate","from","period","activeTab","daily","orders","latestSubmissionId","computed","formattedRange","start","toLocaleDateString","end","deliveredRevenue","filter","d","String","channel","reduce","sum","Number","revenue","pickupRevenue","created","fetchAll","methods","channelLabel","setQuickRange","days","params","dailyRes","get","ordersRes","generatePdfReport","res","post","responseType","disposition","headers","match","filename","mimeType","blob","Blob","type","url","URL","createObjectURL","anchor","document","createElement","href","download","click","revokeObjectURL","err","alert","response","message","downloadExcelForm","m","a","submitReportToDa","confirm","submission_id"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\store\\Reports.vue"],"sourcesContent":["<template>\r\n  <div class=\"reports-page\">\r\n    <header class=\"reports-header\">\r\n      <div>\r\n        <p class=\"eyebrow\">KADIWA Store Reports</p>\r\n        <h2>Sales Reports</h2>\r\n        <p class=\"page-note\">Review sales trends, prepare the DA submission, and export the current range from one place.</p>\r\n      </div>\r\n      <div class=\"range-chip\">\r\n        <span>Range</span>\r\n        <strong>{{ formattedRange }}</strong>\r\n      </div>\r\n    </header>\r\n\r\n    <section class=\"panel controls-panel\">\r\n      <div class=\"panel-head\">\r\n        <div>\r\n          <h3>Report Filters</h3>\r\n          <p>Adjust the date range before loading the report data.</p>\r\n        </div>\r\n      </div>\r\n      <div class=\"filters\">\r\n        <label>From <input type=\"date\" v-model=\"from\" /></label>\r\n        <label>To <input type=\"date\" v-model=\"to\" /></label>\r\n        <label>Period\r\n          <select v-model=\"period\">\r\n            <option value=\"weekly\">Weekly</option>\r\n            <option value=\"monthly\">Monthly</option>\r\n            <option value=\"yearly\">Yearly</option>\r\n          </select>\r\n        </label>\r\n        <div class=\"action-row\">\r\n          <button class=\"primary\" @click=\"fetchAll\">Apply</button>\r\n          <button class=\"secondary\" @click=\"generatePdfReport\">Generate PDF</button>\r\n          <button class=\"secondary\" @click=\"downloadExcelForm\">Download Excel</button>\r\n          <button class=\"success\" @click=\"submitReportToDa\">Submit Report to DA</button>\r\n        </div>\r\n        <div class=\"preset-row\">\r\n          <button type=\"button\" class=\"preset\" @click=\"setQuickRange(7)\">7 Days</button>\r\n          <button type=\"button\" class=\"preset\" @click=\"setQuickRange(30)\">30 Days</button>\r\n          <button type=\"button\" class=\"preset\" @click=\"setQuickRange(90)\">90 Days</button>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"summary-grid\">\r\n      <button type=\"button\" class=\"summary-card accent\" :class=\"{ active: activeTab === 'revenue' }\" @click=\"activeTab = 'revenue'\">\r\n        <span>Delivered Sales</span>\r\n        <strong>₱{{ deliveredRevenue.toFixed(2) }}</strong>\r\n        <small>Revenue from delivered orders</small>\r\n      </button>\r\n      <button type=\"button\" class=\"summary-card\" :class=\"{ active: activeTab === 'revenue' }\" @click=\"activeTab = 'revenue'\">\r\n        <span>Pickup Sales</span>\r\n        <strong>₱{{ pickupRevenue.toFixed(2) }}</strong>\r\n        <small>Revenue from pickup orders</small>\r\n      </button>\r\n      <button type=\"button\" class=\"summary-card\" :class=\"{ active: activeTab === 'orders' }\" @click=\"activeTab = 'orders'\">\r\n        <span>Total Orders</span>\r\n        <strong>{{ orders.length }}</strong>\r\n        <small>Delivered orders in the selected range</small>\r\n      </button>\r\n    </section>\r\n\r\n    <section class=\"tab-bar\" aria-label=\"Report views\">\r\n      <button type=\"button\" class=\"tab-button\" :class=\"{ active: activeTab === 'overview' }\" @click=\"activeTab = 'overview'\">Overview</button>\r\n      <button type=\"button\" class=\"tab-button\" :class=\"{ active: activeTab === 'revenue' }\" @click=\"activeTab = 'revenue'\">Daily Revenue</button>\r\n      <button type=\"button\" class=\"tab-button\" :class=\"{ active: activeTab === 'orders' }\" @click=\"activeTab = 'orders'\">Finalized Orders</button>\r\n    </section>\r\n\r\n    <section v-show=\"activeTab !== 'orders'\" class=\"panel report-panel\" :class=\"{ focus: activeTab === 'revenue' }\">\r\n      <div class=\"panel-head\">\r\n        <div>\r\n          <h3>Daily Revenue</h3>\r\n          <p>Delivered and pickup revenue are shown side by side for easier comparison.</p>\r\n        </div>\r\n      </div>\r\n      <div class=\"table-wrap\">\r\n        <table class=\"table\">\r\n          <thead><tr><th>Day</th><th>Channel</th><th>Orders</th><th>Revenue</th></tr></thead>\r\n          <tbody>\r\n            <tr v-for=\"d in daily\" :key=\"`${d.day}-${d.channel}`\">\r\n              <td>{{ new Date(d.day).toLocaleDateString() }}</td>\r\n              <td>{{ channelLabel(d.channel) }}</td>\r\n              <td>{{ d.orders }}</td>\r\n              <td>₱{{ Number(d.revenue).toFixed(2) }}</td>\r\n            </tr>\r\n            <tr v-if=\"daily.length===0\"><td colspan=\"4\" class=\"empty\">No data for the selected range.</td></tr>\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n    </section>\r\n\r\n    <section v-show=\"activeTab !== 'revenue'\" class=\"panel report-panel\" :class=\"{ focus: activeTab === 'orders' }\">\r\n      <div class=\"panel-head\">\r\n        <div>\r\n          <h3>Finalized Orders</h3>\r\n          <p>Delivered orders with shipping and payment details for quick review.</p>\r\n        </div>\r\n      </div>\r\n      <div class=\"table-wrap large-table\">\r\n        <table class=\"table\">\r\n          <thead><tr><th>ID</th><th>Date</th><th>Customer</th><th>Channel</th><th>Shipping</th><th>Payment</th><th>Delivery Fee</th><th>Total</th></tr></thead>\r\n          <tbody>\r\n            <tr v-for=\"o in orders\" :key=\"o.id\">\r\n              <td>#{{ o.id }}</td>\r\n              <td>{{ new Date(o.created_at).toLocaleString() }}</td>\r\n              <td>{{ o.customer_name || '—' }}</td>\r\n              <td>{{ channelLabel(o.channel) }}</td>\r\n              <td>{{ o.shipping_method }}</td>\r\n              <td>{{ o.payment_method }}</td>\r\n              <td>₱{{ Number(o.delivery_fee||0).toFixed(2) }}</td>\r\n              <td>₱{{ Number(o.total_amount).toFixed(2) }}</td>\r\n            </tr>\r\n            <tr v-if=\"orders.length===0\"><td colspan=\"8\" class=\"empty\">No orders for the selected range.</td></tr>\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n    </section>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../../services/api'\r\nexport default {\r\n  name:'StoreReports',\r\n  data(){\r\n    const today = new Date();\r\n    const to = today.toISOString().slice(0,10);\r\n    const fromDate = new Date(); fromDate.setDate(today.getDate()-30);\r\n    const from = fromDate.toISOString().slice(0,10);\r\n    return {\r\n      from,\r\n      to,\r\n      period: 'monthly',\r\n      activeTab: 'overview',\r\n      daily: [],\r\n      orders: [],\r\n      latestSubmissionId: null\r\n    }\r\n  },\r\n  computed:{\r\n    formattedRange(){\r\n      if(!this.from && !this.to) return 'No range selected'\r\n      const start = this.from ? new Date(this.from).toLocaleDateString() : 'Start'\r\n      const end = this.to ? new Date(this.to).toLocaleDateString() : 'End'\r\n      return `${start} - ${end}`\r\n    },\r\n    deliveredRevenue(){\r\n      return this.daily\r\n        .filter(d => String(d.channel) === 'delivered')\r\n        .reduce((sum, d) => sum + Number(d.revenue || 0), 0)\r\n    },\r\n    pickupRevenue(){\r\n      return this.daily\r\n        .filter(d => String(d.channel) === 'pickup')\r\n        .reduce((sum, d) => sum + Number(d.revenue || 0), 0)\r\n    }\r\n  },\r\n  created(){ this.fetchAll() },\r\n  methods:{\r\n    channelLabel(channel){\r\n      return String(channel) === 'pickup' ? 'Pickup' : 'Delivered'\r\n    },\r\n    setQuickRange(days){\r\n      const end = new Date()\r\n      const start = new Date()\r\n      start.setDate(end.getDate() - days)\r\n      this.from = start.toISOString().slice(0, 10)\r\n      this.to = end.toISOString().slice(0, 10)\r\n      this.fetchAll()\r\n    },\r\n    async fetchAll(){\r\n      const params = { from: this.from, to: this.to }\r\n      const dailyRes = await api.get('/store/reports/sales',{ params })\r\n      this.daily = dailyRes.data || []\r\n      const ordersRes = await api.get('/store/reports/orders',{ params })\r\n      this.orders = ordersRes.data || []\r\n    },\r\n    async generatePdfReport(){\r\n      try{\r\n        const res = await api.post('/store/reports/generate-pdf', {\r\n          period: this.period,\r\n          from: this.from,\r\n          to: this.to\r\n        }, {\r\n          responseType: 'blob'\r\n        })\r\n\r\n        const disposition = res.headers?.['content-disposition'] || ''\r\n        const match = disposition.match(/filename=\"?([^\";]+)\"?/i)\r\n        const filename = (match && match[1]) ? match[1] : `sales_report_${this.from}_to_${this.to}.pdf`\r\n        const mimeType = res.headers?.['content-type'] || 'application/pdf'\r\n\r\n        const blob = new Blob([res.data], { type: mimeType })\r\n        const url = URL.createObjectURL(blob)\r\n        const anchor = document.createElement('a')\r\n        anchor.href = url\r\n        anchor.download = filename\r\n        anchor.click()\r\n        URL.revokeObjectURL(url)\r\n      }catch(err){\r\n        alert(err.response?.data?.message || 'Failed to generate PDF report')\r\n      }\r\n    },\r\n    async downloadExcelForm(){\r\n      try{\r\n        const res = await api.get('/store/reports/da-excel-form', {\r\n          params: { from: this.from, to: this.to },\r\n          responseType: 'blob'\r\n        })\r\n        const disposition = res.headers?.['content-disposition'] || ''\r\n        const m = disposition.match(/filename=\"?([^\";]+)\"?/i)\r\n        const filename = (m && m[1]) ? m[1] : `KADIWA-Sales-Report-Form_${new Date().toISOString().slice(0,10)}.xlsx`\r\n        const mimeType = res.headers?.['content-type'] || 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'\r\n\r\n        const blob = new Blob([res.data], { type: mimeType })\r\n        const url = URL.createObjectURL(blob)\r\n        const a = document.createElement('a')\r\n        a.href = url\r\n        a.download = filename\r\n        a.click()\r\n        URL.revokeObjectURL(url)\r\n      }catch(err){\r\n        alert(err.response?.data?.message || 'Failed to download Excel form')\r\n      }\r\n    },\r\n    async submitReportToDa(){\r\n      if(!confirm('Are you sure you want to submit this report to DA? This will be recorded in the system.')) return\r\n      try{\r\n        const { data } = await api.post('/store/reports/submit-to-da', { period: this.period, from: this.from, to: this.to })\r\n        alert('Report submitted to DA successfully! Submission ID: ' + data?.submission_id)\r\n      }catch(err){\r\n        alert(err.response?.data?.message || 'Failed to submit report to DA')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n.reports-page{ display:grid; gap:16px; max-width:1200px; margin:0 auto; padding:8px 0 24px }\r\n.reports-header{ display:flex; justify-content:space-between; align-items:flex-end; gap:16px; padding:4px 2px 8px }\r\n.eyebrow{ margin:0 0 6px; font-size:12px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#6b8b4f }\r\n.reports-header h2{ margin:0; font-size:30px; line-height:1.1; color:#20351b }\r\n.page-note{ margin:8px 0 0; color:#62755b; max-width:640px }\r\n.range-chip{ min-width:220px; padding:14px 16px; border-radius:16px; border:1px solid #dce8ce; background:linear-gradient(180deg,#fff,#f6f9f1); box-shadow:0 10px 24px rgba(56,92,35,.08) }\r\n.range-chip span{ display:block; font-size:12px; text-transform:uppercase; letter-spacing:.08em; color:#72876a; margin-bottom:6px }\r\n.range-chip strong{ color:#29401f }\r\n.panel{ border:1px solid #dfe9d2; border-radius:18px; background:#fff; box-shadow:0 12px 30px rgba(56,92,35,.08) }\r\n.panel-head{ display:flex; justify-content:space-between; gap:12px; padding:18px 18px 0 }\r\n.panel-head h3{ margin:0; color:#22351c; font-size:18px }\r\n.panel-head p{ margin:6px 0 0; color:#6a7a62; font-size:13px }\r\n.controls-panel{ padding-bottom:18px }\r\n.filters{ display:grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap:12px; padding:16px 18px 0 }\r\n.action-row{ grid-column:1 / -1; display:flex; gap:10px; flex-wrap:wrap; padding-top:2px }\r\n.preset-row{ grid-column:1 / -1; display:flex; gap:8px; flex-wrap:wrap; padding-top:2px }\r\n.filters label{ display:grid; gap:6px; font-size:12px; color:#607355 }\r\n.filters input,.filters select{ min-height:40px; border:1px solid #cddbb9; border-radius:12px; padding:0 12px; background:#fff; color:#22351c }\r\n.summary-grid{ display:grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap:12px }\r\n.summary-card{ border:1px solid #dfe9d2; border-radius:18px; background:linear-gradient(180deg,#fff,#f7faf3); padding:16px 18px; box-shadow:0 10px 24px rgba(56,92,35,.06); text-align:left; cursor:pointer; transition:transform .15s ease, box-shadow .15s ease, border-color .15s ease }\r\n.summary-card:hover{ transform:translateY(-2px); box-shadow:0 14px 26px rgba(56,92,35,.1) }\r\n.summary-card.active{ border-color:#7CB342; box-shadow:0 0 0 3px rgba(124,179,66,.16), 0 14px 26px rgba(56,92,35,.1) }\r\n.summary-card span{ display:block; color:#6f8166; font-size:13px; margin-bottom:10px }\r\n.summary-card strong{ display:block; color:#20351b; font-size:28px; line-height:1.1 }\r\n.summary-card small{ display:block; margin-top:8px; color:#7b8a74 }\r\n.summary-card.accent{ background:linear-gradient(135deg,#7CB342,#4E7D32); border-color:#4e7d32 }\r\n.summary-card.accent span,.summary-card.accent small,.summary-card.accent strong{ color:#fff }\r\n.summary-card.accent.active{ box-shadow:0 0 0 3px rgba(124,179,66,.22), 0 14px 26px rgba(56,92,35,.14) }\r\n.tab-bar{ display:flex; gap:8px; flex-wrap:wrap }\r\n.tab-button{ min-height:40px; border:1px solid #d9e5cb; background:#f7faf3; color:#4b6241; padding:0 14px; border-radius:999px; cursor:pointer; font-weight:600; transition:transform .15s ease, background .15s ease, color .15s ease, border-color .15s ease }\r\n.tab-button:hover{ transform:translateY(-1px) }\r\n.tab-button.active{ background:linear-gradient(135deg,#7CB342,#4E7D32); color:#fff; border-color:#4e7d32 }\r\n.report-panel{ padding-bottom:6px }\r\n.report-panel.focus{ border-color:#7CB342; box-shadow:0 0 0 3px rgba(124,179,66,.12), 0 14px 28px rgba(56,92,35,.1) }\r\n.table-wrap{ overflow:auto; border-top:1px solid #edf2e3; margin-top:16px; border-radius:0 0 18px 18px }\r\n.large-table{ max-height:420px }\r\n.table{ width:100%; border-collapse:collapse; min-width:720px }\r\n.table thead th{ position:sticky; top:0; z-index:2; background:#f4f8ee }\r\n.table th,.table td{ padding:12px 14px; border-bottom:1px solid #e6eddc; text-align:left; vertical-align:top }\r\n.table tbody tr:hover{ background:rgba(124,179,66,.08) }\r\n.empty{ text-align:center; color:#6f7d67; padding:18px 12px }\r\n.primary,.secondary,.success{ min-height:40px; border:none; padding:0 14px; border-radius:12px; cursor:pointer; font-weight:600; transition:transform .15s ease, box-shadow .15s ease, filter .15s ease }\r\n.primary{ background:linear-gradient(135deg,#7CB342,#4E7D32); color:#fff; box-shadow:0 10px 18px rgba(78,125,50,.18) }\r\n.secondary{ background:#eef4e2; color:#355e2a }\r\n.success{ background:linear-gradient(135deg,#5ab65f,#399a3f); color:#fff; box-shadow:0 10px 18px rgba(57,154,63,.16) }\r\n.preset{ min-height:34px; border:1px solid #d9e5cb; background:#f7faf3; color:#4b6241; border-radius:999px; padding:0 12px; cursor:pointer; font-weight:600; transition:transform .15s ease, border-color .15s ease, background .15s ease }\r\n.preset:hover{ transform:translateY(-1px); border-color:#7CB342; background:#eef5e4 }\r\n.primary:hover,.secondary:hover,.success:hover{ transform:translateY(-1px) }\r\n.primary:active,.secondary:active,.success:active{ transform:translateY(0) }\r\n.filters input:focus,.filters select:focus{ outline:none; border-color:#7CB342; box-shadow:0 0 0 3px rgba(124,179,66,.15) }\r\n\r\n@media (max-width: 960px){\r\n  .reports-header,.panel-head{ flex-direction:column; align-items:flex-start }\r\n  .filters,.summary-grid{ grid-template-columns:1fr }\r\n  .action-row{ flex-direction:column }\r\n  .action-row button,.preset-row button{ width:100% }\r\n  .range-chip{ width:100% }\r\n}\r\n</style>\r\n"],"mappings":";;;;;;AAyHA,OAAOA,GAAE,MAAO,oBAAmB;AACnC,eAAe;EACbC,IAAI,EAAC,cAAc;