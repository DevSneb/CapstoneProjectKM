{"ast":null,"code":"import \"core-js/modules/es.json.stringify.js\";\nimport api from '../services/api';\nimport { readAuth } from '../services/authStorage';\nexport default {\n  name: 'CustomerSettings',\n  data() {\n    return {\n      form: {\n        full_name: '',\n        phone: '',\n        address: ''\n      },\n      saving: false\n    };\n  },\n  async created() {\n    const {\n      user\n    } = readAuth('customer');\n    if (user) {\n      this.form.full_name = user.full_name || '';\n      this.form.phone = user.phone || '';\n      this.form.address = user.address || '';\n    }\n    await this.loadProfile();\n  },\n  methods: {\n    async loadProfile() {\n      try {\n        const {\n          data\n        } = await api.get('/customer/account/profile');\n        const user = data?.user;\n        if (!user) return;\n        this.form.full_name = user.full_name || '';\n        this.form.phone = user.phone || '';\n        this.form.address = user.address || '';\n        this.$store.commit('SET_USER', user);\n        localStorage.setItem('user', JSON.stringify(user));\n      } catch (err) {\n        console.error('Failed to load profile', err);\n      }\n    },\n    async save() {\n      this.saving = true;\n      try {\n        const {\n          data\n        } = await api.put('/customer/account/profile', this.form);\n        const {\n          token\n        } = readAuth('customer');\n        this.$store.dispatch('login', {\n          user: data.user,\n          token\n        });\n        alert('Profile updated');\n      } catch (err) {\n        alert(err.response?.data?.message || 'Failed to save');\n      } finally {\n        this.saving = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","readAuth","name","data","form","full_name","phone","address","saving","created","user","loadProfile","methods","get","$store","commit","localStorage","setItem","JSON","stringify","err","console","error","save","put","token","dispatch","alert","res