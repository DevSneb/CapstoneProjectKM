{"ast":null,"code":"import api from '../../services/api';\nimport loadGoogleMaps from '../../services/googleMapsLoader';\nconst CALAPAN = {\n  lat: 13.4117,\n  lng: 121.1803\n};\nexport default {\n  name: 'StoreAccountLocation',\n  data() {\n    return {\n      latitude: null,\n      longitude: null,\n      address: '',\n      mapInstance: null,\n      markerInstance: null,\n      mapTypeId: 'roadmap',\n      mapError: '',\n      saving: false\n    };\n  },\n  computed: {\n    savedPreview() {\n      if (!Number.isFinite(this.latitude) || !Number.isFinite(this.longitude)) return '';\n      return `${Number(this.latitude).toFixed(5)}, ${Number(this.longitude).toFixed(5)}`;\n    }\n  },\n  async mounted() {\n    await this.load();\n    await this.initMap();\n  },\n  methods: {\n    async load() {\n      try {\n        const {\n          data\n        } = await api.get('/store/account/location');\n        this.latitude = data.latitude ?? null;\n        this.longitude = data.longitude ?? null;\n        this.address = data.address || '';\n      } catch (err) {\n        console.error('Failed to load location', err);\n      }\n    },\n    async initMap() {\n      this.mapError = '';\n      try {\n        const maps = await loadGoogleMaps();\n        const el = document.getElementById('ownerMap');\n        if (!el) return;\n        const hasCoords = Number.isFinite(this.latitude) && Number.isFinite(this.longitude);\n        const center = hasCoords ? {\n          lat: Number(this.latitude),\n          lng: Number(this.longitude)\n        } : CALAPAN;\n        this.mapInstance = new maps.Map(el, {\n          center,\n          zoom: hasCoords ? 15 : 13,\n          mapTypeId: this.mapTypeId,\n          mapTypeControl: false,\n          streetViewControl: false,\n          fullscreenControl: true\n        });\n        if (hasCoords) this.placeMarker(center, maps);\n        this.mapInstance.addListener('click', e => {\n          const lat = Number(e.latLng.lat().toFixed(6));\n          const lng = Number(e.latLng.lng().toFixed(6));\n          this.latitude = lat;\n          this.longitude = lng;\n          this.placeMarker({\n            lat,\n            lng\n          }, maps);\n        });\n      } catch (err) {\n        console.error(err);\n        this.mapError = err.message || 'Failed to load Google Maps';\n      }\n    },\n    placeMarker(position, mapsApi) {\n      const maps = mapsApi || window.google?.maps;\n      if (!maps || !this.mapInstance) return;\n      if (this.markerInstance) {\n        this.markerInstance.setPosition(position);\n        return;\n      }\n      this.markerInstance = new maps.Marker({\n        position,\n        map: this.mapInstance,\n        draggable: true,\n        title: 'Store location'\n      });\n      this.markerInstance.addListener('dragend', () => {\n        const pos = this.markerInstance.getPosition();\n        this.latitude = Number(pos.lat().toFixed(6));\n        this.longitude = Number(pos.lng().toFixed(6));\n      });\n    },\n    switchMapType() {\n      if (this.mapInstance) this.mapInstance.setMapTypeId(this.mapTypeId);\n    },\n    syncMarkerFromInputs() {\n      if (!this.mapInstance || !Number.isFinite(this.latitude) || !Number.isFinite(this.longitude)) return;\n      const position = {\n        lat: Number(this.latitude),\n        lng: Number(this.longitude)\n      };\n      this.placeMarker(position);\n      this.mapInstance.panTo(position);\n    },\n    useMyLocation() {\n      if (!navigator.geolocation) {\n        alert('Geolocation is not supported on this device');\n        return;\n      }\n      navigator.geolocation.getCurrentPosition(pos => {\n        this.latitude = Number(pos.coords.latitude.toFixed(6));\n        this.longitude = Number(pos.coords.longitude.toFixed(6));\n        const position = {\n          lat: this.latitude,\n          lng: this.longitude\n        };\n        this.placeMarker(position);\n        if (this.mapInstance) {\n          this.mapInstance.panTo(position);\n          this.mapInstance.setZoom(16);\n        }\n      }, () => alert('Could not get your current location'), {\n        enableHighAccuracy: true,\n        timeout: 10000\n      });\n    },\n    async save() {\n      if (!Number.isFinite(this.latitude) || !Number.isFinite(this.longitude)) {\n        alert('Click the map to set a store pin first');\n        return;\n      }\n      this.saving = true;\n      try {\n        await api.put('/store/account/location', {\n          latitude: this.latitude,\n          longitude: this.longitude,\n          address: this.address\n        });\n        alert('Store location saved');\n      } catch (err) {\n        alert(err.response?.data?.message || 'Failed to save location');\n      } finally {\n        this.saving = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","loadGoogleMaps","CALAPAN","lat","lng","name","data","latitude","longitude","address","mapInstance","markerInstance","mapTypeId","mapError","saving","computed","savedPreview","Number","isFinite","toFixed","mounted","load","initMap","methods","get","err","console","error","maps","el","document","getElementById","hasCoords","center","Map","zoom","mapTypeControl","streetViewControl","fullscreenControl","placeMarker","addListener","e","latLng","message","position","mapsApi","window","google","setPosition","Marker","map","draggable","title","pos","getPosition","switchMapType","setMapTypeId","syncMarkerFromInputs","panTo","useMyLocation","navigator","geolocation","alert","getCurrentPosition","coords","setZoom","enableHighAccuracy","timeout","save","put","response"],"sources":["/var/www/kadiwa/Frontend/src/views/store/AccountLocation.vue"],"sourcesContent":["<template>\r\n  <div class=\"page\">\r\n    <div class=\"page-head\">\r\n      <h2>Maps</h2>\r\n      <p class=\"lead\">Set your store pin on Google Maps so customers can find you.</p>\r\n    </div>\r\n\r\n    <div v-if=\"mapError\" class=\"map-error\">{{ mapError }}</div>\r\n\r\n    <div class=\"layout\">\r\n      <div class=\"map-panel\">\r\n        <div class=\"toolbar\">\r\n          <label>Map type\r\n            <select class=\"select\" v-model=\"mapTypeId\" @change=\"switchMapType\">\r\n              <option value=\"roadmap\">Roadmap</option>\r\n              <option value=\"satellite\">Satellite</option>\r\n              <option value=\"hybrid\">Hybrid</option>\r\n              <option value=\"terrain\">Terrain</option>\r\n            </select>\r\n          </label>\r\n          <button type=\"button\" class=\"ghost-btn\" @click=\"useMyLocation\">Use my location</button>\r\n        </div>\r\n        <div id=\"ownerMap\" class=\"map\"></div>\r\n        <p class=\"hint\">Click the map or drag the pin to set your store location.</p>\r\n      </div>\r\n\r\n      <div class=\"side-panel\">\r\n        <h3>Location details</h3>\r\n        <div class=\"form\">\r\n          <label>Latitude\r\n            <input class=\"input\" v-model.number=\"latitude\" type=\"number\" step=\"0.000001\" @change=\"syncMarkerFromInputs\" />\r\n          </label>\r\n          <label>Longitude\r\n            <input class=\"input\" v-model.number=\"longitude\" type=\"number\" step=\"0.000001\" @change=\"syncMarkerFromInputs\" />\r\n          </label>\r\n          <label>Address (optional)\r\n            <textarea class=\"input\" v-model=\"address\" rows=\"3\" placeholder=\"Street, barangay, city\"></textarea>\r\n          </label>\r\n          <button class=\"primary-btn\" @click=\"save\" :disabled=\"saving\">\r\n            {{ saving ? 'Saving...' : 'Save location' }}\r\n          </button>\r\n        </div>\r\n        <div v-if=\"savedPreview\" class=\"saved-note\">\r\n          Saved pin: {{ savedPreview }}\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\nimport loadGoogleMaps from '../../services/googleMapsLoader'\r\n\r\nconst CALAPAN = { lat: 13.4117, lng: 121.1803 }\r\n\r\nexport default {\r\n  name: 'StoreAccountLocation',\r\n  data() {\r\n    return {\r\n      latitude: null,\r\n      longitude: null,\r\n      address: '',\r\n      mapInstance: null,\r\n      markerInstance: null,\r\n      mapTypeId: 'roadmap',\r\n      mapError: '',\r\n      saving: false\r\n    }\r\n  },\r\n  computed: {\r\n    savedPreview() {\r\n      if (!Number.isFinite(this.latitude) || !Number.isFinite(this.longitude)) return ''\r\n      return `${Number(this.latitude).toFixed(5)}, ${Number(this.longitude).toFixed(5)}`\r\n    }\r\n  },\r\n  async mounted() {\r\n    await this.load()\r\n    await this.initMap()\r\n  },\r\n  methods: {\r\n    async load() {\r\n      try {\r\n        const { data } = await api.get('/store/account/location')\r\n        this.latitude = data.latitude ?? null\r\n        this.longitude = data.longitude ?? null\r\n        this.address = data.address || ''\r\n      } catch (err) {\r\n        console.error('Failed to load location', err)\r\n      }\r\n    },\r\n    async initMap() {\r\n      this.mapError = ''\r\n      try {\r\n        const maps = await loadGoogleMaps()\r\n        const el = document.getElementById('ownerMap')\r\n        if (!el) return\r\n\r\n        const hasCoords = Number.isFinite(this.latitude) && Number.isFinite(this.longitude)\r\n        const center = hasCoords\r\n          ? { lat: Number(this.latitude), lng: Number(this.longitude) }\r\n          : CALAPAN\r\n\r\n        this.mapInstance = new maps.Map(el, {\r\n          center,\r\n          zoom: hasCoords ? 15 : 13,\r\n          mapTypeId: this.mapTypeId,\r\n          mapTypeControl: false,\r\n          streetViewControl: false,\r\n          fullscreenControl: true\r\n        })\r\n\r\n        if (hasCoords) this.placeMarker(center, maps)\r\n\r\n        this.mapInstance.addListener('click', (e) => {\r\n          const lat = Number(e.latLng.lat().toFixed(6))\r\n          const lng = Number(e.latLng.lng().toFixed(6))\r\n          this.latitude = lat\r\n          this.longitude = lng\r\n          this.placeMarker({ lat, lng }, maps)\r\n        })\r\n      } catch (err) {\r\n        console.error(err)\r\n        this.mapError = err.message || 'Failed to load Google Maps'\r\n      }\r\n    },\r\n    placeMarker(position, mapsApi) {\r\n      const maps = mapsApi || window.google?.maps\r\n      if (!maps || !this.mapInstance) return\r\n\r\n      if (this.markerInstance) {\r\n        this.markerInstance.setPosition(position)\r\n        return\r\n      }\r\n\r\n      this.markerInstance = new maps.Marker({\r\n        position,\r\n        map: this.mapInstance,\r\n        draggable: true,\r\n        title: 'Store location'\r\n      })\r\n      this.markerInstance.addListener('dragend', () => {\r\n        const pos = this.markerInstance.getPosition()\r\n        this.latitude = Number(pos.lat().toFixed(6))\r\n        this.longitude = Number(pos.lng().toFixed(6))\r\n      })\r\n    },\r\n    switchMapType() {\r\n      if (this.mapInstance) this.mapInstance.setMapTypeId(this.mapTypeId)\r\n    },\r\n    syncMarkerFromInputs() {\r\n      if (!this.mapInstance || !Number.isFinite(this.latitude) || !Number.isFinite(this.longitude)) return\r\n      const position = { lat: Number(this.latitude), lng: Number(this.longitude) }\r\n      this.placeMarker(position)\r\n      this.mapInstance.panTo(position)\r\n    },\r\n    useMyLocation() {\r\n      if (!navigator.geolocation) {\r\n        alert('Geolocation is not supported on this device')\r\n        return\r\n      }\r\n      navigator.geolocation.getCurrentPosition(\r\n        (pos) => {\r\n          this.latitude = Number(pos.coords.latitude.toFixed(6))\r\n          this.longitude = Number(pos.coords.longitude.toFixed(6))\r\n          const position = { lat: this.latitude, lng: this.longitude }\r\n          this.placeMarker(position)\r\n          if (this.mapInstance) {\r\n            this.mapInstance.panTo(position)\r\n            this.mapInstance.setZoom(16)\r\n          }\r\n        },\r\n        () => alert('Could not get your current location'),\r\n        { enableHighAccuracy: true, timeout: 10000 }\r\n      )\r\n    },\r\n    async save() {\r\n      if (!Number.isFinite(this.latitude) || !Number.isFinite(this.longitude)) {\r\n        alert('Click the map to set a store pin first')\r\n        return\r\n      }\r\n      this.saving = true\r\n      try {\r\n        await api.put('/store/account/location', {\r\n          latitude: this.latitude,\r\n          longitude: this.longitude,\r\n          address: this.address\r\n        })\r\n        alert('Store location saved')\r\n      } catch (err) {\r\n        alert(err.response?.data?.message || 'Failed to save location')\r\n      } finally {\r\n        this.saving = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.page { padding: 4px 2px 20px; }\r\n.page-head h2 { margin: 0; color: #2f5a23; }\r\n.lead { margin: 6px 0 0; color: #5f7256; max-width: 62ch; }\r\n.layout {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1.5fr) minmax(260px, 0.8fr);\r\n  gap: 16px;\r\n  align-items: start;\r\n  margin-top: 14px;\r\n}\r\n.map-panel,\r\n.side-panel {\r\n  background: #fff;\r\n  border: 1px solid #deead0;\r\n  border-radius: 14px;\r\n  padding: 14px;\r\n  box-shadow: 0 8px 20px rgba(56, 92, 35, 0.07);\r\n}\r\n.side-panel h3 {\r\n  margin: 0 0 12px;\r\n  color: #2f5a23;\r\n  font-size: 15px;\r\n}\r\n.toolbar {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n  align-items: end;\r\n  margin-bottom: 10px;\r\n}\r\n.toolbar label {\r\n  display: grid;\r\n  gap: 4px;\r\n  font-size: 13px;\r\n  color: #48603b;\r\n  font-weight: 600;\r\n}\r\n.map {\r\n  height: 420px;\r\n  border: 1px solid #d9e5c8;\r\n  border-radius: 10px;\r\n  overflow: hidden;\r\n}\r\n.hint {\r\n  margin: 8px 0 0;\r\n  color: #6a7b60;\r\n  font-size: 13px;\r\n}\r\n.map-error {\r\n  margin-top: 12px;\r\n  margin-bottom: 0;\r\n  padding: 10px 12px;\r\n  border-radius: 8px;\r\n  background: #fff1f1;\r\n  border: 1px solid #f4c8c8;\r\n  color: #b42318;\r\n  font-size: 13px;\r\n}\r\n.form { display: grid; gap: 10px; }\r\n.form label {\r\n  display: grid;\r\n  gap: 5px;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: #48603b;\r\n}\r\n.input, .select {\r\n  padding: 9px 10px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 8px;\r\n  background: #fff;\r\n  font-weight: 500;\r\n}\r\n.primary-btn {\r\n  background: linear-gradient(135deg, #7CB342, #4E7D32);\r\n  color: #fff;\r\n  border: none;\r\n  padding: 11px 14px;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  font-weight: 700;\r\n}\r\n.primary-btn:disabled { opacity: 0.7; cursor: default; }\r\n.ghost-btn {\r\n  border: 1px solid #cddbb9;\r\n  background: #f7faf2;\r\n  color: #355e2a;\r\n  border-radius: 8px;\r\n  padding: 9px 12px;\r\n  cursor: pointer;\r\n  font-weight: 600;\r\n}\r\n.saved-note {\r\n  margin-top: 12px;\r\n  padding: 10px;\r\n  border-radius: 8px;\r\n  background: #f4f8ee;\r\n  color: #355e2a;\r\n  font-size: 13px;\r\n}\r\n@media (max-width: 900px) {\r\n  .layout { grid-template-columns: 1fr; }\r\n  .map { height: 280px; }\r\n}\r\n</style>\r\n"],"mappings":"AAmDA,OAAOA,GAAE,MAAO,oBAAmB;AACnC,OAAOC,cAAa,MAAO,iCAAgC;AAE3D,MAAMC,OAAM,GAAI;EAAEC,GAAG,EAAE,OAAO;EAAEC,GAAG,EAAE;AAAS;AAE9C,eAAe;EACbC,IAAI,EAAE,sBAAsB;EAC5BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,IAAI;MACdC,SAAS,EAAE,IAAI;MACfC,OAAO,EAAE,EAAE;MACXC,WAAW,EAAE,IAAI;MACjBC,cAAc,EAAE,IAAI;MACpBC,SAAS,EAAE,SAAS;MACpBC,QAAQ,EAAE,EAAE;MACZC,MAAM,EAAE;IACV;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,YAAYA,CAAA,EAAG;MACb,IAAI,CAACC,MAAM,CAACC,QAAQ,CAAC,IAAI,CAACX,QAAQ,KAAK,CAACU,MAAM,CAACC,QAAQ,CAAC,IAAI,CAACV,SAAS,CAAC,EAAE,OAAO,EAAC;MACjF,OAAO,GAAGS,MAAM,CAAC,IAAI,CAACV,QAAQ,CAAC,CAACY,OAAO,CAAC,CAAC,CAAC,KAAKF,MAAM,CAAC,IAAI,CAACT,SAAS,CAAC,CAACW,OAAO,CAAC,CAAC,CAAC,EAAC;IACnF;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,IAAI,CAAC;IAChB,MAAM,IAAI,CAACC,OAAO,CAAC;EACrB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMF,IAAIA,CAAA,EAAG;MACX