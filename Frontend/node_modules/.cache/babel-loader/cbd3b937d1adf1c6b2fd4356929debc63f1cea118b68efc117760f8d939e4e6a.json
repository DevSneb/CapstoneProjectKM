"nav\">\r\n      <router-link class=\"brand\" to=\"/\" aria-label=\"Kadiwa Mart home\">\r\n        <span class=\"brand-mark\">K</span>\r\n      </router-link>\r\n      <nav class=\"nav-links\" aria-label=\"Account\">\r\n        <router-link class=\"link-login\" to=\"/customer/login\">Login</router-link>\r\n        <router-link class=\"link-signup\" to=\"/customer/register\">Sign up</router-link>\r\n      </nav>\r\n    </header>\r\n\r\n    <section class=\"hero\" aria-label=\"Kadiwa Mart\">\r\n      <div class=\"hero-bg\" aria-hidden=\"true\">\r\n        <div class=\"sky\"></div>\r\n        <div class=\"sun\"></div>\r\n        <div class=\"hills\"></div>\r\n        <div class=\"crops\"></div>\r\n        <div class=\"mist\"></div>\r\n      </div>\r\n\r\n      <div class=\"hero-copy\">\r\n        <p class=\"brand-title\">Kadiwa Mart</p>\r\n        <h1>Fresh from local stores to your table.</h1>\r\n        <p class=\"lede\">\r\n          Shop Calapan Kadiwa stores for pickup or delivery—all in one place.\r\n        </p>\r\n        <div class=\"cta-row\">\r\n          <router-link\r\n            v-if=\"loggedInCustomer\"\r\n            class=\"cta-primary\"\r\n            to=\"/customer/dashboard\"\r\n          >\r\n            Go to dashboard\r\n          </router-link>\r\n          <template v-else>\r\n            <router-link class=\"cta-primary\" to=\"/customer/register\">Get started</router-link>\r\n            <router-link class=\"cta-ghost\" to=\"/customer/login\">Login</router-link>\r\n          </template>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  </main>\r\n</template>\r\n\r\n<script>\r\nimport { readAuth } from '../services/authStorage'\r\n\r\nexport default {\r\n  name: 'LandingPage',\r\n  computed: {\r\n    loggedInCustomer() {\r\n      const { token, userRole } = readAuth('customer')\r\n      return !!(token && userRole === 'customer')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,650;9..144,750&family=Manrope:wght@500;600;700&display=swap');\r\n\r\n.landing {\r\n  --ink: #173016;\r\n  --foam: #f4f7ee;\r\n  --leaf: #3d7a2b;\r\n  --leaf-deep: #2a5a1c;\r\n  --muted: rgba(244, 247, 238, 0.86);\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  font-family: Manrope, 'Segoe UI', sans-serif;\r\n  color: var(--foam);\r\n  background: #1a2f16;\r\n}\r\n\r\n.nav {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 5;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 22px clamp(18px, 4vw, 40px);\r\n}\r\n\r\n.brand {\r\n  text-decoration: none;\r\n}\r\n\r\n.brand-mark {\r\n  width: 44px;\r\n  height: 44px;\r\n  border-radius: 14px;\r\n  display: grid;\r\n  place-items: center;\r\n  font-weight: 700;\r\n  color: #fff;\r\n  background: linear-gradient(145deg, #6aa84f, #2f5c1d);\r\n  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);\r\n}\r\n\r\n.nav-links {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n}\r\n\r\n.link-login,\r\n.link-signup {\r\n  text-decoration: none;\r\n  font-weight: 700;\r\n  font-size: 0.95rem;\r\n  padding: 10px 16px;\r\n  border-radius: 999px;\r\n}\r\n\r\n.link-login {\r\n  color: var(--foam);\r\n}\r\n\r\n.link-signup {\r\n  color: var(--ink);\r\n  background: rgba(244, 247, 238, 0.94);\r\n}\r\n\r\n.hero {\r\n  position: relative;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  display: grid;\r\n  align-items: end;\r\n  overflow: hidden;\r\n}\r\n\r\n.hero-bg {\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 0;\r\n}\r\n\r\n.sky {\r\n  position: absolute;\r\n  inset: 0;\r\n  background:\r\n    radial-gradient(ellipse 70% 50% at 78% 18%, rgba(255, 210, 110, 0.55), transparent 55%),\r\n    linear-gradient(180deg, #6f9d4f 0%, #4e7d32 42%, #355e2a 72%, #243f1c 100%);\r\n  animation: skyDrift 14s ease-in-out infinite alternate;\r\n}\r\n\r\n.sun {\r\n  position: absolute;\r\n  top: 12%;\r\n  right: 14%;\r\n  width: min(22vw, 180px);\r\n  height: min(22vw, 180px);\r\n  border-radius: 50%;\r\n  background: radial-gradient(circle at 35% 35%, #ffe08a, #f0b43a 58%, rgba(240, 180, 58, 0));\r\n  animation: sunPulse 6s ease-in-out infinite;\r\n}\r\n\r\n.hills {\r\n  position: absolute;\r\n  left: -8%;\r\n  right: -8%;\r\n  bottom: -4%;\r\n  height: 48%;\r\n  background:\r\n    radial-gradient(ellipse 55% 90% at 18% 100%, #2f5a22 0%, transparent 70%),\r\n    radial-gradient(ellipse 60% 100% at 55% 110%, #3a6b2a 0%, transparent 72%),\r\n    radial-gradient(ellipse 50% 90% at 88% 100%, #274d1c 0%, transparent 70%);\r\n}\r\n\r\n.crops {\r\n  position: absolute;\r\n  inset: auto 0 0 0;\r\n  height: 28%;\r\n  background:\r\n    repeating-linear-gradient(\r\n      95deg,\r\n      rgba(124, 179, 66, 0.0) 0 10px,\r\n      rgba(168, 208, 96, 0.18) 10px 14px,\r\n      rgba(124, 179, 66, 0.0) 14px 24px\r\n    );\r\n  mask-image: linear-gradient(180deg, transparent, #000 40%);\r\n  animation: cropSway 8s ease-in-out infinite alternate;\r\n}\r\n\r\n.mist {\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(180deg, rgba(20, 35, 16, 0.15) 0%, rgba(20, 35, 16, 0.55) 72%, rgba(20, 35, 16, 0.78) 100%);\r\n}\r\n\r\n.hero-copy {\r\n  position: relative;\r\n  z-index: 2;\r\n  width: min(720px, 100%);\r\n  padding: 0 clamp(18px, 5vw, 56px) clamp(48px, 10vh, 96px);\r\n  animation: riseIn 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;\r\n}\r\n\r\n.brand-title {\r\n  margin: 0;\r\n  font-family: Fraunces, Georgia, serif;\r\n  font-weight: 750;\r\n  font-size: clamp(3.2rem, 10vw, 6.4rem);\r\n  line-height: 0.92;\r\n  letter-spacing: -0.04em;\r\n  color: #f7fbe9;\r\n  text-shadow: 0 10px 30px rgba(0, 0, 0, 0.28);\r\n}\r\n\r\n.hero-copy h1 {\r\n  margin: 18px 0 0;\r\n  max-width: 16ch;\r\n  font-family: Fraunces, Georgia, serif;\r\n  font-weight: 650;\r\n  font-size: clamp(1.35rem, 3.2vw, 2rem);\r\n  line-height: 1.2;\r\n  color: rgba(247, 251, 233, 0.96);\r\n}\r\n\r\n.lede {\r\n  margin: 16px 0 0;\r\n  max-width: 34ch;\r\n  font-size: clamp(1rem, 2.2vw, 1.15rem);\r\n  line-height: 1.55;\r\n  color: var(--muted);\r\n  font-weight: 500;\r\n}\r\n\r\n.cta-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  margin-top: 28px;\r\n}\r\n\r\n.cta-primary,\r\n.cta-ghost {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-height: 50px;\r\n  padding: 0 22px;\r\n  border-radius: 14px;\r\n  text-decoration: none;\r\n  font-weight: 700;\r\n  font-size: 1rem;\r\n}\r\n\r\n.cta-primary {\r\n  color: var(--ink);\r\n  background: #f4f7ee;\r\n  box-shadow: 0 14px 28px rgba(0, 0, 0, 0.22);\r\n}\r\n\r\n.cta-ghost {\r\n  color: #f4f7ee;\r\n  border: 1.5px solid rgba(244, 247, 238, 0.45);\r\n  background: rgba(255, 255, 255, 0.08);\r\n  backdrop-filter: blur(6px);\r\n}\r\n\r\n@keyframes skyDrift {\r\n  from { filter: saturate(1) brightness(1); }\r\n  to { filter: saturate(1.08) brightness(1.05); }\r\n}\r\n\r\n@keyframes sunPulse {\r\n  0%, 100% { transform: scale(1); opacity: 0.9; }\r\n  50% { transform: scale(1.06); opacity: 1; }\r\n}\r\n\r\n@keyframes cropSway {\r\n  from { transform: translateX(0); }\r\n  to { transform: translateX(18px); }\r\n}\r\n\r\n@keyframes riseIn {\r\n  from { opacity: 0; transform: translateY(24px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n@media (max-width: 720px) {\r\n  .nav { padding: 16px; }\r\n  .hero {\r\n    align-items: end;\r\n  }\r\n  .hero-copy {\r\n    padding-bottom: calc(36px + env(safe-area-inset-bottom, 0px));\r\n  }\r\n  .brand-title {\r\n    font-size: clamp(2.8rem, 16vw, 3.6rem);\r\n  }\r\n  .cta-row {\r\n    flex-direction: column;\r\n  }\r\n  .cta-primary,\r\n  .cta-ghost {\r\n    width: 100%;\r\n  }\r\n  .sun {\r\n    top: 10%;\r\n    right: 8%;\r\n    width: 120px;\r\n    height: 120px;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";;EACQA,KAAK,EAAC;AAAS;;EACXA,KAAK,EAAC;AAAK;;EAIZA,KAAK,EAAC,WAAW;EAAC,YAAU,EAAC;;;EAM3BA,KAAK,EAAC,MAAM;EAAC,YAAU,