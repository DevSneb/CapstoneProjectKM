{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '../services/api';\nimport { bindKeyboardScroll } from '../utils/keyboardScroll';\nexport default {\n  name: 'StoreOwnerLogin',\n  data() {\n    return {\n      credentials: {\n        username: '',\n        password: ''\n      },\n      showPassword: false,\n      showRegisterPassword: false,\n      unbindKeyboardScroll: null,\n      registerData: {\n        username: '',\n        email: '',\n        password: '',\n        full_name: '',\n        store_name: '',\n        phone: '',\n        address: ''\n      },\n      error: '',\n      loading: false,\n      showRegisterForm: false\n    };\n  },\n  mounted() {\n    this.unbindKeyboardScroll = bindKeyboardScroll(this.$el);\n  },\n  beforeUnmount() {\n    if (this.unbindKeyboardScroll) this.unbindKeyboardScroll();\n  },\n  methods: {\n    async handleLogin() {\n      this.error = '';\n      this.loading = true;\n      try {\n        const response = await api.post('/admin/auth/login/store-owner', this.credentials);\n        this.$store.dispatch('login', {\n          user: response.data.user,\n          token: response.data.token\n        });\n        this.$router.push('/store-owner/dashboard');\n      } catch (err) {\n        this.error = err.response?.data?.message || 'Login failed. Please try again.';\n      } finally {\n        this.loading = false;\n      }\n    },\n    async handleRegister() {\n      try {\n        const response = await api.post('/admin/auth/register/store-owner', this.registerData);\n        alert(response.data.message);\n        this.showRegisterForm = false;\n        this.registerData = {\n          username: '',\n          email: '',\n          password: '',\n          full_name: '',\n          store_name: '',\n          phone: '',\n          address: ''\n        };\n      } catch (err) {\n        alert(err.response?.data?.message || 'Registration failed');\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","bindKeyboardScroll","name","data","credentials","username","password","showPassword","showRegisterPassword","unbindKeyboardScroll","registerData","email","full_name","store_name","phone","address","error","loading","showRegisterForm","mounted","$el","beforeUnmount","methods","handleLogin","response","post","$store","dispatch","user","token","$router","push","err","message","handleRegister","alert"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\StoreOwnerLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-container\">\r\n    <div class=\"login-box\">\r\n      <div class=\"login-header\">\r\n        <div class=\"eyebrow\">Secure Access</div>\r\n        <h1>Kadiwa E-Commerce</h1>\r\n        <h2>Store Owner Login</h2>\r\n        <p class=\"subtext\">Sign in with your store owner account.</p>\r\n      </div>\r\n\r\n      <form @submit.prevent=\"handleLogin\" class=\"login-form\">\r\n        <div v-if=\"error\" class=\"error-message\">{{ error }}</div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"username\">Username</label>\r\n          <input\r\n            type=\"text\"\r\n            id=\"username\"\r\n            v-model=\"credentials.username\"\r\n            placeholder=\"Enter username\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"password\">Password</label>\r\n          <div class=\"password-field\">\r\n            <input\r\n              :type=\"showPassword ? 'text' : 'password'\"\r\n              id=\"password\"\r\n              v-model=\"credentials.password\"\r\n              placeholder=\"Enter password\"\r\n              required\r\n            />\r\n            <button\r\n              type=\"button\"\r\n              class=\"toggle-password\"\r\n              :aria-label=\"showPassword ? 'Hide password' : 'Show password'\"\r\n              @click=\"showPassword = !showPassword\"\r\n            >\r\n              {{ showPassword ? 'Hide' : 'Show' }}\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        <button type=\"submit\" class=\"login-btn\" :disabled=\"loading\">\r\n          {{ loading ? 'Logging in...' : 'Login' }}\r\n        </button>\r\n      </form>\r\n\r\n      <div class=\"links\">\r\n        <router-link to=\"/customer/login\">Customer Login</router-link>\r\n        <span> | </span>\r\n        <router-link to=\"/admin/login\">Admin Login</router-link>\r\n        <span> | </span>\r\n        <a href=\"#\" @click.prevent=\"showRegisterForm = true\">Register as Store Owner</a>\r\n      </div>\r\n\r\n      <div v-if=\"showRegisterForm\" class=\"register-modal\">\r\n        <div class=\"modal-content\">\r\n          <h3>Store Owner Registration</h3>\r\n          <form @submit.prevent=\"handleRegister\">\r\n            <div class=\"form-group\">\r\n              <label>Username</label>\r\n              <input type=\"text\" v-model=\"registerData.username\" required />\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Email</label>\r\n              <input type=\"email\" v-model=\"registerData.email\" required />\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Password</label>\r\n              <div class=\"password-field\">\r\n                <input\r\n                  :type=\"showRegisterPassword ? 'text' : 'password'\"\r\n                  v-model=\"registerData.password\"\r\n                  required\r\n                />\r\n                <button\r\n                  type=\"button\"\r\n                  class=\"toggle-password\"\r\n                  :aria-label=\"showRegisterPassword ? 'Hide password' : 'Show password'\"\r\n                  @click=\"showRegisterPassword = !showRegisterPassword\"\r\n                >\r\n                  {{ showRegisterPassword ? 'Hide' : 'Show' }}\r\n                </button>\r\n              </div>\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Full Name</label>\r\n              <input type=\"text\" v-model=\"registerData.full_name\" required />\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Store Name</label>\r\n              <input type=\"text\" v-model=\"registerData.store_name\" required />\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Phone</label>\r\n              <input type=\"tel\" v-model=\"registerData.phone\" />\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <label>Address</label>\r\n              <textarea v-model=\"registerData.address\"></textarea>\r\n            </div>\r\n            <div class=\"modal-buttons\">\r\n              <button type=\"submit\" class=\"btn-submit\">Register</button>\r\n              <button type=\"button\" @click=\"showRegisterForm = false\" class=\"btn-cancel\">Cancel</button>\r\n            </div>\r\n          </form>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../services/api'\r\nimport { bindKeyboardScroll } from '../utils/keyboardScroll'\r\n\r\nexport default {\r\n  name: 'StoreOwnerLogin',\r\n  data() {\r\n    return {\r\n      credentials: {\r\n        username: '',\r\n        password: ''\r\n      },\r\n      showPassword: false,\r\n      showRegisterPassword: false,\r\n      unbindKeyboardScroll: null,\r\n      registerData: {\r\n        username: '',\r\n        email: '',\r\n        password: '',\r\n        full_name: '',\r\n        store_name: '',\r\n        phone: '',\r\n        address: ''\r\n      },\r\n      error: '',\r\n      loading: false,\r\n      showRegisterForm: false\r\n    }\r\n  },\r\n  mounted() {\r\n    this.unbindKeyboardScroll = bindKeyboardScroll(this.$el)\r\n  },\r\n  beforeUnmount() {\r\n    if (this.unbindKeyboardScroll) this.unbindKeyboardScroll()\r\n  },\r\n  methods: {\r\n    async handleLogin() {\r\n      this.error = ''\r\n      this.loading = true\r\n\r\n      try {\r\n        const response = await api.post('/admin/auth/login/store-owner', this.credentials)\r\n        this.$store.dispatch('login', {\r\n          user: response.data.user,\r\n          token: response.data.token\r\n        })\r\n        this.$router.push('/store-owner/dashboard')\r\n      } catch (err) {\r\n        this.error = err.response?.data?.message || 'Login failed. Please try again.'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    async handleRegister() {\r\n      try {\r\n        const response = await api.post('/admin/auth/register/store-owner', this.registerData)\r\n        alert(response.data.message)\r\n        this.showRegisterForm = false\r\n        this.registerData = {\r\n          username: '',\r\n          email: '',\r\n          password: '',\r\n          full_name: '',\r\n          store_name: '',\r\n          phone: '',\r\n          address: ''\r\n        }\r\n      } catch (err) {\r\n        alert(err.response?.data?.message || 'Registration failed')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: flex-start;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  background: radial-gradient(circle at 15% 15%, rgba(124, 179, 66, 0.3), transparent 45%),\r\n              radial-gradient(circle at 85% 85%, rgba(78, 125, 50, 0.26), transparent 42%),\r\n              linear-gradient(135deg, #edf5e2 0%, #d9e7c7 100%);\r\n  padding: max(20px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom));\r\n  position: relative;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.login-container::before,\r\n.login-container::after {\r\n  content: '';\r\n  position: absolute;\r\n  border-radius: 999px;\r\n  pointer-events: none;\r\n}\r\n\r\n.login-container::before {\r\n  width: 300px;\r\n  height: 300px;\r\n  background: rgba(124, 179, 66, 0.16);\r\n  top: -100px;\r\n  left: -90px;\r\n}\r\n\r\n.login-container::after {\r\n  width: 220px;\r\n  height: 220px;\r\n  background: rgba(53, 94, 42, 0.12);\r\n  right: -70px;\r\n  bottom: -60px;\r\n}\r\n\r\n.login-box {\r\n  background: rgba(255, 255, 255, 0.88);\r\n  backdrop-filter: blur(8px);\r\n  -webkit-backdrop-filter: blur(8px);\r\n  padding: 36px;\r\n  border-radius: 18px;\r\n  border: 1px solid rgba(205, 219, 185, 0.9);\r\n  box-shadow: 0 18px 40px rgba(56, 92, 35, 0.18);\r\n  width: 100%;\r\n  max-width: 430px;\r\n  position: relative;\r\n  z-index: 1;\r\n  margin: auto 0;\r\n}\r\n\r\n.login-header {\r\n  text-align: center;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.eyebrow {\r\n  display: inline-block;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: 1px;\r\n  color: #5a7e45;\r\n  text-transform: uppercase;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.login-header h1 {\r\n  margin: 0;\r\n  font-size: 28px;\r\n  color: #2f5f28;\r\n}\r\n\r\n.login-header h2 {\r\n  margin: 12px 0 8px;\r\n  font-size: 20px;\r\n  color: #385e2f;\r\n}\r\n\r\n.subtext {\r\n  margin: 0;\r\n  color: #5f6f55;\r\n}\r\n\r\n.login-form {\r\n  display: grid;\r\n  gap: 18px;\r\n}\r\n\r\n.form-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.form-group label {\r\n  margin-bottom: 6px;\r\n  font-weight: 600;\r\n  color: #465f3d;\r\n}\r\n\r\n.form-group input,\r\n.form-group textarea {\r\n  padding: 12px 14px;\r\n  border: 1px solid #c9d1b9;\r\n  border-radius: 12px;\r\n  font-size: 14px;\r\n  color: #2f3f24;\r\n  background: #f8faf3;\r\n}\r\n\r\n.password-field {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.password-field input {\r\n  width: 100%;\r\n  padding-right: 64px;\r\n}\r\n.toggle-password {\r\n  position: absolute;\r\n  right: 8px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  border: none;\r\n  background: transparent;\r\n  color: #4E7D32;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  padding: 6px 8px;\r\n  border-radius: 8px;\r\n}\r\n.toggle-password:hover {\r\n  background: rgba(124, 179, 66, 0.12);\r\n}\r\n\r\n.form-group textarea {\r\n  min-height: 100px;\r\n  resize: vertical;\r\n}\r\n\r\n.login-btn,\r\n.btn-submit,\r\n.btn-cancel {\r\n  width: 100%;\r\n  padding: 14px 18px;\r\n  border: none;\r\n  border-radius: 12px;\r\n  font-size: 15px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n}\r\n\r\n.login-btn {\r\n  background: linear-gradient(135deg, #5a944a, #3e712e);\r\n  color: #fff;\r\n}\r\n\r\n.login-btn:disabled {\r\n  opacity: 0.65;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.links {\r\n  margin-top: 18px;\r\n  display: flex;\r\n  justify-content: center;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.links a,\r\n.links router-link {\r\n  color: #4b783e;\r\n  text-decoration: none;\r\n  font-weight: 600;\r\n}\r\n\r\n.error-message {\r\n  padding: 12px 14px;\r\n  background: #ffe8e3;\r\n  border: 1px solid #f2b0a1;\r\n  color: #8a2e24;\r\n  border-radius: 12px;\r\n}\r\n\r\n.register-modal {\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(19, 48, 17, 0.45);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  padding: 24px;\r\n}\r\n\r\n.modal-content {\r\n  background: #ffffff;\r\n  border-radius: 18px;\r\n  padding: 28px;\r\n  width: 100%;\r\n  max-width: 520px;\r\n  box-shadow: 0 18px 40px rgba(23, 59, 16, 0.18);\r\n}\r\n\r\n.modal-buttons {\r\n  display: flex;\r\n  gap: 12px;\r\n  margin-top: 18px;\r\n}\r\n\r\n.btn-submit {\r\n  background: #4b783e;\r\n  color: #fff;\r\n}\r\n\r\n.btn-cancel {\r\n  background: #dde5d2;\r\n  color: #314427;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .login-container {\r\n    padding: 12px 12px 45vh;\r\n    align-items: flex-start;\r\n  }\r\n  .login-box {\r\n    margin-top: 8px;\r\n    padding: 24px 16px;\r\n  }\r\n  .login-btn { min-height: 44px; }\r\n  .modal-content {\r\n    max-height: min(85vh, 100%);\r\n    overflow-y: auto;\r\n    -webkit-overflow-scrolling: touch;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";AAoHA,OAAOA,GAAE,MAAO,iBAAgB;AAChC,SAASC,kBAAiB,QAAS,yBAAwB;AAE3D,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,WAAW,EAAE;QACXC,QAAQ,EAAE,EAAE;QACZC,QAAQ,EAAE;MACZ,CAAC;MACDC,YAAY,EAAE,KAAK;MACnBC,oBAAoB,EAAE,KAAK;MAC3BC,oBAAoB,EAAE,IAAI;MAC1BC,YAAY,EAAE;QACZL,QAAQ,EAAE,EAAE;QACZM,KAAK,EAAE,EAAE;QACTL,QAAQ,EAAE,EAAE;QACZM,SAAS,EAAE,EAAE;QACbC,UAAU,EAAE,EAAE;QACdC,KAAK,EAAE,EAAE;QACTC,OAAO,EAAE;MACX,CAAC;MACDC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE,KAAK;MACdC,gBAAgB,EAAE;IACpB;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACV,oBAAmB,GAAIR,kBAAkB,CAAC,IAAI,CAACmB,GAAG;EACzD,CAAC;EACDC,aAAaA,CAAA,EAAG;IACd,IAAI,IAAI,CAACZ,oBAAoB,EAAE,IAAI,CAACA,oBAAoB,CAAC;EAC3D,CAAC;EACDa,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MAClB,IAAI,CAACP,KAAI,GAAI,EAAC;MACd,IAAI,CAACC,OAAM,GAAI,IAAG;MAElB,IAAI;QACF,MAAMO,QAAO,GAAI,MAAMxB,GAAG,CAACyB,IAAI,CAAC,+BAA+B,EAAE,IAAI,CAACrB,WAAW;QACjF,IAAI,CAACsB,MAAM,CAACC,QAAQ,CAAC,OAAO,EAAE;UAC5BC,IAAI,EAAEJ,QAAQ,CAACrB,IAAI,CAACyB,IAAI;UACxBC,KAAK,EAAEL,QAAQ,CAACrB,IAAI,CAAC0B;QACvB,CAAC;QACD,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,wBAAwB;MAC5C,EAAE,OAAOC,GAAG,EAAE;QACZ,IAAI,CAAChB,KAAI,GAAIgB,GAAG,CAACR,QAAQ,EAAErB,IAAI,EAAE8B,OAAM,IAAK,iCAAgC;MAC9E,UAAU;QACR,IAAI,CAAChB,OAAM,GAAI,KAAI;MACrB;IACF,CAAC;IACD,MAAMiB,cAAcA,CAAA,EAAG;MACrB,IAAI;QACF,MAAMV,QAAO,GAAI,MAAMxB,GAAG,CAACyB,IAAI,CAAC,kCAAkC,EAAE,IAAI,CAACf,YAAY;QACrFyB,KAAK,CAACX,QAAQ,CAACrB,IAAI,CAAC8B,OAAO;QAC3B,IAAI,CAACf,gBAAe,GAAI,KAAI;QAC5B,IAAI,CAACR,YAAW,GAAI;UAClBL,QAAQ,EAAE,EAAE;UACZM,KAAK,EAAE,EAAE;UACTL,QAAQ,EAAE,EAAE;UACZM,SAAS,EAAE,EAAE;UACbC,UAAU,EAAE,EAAE;UACdC,KAAK,EAAE,EAAE;UACTC,OAAO,EAAE;QACX;MACF,EAAE,OAAOiB,GAAG,EAAE;QACZG,KAAK,CAACH,GAAG,CAACR,QAAQ,EAAErB,IAAI,EAAE8B,OAAM,IAAK,qBAAqB;MAC5D;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}