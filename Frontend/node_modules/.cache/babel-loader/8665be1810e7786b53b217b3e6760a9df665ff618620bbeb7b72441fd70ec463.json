ata.saving,\n    class: \"save-btn\"\n  }, _toDisplayString($data.saving ? 'Saving...' : 'Save Settings'), 9, _hoisted_6)])]);\n}","map":{"version":3,"names":["class","_createElementBlock","_createElementVNode","_hoisted_1","_hoisted_2","_Fragment","_renderList","$data","barangays","barangay","key","name","_hoisted_3","_toDisplayString","_hoisted_4","type","min","step","fee","$event","disabled","saving","number","onClick","_cache","args","$options","save","_hoisted_6"],"sources":["/var/www/kadiwa/Frontend/src/views/store/Logistics.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>Delivery Service</h2>\r\n    <div class=\"card\">\r\n      <p class=\"sub\">Set the delivery fee for each barangay.</p>\r\n\r\n      <div class=\"barangay-list\">\r\n        <div v-for=\"barangay in barangays\" :key=\"barangay.name\" class=\"barangay-row\">\r\n          <div class=\"barangay-name\">{{ barangay.name }}</div>\r\n          <div class=\"fee-input-wrapper\">\r\n            <span class=\"peso\">₱</span>\r\n            <input\r\n              type=\"number\"\r\n              min=\"0\"\r\n              step=\"0.01\"\r\n              v-model.number=\"barangay.fee\"\r\n              class=\"fee-input\"\r\n              :disabled=\"saving\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <button @click=\"save\" :disabled=\"saving\" class=\"save-btn\">{{ saving ? 'Saving...' : 'Save Settings' }}</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\nimport { BARANGAYS } from '../../constants/barangays'\r\n\r\nexport default {\r\n  name: 'StoreLogistics',\r\n  data() {\r\n    return {\r\n      saving: false,\r\n      barangays: BARANGAYS.map(name => ({ name, fee: 0 }))\r\n    }\r\n  },\r\n  methods: {\r\n    async loadBarangays() {\r\n      try {\r\n        const { data } = await api.get('/store/delivery-barangays')\r\n        if (Array.isArray(data.barangays) && data.barangays.length) {\r\n          this.barangays = data.barangays.map(row => ({\r\n            name: row.name,\r\n            fee: Number(row.fee || 0)\r\n          }))\r\n        }\r\n      } catch (err) {\r\n        console.error('Failed to load delivery barangays:', err.response?.data?.message)\r\n      }\r\n    },\r\n    async save() {\r\n      this.saving = true\r\n      try {\r\n        const barangays = {}\r\n        for (const barangay of this.barangays) {\r\n          barangays[barangay.name] = Number(barangay.fee || 0)\r\n        }\r\n        const { data } = await api.put('/store/delivery-barangays', { barangays })\r\n        if (Array.isArray(data.barangays)) {\r\n          this.barangays = data.barangays.map(row => ({\r\n            name: row.name,\r\n            fee: Number(row.fee || 0)\r\n          }))\r\n        }\r\n        alert(data.message || 'Delivery barangay settings updated')\r\n      } catch (err) {\r\n        alert(err.response?.data?.message || 'Failed to update delivery barangay settings')\r\n      } finally {\r\n        this.saving = false\r\n      }\r\n    }\r\n  },\r\n  async mounted() {\r\n    await this.loadBarangays()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.card {\r\n  max-width: 1100px;\r\n  background: #fff;\r\n  border: 1px solid #e6eddc;\r\n  border-radius: 10px;\r\n  padding: 20px;\r\n  box-shadow: 0 4px 14px rgba(56, 92, 35, 0.08);\r\n}\r\n\r\n.sub {\r\n  margin: 0 0 20px;\r\n  color: #6f7d67;\r\n}\r\n\r\n.barangay-list {\r\n  max-height: 60vh;\r\n  overflow-y: auto;\r\n  border: 1px solid #e6eddc;\r\n  border-radius: 8px;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.barangay-row {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 16px;\r\n  padding: 10px 12px;\r\n  border-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.barangay-row:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.barangay-name {\r\n  flex: 1;\r\n  font-size: 14px;\r\n  color: #333;\r\n}\r\n\r\n.fee-input-wrapper {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  width: fit-content;\r\n}\r\n\r\n.peso {\r\n  font-size: 12px;\r\n  color: #6f7d67;\r\n  font-weight: 500;\r\n}\r\n\r\n.fee-input {\r\n  width: 90px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 4px;\r\n  padding: 6px 8px;\r\n  background: #fff;\r\n  font-size: 13px;\r\n  text-align: right;\r\n  font-weight: 500;\r\n}\r\n\r\n.fee-input:hover {\r\n  border-color: #b5c89e;\r\n}\r\n\r\n.fee-input:focus {\r\n  outline: none;\r\n  border-color: #7CB342;\r\n  box-shadow: 0 0 4px rgba(124, 179, 66, 0.2);\r\n}\r\n\r\n.fee-input:disabled {\r\n  background: #f5f5f5;\r\n  cursor: not-allowed;\r\n  opacity: 0.6;\r\n}\r\n\r\n.save-btn {\r\n  background: linear-gradient(135deg, #7CB342, #4E7D32);\r\n  color: #fff;\r\n  border: none;\r\n  padding: 10px 20px;\r\n  border-radius: 6px;\r\n  cursor: pointer;\r\n  font-weight: 600;\r\n  font-size: 14px;\r\n}\r\n\r\n.save-btn:hover:not(:disabled) {\r\n  background: linear-gradient(135deg, #6ba32f, #3d6428);\r\n}\r\n\r\n.save-btn:disabled {\r\n  opacity: 0.6;\r\n  cursor: not-allowed;\r\n}\r\n\r\n/* mobile-dashboard-fix */\r\n.table-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}\r\n.table-wrap .table, table.table{width:100%}\r\n@media (max-width: 640px){\r\n  .toolbar,.filters,.head,.section-head,.graph-head,.forecast-tools,.reports-header,.form{flex-wrap:wrap}\r\n  .toolbar,.filters,.head,.section-head{display:flex;gap:8px}\r\n  .toolbar input,.search-input,input[type=\"search\"],.search{min-width:0!important;width:100%;max-width:100%}\r\n  .table-wrap .table, table.table{min-width:560px}\r\n  .btn,button.primary,button.save-btn{min-height:40px}\r\n  .barangay-row{flex-direction:column;align-items:stretch!important}\r\n  .map{height:260px!important}\r\n  .details-grid{grid-template-columns:1fr!important}\r\n  .card,.form{max-width:100%}\r\n}\r\n</style>\r\n"],"mappings":";;EAGSA,KAAK,EAAC;AAAM;;EAGVA,KAAK,EAAC;AAAe;;EAEjBA,KAAK,EAAC;AAAe;;EACrBA,KAAK,EAAC;AAAmB;;;;uBARt