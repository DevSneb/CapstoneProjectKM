ta.fieldErrors.password,\n    onBlur: _cache[4] || (_cache[4] = $event => $options.validateField('password')),\n    onInput: _cache[5] || (_cache[5] = $event => $options.clearFieldError('password'))\n  }, null, 40, _hoisted_8), [[_vModelDynamic, $data.credentials.password]]), _createElementVNode(\"button\", {\n    type: \"button\",\n    class: \"toggle-password\",\n    \"aria-label\": $data.showPassword ? 'Hide password' : 'Show password',\n    onClick: _cache[6] || (_cache[6] = $event => $data.showPassword = !$data.showPassword)\n  }, _toDisplayString($data.showPassword ? 'Hide' : 'Show'), 9, _hoisted_9)]), $data.fieldErrors.password ? (_openBlock(), _createElementBlock(\"p\", _hoisted_10, _toDisplayString($data.fieldErrors.password), 1)) : _createCommentVNode(\"\", true)], 2), _createElementVNode(\"button\", {\n    type: \"submit\",\n    class: \"login-btn\",\n    disabled: $data.loading\n  }, _toDisplayString($data.loading ? 'Logging in...' : 'Login'), 9, _hoisted_11)], 32), _createElementVNode(\"div\", _hoisted_12, [_createElementVNode(\"p\", null, [_cache[15] || (_cache[15] = _createTextVNode(\"Don't have an account? \", -1)), _createVNode(_component_router_link, {\n    to: \"/customer/register\"\n  }, {\n    default: _withCtx(() => [...(_cache[14] || (_cache[14] = [_createTextVNode(\"Register here\", -1)]))]),\n    _: 1\n  })]), _createElementVNode(\"p\", null, [_createVNode(_component_router_link, {\n    to: \"/\"\n  }, {\n    default: _withCtx(() => [...(_cache[16] || (_cache[16] = [_createTextVNode(\"← Back to home\", -1)]))]),\n    _: 1\n  })])])])]);\n}","map":{"version":3,"names":["class","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","_hoisted_3","_createVNode","_component_router_link","to","_cache","onSubmit","_withModifiers","args","$options","handleLogin","novalidate","$data","error","_hoisted_4","_toDisplayString","_normalizeClass","invalid","fieldErrors","username","for","type","id","credentials","$event","placeholder","autoc