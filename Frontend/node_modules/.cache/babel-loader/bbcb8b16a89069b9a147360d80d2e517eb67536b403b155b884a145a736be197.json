             :aria-invalid=\"!!fieldErrors.password\"\r\n              @blur=\"validateField('password')\"\r\n              @input=\"clearFieldError('password')\"\r\n            />\r\n            <button\r\n              type=\"button\"\r\n              class=\"toggle-password\"\r\n              :aria-label=\"showPassword ? 'Hide password' : 'Show password'\"\r\n              @click=\"showPassword = !showPassword\"\r\n            >\r\n              {{ showPassword ? 'Hide' : 'Show' }}\r\n            </button>\r\n          </div>\r\n          <p v-if=\"fieldErrors.password\" class=\"field-error\">{{ fieldErrors.password }}</p>\r\n        </div>\r\n\r\n        <button type=\"submit\" class=\"login-btn\" :disabled=\"loading\">\r\n          {{ loading ? 'Logging in...' : 'Login' }}\r\n        </button>\r\n      </form>\r\n\r\n      <div class=\"links\">\r\n        <p>Don't have an account? <router-link to=\"/customer/register\">Register here</router-link></p>\r\n        <p><router-link to=\"/\">← Back to home</router-link></p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../services/api'\r\nimport { bindKeyboardScroll } from '../utils/keyboardScroll'\r\n\r\nexport default {\r\n  name: 'CustomerLogin',\r\n  data() {\r\n    return {\r\n      credentials: {\r\n        username: '',\r\n        password: ''\r\n      },\r\n      fieldErrors: {\r\n        username: '',\r\n        password: ''\r\n      },\r\n      showPassword: false,\r\n      error: '',\r\n      loading: false,\r\n      unbindKeyboardScroll: null\r\n    }\r\n  },\r\n  mounted() {\r\n    this.unbindKeyboardScroll = bindKeyboardScroll(this.$el)\r\n  },\r\n  beforeUnmount() {\r\n    if (this.unbindKeyboardScroll) this.unbindKeyboardScroll()\r\n  },\r\n  methods: {\r\n    clearFieldError(field) {\r\n      this.fieldErrors[field] = ''\r\n    },\r\n    validateField(field) {\r\n      if (field === 'username') {\r\n        const value = String(this.credentials.username || '').trim()\r\n        if (!value) this.fieldErrors.username = 'Username is required.'\r\n        else if (value.length < 3) this.fieldErrors.username = 'Username must be at least 3 characters.'\r\n        else this.fieldErrors.username = ''\r\n      }\r\n      if (field === 'password') {\r\n        const value = String(this.credentials.password || '')\r\n        if (!value) this.fieldErrors.password = 'Password is required.'\r\n        else if (value.length < 6) this.fieldErrors.password = 'Password must be at least 6 characters.'\r\n        else this.fieldErrors.password = ''\r\n      }\r\n      return !this.fieldErrors[field]\r\n    },\r\n    validateForm() {\r\n      const userOk = this.validateField('username')\r\n      const passOk = this.validateField('password')\r\n      return userOk && passOk\r\n    },\r\n    async handleLogin() {\r\n      this.error = ''\r\n      if (!this.validateForm()) return\r\n\r\n      this.loading = true\r\n      try {\r\n        const response = await api.post('/customer/auth/login', {\r\n          username: String(this.credentials.username || '').trim(),\r\n          password: this.credentials.password\r\n        })\r\n\r\n        this.$store.dispatch('login', {\r\n          user: response.data.user,\r\n          token: response.data.token\r\n        })\r\n\r\n        this.$router.push('/customer/dashboard')\r\n      } catch (err) {\r\n        this.error = err.response?.data?.message || 'Login failed. Please try again.'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: flex-start;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  background: radial-gradient(circle at 15% 15%, rgba(124, 179, 66, 0.3), transparent 45%),\r\n              radial-gradient(circle at 85% 85%, rgba(78, 125, 50, 0.26), transparent 42%),\r\n              linear-gradient(135deg, #edf5e2 0%, #d9e7c7 100%);\r\n  padding: max(20px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom));\r\n  position: relative;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.login-container::before,\r\n.login-container::after {\r\n  content: '';\r\n  position: absolute;\r\n  border-radius: 999px;\r\n  pointer-events: none;\r\n}\r\n\r\n.login-container::before {\r\n  width: 280px;\r\n  height: 280px;\r\n  background: rgba(124, 179, 66, 0.18);\r\n  top: -90px;\r\n  left: -70px;\r\n}\r\n\r\n.login-container::after {\r\n  width: 220px;\r\n  height: 220px;\r\n  background: rgba(53, 94, 42, 0.14);\r\n  right: -60px;\r\n  bottom: -60px;\r\n}\r\n\r\n.login-box {\r\n  background: rgba(255, 255, 255, 0.88);\r\n  backdrop-filter: blur(8px);\r\n  -webkit-backdrop-filter: blur(8px);\r\n  padding: 36px;\r\n  border-radius: 18px;\r\n  border: 1px solid rgba(205, 219, 185, 0.9);\r\n  box-shadow: 0 18px 40px rgba(56, 92, 35, 0.18);\r\n  width: 100%;\r\n  max-width: 420px;\r\n  position: relative;\r\n  z-index: 1;\r\n  margin: auto 0;\r\n}\r\n\r\n.login-header {\r\n  text-align: center;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.eyebrow {\r\n  display: inline-block;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n  color: #4E7D32;\r\n  background: #eaf2de;\r\n  border: 1px solid #d5e4bf;\r\n  border-radius: 999px;\r\n  padding: 4px 10px;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.home-link {\r\n  display: inline-block;\r\n  color: #355e2a;\r\n  text-decoration: none;\r\n  font-size: 30px;\r\n  font-weight: 700;\r\n  line-height: 1.1;\r\n  margin-bottom: 8px;\r\n}\r\n.home-link:hover { text-decoration: underline; }\r\n\r\n.login-header h2 {\r\n  color: #5f7256;\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  margin: 0;\r\n}\r\n\r\n.subtext {\r\n  color: #6f7d67;\r\n  margin: 8px 0 0;\r\n  font-size: 13px;\r\n}\r\n\r\n.error-message {\r\n  background: #fff1f1;\r\n  color: #b42318;\r\n  padding: 10px 12px;\r\n  border-radius: 10px;\r\n  border: 1px solid #f4c8c8;\r\n  margin-bottom: 15px;\r\n  text-align: center;\r\n  font-size: 13px;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 7px;\r\n  color: #355e2a;\r\n  font-weight: 600;\r\n  font-size: 13px;\r\n}\r\n\r\n.form-group input {\r\n  width: 100%;\r\n  padding: 12px 13px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 10px;\r\n  font-size: 14px;\r\n  transition: border-color 0.2s ease, box-shadow 0.2s ease;\r\n  background: #fff;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.form-group input:focus {\r\n  outline: none;\r\n  border-color: #7CB342;\r\n  box-shadow: 0 0 0 4px rgba(124, 179, 66, 0.2);\r\n}\r\n\r\n.form-group.invalid input {\r\n  border-color: #e07a6c;\r\n  box-shadow: 0 0 0 3px rgba(180, 35, 24, 0.12);\r\n}\r\n\r\n.field-error {\r\n  margin: 6px 0 0;\r\n  color: #b42318;\r\n  font-size: 12px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.password-field {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.password-field input {\r\n  width: 100%;\r\n  padding-right: 64px;\r\n}\r\n.toggle-password {\r\n  position: absolute;\r\n  right: 8px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  border: none;\r\n  background: transparent;\r\n  color: #4E7D32;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  padding: 6px 8px;\r\n  border-radius: 8px;\r\n  min-height: 36px;\r\n}\r\n.toggle-password:hover {\r\n  background: rgba(124, 179, 66, 0.12);\r\n}\r\n\r\n.login-btn {\r\n  width: 100%;\r\n  margin-top: 6px;\r\n  padding: 12px;\r\n  background: linear-gradient(135deg, #7CB342, #4E7D32);\r\n  color: white;\r\n  border: none;\r\n  border-radius: 10px;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;\r\n  box-shadow: 0 10px 20px rgba(78, 125, 50, 0.24);\r\n  min-