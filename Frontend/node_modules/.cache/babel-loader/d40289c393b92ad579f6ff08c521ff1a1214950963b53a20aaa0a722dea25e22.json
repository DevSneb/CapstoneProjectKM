{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport api from '../services/api';\nconst API_ROOT = (api.defaults.baseURL || '').replace(/\\/api\\/?$/, '');\nexport default {\n  name: 'CustomerProducts',\n  data() {\n    return {\n      products: [],\n      q: '',\n      storeOwnerId: 0,\n      stores: [],\n      debounceTimer: null\n    };\n  },\n  async created() {\n    await this.fetchStores();\n    await this.fetchProducts();\n  },\n  methods: {\n    async fetchStores() {\n      // Derive store list from all active products returned by customer endpoint\n      const resp = await api.get('/customer/products');\n      const uniq = {};\n      resp.data.forEach(p => {\n        if (p.store_owner_id) uniq[p.store_owner_id] = true;\n      });\n      this.stores = Object.keys(uniq).map(id => ({\n        id: Number(id),\n        store_name: `Store ${id}`\n      }));\n    },\n    async fetchProducts() {\n      const params = {};\n      if (this.q) params.q = this.q;\n      if (this.storeOwnerId) params.storeOwnerId = this.storeOwnerId;\n      const {\n        data\n      } = await api.get('/customer/products', {\n        params\n      });\n      this.products = data;\n    },\n    debouncedFetch() {\n      clearTimeout(this.debounceTimer);\n      this.debounceTimer = setTimeout(() => this.fetchProducts(), 300);\n    },\n    add(p) {\n      this.$store.dispatch('addToCart', {\n        product_id: p.id,\n        name: this.productLabel(p),\n        unit_price: p.price,\n        quantity: 1,\n        store_owner_id: p.store_owner_id\n      });\n    },\n    toPublicImageUrl(imageUrl) {\n      if (!imageUrl) return '';\n      if (/^https?:\\/\\//i.test(imageUrl)) return imageUrl;\n      return `${API_ROOT}${imageUrl.startsWith('/') ? '' : '/'}${imageUrl}`;\n    },\n    productLabel(p) {\n      return p.description || '—';\n    },\n    fmt(v) {\n      const n = Number(v);\n      return isFinite(n) ? n.toFixed(2) : '0.00';\n    }\n  }\n};","map":{"version":3,"names":["api","API_ROOT","defaults","baseURL","replace","name","data","products","q","storeOwnerId","stores","debounceTimer","created","fetchStores","fetchProducts","methods","resp","get","uniq","forEach","p","store_owner_id","Object","keys","map","id","Number","store_name","params","debouncedFetch","clearTimeout","setTimeout","add","$store","dispatch","product_id","productLabel","unit_price","price","quantity","toPublicImageUrl","imageUrl","test","startsWith","description","fmt","v","n","isFinite","toFixed"],"sources":["C:\\Users\\Nicole\\Downloads\\CapstoneProject (19)\\CapstoneProject\\Frontend\\src\\views\\CustomerProducts.vue"],"sourcesContent":["<template>\r\n  <div class=\"page\">\r\n    <h2>Products</h2>\r\n    <div class=\"toolbar\">\r\n      <input v-model=\"q\" @input=\"debouncedFetch\" placeholder=\"Search products...\"/>\r\n      <select v-model.number=\"storeOwnerId\" @change=\"fetchProducts\">\r\n        <option :value=\"0\">All Stores</option>\r\n        <option v-for=\"s in stores\" :key=\"s.id\" :value=\"s.id\">{{ s.store_name }}</option>\r\n      </select>\r\n    </div>\r\n    <div class=\"grid\">\r\n      <div class=\"card\" v-for=\"p in products\" :key=\"p.id\">\r\n        <img v-if=\"p.image_url\" :src=\"toPublicImageUrl(p.image_url)\" alt=\"Product image\" class=\"product-image\" />\r\n        <h3>{{ productLabel(p) }}</h3>\r\n        <p class=\"desc\">{{ p.description || '—' }}</p>\r\n        <p class=\"meta\">{{ p.unit || '' }} • {{ p.category || '' }}</p>\r\n        <p class=\"price\">₱{{ fmt(p.price) }}</p>\r\n        <button @click=\"add(p)\">Add to Cart</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../services/api'\r\nconst API_ROOT = (api.defaults.baseURL || '').replace(/\\/api\\/?$/, '')\r\nexport default{\r\n  name:'CustomerProducts',\r\n  data(){return{products:[], q:'', storeOwnerId:0, stores:[], debounceTimer:null}},\r\n  async created(){\r\n    await this.fetchStores();\r\n    await this.fetchProducts();\r\n  },\r\n  methods:{\r\n    async fetchStores(){\r\n      // Derive store list from all active products returned by customer endpoint\r\n      const resp = await api.get('/customer/products');\r\n      const uniq = {};\r\n      resp.data.forEach(p=>{ if(p.store_owner_id) uniq[p.store_owner_id] = true });\r\n      this.stores = Object.keys(uniq).map(id=>({ id:Number(id), store_name:`Store ${id}` }));\r\n    },\r\n    async fetchProducts(){\r\n      const params = {};\r\n      if(this.q) params.q = this.q;\r\n      if(this.storeOwnerId) params.storeOwnerId = this.storeOwnerId;\r\n      const { data } = await api.get('/customer/products', { params });\r\n      this.products = data;\r\n    },\r\n    debouncedFetch(){ clearTimeout(this.debounceTimer); this.debounceTimer = setTimeout(()=>this.fetchProducts(), 300) },\r\n    add(p){\r\n      this.$store.dispatch('addToCart', { product_id: p.id, name: this.productLabel(p), unit_price: p.price, quantity: 1, store_owner_id: p.store_owner_id })\r\n    },\r\n    toPublicImageUrl(imageUrl){\r\n      if (!imageUrl) return ''\r\n      if (/^https?:\\/\\//i.test(imageUrl)) return imageUrl\r\n      return `${API_ROOT}${imageUrl.startsWith('/') ? '' : '/'}${imageUrl}`\r\n    },\r\n    productLabel(p){ return p.description || '—' },\r\n    fmt(v){ const n=Number(v); return isFinite(n)?n.toFixed(2):'0.00' }\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n.page{padding:20px}\r\n.toolbar{display:flex;gap:10px;margin-bottom:12px}\r\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px}\r\n.card{background:#fff;padding:12px;border:1px solid #eee;border-radius:8px}\r\n.product-image{width:100%;height:130px;object-fit:cover;border-radius:6px;margin-bottom:8px;border:1px solid #eee}\r\n.card h3{margin:0 0 4px}\r\n.desc{color:#666;height:40px;overflow:hidden}\r\n.price{font-weight:bold;color:#e04357}\r\nbutton{padding:8px 10px;border:1px solid #ddd;background:#fff;border-radius:6px;cursor:pointer}\r\n</style>\r\n"],"mappings":";;;AAuBA,OAAOA,GAAE,MAAO,iBAAgB;AAChC,MAAMC,QAAO,GAAI,CAACD,GAAG,CAACE,QAAQ,CAACC,OAAM,IAAK,EAAE,EAAEC,OAAO,CAAC,WAAW,EAAE,EAAE;AACrE,eAAc;EACZC,IAAI,EAAC,kBAAkB;EACvBC,IAAIA,CAAA,EAAE;IAAC,OAAM;MAACC,QAAQ,EAAC,EAAE;MAAEC,CAAC,EAAC,EAAE;MAAEC,YAAY,EAAC,CAAC;MAAEC,MAAM,EAAC,EAAE;MAAEC,aAAa,EAAC;IAAI,CAAC;EAAA,CAAC;EAChF,MAAMC,OAAOA,CAAA,EAAE;IACb,MAAM,IAAI,CAACC,WAAW,CAAC,CAAC;IACxB,MAAM,IAAI,CAACC,aAAa,CAAC,CAAC;EAC5B,CAAC;EACDC,OAAO,EAAC;IACN,MAAMF,WAAWA,CAAA,EAAE;MACjB;MACA,MAAMG,IAAG,GAAI,MAAMhB,GAAG,CAACiB,GAAG,CAAC,oBAAoB,CAAC;MAChD,MAAMC,IAAG,GAAI,CAAC,CAAC;MACfF,IAAI,CAACV,IAAI,CAACa,OAAO,CAACC,CAAC,IAAE;QAAE,IAAGA,CAAC,CAACC,cAAc,EAAEH,IAAI,CAACE,CAAC,CAACC,cAAc,IAAI,IAAG;MAAE,CAAC,CAAC;MAC5E,IAAI,CAACX,MAAK,GAAIY,MAAM,CAACC,IAAI,CAACL,IAAI,CAAC,CAACM,GAAG,CAACC,EAAE,KAAG;QAAEA,EAAE,EAACC,MAAM,CAACD,EAAE,CAAC;QAAEE,UAAU,EAAC,SAASF,EAAE;MAAG,CAAC,CAAC,CAAC;IACxF,CAAC;IACD,MAAMX,aAAaA,CAAA,EAAE;MACnB,MAAMc,MAAK,GAAI,CAAC,CAAC;MACjB,IAAG,IAAI,CAACpB,CAAC,EAAEoB,MAAM,CAACpB,CAAA,GAAI,IAAI,CAACA,CAAC;MAC5B,IAAG,IAAI,CAACC,YAAY,EAAEmB,MAAM,CAACnB,YAAW,GAAI,IAAI,CAACA,YAAY;MAC7D,MAAM;QAAEH;MAAK,IAAI,MAAMN,GAAG,CAACiB,GAAG,CAAC,oBAAoB,EAAE;QAAEW;MAAO,CAAC,CAAC;MAChE,IAAI,CAACrB,QAAO,GAAID,IAAI;IACtB,CAAC;IACDuB,cAAcA,CAAA,EAAE;MAAEC,YAAY,CAAC,IAAI,CAACnB,aAAa,CAAC;MAAE,IAAI,CAACA,aAAY,GAAIoB,UAAU,CAAC,MAAI,IAAI,CAACjB,aAAa,CAAC,CAAC,EAAE,GAAG;IAAE,CAAC;IACpHkB,GAAGA,CAACZ,CAAC,EAAC;MACJ,IAAI,CAACa,MAAM,CAACC,QAAQ,CAAC,WAAW,EAAE;QAAEC,UAAU,EAAEf,CAAC,CAACK,EAAE;QAAEpB,IAAI,EAAE,IAAI,CAAC+B,YAAY,CAAChB,CAAC,CAAC;QAAEiB,UAAU,EAAEjB,CAAC,CAACkB,KAAK;QAAEC,QAAQ,EAAE,CAAC;QAAElB,cAAc,EAAED,CAAC,CAACC;MAAe,CAAC;IACxJ,CAAC;IACDmB,gBAAgBA,CAACC,QAAQ,EAAC;MACxB,IAAI,CAACA,QAAQ,EAAE,OAAO,EAAC;MACvB,IAAI,eAAe,CAACC,IAAI,CAACD,QAAQ,CAAC,EAAE,OAAOA,QAAO;MAClD,OAAO,GAAGxC,QAAQ,GAAGwC,QAAQ,CAACE,UAAU,CAAC,GAAG,IAAI,EAAC,GAAI,GAAG,G