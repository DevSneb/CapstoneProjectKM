{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport api from '../../services/api';\nconst API_ROOT = (api.defaults.baseURL || '').replace(/\\/api\\/?$/, '');\nconst UNIT_OPTIONS = ['PC/S', 'KG/S', 'LT/S'];\nconst CATEGORY_OPTIONS = ['LOWLAND', 'HIGHLAND', 'FRUITS', 'RICE', 'EGGS (pc)', 'SEAFOOD', 'PORK', 'BEEF', 'CHICKEN', 'OTHER PRODUCTS'];\nfunction matchPreset(value, options) {\n  const raw = String(value || '').trim();\n  if (!raw) return '';\n  const found = options.find(opt => opt.toLowerCase() === raw.toLowerCase());\n  return found || '';\n}\nexport default {\n  props: {\n    mode: {\n      type: String,\n      required: true\n    }\n  },\n  data() {\n    return {\n      rows: [],\n      page: 1,\n      pageSize: 25,\n      searchQ: '',\n      editingId: null,\n      savingId: null,\n      editForm: null,\n      editImageDataUrl: null,\n      editImagePreviewUrl: ''\n    };\n  },\n  async created() {\n    await this.refreshRows();\n  },\n  computed: {\n    unitOptions() {\n      return UNIT_OPTIONS;\n    },\n    categoryOptions() {\n      return CATEGORY_OPTIONS;\n    },\n    filteredRows() {\n      const q = this.searchQ.toLowerCase();\n      if (!q) return this.rows;\n      return this.rows.filter(p => {\n        const hay = [p.name, p.description, p.category, p.unit, p.status].map(x => String(x || '').toLowerCase()).join(' ');\n        return hay.includes(q);\n      });\n    },\n    sortedRows() {\n      return [...this.filteredRows].sort((a, b) => String(a.name || '').localeCompare(String(b.name || '')));\n    },\n    totalPages() {\n      return Math.max(1, Math.ceil(this.sortedRows.length / this.pageSize));\n    },\n    paginatedRows() {\n      const start = (this.page - 1) * this.pageSize;\n      return this.sortedRows.slice(start, start + this.pageSize);\n    }\n  },\n  watch: {\n    pageSize() {\n      this.page = 1;\n    },\n    searchQ() {\n      this.page = 1;\n    }\n  },\n  methods: {\n    startEdit(p) {\n      const normalizedUnit = matchPreset(p.unit, UNIT_OPTIONS);\n      const normalizedCategory = matchPreset(p.category, CATEGORY_OPTIONS);\n      const resolvedUnit = this.unitOptions.includes(normalizedUnit) ? normalizedUnit : '__other__';\n      const resolvedCategory = this.categoryOptions.includes(normalizedCategory) ? normalizedCategory : '__other__';\n      this.editingId = p.id;\n      this.editImageDataUrl = null;\n      this.editImagePreviewUrl = '';\n      this.editForm = {\n        name: p.name || '',\n        description: p.description || '',\n        unit: resolvedUnit,\n        unit_other: resolvedUnit === '__other__' ? String(p.unit || '').trim() : '',\n        cost: p.cost ?? null,\n        srp: p.srp ?? null,\n        srp_vat: p.srp_vat ?? null,\n        category: resolvedCategory,\n        category_other: resolvedCategory === '__other__' ? String(p.category || '').trim() : '',\n        stock: Number(p.stock || 0),\n        price: Number(p.price || 0),\n        status: p.status || 'active',\n        image_url: p.image_url || null\n      };\n    },\n    cancelEdit() {\n      this.editingId = null;\n      this.savingId = null;\n      this.editForm = null;\n      this.editImageDataUrl = null;\n      this.editImagePreviewUrl = '';\n    },\n    async onEditImageSelected(event) {\n      const file = event.target?.files?.[0];\n      if (!file) {\n        this.editImageDataUrl = null;\n        this.editImagePreviewUrl = '';\n        return;\n      }\n      if (!file.type.startsWith('image/')) {\n        alert('Please select a valid image file.');\n        event.target.value = '';\n        return;\n      }\n      if (file.size > 2 * 1024 * 1024) {\n        alert('Image is too large. Maximum size is 2MB.');\n        event.target.value = '';\n        return;\n      }\n      this.editImageDataUrl = await this.readAsDataUrl(file);\n      this.editImagePreviewUrl = this.editImageDataUrl;\n    },\n    readAsDataUrl(file) {\n      return new Promise((resolve, reject) => {\n        const reader = new FileReader();\n        reader.onload = () => resolve(reader.result);\n        reader.onerror = () => reject(new Error('Failed to read image file'));\n        reader.readAsDataURL(file);\n      });\n    },\n    async saveEdit(id) {\n      if (!this.editForm) return;\n      const stockValue = Number(this.editForm.stock);\n      const priceValue = Number(this.editForm.price);\n      const costValue = this.editForm.cost === null || this.editForm.cost === '' || typeof this.editForm.cost === 'undefined' ? null : Number(this.editForm.cost);\n      const srpValue = this.editForm.srp === null || this.editForm.srp === '' || typeof this.editForm.srp === 'undefined' ? null : Number(this.editForm.srp);\n      const srpVatValue = this.editForm.srp_vat === null || this.editForm.srp_vat === '' || typeof this.editForm.srp_vat === 'undefined' ? null : Number(this.editForm.srp_vat);\n      if (!Number.isInteger(stockValue) || stockValue < 0) {\n        alert('Stock must be a non-negative whole number.');\n        return;\n      }\n      if (!Number.isFinite(priceValue) || priceValue < 0) {\n        alert('Price must be a non-negative number.');\n        return;\n      }\n      const resolvedUnit = this.editForm.unit === '__other__' ? (this.editForm.unit_other || '').trim() : this.editForm.unit;\n      const resolvedCategory = this.editForm.category === '__other__' ? (this.editForm.category_other || '').trim() : this.editForm.category;\n      const finalUnit = resolvedUnit;\n      const finalCategory = resolvedCategory;\n      if (!finalUnit) {\n        alert('Please select a unit or specify one in Others.');\n        return;\n      }\n      if (!finalCategory) {\n        alert('Please select a category or specify one in Others.');\n        return;\n      }\n      if (costValue !== null && (!Number.isFinite(costValue) || costValue < 0)) {\n        alert('Cost must be a non-negative number.');\n        return;\n      }\n      if (srpValue !== null && (!Number.isFinite(srpValue) || srpValue < 0)) {\n        alert('SRP must be a non-negative number.');\n        return;\n      }\n      if (srpVatValue !== null && (!Number.isFinite(srpVatValue) || srpVatValue < 0)) {\n        alert('SRP (VAT) must be a non-negative number.');\n        return;\n      }\n      this.savingId = id;\n      try {\n        await api.put(`/store/products/${id}`, {\n          name: this.editForm.name,\n          description: this.editForm.description,\n          unit: finalUnit,\n          category: finalCategory,\n          price: priceValue,\n          cost: costValue,\n          srp: srpValue,\n          srp_vat: srpVatValue,\n          status: this.editForm.status,\n          stock: stockValue,\n          image_data_url: this.editImageDataUrl || null\n        });\n        await this.refreshRows();\n        this.cancelEdit();\n      } catch (err) {\n        const backendErrors = err.response?.data?.errors;\n        const backendMessage = Array.isArray(backendErrors) && backendErrors.length ? backendErrors.map(e => e.msg).join(', ') : err.response?.data?.message;\n        alert(backendMessage || 'Failed to update product');\n      } finally {\n        this.savingId = null;\n      }\n    },\n    async deleteProduct(p) {\n      if (!confirm(`Delete product \"${p.name}\"?`)) return;\n      try {\n        await api.delete(`/store/products/${p.id}`);\n        if (this.editingId === p.id) this.cancelEdit();\n        await this.refreshRows();\n      } catch (err) {\n        alert(err.response?.data?.message || 'Failed to delete product');\n      }\n    },\n    async refreshRows() {\n      if (this.mode === 'low') {\n        const {\n          data\n        } = await api.get('/store/inventory/low');\n        this.rows = data;\n      } else if (this.mode === 'out') {\n        const {\n          data\n        } = await api.get('/store/inventory/out');\n        this.rows = data;\n      } else {\n        const {\n          data\n        } = await api.get('/store/products');\n        this.rows = data;\n      }\n      if (this.page > this.totalPages) this.page = this.totalPages;\n    },\n    prevPage() {\n      if (this.page > 1) this.page--;\n    },\n    nextPage() {\n      if (this.page < this.totalPages) this.page++;\n    },\n    formatCurrency(v) {\n      const n = Number(v);\n      return isFinite(n) ? n.toFixed(2) : '0.00';\n    },\n    toPublicImageUrl(imageUrl) {\n      if (!imageUrl) return '';\n      if (/^https?:\\/\\//i.test(imageUrl)) return imageUrl;\n      return `${API_ROOT}${imageUrl.startsWith('/') ? '' : '/'}${imageUrl}`;\n    },\n    formatDateTime(value) {\n      if (!value) return '—';\n      const parsed = new Date(value);\n      if (Number.isNaN(parsed.getTime())) return '—';\n      return parsed.toLocaleString();\n    }\n  }\n};","map":{"version":3,"names":["api","API_ROOT","defaults","baseURL","replace","UNIT_OPTIONS","CATEGORY_OPTIONS","matchPreset","value","options","raw","String","trim","found","find","opt","toLowerCase","props","mode","type","required","data","rows","page","pageSize","searchQ","editingId","savingId","editForm","editImageDataUrl","editImagePreviewUrl","created","refreshRows","computed","unitOptions","categoryOptions","filteredRows","q","filter","p","hay","name","description","category","unit","status","map","x","join","includes","sortedRows","sort","a","b","localeCompare","totalPages","Math","max","ceil","length","paginatedRows","start","slice","watch","methods","startEdit","normalizedUnit","normalizedCategory","resolvedUnit","resolvedCategory","id","unit_other","cost","srp","srp_vat","category_other","stock","Number","price","image_url","cancelEdit","onEditImageSelected","event","file","target","files","startsWith","alert","size","readAsDataUrl","Promise","resolve","reject","reader","FileReader","onload","result","onerror","Error","readAsDataURL","saveEdit","stockValue","priceValue","costValue","srpValue","srpVatValue","isInteger","isFinite","finalUnit","finalCategory","put","image_data_url","err","backendErrors","response","errors","backendMessage","Array","isArray","e","msg","message","deleteProduct","confirm","delete","get","prevPage","nextPage","formatCurrency","v","n","toFixed","toPublicImageUrl","imageUrl","test","formatDateTime","parsed","Date","isNaN","getTime","toLocaleString"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\store\\_InventoryTable.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"toolbar\">\r\n      <div class=\"left\">\r\n        <strong>Items:</strong> {{ filteredRows.length }}\r\n        <input v-model.trim=\"searchQ\" class=\"search-input\" placeholder=\"Search products...\" />\r\n      </div>\r\n      <div class=\"right\">\r\n        <label>Per page\r\n          <select v-model.number=\"pageSize\">\r\n            <option :value=\"10\">10</option>\r\n            <option :value=\"25\">25</option>\r\n            <option :value=\"50\">50</option>\r\n            <option :value=\"100\">100</option>\r\n          </select>\r\n        </label>\r\n        <button class=\"btn\" :disabled=\"page===1\" @click=\"prevPage\">Prev</button>\r\n        <span class=\"page\">Page {{ page }} / {{ totalPages }}</span>\r\n        <button class=\"btn\" :disabled=\"page===totalPages\" @click=\"nextPage\">Next</button>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"table-wrapper\">\r\n      <table class=\"table\">\r\n        <thead>\r\n          <tr>\r\n            <th>Image</th>\r\n            <th>Name</th>\r\n            <th>Description</th>\r\n            <th>Unit</th>\r\n            <th>Cost</th>\r\n            <th>SRP</th>\r\n            <th>SRP (VAT)</th>\r\n            <th>Category</th>\r\n            <th>Stock</th>\r\n            <th>Price</th>\r\n            <th>Last Changed</th>\r\n            <th>Status</th>\r\n            <th>Actions</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"p in paginatedRows\" :key=\"p.id\">\r\n            <td>\r\n              <template v-if=\"editingId === p.id\">\r\n                <img v-if=\"editImagePreviewUrl\" :src=\"editImagePreviewUrl\" alt=\"Product\" class=\"thumb\" />\r\n                <img v-else-if=\"editForm.image_url\" :src=\"toPublicImageUrl(editForm.image_url)\" alt=\"Product\" class=\"thumb\" />\r\n                <span v-else>—</span>\r\n                <input type=\"file\" accept=\"image/*\" @change=\"onEditImageSelected\" class=\"file-input\" />\r\n              </template>\r\n              <template v-else>\r\n                <img v-if=\"p.image_url\" :src=\"toPublicImageUrl(p.image_url)\" alt=\"Product\" class=\"thumb\" />\r\n                <span v-else>—</span>\r\n              </template>\r\n            </td>\r\n            <td>\r\n              <input v-if=\"editingId === p.id\" v-model.trim=\"editForm.name\" class=\"txt-input\" />\r\n              <span v-else>{{ p.name }}</span>\r\n            </td>\r\n            <td class=\"desc\">\r\n              <input v-if=\"editingId === p.id\" v-model.trim=\"editForm.description\" class=\"txt-input\" />\r\n              <span v-else>{{ p.description || '—' }}</span>\r\n            </td>\r\n            <td>\r\n              <template v-if=\"editingId === p.id\">\r\n                <select v-model=\"editForm.unit\">\r\n                  <option disabled value=\"\">Select unit</option>\r\n                  <option v-for=\"u in unitOptions\" :key=\"u\" :value=\"u\">{{ u }}</option>\r\n                  <option value=\"__other__\">Others</option>\r\n                </select>\r\n                <input\r\n                  v-if=\"editForm.unit === '__other__'\"\r\n                  v-model.trim=\"editForm.unit_other\"\r\n                  class=\"txt-input short-input\"\r\n                  placeholder=\"Specify unit\"\r\n                />\r\n              </template>\r\n              <span v-else>{{ p.unit || '—' }}</span>\r\n            </td>\r\n            <td>\r\n              <input v-if=\"editingId === p.id\" type=\"number\" min=\"0\" step=\"0.01\" v-model.number=\"editForm.cost\" class=\"price-input\" />\r\n              <span v-else>{{ formatCurrency(p.cost) }}</span>\r\n            </td>\r\n            <td>\r\n              <input v-if=\"editingId === p.id\" type=\"number\" min=\"0\" step=\"0.01\" v-model.number=\"editForm.srp\" class=\"price-input\" />\r\n              <span v-else>{{ formatCurrency(p.srp) }}</span>\r\n            </td>\r\n            <td>\r\n              <input v-if=\"editingId === p.id\" type=\"number\" min=\"0\" step=\"0.01\" v-model.number=\"editForm.srp_vat\" class=\"price-input\" />\r\n              <span v-else>{{ formatCurrency(p.srp_vat) }}</span>\r\n            </td>\r\n            <td>\r\n              <template v-if=\"editingId === p.id\">\r\n                <select v-model=\"editForm.category\">\r\n                  <option disabled value=\"\">Select category</option>\r\n                  <option v-for=\"c in categoryOptions\" :key=\"c\" :value=\"c\">{{ c }}</option>\r\n                  <option value=\"__other__\">Others</option>\r\n                </select>\r\n                <input\r\n                  v-if=\"editForm.category === '__other__'\"\r\n                  v-model.trim=\"editForm.category_other\"\r\n                  class=\"txt-input\"\r\n                  placeholder=\"Specify category\"\r\n                />\r\n              </template>\r\n              <span v-else>{{ p.category || '—' }}</span>\r\n            </td>\r\n            <td>\r\n              <input v-if=\"editingId === p.id\" type=\"number\" min=\"0\" v-model.number=\"editForm.stock\" class=\"stock-input\" />\r\n              <span v-else>{{ Number(p.stock || 0) }}</span>\r\n            </td>\r\n            <td>\r\n              <input v-if=\"editingId === p.id\" type=\"number\" min=\"0\" step=\"0.01\" v-model.number=\"editForm.price\" class=\"price-input\" />\r\n              <span v-else>{{ formatCurrency(p.price) }}</span>\r\n            </td>\r\n            <td>{{ formatDateTime(p.updated_at) }}</td>\r\n            <td>\r\n              <select v-if=\"editingId === p.id\" v-model=\"editForm.status\">\r\n                <option value=\"active\">active</option>\r\n                <option value=\"inactive\">inactive</option>\r\n              </select>\r\n              <span v-else>{{ p.status }}</span>\r\n            </td>\r\n            <td class=\"actions\">\r\n              <template v-if=\"editingId === p.id\">\r\n                <button class=\"save\" :disabled=\"savingId===p.id\" @click=\"saveEdit(p.id)\">Save</button>\r\n                <button class=\"btn danger-outline\" @click=\"cancelEdit\">Cancel</button>\r\n              </template>\r\n              <template v-else>\r\n                <button class=\"btn\" @click=\"startEdit(p)\">Edit</button>\r\n                <button class=\"btn danger\" @click=\"deleteProduct(p)\">Delete</button>\r\n              </template>\r\n            </td>\r\n          </tr>\r\n          <tr v-if=\"filteredRows.length===0\"><td colspan=\"13\" class=\"empty\">No items</td></tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../../services/api'\r\nconst API_ROOT = (api.defaults.baseURL || '').replace(/\\/api\\/?$/, '')\r\nconst UNIT_OPTIONS = ['PC/S', 'KG/S', 'LT/S']\r\nconst CATEGORY_OPTIONS = ['LOWLAND', 'HIGHLAND', 'FRUITS', 'RICE', 'EGGS (pc)', 'SEAFOOD', 'PORK', 'BEEF', 'CHICKEN', 'OTHER PRODUCTS']\r\nfunction matchPreset(value, options) {\r\n  const raw = String(value || '').trim()\r\n  if (!raw) return ''\r\n  const found = options.find((opt) => opt.toLowerCase() === raw.toLowerCase())\r\n  return found || ''\r\n}\r\nexport default {\r\n  props:{ mode:{ type:String, required:true } },\r\n  data(){\r\n    return {\r\n      rows: [],\r\n      page: 1,\r\n      pageSize: 25,\r\n      searchQ: '',\r\n      editingId: null,\r\n      savingId: null,\r\n      editForm: null,\r\n      editImageDataUrl: null,\r\n      editImagePreviewUrl: ''\r\n    }\r\n  },\r\n  async created(){\r\n    await this.refreshRows()\r\n  },\r\n  computed:{\r\n    unitOptions(){\r\n      return UNIT_OPTIONS\r\n    },\r\n    categoryOptions(){\r\n      return CATEGORY_OPTIONS\r\n    },\r\n    filteredRows(){\r\n      const q = this.searchQ.toLowerCase()\r\n      if (!q) return this.rows\r\n      return this.rows.filter((p) => {\r\n        const hay = [p.name, p.description, p.category, p.unit, p.status]\r\n          .map((x) => String(x || '').toLowerCase())\r\n          .join(' ')\r\n        return hay.includes(q)\r\n      })\r\n    },\r\n    sortedRows(){\r\n      return [...this.filteredRows].sort((a,b)=>String(a.name||'').localeCompare(String(b.name||'')))\r\n    },\r\n    totalPages(){\r\n      return Math.max(1, Math.ceil(this.sortedRows.length / this.pageSize))\r\n    },\r\n    paginatedRows(){\r\n      const start = (this.page-1) * this.pageSize\r\n      return this.sortedRows.slice(start, start + this.pageSize)\r\n    }\r\n  },\r\n  watch:{\r\n    pageSize(){ this.page = 1 },\r\n    searchQ(){ this.page = 1 }\r\n  },\r\n  methods:{\r\n    startEdit(p){\r\n      const normalizedUnit = matchPreset(p.unit, UNIT_OPTIONS)\r\n      const normalizedCategory = matchPreset(p.category, CATEGORY_OPTIONS)\r\n      const resolvedUnit = this.unitOptions.includes(normalizedUnit) ? normalizedUnit : '__other__'\r\n      const resolvedCategory = this.categoryOptions.includes(normalizedCategory) ? normalizedCategory : '__other__'\r\n      this.editingId = p.id\r\n      this.editImageDataUrl = null\r\n      this.editImagePreviewUrl = ''\r\n      this.editForm = {\r\n        name: p.name || '',\r\n        description: p.description || '',\r\n        unit: resolvedUnit,\r\n        unit_other: resolvedUnit === '__other__' ? String(p.unit || '').trim() : '',\r\n        cost: p.cost ?? null,\r\n        srp: p.srp ?? null,\r\n        srp_vat: p.srp_vat ?? null,\r\n        category: resolvedCategory,\r\n        category_other: resolvedCategory === '__other__' ? String(p.category || '').trim() : '',\r\n        stock: Number(p.stock || 0),\r\n        price: Number(p.price || 0),\r\n        status: p.status || 'active',\r\n        image_url: p.image_url || null\r\n      }\r\n    },\r\n    cancelEdit(){\r\n      this.editingId = null\r\n      this.savingId = null\r\n      this.editForm = null\r\n      this.editImageDataUrl = null\r\n      this.editImagePreviewUrl = ''\r\n    },\r\n    async onEditImageSelected(event){\r\n      const file = event.target?.files?.[0]\r\n      if (!file) {\r\n        this.editImageDataUrl = null\r\n        this.editImagePreviewUrl = ''\r\n        return\r\n      }\r\n      if (!file.type.startsWith('image/')) {\r\n        alert('Please select a valid image file.')\r\n        event.target.value = ''\r\n        return\r\n      }\r\n      if (file.size > 2 * 1024 * 1024) {\r\n        alert('Image is too large. Maximum size is 2MB.')\r\n        event.target.value = ''\r\n        return\r\n      }\r\n      this.editImageDataUrl = await this.readAsDataUrl(file)\r\n      this.editImagePreviewUrl = this.editImageDataUrl\r\n    },\r\n    readAsDataUrl(file){\r\n      return new Promise((resolve, reject) => {\r\n        const reader = new FileReader()\r\n        reader.onload = () => resolve(reader.result)\r\n        reader.onerror = () => reject(new Error('Failed to read image file'))\r\n        reader.readAsDataURL(file)\r\n      })\r\n    },\r\n    async saveEdit(id){\r\n      if (!this.editForm) return\r\n      const stockValue = Number(this.editForm.stock)\r\n      const priceValue = Number(this.editForm.price)\r\n      const costValue = this.editForm.cost === null || this.editForm.cost === '' || typeof this.editForm.cost === 'undefined' ? null : Number(this.editForm