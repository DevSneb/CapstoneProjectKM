{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport api from '../../services/api';\nexport default {\n  name: 'StoreReports',\n  data() {\n    const today = new Date();\n    const to = today.toISOString().slice(0, 10);\n    const fromDate = new Date();\n    fromDate.setDate(today.getDate() - 30);\n    const from = fromDate.toISOString().slice(0, 10);\n    return {\n      from,\n      to,\n      period: 'monthly',\n      daily: [],\n      orders: [],\n      latestSubmissionId: null\n    };\n  },\n  computed: {\n    deliveredRevenue() {\n      return this.daily.filter(d => String(d.channel) === 'delivered').reduce((sum, d) => sum + Number(d.revenue || 0), 0);\n    },\n    pickupRevenue() {\n      return this.daily.filter(d => String(d.channel) === 'pickup').reduce((sum, d) => sum + Number(d.revenue || 0), 0);\n    }\n  },\n  created() {\n    this.fetchAll();\n  },\n  methods: {\n    channelLabel(channel) {\n      return String(channel) === 'pickup' ? 'Pickup' : 'Delivered';\n    },\n    async fetchAll() {\n      const params = {\n        from: this.from,\n        to: this.to\n      };\n      const dailyRes = await api.get('/store/reports/sales', {\n        params\n      });\n      this.daily = dailyRes.data || [];\n      const ordersRes = await api.get('/store/reports/orders', {\n        params\n      });\n      this.orders = ordersRes.data || [];\n    },\n    async generatePdfReport() {\n      try {\n        const res = await api.post('/store/reports/generate-pdf', {\n          period: this.period,\n          from: this.from,\n          to: this.to\n        }, {\n          responseType: 'blob'\n        });\n        const disposition = res.headers?.['content-disposition'] || '';\n        const match = disposition.match(/filename=\"?([^\";]+)\"?/i);\n        const filename = match && match[1] ? match[1] : `sales_report_${this.from}_to_${this.to}.pdf`;\n        const mimeType = res.headers?.['content-type'] || 'application/pdf';\n        const blob = new Blob([res.data], {\n          type: mimeType\n        });\n        const url = URL.createObjectURL(blob);\n        const anchor = document.createElement('a');\n        anchor.href = url;\n        anchor.download = filename;\n        anchor.click();\n        URL.revokeObjectURL(url);\n      } catch (err) {\n        alert(err.response?.data?.message || 'Failed to generate PDF report');\n      }\n    },\n    async downloadExcelForm() {\n      try {\n        const res = await api.get('/store/reports/da-excel-form', {\n          params: {\n            from: this.from,\n            to: this.to\n          },\n          responseType: 'blob'\n        });\n        const disposition = res.headers?.['content-disposition'] || '';\n        const m = disposition.match(/filename=\"?([^\";]+)\"?/i);\n        const filename = m && m[1] ? m[1] : `KADIWA-Sales-Report-Form_${new Date().toISOString().slice(0, 10)}.xlsx`;\n        const mimeType = res.headers?.['content-type'] || 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';\n        const blob = new Blob([res.data], {\n          type: mimeType\n        });\n        const url = URL.createObjectURL(blob);\n        const a = document.createElement('a');\n        a.href = url;\n        a.download = filename;\n        a.click();\n        URL.revokeObjectURL(url);\n      } catch (err) {\n        alert(err.response?.data?.message || 'Failed to download Excel form');\n      }\n    },\n    async submitReportToDa() {\n      if (!confirm('Are you sure you want to submit this report to DA? This will be recorded in the system.')) return;\n      try {\n        const {\n          data\n        } = await api.post('/store/reports/submit-to-da', {\n          period: this.period,\n          from: this.from,\n          to: this.to\n        });\n        alert('Report submitted to DA successfully! Submission ID: ' + data?.submission_id);\n      } catch (err) {\n        alert(err.response?.data?.message || 'Failed to submit report to DA');\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","today","Date","to","toISOString","slice","fromDate","setDate","getDate","from","period","daily","orders","latestSubmissionId","computed","deliveredRevenue","filter","d","String","channel","reduce","sum","Number","revenue","pickupRevenue","created","fetchAll","methods","channelLabel","params","dailyRes","get","ordersRes","generatePdfReport","res","post","responseType","disposition","headers","match","filename","mimeType","blob","Blob","type","url","URL","createObjectURL","anchor","document","createElement","href","download","click","revokeObjectURL","err","alert","response","message","downloadExcelForm","m","a","submitReportToDa","confirm","submission_id"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\store\\Reports.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>Sales Reports</h2>\r\n    <div class=\"filters\">\r\n      <label>From <input type=\"date\" v-model=\"from\" /></label>\r\n      <label>To <input type=\"date\" v-model=\"to\" /></label>\r\n      <label>Period\r\n        <select v-model=\"period\">\r\n          <option value=\"weekly\">Weekly</option>\r\n          <option value=\"monthly\">Monthly</option>\r\n          <option value=\"yearly\">Yearly</option>\r\n        </select>\r\n      </label>\r\n      <button class=\"primary\" @click=\"fetchAll\">Apply</button>\r\n      <button class=\"primary\" @click=\"generatePdfReport\">Generate PDF</button>\r\n      <button class=\"secondary\" @click=\"downloadExcelForm\">Download Excel</button>\r\n      <button class=\"success\" @click=\"submitReportToDa\">Submit Report to DA</button>\r\n    </div>\r\n\r\n    <h3>Daily Revenue (Delivered & Pickup)</h3>\r\n    <div class=\"channel-summary\">\r\n      <div class=\"card\"><span>Delivered Sales</span><strong>₱{{ deliveredRevenue.toFixed(2) }}</strong></div>\r\n      <div class=\"card\"><span>Pickup Sales</span><strong>₱{{ pickupRevenue.toFixed(2) }}</strong></div>\r\n    </div>\r\n    <table class=\"table\">\r\n      <thead><tr><th>Day</th><th>Channel</th><th>Orders</th><th>Revenue</th></tr></thead>\r\n      <tbody>\r\n        <tr v-for=\"d in daily\" :key=\"`${d.day}-${d.channel}`\">\r\n          <td>{{ new Date(d.day).toLocaleDateString() }}</td>\r\n          <td>{{ channelLabel(d.channel) }}</td>\r\n          <td>{{ d.orders }}</td>\r\n          <td>₱{{ Number(d.revenue).toFixed(2) }}</td>\r\n        </tr>\r\n        <tr v-if=\"daily.length===0\"><td colspan=\"4\" class=\"empty\">No data for the selected range.</td></tr>\r\n      </tbody>\r\n    </table>\r\n\r\n    <h3>Finalized Orders (Status: Delivered)</h3>\r\n    <table class=\"table\">\r\n      <thead><tr><th>ID</th><th>Date</th><th>Customer</th><th>Channel</th><th>Shipping</th><th>Payment</th><th>Delivery Fee</th><th>Total</th></tr></thead>\r\n      <tbody>\r\n        <tr v-for=\"o in orders\" :key=\"o.id\">\r\n          <td>#{{ o.id }}</td>\r\n          <td>{{ new Date(o.created_at).toLocaleString() }}</td>\r\n          <td>{{ o.customer_name || '—' }}</td>\r\n          <td>{{ channelLabel(o.channel) }}</td>\r\n          <td>{{ o.shipping_method }}</td>\r\n          <td>{{ o.payment_method }}</td>\r\n          <td>₱{{ Number(o.delivery_fee||0).toFixed(2) }}</td>\r\n          <td>₱{{ Number(o.total_amount).toFixed(2) }}</td>\r\n        </tr>\r\n        <tr v-if=\"orders.length===0\"><td colspan=\"8\" class=\"empty\">No orders for the selected range.</td></tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n<script>\r\nimport api from '../../services/api'\r\nexport default {\r\n  name:'StoreReports',\r\n  data(){\r\n    const today = new Date();\r\n    const to = today.toISOString().slice(0,10);\r\n    const fromDate = new Date(); fromDate.setDate(today.getDate()-30);\r\n    const from = fromDate.toISOString().slice(0,10);\r\n    return {\r\n      from,\r\n      to,\r\n      period: 'monthly',\r\n      daily: [],\r\n      orders: [],\r\n      latestSubmissionId: null\r\n    }\r\n  },\r\n  computed:{\r\n    deliveredRevenue(){\r\n      return this.daily\r\n        .filter(d => String(d.channel) === 'delivered')\r\n        .reduce((sum, d) => sum + Number(d.revenue || 0), 0)\r\n    },\r\n    pickupRevenue(){\r\n      return this.daily\r\n        .filter(d => String(d.channel) === 'pickup')\r\n        .reduce((sum, d) => sum + Number(d.revenue || 0), 0)\r\n    }\r\n  },\r\n  created(){ this.fetchAll() },\r\n  methods:{\r\n    channelLabel(channel){\r\n      return String(channel) === 'pickup' ? 'Pickup' : 'Delivered'\r\n    },\r\n    async fetchAll(){\r\n      const params = { from: this.from, to: this.to }\r\n      const dailyRes = await api.get('/store/reports/sales',{ params })\r\n      this.daily = dailyRes.data || []\r\n      const ordersRes = await api.get('/store/reports/orders',{ params })\r\n      this.orders = ordersRes.data || []\r\n    },\r\n    async generatePdfReport(){\r\n      try{\r\n        const res = await api.post('/store/reports/generate-pdf', {\r\n          period: this.period,\r\n          from: this.from,\r\n          to: this.to\r\n        }, {\r\n          responseType: 'blob'\r\n        })\r\n\r\n        const disposition = res.headers?.['content-disposition'] || ''\r\n        const match = disposition.match(/filename=\"?([^\";]+)\"?/i)\r\n        const filename = (match && match[1]) ? match[1] : `sales_report_${this.from}_to_${this.to}.pdf`\r\n        const mimeType = res.headers?.['content-type'] || 'application/pdf'\r\n\r\n        const blob = new Blob([res.data], { type: mimeType })\r\n        const url = URL.createObjectURL(blob)\r\n        const anchor = document.createElement('a')\r\n        anchor.href = url\r\n        anchor.download = filename\r\n        anchor.click()\r\n        URL.revokeObjectURL(url)\r\n      }catch(err){\r\n        alert(err.response?.data?.message || 'Failed to generate PDF report')\r\n      }\r\n    },\r\n    async downloadExcelForm(){\r\n      try{\r\n        const res = await api.get('/store/reports/da-excel-form', {\r\n          params: { from: this.from, to: this.to },\r\n          responseType: 'blob'\r\n        })\r\n        const disposition = res.headers?.['content-disposition'] || ''\r\n        const m = disposition.match(/filename=\"?([^\";]+)\"?/i)\r\n        const filename = (m && m[1]) ? m[1] : `KADIWA-Sales-Report-Form_${new Date().toISOString().slice(0,10)}.xlsx`\r\n        const mimeType = res.headers?.['content-type'] || 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'\r\n\r\n        const blob = new Blob([res.data], { type: mimeType })\r\n        const url = URL.createObjectURL(blob)\r\n        const a = document.createElement('a')\r\n        a.href = url\r\n        a.download = filename\r\n        a.click()\r\n        URL.revokeObjectURL(url)\r\n      }catch(err){\r\n        alert(err.response?.data?.message || 'Failed to download Excel form')\r\n      }\r\n    },\r\n    async submitReportToDa(){\r\n      if(!confirm('Are you sure you want to submit this report to DA? This will be recorded in the system.')) return\r\n      try{\r\n        const { data } = await api.post('/store/reports/submit-to-da', { period: this.period, from: this.from, to: this.to })\r\n        alert('Report submitted to DA successfully! Submission ID: ' + data?.submission_id)\r\n      }catch(err){\r\n        alert(err.response?.data?.message || 'Failed to submit report to DA')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n.filters{ display:flex; gap:10px; align-items:center; margin-bottom:12px }\r\n.channel-summary{ display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:10px; margin-bottom:10px }\r\n.channel-summary .card{ background:#fff; border:1px solid #e3ecd6; border-radius:8px; padding:10px 12px; display:flex; justify-content:space-between; align-items:center }\r\n.channel-summary .card span{ color:#5f7256; font-size:13px }\r\n.table{ width:100%; background:#fff; border-collapse:collapse; border-radius:8px; overflow:hidden; box-shadow:0 4px 14px rgba(56,92,35,.08) }\r\n.table th,.table td{ padding:10px 12px; border-bottom:1px solid #e6eddc }\r\n.table th{ background:#f4f8ee }\r\n.empty{ text-align:center; color:#6f7d67 }\r\n.primary{ background:linear-gradient(135deg,#7CB342,#4E7D32); color:#fff; border:none; padding:8px 12px; border-radius:6px; cursor:pointer }\r\n.secondary{ background:#eaf2de; color:#355e2a; border:none; padding:8px 12px; border-radius:6px; cursor:pointer }\r\n.success{ background:#4CAF50; color:#fff; border:none; padding:8px 12px; border-radius:6px; cursor:pointer }\r\n.filters input,.filters select{ border:1px solid #cddbb9; border-radius:6px; padding:7px 10px; background:#fff }\r\n</style>\r\n"],"mappings":";;;;;;AAyDA,OAAOA,GAAE,MAAO,oBAAmB;AACnC,eAAe;EACbC,IAAI,EAAC,cAAc;EACnBC,IAAIA,CAAA,EAAE;IACJ,MAAMC,KAAI,GAAI,IAAIC,IAAI,CAAC,CAAC;IACxB,MAAMC,EAAC,GAAIF,KAAK,CAACG,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,CAAC,EAAC,EAAE,CAAC;IAC1C,MAAMC,QAAO,GAAI,IAAIJ,IAAI,CAAC,CAAC;IAAEI,QAAQ,CAACC,OAAO,CAACN,KAAK,CAACO,OAAO,CAAC,CAAC,GAAC,EAAE,CAAC;IACjE,MAAMC,IAAG,GAAIH,QAAQ,CAACF,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,CAAC,EAAC,EAAE,CAAC;IAC/C,OAAO;MACLI,IAAI;MACJN,EAAE;MACFO,MAAM,EAAE,SAAS;MACjBC,KAAK,EAAE,EAAE;MACTC,MAAM,EAAE,EAAE;MACVC,kBAAkB,EAAE;IACtB;EACF,CAAC;EACDC,QAAQ,EAAC;IACPC,gBAAgBA,CAAA,EAAE;MAChB,OAAO,IAAI,CAACJ,KAAI,CACbK,MAAM,CAACC,CAAA,IAAKC,MAAM,CAACD,CAAC,CAACE,OAAO,MAAM,WAAW,EAC7CC,MAAM,CAAC,CAACC,GAAG,EAAEJ,CAAC,KAAKI,GAAE,GAAIC,MAAM,CAACL,CAAC,CAACM,OAAM,IAAK,CAAC,CAAC,EAAE,CAAC;IACvD,CAAC;IACDC,aAAaA,CAAA,EAAE;MACb,OAAO,IAAI,CAACb,KAAI,CACbK,MAAM,CAACC,CAAA,IAAKC,MAAM,CAACD