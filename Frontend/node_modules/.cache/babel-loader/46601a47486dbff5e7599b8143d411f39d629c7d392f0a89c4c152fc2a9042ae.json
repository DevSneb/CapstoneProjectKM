{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '../services/api';\nexport default {\n  name: 'CustomerLogin',\n  data() {\n    return {\n      credentials: {\n        username: '',\n        password: ''\n      },\n      error: '',\n      loading: false\n    };\n  },\n  methods: {\n    async handleLogin() {\n      this.error = '';\n      this.loading = true;\n      try {\n        const response = await api.post('/customer/auth/login', this.credentials);\n\n        // Store user data and token\n        this.$store.dispatch('login', {\n          user: response.data.user,\n          token: response.data.token\n        });\n\n        // Redirect to customer dashboard\n        this.$router.push('/customer/dashboard');\n      } catch (err) {\n        this.error = err.response?.data?.message || 'Login failed. Please try again.';\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","credentials","username","password","error","loading","methods","handleLogin","response","post","$store","dispatch","user","token","$router","push","err","message"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\CustomerLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-container\">\r\n    <div class=\"login-box\">\r\n      <div class=\"login-header\">\r\n        <div class=\"eyebrow\">Welcome</div>\r\n        <h1>Kadiwa E-Commerce</h1>\r\n        <h2>Customer Login</h2>\r\n        <p class=\"subtext\">Sign in to manage your orders and account.</p>\r\n      </div>\r\n\r\n      <form @submit.prevent=\"handleLogin\" class=\"login-form\">\r\n        <div v-if=\"error\" class=\"error-message\">{{ error }}</div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"username\">Username</label>\r\n          <input\r\n            type=\"text\"\r\n            id=\"username\"\r\n            v-model=\"credentials.username\"\r\n            placeholder=\"Enter username\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"password\">Password</label>\r\n          <input\r\n            type=\"password\"\r\n            id=\"password\"\r\n            v-model=\"credentials.password\"\r\n            placeholder=\"Enter password\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <button type=\"submit\" class=\"login-btn\" :disabled=\"loading\">\r\n          {{ loading ? 'Logging in...' : 'Login' }}\r\n        </button>\r\n      </form>\r\n\r\n      <div class=\"links\">\r\n        <p>Don't have an account? <router-link to=\"/customer/register\">Register here</router-link></p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../services/api'\r\n\r\nexport default {\r\n  name: 'CustomerLogin',\r\n  data() {\r\n    return {\r\n      credentials: {\r\n        username: '',\r\n        password: ''\r\n      },\r\n      error: '',\r\n      loading: false\r\n    }\r\n  },\r\n  methods: {\r\n    async handleLogin() {\r\n      this.error = ''\r\n      this.loading = true\r\n\r\n      try {\r\n        const response = await api.post('/customer/auth/login', this.credentials)\r\n\r\n        // Store user data and token\r\n        this.$store.dispatch('login', {\r\n          user: response.data.user,\r\n          token: response.data.token\r\n        })\r\n\r\n        // Redirect to customer dashboard\r\n        this.$router.push('/customer/dashboard')\r\n      } catch (err) {\r\n        this.error = err.response?.data?.message || 'Login failed. Please try again.'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  min-height: 100vh;\r\n  background: radial-gradient(circle at 15% 15%, rgba(124, 179, 66, 0.3), transparent 45%),\r\n              radial-gradient(circle at 85% 85%, rgba(78, 125, 50, 0.26), transparent 42%),\r\n              linear-gradient(135deg, #edf5e2 0%, #d9e7c7 100%);\r\n  padding: 20px;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.login-container::before,\r\n.login-container::after {\r\n  content: '';\r\n  position: absolute;\r\n  border-radius: 999px;\r\n  pointer-events: none;\r\n}\r\n\r\n.login-container::before {\r\n  width: 280px;\r\n  height: 280px;\r\n  background: rgba(124, 179, 66, 0.18);\r\n  top: -90px;\r\n  left: -70px;\r\n}\r\n\r\n.login-container::after {\r\n  width: 220px;\r\n  height: 220px;\r\n  background: rgba(53, 94, 42, 0.14);\r\n  right: -60px;\r\n  bottom: -60px;\r\n}\r\n\r\n.login-box {\r\n  background: rgba(255, 255, 255, 0.88);\r\n  backdrop-filter: blur(8px);\r\n  -webkit-backdrop-filter: blur(8px);\r\n  padding: 36px;\r\n  border-radius: 18px;\r\n  border: 1px solid rgba(205, 219, 185, 0.9);\r\n  box-shadow: 0 18px 40px rgba(56, 92, 35, 0.18);\r\n  width: 100%;\r\n  max-width: 420px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.login-header {\r\n  text-align: center;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.eyebrow {\r\n  display: inline-block;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n  color: #4E7D32;\r\n  background: #eaf2de;\r\n  border: 1px solid #d5e4bf;\r\n  border-radius: 999px;\r\n  padding: 4px 10px;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.login-header h1 {\r\n  color: #355e2a;\r\n  margin-bottom: 8px;\r\n  font-size: 30px;\r\n  line-height: 1.1;\r\n}\r\n\r\n.login-header h2 {\r\n  color: #5f7256;\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  margin: 0;\r\n}\r\n\r\n.subtext {\r\n  color: #6f7d67;\r\n  margin: 8px 0 0;\r\n  font-size: 13px;\r\n}\r\n\r\n.error-message {\r\n  background: #fff1f1;\r\n  color: #b42318;\r\n  padding: 10px 12px;\r\n  border-radius: 10px;\r\n  border: 1px solid #f4c8c8;\r\n  margin-bottom: 15px;\r\n  text-align: center;\r\n  font-size: 13px;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 7px;\r\n  color: #355e2a;\r\n  font-weight: 600;\r\n  font-size: 13px;\r\n}\r\n\r\n.form-group input {\r\n  width: 100%;\r\n  padding: 12px 13px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 10px;\r\n  font-size: 14px;\r\n  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;\r\n  background: #fff;\r\n}\r\n\r\n.form-group input:focus {\r\n  outline: none;\r\n  border-color: #7CB342;\r\n  box-shadow: 0 0 0 4px rgba(124, 179, 66, 0.2);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.login-btn {\r\n  width: 100%;\r\n  margin-top: 6px;\r\n  padding: 12px;\r\n  background: linear-gradient(135deg, #7CB342, #4E7D32);\r\n  color: white;\r\n  border: none;\r\n  border-radius: 10px;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;\r\n  box-shadow: 0 10px 20px rgba(78, 125, 50, 0.24);\r\n}\r\n\r\n.login-btn:hover:not(:disabled) {\r\n  filter: brightness(1.02);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.login-btn:disabled {\r\n  opacity: 0.6;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.links {\r\n  margin-top: 18px;\r\n  text-align: center;\r\n  color: #5f7256;\r\n}\r\n\r\n.links p {\r\n  margin: 8px 0;\r\n  font-size: 14px;\r\n}\r\n\r\n.links a {\r\n  color: #4E7D32;\r\n  text-decoration: none;\r\n  font-weight: 500;\r\n}\r\n\r\n.links a:hover {\r\n  text-decoration: underline;\r\n}\r\n</style>\r\n"],"mappings":";AAgDA,OAAOA,GAAE,MAAO,iBAAgB;AAEhC,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,WAAW,EAAE;QACXC,QAAQ,EAAE,EAAE;QACZC,QAAQ,EAAE;MACZ,CAAC;MACDC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MAClB,IAAI,CAACH,KAAI,GAAI,EAAC;MACd,IAAI,CAACC,OAAM,GAAI,IAAG;MAElB,IAAI;QACF,MAAMG,QAAO,GAAI,MAAMV,GAAG,CAACW,IAAI,CAAC,sBAAsB,EAAE,IAAI,CAACR,WAAW;;QAExE;QACA,IAAI,CAACS,MAAM,CAACC,QAAQ,CAAC,OAAO,EAAE;UAC5BC,IAAI,EAAEJ,QAAQ,CAACR,IAAI,CAACY,IAAI;UACxBC,KAAK,EAAEL,QAAQ,CAACR,IAAI,CAACa;QACvB,CAAC;;QAED;QACA,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,qBAAqB;MACzC,EAAE,OAAOC,GAAG,EAAE;QACZ,IAAI,CAACZ,KAAI,GAAIY,GAAG,CAACR,QAAQ,EAAER,IAAI,EAAEiB,OAAM,IAAK,iCAAgC;MAC9E,UAAU;QACR,IAAI,CAACZ,OAAM,GAAI,KAAI;MACrB;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}