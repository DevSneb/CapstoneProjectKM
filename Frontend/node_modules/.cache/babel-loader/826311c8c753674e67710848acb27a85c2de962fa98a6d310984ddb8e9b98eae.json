{"ast":null,"code":"import api from '../../services/api';\nexport default {\n  name: 'StoreFeaturesManagement',\n  data() {\n    return {\n      features: [],\n      featureFlags: {},\n      labels: {\n        products: 'Products',\n        orders: 'Orders',\n        inventory: 'Inventory',\n        customers: 'Customers',\n        reports: 'Reports',\n        cashflow: 'Cash Flow',\n        cashflow2: 'Cash Flow 2',\n        forecasting: 'Forecasting',\n        logistics: 'Delivery Service',\n        notifications: 'Notifications',\n        pos: 'POS'\n      }\n    };\n  },\n  async created() {\n    await this.loadFeatures();\n  },\n  methods: {\n    async loadFeatures() {\n      try {\n        const {\n          data\n        } = await api.get('/store/features/me');\n        this.featureFlags = data?.features || {};\n        this.features = Object.keys(this.featureFlags);\n      } catch (err) {\n        console.error(err);\n        this.featureFlags = {};\n        this.features = [];\n      }\n    },\n    isEnabled(featureKey) {\n      return this.featureFlags[featureKey] !== false;\n    },\n    async toggleFeature(featureKey) {\n      const nextEnabled = !this.isEnabled(featureKey);\n      try {\n        await api.put('/store/features/me', {\n          feature_key: featureKey,\n          enabled: nextEnabled\n        });\n        this.featureFlags[featureKey] = nextEnabled;\n      } catch (err) {\n        alert('Failed to update feature');\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","features","featureFlags","labels","products","orders","inventory","customers","reports","cashflow","cashflow2","forecasting","logistics","notifications","pos","created","loadFeatures","methods","get","Object","keys","err","console","error","isEnabled","featureKey","toggleFeature","nextEnabled","put","feature_key","enabled","alert"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\store\\FeaturesManagement.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>Features Management</h2>\r\n    <p>Manage which features are enabled for your store.</p>\r\n\r\n    <table class=\"table\">\r\n      <thead>\r\n        <tr><th>Feature</th><th>Enabled</th><th>Action</th></tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"f in features\" :key=\"f\">\r\n          <td>{{ labels[f] || f }}</td>\r\n          <td>{{ isEnabled(f) ? 'Yes' : 'No' }}</td>\r\n          <td>\r\n            <button class=\"btn\" @click=\"toggleFeature(f)\">\r\n              {{ isEnabled(f) ? 'Disable' : 'Enable' }}\r\n            </button>\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\nexport default {\r\n  name: 'StoreFeaturesManagement',\r\n  data() {\r\n    return {\r\n      features: [],\r\n      featureFlags: {},\r\n      labels: {\r\n        products: 'Products',\r\n        orders: 'Orders',\r\n        inventory: 'Inventory',\r\n        customers: 'Customers',\r\n        reports: 'Reports',\r\n        cashflow: 'Cash Flow',\r\n        cashflow2: 'Cash Flow 2',\r\n        forecasting: 'Forecasting',\r\n        logistics: 'Delivery Service',\r\n        notifications: 'Notifications',\r\n        pos: 'POS'\r\n      }\r\n    }\r\n  },\r\n  async created() {\r\n    await this.loadFeatures()\r\n  },\r\n  methods: {\r\n    async loadFeatures() {\r\n      try {\r\n        const { data } = await api.get('/store/features/me')\r\n        this.featureFlags = data?.features || {}\r\n        this.features = Object.keys(this.featureFlags)\r\n      } catch (err) {\r\n        console.error(err)\r\n        this.featureFlags = {}\r\n        this.features = []\r\n      }\r\n    },\r\n    isEnabled(featureKey) {\r\n      return this.featureFlags[featureKey] !== false\r\n    },\r\n    async toggleFeature(featureKey) {\r\n      const nextEnabled = !this.isEnabled(featureKey)\r\n      try {\r\n        await api.put('/store/features/me', { feature_key: featureKey, enabled: nextEnabled })\r\n        this.featureFlags[featureKey] = nextEnabled\r\n      } catch (err) {\r\n        alert('Failed to update feature')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.table{width:100%;border-collapse:collapse;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 4px 14px rgba(56,92,35,.08)}\r\n.table th,.table td{padding:10px 12px;border-bottom:1px solid #e6eddc;text-align:left}\r\n.table th{background:#f4f8ee}\r\n.btn{padding:6px 10px;border:1px solid #cddbb9;background:#f8fbf4;border-radius:6px;cursor:pointer}\r\n</style>"],"mappings":"AAyBA,OAAOA,GAAE,MAAO,oBAAmB;AACnC,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,YAAY,EAAE,CAAC,CAAC;MAChBC,MAAM,EAAE;QACNC,QAAQ,EAAE,UAAU;QACpBC,MAAM,EAAE,QAAQ;QAChBC,SAAS,EAAE,WAAW;QACtBC,SAAS,EAAE,WAAW;QACtBC,OAAO,EAAE,SAAS;QAClBC,QAAQ,EAAE,WAAW;QACrBC,SAAS,EAAE,aAAa;QACxBC,WAAW,EAAE,aAAa;QAC1BC,SAAS,EAAE,kBAAkB;QAC7BC,aAAa,EAAE,eAAe;QAC9BC,GAAG,EAAE;MACP;IACF;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,YAAY,CAAC;EAC1B,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,YAAYA,CAAA,EAAG;MACnB,IAAI;QACF,MAAM;UAAEhB;QAAK,IAAI,MAAMF,GAAG,CAACoB,GAAG,CAAC,oBAAoB;QACnD,IAAI,CAAChB,YAAW,GAAIF,IAAI,EAAEC,QAAO,IAAK,CAAC;QACvC,IAAI,CAACA,QAAO,GAAIkB,MAAM,CAACC,IAAI,CAAC,IAAI,CAAClB,YAAY;MAC/C,EAAE,OAAOmB,GAAG,EAAE;QACZC,OAAO,CAACC,KAAK,CAACF,GAAG;QACjB,IAAI,CAACnB,YAAW,GAAI,CAAC;QACrB,IAAI,CAACD,QAAO,GAAI,EAAC;MACnB;IACF,CAAC;IACDuB,SAASA,CAACC,UAAU,EAAE;MACpB,OAAO,IAAI,CAACvB,YAAY,CAACuB,UAAU,MAAM,KAAI;IAC/C,CAAC;IACD,MAAMC,aAAaA,CAACD,UAAU,EAAE;MAC9B,MAAME,WAAU,GAAI,CAAC,IAAI,CAACH,SAAS,CAACC,UAAU;MAC9C,IAAI;QACF,MAAM3B,GAAG,CAAC8B,GAAG,CAAC,oBAAoB,EAAE;UAAEC,WAAW,EAAEJ,UAAU;UAAEK,OAAO,EAAEH;QAAY,CAAC;QACrF,IAAI,CAACzB,YAAY,CAACuB,UAAU,IAAIE,WAAU;MAC5C,EAAE,OAAON,GAAG,EAAE;QACZU,KAAK,CAAC,0BAA0B;MAClC;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module",