{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '../services/api';\nexport default {\n  name: 'PosLogin',\n  data() {\n    return {\n      credentials: {\n        username: '',\n        password: ''\n      },\n      error: '',\n      loading: false\n    };\n  },\n  methods: {\n    async handleLogin() {\n      this.error = '';\n      this.loading = true;\n      try {\n        const response = await api.post('/pos/auth/login', this.credentials);\n        this.$store.dispatch('login', {\n          user: response.data.user,\n          token: response.data.token\n        });\n        this.$router.push('/pos/dashboard');\n      } catch (err) {\n        this.error = err.response?.data?.message || 'Login failed. Please try again.';\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","credentials","username","password","error","loading","methods","handleLogin","response","post","$store","dispatch","user","token","$router","push","err","message"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\frontend\\src\\views\\PosLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-container\">\r\n    <div class=\"login-box\">\r\n      <div class=\"login-header\">\r\n        <div class=\"eyebrow\">Secure Access</div>\r\n        <h1>Kadiwa E-Commerce</h1>\r\n        <h2>POS Login</h2>\r\n        <p class=\"subtext\">Sign in with your POS account.</p>\r\n      </div>\r\n\r\n      <form @submit.prevent=\"handleLogin\" class=\"login-form\">\r\n        <div v-if=\"error\" class=\"error-message\">{{ error }}</div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"username\">Username</label>\r\n          <input\r\n            type=\"text\"\r\n            id=\"username\"\r\n            v-model=\"credentials.username\"\r\n            placeholder=\"Enter username\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"password\">Password</label>\r\n          <input\r\n            type=\"password\"\r\n            id=\"password\"\r\n            v-model=\"credentials.password\"\r\n            placeholder=\"Enter password\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <button type=\"submit\" class=\"login-btn\" :disabled=\"loading\">\r\n          {{ loading ? 'Logging in...' : 'Login' }}\r\n        </button>\r\n      </form>\r\n\r\n      <div class=\"links\">\r\n        <router-link to=\"/customer/login\">Customer Login</router-link>\r\n        <span> | </span>\r\n        <router-link to=\"/admin/login\">Admin Login</router-link>\r\n        <span> | </span>\r\n        <router-link to=\"/store-owner/login\">Store Owner Login</router-link>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../services/api'\r\n\r\nexport default {\r\n  name: 'PosLogin',\r\n  data() {\r\n    return {\r\n      credentials: {\r\n        username: '',\r\n        password: ''\r\n      },\r\n      error: '',\r\n      loading: false\r\n    }\r\n  },\r\n  methods: {\r\n    async handleLogin() {\r\n      this.error = ''\r\n      this.loading = true\r\n\r\n      try {\r\n        const response = await api.post('/pos/auth/login', this.credentials)\r\n        this.$store.dispatch('login', {\r\n          user: response.data.user,\r\n          token: response.data.token\r\n        })\r\n        this.$router.push('/pos/dashboard')\r\n      } catch (err) {\r\n        this.error = err.response?.data?.message || 'Login failed. Please try again.'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  min-height: 100vh;\r\n  background: radial-gradient(circle at 15% 15%, rgba(124, 179, 66, 0.3), transparent 45%),\r\n              radial-gradient(circle at 85% 85%, rgba(78, 125, 50, 0.26), transparent 42%),\r\n              linear-gradient(135deg, #edf5e2 0%, #d9e7c7 100%);\r\n  padding: 20px;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.login-container::before,\r\n.login-container::after {\r\n  content: '';\r\n  position: absolute;\r\n  border-radius: 999px;\r\n  pointer-events: none;\r\n}\r\n\r\n.login-container::before {\r\n  width: 300px;\r\n  height: 300px;\r\n  background: rgba(124, 179, 66, 0.16);\r\n  top: -100px;\r\n  left: -90px;\r\n}\r\n\r\n.login-container::after {\r\n  width: 220px;\r\n  height: 220px;\r\n  background: rgba(53, 94, 42, 0.12);\r\n  right: -70px;\r\n  bottom: -60px;\r\n}\r\n\r\n.login-box {\r\n  background: rgba(255, 255, 255, 0.88);\r\n  backdrop-filter: blur(8px);\r\n  -webkit-backdrop-filter: blur(8px);\r\n  padding: 36px;\r\n  border-radius: 18px;\r\n  border: 1px solid rgba(205, 219, 185, 0.9);\r\n  box-shadow: 0 18px 40px rgba(56, 92, 35, 0.18);\r\n  width: 100%;\r\n  max-width: 430px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.login-header {\r\n  text-align: center;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.eyebrow {\r\n  display: inline-block;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: 1px;\r\n  color: #5a7e45;\r\n  text-transform: uppercase;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.login-header h1 {\r\n  margin: 0;\r\n  font-size: 28px;\r\n  color: #2f5f28;\r\n}\r\n\r\n.login-header h2 {\r\n  margin: 12px 0 8px;\r\n  font-size: 20px;\r\n  color: #385e2f;\r\n}\r\n\r\n.subtext {\r\n  margin: 0;\r\n  color: #5f6f55;\r\n}\r\n\r\n.login-form {\r\n  display: grid;\r\n  gap: 18px;\r\n}\r\n\r\n.form-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.form-group label {\r\n  margin-bottom: 6px;\r\n  font-weight: 600;\r\n  color: #465f3d;\r\n}\r\n\r\n.form-group input {\r\n  padding: 12px 14px;\r\n  border: 1px solid #c9d1b9;\r\n  border-radius: 12px;\r\n  font-size: 14px;\r\n  color: #2f3f24;\r\n  background: #f8faf3;\r\n}\r\n\r\n.login-btn {\r\n  background: linear-gradient(135deg, #5a944a, #3e712e);\r\n  color: #fff;\r\n  width: 100%;\r\n  padding: 14px 18px;\r\n  border: none;\r\n  border-radius: 12px;\r\n  font-size: 15px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n}\r\n\r\n.login-btn:disabled {\r\n  opacity: 0.65;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.links {\r\n  margin-top: 18px;\r\n  display: flex;\r\n  justify-content: center;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.links a,\r\n.links router-link {\r\n  color: #4b783e;\r\n  text-decoration: none;\r\n  font-weight: 600;\r\n}\r\n\r\n.error-message {\r\n  padding: 12px 14px;\r\n  background: #ffe8e3;\r\n  border: 1px solid #f2b0a1;\r\n  color: #8a2e24;\r\n  border-radius: 12px;\r\n}\r\n</style>\r\n"],"mappings":";AAoDA,OAAOA,GAAE,MAAO,iBAAgB;AAEhC,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,WAAW,EAAE;QACXC,QAAQ,EAAE,EAAE;QACZC,QAAQ,EAAE;MACZ,CAAC;MACDC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MAClB,IAAI,CAACH,KAAI,GAAI,EAAC;MACd,IAAI,CAACC,OAAM,GAAI,IAAG;MAElB,IAAI;QACF,MAAMG,QAAO,GAAI,MAAMV,GAAG,CAACW,IAAI,CAAC,iBAAiB,EAAE,IAAI,CAACR,WAAW;QACnE,IAAI,CAACS,MAAM,CAACC,QAAQ,CAAC,OAAO,EAAE;UAC5BC,IAAI,EAAEJ,QAAQ,CAACR,IAAI,CAACY,IAAI;UACxBC,KAAK,EAAEL,QAAQ,CAACR,IAAI,CAACa;QACvB,CAAC;QACD,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,gBAAgB;MACpC,EAAE,OAAOC,GAAG,EAAE;QACZ,IAAI,CAACZ,KAAI,GAAIY,GAAG,CAACR,QAAQ,EAAER,IAAI,EAAEiB,OAAM,IAAK,iCAAgC;MAC9E,UAAU;QACR,IAAI,CAACZ,OAAM,GAAI,KAAI;MACrB;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}