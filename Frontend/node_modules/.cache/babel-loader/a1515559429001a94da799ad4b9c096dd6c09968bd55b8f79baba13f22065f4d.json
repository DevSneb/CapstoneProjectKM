","address","onClick","save"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\store\\AccountLocation.vue"],"sourcesContent":["<template>\r\n  <div class=\"page\">\r\n    <h2>Store Location</h2>\r\n    <p>Set your store's location by clicking on the map or entering coordinates.</p>\r\n\r\n    <div v-if=\"mapError\" class=\"map-error\">{{ mapError }}</div>\r\n\r\n    <div class=\"map-style\">\r\n      <label>Map type\r\n        <select class=\"select\" v-model=\"mapTypeId\" @change=\"switchMapType\">\r\n          <option value=\"roadmap\">Roadmap</option>\r\n          <option value=\"satellite\">Satellite</option>\r\n          <option value=\"hybrid\">Hybrid</option>\r\n          <option value=\"terrain\">Terrain</option>\r\n        </select>\r\n      </label>\r\n    </div>\r\n\r\n    <div id=\"ownerMap\" class=\"map\"></div>\r\n\r\n    <div class=\"form\">\r\n      <label>Latitude\r\n        <input class=\"input\" v-model.number=\"latitude\" type=\"number\" step=\"0.000001\" @change=\"syncMarkerFromInputs\" />\r\n      </label>\r\n      <label>Longitude\r\n        <input class=\"input\" v-model.number=\"longitude\" type=\"number\" step=\"0.000001\" @change=\"syncMarkerFromInputs\" />\r\n      </label>\r\n      <label>Address (optional)\r\n        <input class=\"input\" v-model=\"address\" />\r\n      </label>\r\n      <button class=\"primary-btn\" @click=\"save\">Save Location</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\nimport loadGoogleMaps from '../../services/googleMapsLoader'\r\n\r\nconst CALAPAN = { lat: 13.4117, lng: 121.1803 }\r\n\r\nexport default {\r\n  name: 'StoreAccountLocation',\r\n  data() {\r\n    return {\r\n      latitude: null,\r\n      longitude: null,\r\n      address: '',\r\n      mapInstance: null,\r\n      markerInstance: null,\r\n      mapTypeId: 'roadmap',\r\n      mapError: ''\r\n    }\r\n  },\r\n  async mounted() {\r\n    await this.load()\r\n    await this.initMap()\r\n  },\r\n  methods: {\r\n    async load() {\r\n      try {\r\n        const { data } = await api.get('/store/account/location')\r\n        this.latitude = data.latitude ?? null\r\n        this.longitude = data.longitude ?? null\r\n        this.address = data.address || ''\r\n      } catch (err) {\r\n        console.error('Failed to load location', err)\r\n      }\r\n    },\r\n    async initMap() {\r\n      this.mapError = ''\r\n      try {\r\n        const maps = await loadGoogleMaps()\r\n        const el = document.getElementById('ownerMap')\r\n        if (!el) return\r\n\r\n        const hasCoords = Number.isFinite(this.latitude) && Number.isFinite(this.longitude)\r\n        const center = hasCoords\r\n          ? { lat: Number(this.latitude), lng: Number(this.longitude) }\r\n          : CALAPAN\r\n\r\n        this.mapInstance = new maps.Map(el, {\r\n          center,\r\n          zoom: hasCoords ? 15 : 13,\r\n          mapTypeId: this.mapTypeId,\r\n          mapTypeControl: true,\r\n          streetViewControl: false,\r\n          fullscreenControl: true\r\n        })\r\n\r\n        if (hasCoords) {\r\n          this.markerInstance = new maps.Marker({\r\n            position: center,\r\n            map: this.mapInstance,\r\n            draggable: true,\r\n            title: 'Store location'\r\n          })\r\n          this.markerInstance.addListener('dragend', () => {\r\n            const pos = this.markerInstance.getPosition()\r\n            this.latitude = Number(pos.lat().toFixed(6))\r\n            this.longitude = Number(pos.lng().toFixed(6))\r\n          })\r\n        }\r\n\r\n        this.mapInstance.addListener('click', (e) => {\r\n          const lat = Number(e.latLng.lat().toFixed(6))\r\n          const lng = Number(e.latLng.lng().toFixed(6))\r\n          this.latitude = lat\r\n          this.longitude = lng\r\n          const position = { lat, lng }\r\n          if (this.markerInstance) {\r\n            this.markerInstance.setPosition(position)\r\n          } else {\r\n            this.markerInstance = new maps.Marker({\r\n              position,\r\n              map: this.mapInstance,\r\n              draggable: true,\r\n              title: 'Store location'\r\n            })\r\n            this.markerInstance.addListener('dragend', () => {\r\n              const pos = this.markerInstance.getPosition()\r\n              this.latitude = Number(pos.lat().toFixed(6))\r\n              this.longitude = Number(pos.lng().toFixed(6))\r\n            })\r\n          }\r\n        })\r\n      } catch (err) {\r\n        console.error(err)\r\n        this.mapError = err.message || 'Failed to load Google Maps'\r\n      }\r\n    },\r\n    switchMapType() {\r\n      if (this.mapInstance) {\r\n        this.mapInstance.setMapTypeId(this.mapTypeId)\r\n      }\r\n    },\r\n    syncMarkerFromInputs() {\r\n      if (!this.mapInstance || !Number.isFinite(this.latitude) || !Number.isFinite(this.longitude)) return\r\n      const position = { lat: Number(this.latitude), lng: Number(this.longitude) }\r\n      if (this.markerInstance) {\r\n        this.markerInstance.setPosition(position)\r\n      } else if (window.google?.maps) {\r\n        this.markerInstance = new window.google.maps.Marker({\r\n          position,\r\n          map: this.mapInstance,\r\n          draggable: true,\r\n          title: 'Store location'\r\n        })\r\n      }\r\n      this.mapInstance.panTo(position)\r\n    },\r\n    async save() {\r\n      try {\r\n        const payload = {\r\n          latitude: this.latitude,\r\n          longitude: this.longitude,\r\n          address: this.address\r\n        }\r\n        await api.put('/store/account/location', payload)\r\n        alert('Location saved')\r\n      } catch (err) {\r\n        alert(err.response?.data?.message || 'Failed to save location')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.page{ padding:20px }\r\n.map{ height:420px; border:1px solid #d9e5c8; border-radius:10px; overflow:hidden; margin-bottom:12px; box-shadow:0 4px 14px rgba(56,92,35,.08) }\r\n.map-style{ margin-bottom:8px }\r\n.map-error{\r\n  margin-bottom:10px;\r\n  padding:10px 12px;\r\n  border-radius:8px;\r\n  background:#fff1f1;\r\n  border:1px solid #f4c8c8;\r\n  color:#b42318;\r\n  font-size:13px;\r\n}\r\n.form{ display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:12px; align-items:end }\r\n.input{ padding:8px 10px; border:1px solid #cddbb9; border-radius:6px }\r\n.select{ padding:8px 10px; border:1px solid #cddbb9; border-radius:6px; background:#fff }\r\n.primary-btn{ background:linear-gradient(135deg,#7CB342,#4E7D32); color:#fff; border:none; padding:10px 14px; border-radius:8px; cursor:pointer }\r\n.primary-btn:hover{ filter:brightness(0.95) }\r\n@media (max-width: 640px){\r\n  .map{height:260px!important}\r\n  .form{grid-template-columns:1fr}\r\n}\r\n</style>\r\n"],"mappings":";;EACOA,KAAK,EAAC;AAAM;;;EAIMA,KAAK,EAAC;;;EAEtBA,KAAK,EAAC;AAAW;;EAajBA,KAAK,EAAC;AAAM;;uBAnBnBC,mBAAA,CA+BM,OA/BNC,UA+BM,G,4BA9BJC,mBAAA,CAAuB,YAAnB,gBAAc,Q,4BAClBA,mBAAA,CAAgF,WAA7E,2EAAyE,QAEjEC,KAAA,CAAAC,QAAQ,I,cAAnBJ,mBAAA,CAA2D,OAA3DK,UAA2D,EAAAC,gBAAA,CAAjBH,KAAA,CAAAC,QAAQ,S,+BAElDF,mBAAA,CASM,OATNK,UASM,GARJL,mBAAA,CAOQ,gB,2CAPD,WACL,Q,gBAAAA,mBAAA,CAKS;IALDH,KAAK,EAAC,QAAQ;+DAAUI,KAAA,CAAAK,SAAS,GAAAC,MAAA;IAAGC,QAAM,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,QAAA,CAAAC,aAAA,IAAAD,QAAA,CAAAC,aAAA,IAAAF,IAAA,CAAa;qCAC/DV,mBAAA,CAAwC;IAAhCa,KAAK,EAAC;EAAS,GAAC,SAAO,OAC/Bb,mBAAA,CAA4C;IAApCa,KAAK,EAAC;EAAW,GAAC,WAAS,OACnCb,mBAAA,CAAsC;IAA9Ba,KAAK,EAAC;EAAQ,GAAC,QAAM,OAC7Bb,mBAAA,CAAwC;IAAhCa,KAAK,EAAC;EAAS,GAAC,SAAO,M,4BAJDZ,KAAA,CAAAK,SAAS,E,mCAS7CN,mBAAA,CAAqC;IAAhCc,EAAE,EAAC,UAAU;IAACjB,KAAK,EAAC;iBAEzBG,mBAAA,CAWM,OAXNe,UAWM,GAVJf,mBAAA,CAEQ,gB,6CAFD,WACL,Q,gBAAAA,mBAAA,CAA8G;IAAvGH,KAAK,EAAC,OAAO;+DAAiBI,KAAA,CAAAe,QAAQ,GAAAT,MAAA;IAAEU,IAAI,EAAC,QAAQ;IAACC,IAAI,EAAC,UAAU;IAAEV,QAAM,EAAAC,MAAA,QAAAA,MAAA,UA