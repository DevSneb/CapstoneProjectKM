{"ast":null,"code":"export default {\n  name: 'LandingPage'\n};","map":{"version":3,"names":["name"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\LandingPage.vue"],"sourcesContent":["<template>\r\n  <main class=\"landing-page\">\r\n    <header class=\"landing-nav\">\r\n      <router-link class=\"brand\" to=\"/\">\r\n        <span class=\"brand-mark\">K</span>\r\n        <span>Kadiwa</span>\r\n      </router-link>\r\n      <nav class=\"nav-actions\" aria-label=\"Account actions\">\r\n        <router-link class=\"nav-login\" to=\"/customer/login\">Login</router-link>\r\n        <router-link class=\"nav-signup\" to=\"/customer/register\">Sign up</router-link>\r\n      </nav>\r\n    </header>\r\n\r\n    <section class=\"landing-hero\">\r\n      <div class=\"hero-copy\">\r\n        <p class=\"eyebrow\">Local food, closer to home</p>\r\n        <h1>Fresh choices from the Kadiwa community.</h1>\r\n        <p class=\"hero-text\">Shop everyday essentials from local stores, choose pickup or delivery, and keep your orders in one simple place.</p>\r\n        <div class=\"hero-actions\">\r\n          <router-link class=\"primary-action\" to=\"/customer/register\">Create an account</router-link>\r\n          <router-link class=\"secondary-action\" to=\"/customer/login\">I already have an account</router-link>\r\n        </div>\r\n      </div>\r\n      <div class=\"hero-scene\" aria-hidden=\"true\">\r\n        <div class=\"sun\"></div>\r\n        <div class=\"leaf leaf-one\"></div>\r\n        <div class=\"leaf leaf-two\"></div>\r\n        <div class=\"basket\">\r\n          <span>Fresh</span>\r\n          <strong>from local stores</strong>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"feature-row\" aria-label=\"Kadiwa benefits\">\r\n      <article><span class=\"feature-number\">01</span><h2>Browse nearby</h2><p>Find products and stores in one clear catalog.</p></article>\r\n      <article><span class=\"feature-number\">02</span><h2>Order your way</h2><p>Choose pickup or delivery during checkout.</p></article>\r\n      <article><span class=\"feature-number\">03</span><h2>Track with ease</h2><p>Review your order history whenever you need it.</p></article>\r\n    </section>\r\n  </main>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'LandingPage'\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.landing-page{min-height:100vh;color:#20351b;background:#f5f8ee;overflow:hidden}\r\n.landing-nav{display:flex;justify-content:space-between;align-items:center;max-width:1240px;margin:0 auto;padding:24px 32px;position:relative;z-index:2}\r\n.brand{display:flex;align-items:center;gap:10px;color:#20351b;text-decoration:none;font-size:20px;font-weight:800;letter-spacing:.01em}\r\n.brand-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;color:#fff;background:#3f762a;box-shadow:0 8px 18px rgba(63,118,42,.2)}\r\n.nav-actions{display:flex;align-items:center;gap:10px}.nav-login,.nav-signup{padding:10px 16px;border-radius:999px;text-decoration:none;font-weight:700}.nav-login{color:#355e2a}.nav-signup{color:#fff;background:#3f762a;box-shadow:0 8px 18px rgba(63,118,42,.2)}\r\n.landing-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px, .85fr);gap:48px;align-items:center;max-width:1240px;margin:0 auto;padding:76px 32px 92px;min-height:560px}\r\n.hero-copy{max-width:620px}.eyebrow{margin:0 0 16px;color:#66804f;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.hero-copy h1{max-width:590px;margin:0;color:#20351b;font-size:clamp(42px,6vw,76px);line-height:.98;letter-spacing:-.03em}.hero-text{max-width:520px;margin:24px 0 0;color:#5e7156;font-size:18px;line-height:1.6}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.primary-action,.secondary-action{padding:14px 20px;border-radius:12px;text-decoration:none;font-weight:800}.primary-action{color:#fff;background:#3f762a;box-shadow:0 12px 24px rgba(63,118,42,.2)}.secondary-action{color:#355e2a;border:1px solid #cbdcb9;background:rgba(255,255,255,.62)}\r\n.hero-scene{position:relative;min-height:390px;border-radius:34px;background:linear-gradient(145deg,#dce9ca,#f5e5ba 58%,#d7e4c4);box-shadow:inset 0 0 0 1px rgba(255,255,255,.6),0 24px 50px rgba(56,92,35,.12);overflow:hidden}.hero-scene:after{content:'';position:absolute;right:-8%;bottom:-25%;width:120%;height:48%;border-radius:50%;background:#9fbd77;transform:rotate(-8deg)}.sun{position:absolute;top:46px;right:52px;width:110px;height:110px;border-radius:50%;background:#f4bd5c;opacity:.9}.leaf{position:absolute;z-index:1;width:110px;height:210px;border-radius:100% 0 100% 0;background:#5e913d;transform:rotate(35deg)}.leaf-one{left:70px;top:65px}.leaf-two{left:150px;top:12px;transform:rotate(72deg);background:#7cac50}.basket{position:absolute;z-index:2;left:50%;bottom:66px;display:flex;flex-direction:column;gap:8px;width:220px;padding:28px 24px;border-radius:18px;background:#f8f1dd;color:#355e2a;box-shadow:0 16px 28px rgba(56,92,35,.16);transform:translateX(-50%) rotate(-4deg)}.basket span{font-size:13px;letter-spacing:.14em;text-transform:uppercase}.basket strong{font-size:28px;line-height:1.05}\r\n.feature-row{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:1240px;margin:0 auto;padding:0 32px 56px}.feature-row article{padding:22px 0;border-top:1px solid #cfddc2}.feature-number{color:#7da45b;font-size:12px;font-weight:800}.feature-row h2{margin:12px 0 6px;font-size:20px}.feature-row p{margin:0;color:#6a7a62;line-height:1.5}\r\n@media (max-width:760px){.landing-nav{padding:18px 16px}.brand{font-size:18px}.nav-login,.nav-signup{padding:9px 12px;font-size:13px}.landing-hero{display:flex;flex-direction:column;align-items:stretch;gap:34px;padding:54px 16px 64px}.hero-copy h1{font-size:48px}.hero-text{font-size:16px}.hero-actions{flex-direction:column}.primary-action,.secondary-action{text-align:center}.hero-scene{min-height:300px}.feature-row{grid-template-columns:1fr;padding:0 16px 36px;gap:10px}.feature-row article{padding:18px 0}}\r\n</style>\r\n"],"mappings":"AA2CA,eAAe;EACbA,IAAI,EAAE;AACR","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}