{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '../services/api';\nimport { bindKeyboardScroll } from '../utils/keyboardScroll';\nexport default {\n  name: 'CustomerLogin',\n  data() {\n    return {\n      credentials: {\n        username: '',\n        password: ''\n      },\n      showPassword: false,\n      error: '',\n      loading: false,\n      _unbindKeyboardScroll: null\n    };\n  },\n  mounted() {\n    this._unbindKeyboardScroll = bindKeyboardScroll(this.$el);\n  },\n  beforeUnmount() {\n    if (this._unbindKeyboardScroll) this._unbindKeyboardScroll();\n  },\n  methods: {\n    async handleLogin() {\n      this.error = '';\n      this.loading = true;\n      try {\n        const response = await api.post('/customer/auth/login', this.credentials);\n\n        // Store user data and token\n        this.$store.dispatch('login', {\n          user: response.data.user,\n          token: response.data.token\n        });\n\n        // Redirect to customer dashboard\n        this.$router.push('/customer/dashboard');\n      } catch (err) {\n        this.error = err.response?.data?.message || 'Login failed. Please try again.';\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","bindKeyboardScroll","name","data","credentials","username","password","showPassword","error","loading","_unbindKeyboardScroll","mounted","$el","beforeUnmount","methods","handleLogin","response","post","$store","dispatch","user","token","$router","push","err","message"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\CustomerLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-container\">\r\n    <div class=\"login-box\">\r\n      <div class=\"login-header\">\r\n        <div class=\"eyebrow\">Welcome</div>\r\n        <router-link class=\"home-link\" to=\"/\">Kadiwa Mart</router-link>\r\n        <h2>Customer Login</h2>\r\n        <p class=\"subtext\">Sign in to manage your orders and account.</p>\r\n      </div>\r\n\r\n      <form @submit.prevent=\"handleLogin\" class=\"login-form\">\r\n        <div v-if=\"error\" class=\"error-message\">{{ error }}</div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"username\">Username</label>\r\n          <input\r\n            type=\"text\"\r\n            id=\"username\"\r\n            v-model=\"credentials.username\"\r\n            placeholder=\"Enter username\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"password\">Password</label>\r\n          <div class=\"password-field\">\r\n            <input\r\n              :type=\"showPassword ? 'text' : 'password'\"\r\n              id=\"password\"\r\n              v-model=\"credentials.password\"\r\n              placeholder=\"Enter password\"\r\n              required\r\n            />\r\n            <button\r\n              type=\"button\"\r\n              class=\"toggle-password\"\r\n              :aria-label=\"showPassword ? 'Hide password' : 'Show password'\"\r\n              @click=\"showPassword = !showPassword\"\r\n            >\r\n              {{ showPassword ? 'Hide' : 'Show' }}\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        <button type=\"submit\" class=\"login-btn\" :disabled=\"loading\">\r\n          {{ loading ? 'Logging in...' : 'Login' }}\r\n        </button>\r\n      </form>\r\n\r\n      <div class=\"links\">\r\n        <p>Don't have an account? <router-link to=\"/customer/register\">Register here</router-link></p>\r\n        <p><router-link to=\"/\">← Back to home</router-link></p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../services/api'\r\nimport { bindKeyboardScroll } from '../utils/keyboardScroll'\r\n\r\nexport default {\r\n  name: 'CustomerLogin',\r\n  data() {\r\n    return {\r\n      credentials: {\r\n        username: '',\r\n        password: ''\r\n      },\r\n      showPassword: false,\r\n      error: '',\r\n      loading: false,\r\n      _unbindKeyboardScroll: null\r\n    }\r\n  },\r\n  mounted() {\r\n    this._unbindKeyboardScroll = bindKeyboardScroll(this.$el)\r\n  },\r\n  beforeUnmount() {\r\n    if (this._unbindKeyboardScroll) this._unbindKeyboardScroll()\r\n  },\r\n  methods: {\r\n    async handleLogin() {\r\n      this.error = ''\r\n      this.loading = true\r\n\r\n      try {\r\n        const response = await api.post('/customer/auth/login', this.credentials)\r\n\r\n        // Store user data and token\r\n        this.$store.dispatch('login', {\r\n          user: response.data.user,\r\n          token: response.data.token\r\n        })\r\n\r\n        // Redirect to customer dashboard\r\n        this.$router.push('/customer/dashboard')\r\n      } catch (err) {\r\n        this.error = err.response?.data?.message || 'Login failed. Please try again.'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: flex-start;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  background: radial-gradient(circle at 15% 15%, rgba(124, 179, 66, 0.3), transparent 45%),\r\n              radial-gradient(circle at 85% 85%, rgba(78, 125, 50, 0.26), transparent 42%),\r\n              linear-gradient(135deg, #edf5e2 0%, #d9e7c7 100%);\r\n  padding: max(20px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom));\r\n  position: relative;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.login-container::before,\r\n.login-container::after {\r\n  content: '';\r\n  position: absolute;\r\n  border-radius: 999px;\r\n  pointer-events: none;\r\n}\r\n\r\n.login-container::before {\r\n  width: 280px;\r\n  height: 280px;\r\n  background: rgba(124, 179, 66, 0.18);\r\n  top: -90px;\r\n  left: -70px;\r\n}\r\n\r\n.login-container::after {\r\n  width: 220px;\r\n  height: 220px;\r\n  background: rgba(53, 94, 42, 0.14);\r\n  right: -60px;\r\n  bottom: -60px;\r\n}\r\n\r\n.login-box {\r\n  background: rgba(255, 255, 255, 0.88);\r\n  backdrop-filter: blur(8px);\r\n  -webkit-backdrop-filter: blur(8px);\r\n  padding: 36px;\r\n  border-radius: 18px;\r\n  border: 1px solid rgba(205, 219, 185, 0.9);\r\n  box-shadow: 0 18px 40px rgba(56, 92, 35, 0.18);\r\n  width: 100%;\r\n  max-width: 420px;\r\n  position: relative;\r\n  z-index: 1;\r\n  margin: auto 0;\r\n}\r\n\r\n.login-header {\r\n  text-align: center;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.eyebrow {\r\n  display: inline-block;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n  color: #4E7D32;\r\n  background: #eaf2de;\r\n  border: 1px solid #d5e4bf;\r\n  border-radius: 999px;\r\n  padding: 4px 10px;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.login-header h1 {\r\n  color: #355e2a;\r\n  margin-bottom: 8px;\r\n  font-size: 30px;\r\n  line-height: 1.1;\r\n}\r\n\r\n.home-link {\r\n  display: inline-block;\r\n  color: #355e2a;\r\n  text-decoration: none;\r\n  font-size: 30px;\r\n  font-weight: 700;\r\n  line-height: 1.1;\r\n  margin-bottom: 8px;\r\n}\r\n.home-link:hover { text-decoration: underline; }\r\n\r\n.login-header h2 {\r\n  color: #5f7256;\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  margin: 0;\r\n}\r\n\r\n.subtext {\r\n  color: #6f7d67;\r\n  margin: 8px 0 0;\r\n  font-size: 13px;\r\n}\r\n\r\n.error-message {\r\n  background: #fff1f1;\r\n  color: #b42318;\r\n  padding: 10px 12px;\r\n  border-radius: 10px;\r\n  border: 1px solid #f4c8c8;\r\n  margin-bottom: 15px;\r\n  text-align: center;\r\n  font-size: 13px;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 7px;\r\n  color: #355e2a;\r\n  font-weight: 600;\r\n  font-size: 13px;\r\n}\r\n\r\n.form-group input {\r\n  width: 100%;\r\n  padding: 12px 13px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 10px;\r\n  font-size: 14px;\r\n  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;\r\n  background: #fff;\r\n}\r\n\r\n.form-group input:focus {\r\n  outline: none;\r\n  border-color: #7CB342;\r\n  box-shadow: 0 0 0 4px rgba(124, 179, 66, 0.2);\r\n}\r\n\r\n.password-field {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.password-field input {\r\n  width: 100%;\r\n  padding-right: 64px;\r\n}\r\n.toggle-password {\r\n  position: absolute;\r\n  right: 8px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  border: none;\r\n  background: transparent;\r\n  color: #4E7D32;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  padding: 6px 8px;\r\n  border-radius: 8px;\r\n}\r\n.toggle-password:hover {\r\n  background: rgba(124, 179, 66, 0.12);\r\n}\r\n\r\n.login-btn {\r\n  width: 100%;\r\n  margin-top: 6px;\r\n  padding: 12px;\r\n  background: linear-gradient(135deg, #7CB342, #4E7D32);\r\n  color: white;\r\n  border: none;\r\n  border-radius: 10px;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;\r\n  box-shadow: 0 10px 20px rgba(78, 125, 50, 0.24);\r\n}\r\n\r\n.login-btn:hover:not(:disabled) {\r\n  filter: brightness(1.02);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.login-btn:disabled {\r\n  opacity: 0.6;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.links {\r\n  margin-top: 18px;\r\n  text-align: center;\r\n  color: #5f7256;\r\n}\r\n\r\n.links p {\r\n  margin: 8px 0;\r\n  font-size: 14px;\r\n}\r\n\r\n.links a {\r\n  color: #4E7D32;\r\n  text-decoration: none;\r\n  font-weight: 500;\r\n}\r\n\r\n.links a:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .login-container {\r\n    padding: 12px 12px 45vh;\r\n    align-items: flex-start;\r\n  }\r\n  .login-box {\r\n    margin-top: 8px;\r\n    padding: 24px 16px;\r\n  }\r\n  .login-btn { width: 100%; min-height: 44px; }\r\n}\r\n</style>\r\n"],"mappings":";AA2DA,OAAOA,GAAE,MAAO,iBAAgB;AAChC,SAASC,kBAAiB,QAAS,yBAAwB;AAE3D,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,WAAW,EAAE;QACXC,QAAQ,EAAE,EAAE;QACZC,QAAQ,EAAE;MACZ,CAAC;MACDC,YAAY,EAAE,KAAK;MACnBC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE,KAAK;MACdC,qBAAqB,EAAE;IACzB;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACD,qBAAoB,GAAIT,kBAAkB,CAAC,IAAI,CAACW,GAAG;EAC1D,CAAC;EACDC,aAAaA,CAAA,EAAG;IACd,IAAI,IAAI,CAACH,qBAAqB,EAAE,IAAI,CAACA,qBAAqB,CAAC;EAC7D,CAAC;EACDI,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MAClB,IAAI,CAACP,KAAI,GAAI,EAAC;MACd,IAAI,CAACC,OAAM,GAAI,IAAG;MAElB,IAAI;QACF,MAAMO,QAAO,GAAI,MAAMhB,GAAG,CAACiB,IAAI,CAAC,sBAAsB,EAAE,IAAI,CAACb,WAAW;;QAExE;QACA,IAAI,CAACc,MAAM,CAACC,QAAQ,CAAC,OAAO,EAAE;UAC5BC,IAAI,EAAEJ,QAAQ,CAACb,IAAI,CAACiB,IAAI;UACxBC,KAAK,EAAEL,QAAQ,CAACb,IAAI,CAACkB;QACvB,CAAC;;QAED;QACA,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,qBAAqB;MACzC,EAAE,OAAOC,GAAG,EAAE;QACZ,IAAI,CAAChB,KAAI,GAAIgB,GAAG,CAACR,QAAQ,EAAEb,IAAI,EAAEsB,OAAM,IAAK,iCAAgC;MAC9E,UAAU;QACR,IAAI,CAAChB,OAAM,GAAI,KAAI;MACrB;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}