{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport api from '../services/api';\nimport { bindKeyboardScroll } from '../utils/keyboardScroll';\nimport { BARANGAYS, joinAddress } from '../constants/barangays';\nconst emptyErrors = () => ({\n  username: '',\n  email: '',\n  password: '',\n  full_name: '',\n  phone: '',\n  barangay: '',\n  terms: ''\n});\nexport default {\n  name: 'CustomerRegister',\n  data() {\n    return {\n      barangays: BARANGAYS,\n      formData: {\n        username: '',\n        email: '',\n        password: '',\n        full_name: '',\n        phone: '',\n        barangay: '',\n        street: ''\n      },\n      fieldErrors: emptyErrors(),\n      showPassword: false,\n      error: '',\n      success: '',\n      loading: false,\n      agreedToTerms: false,\n      showTerms: false,\n      unbindKeyboardScroll: null\n    };\n  },\n  mounted() {\n    this.unbindKeyboardScroll = bindKeyboardScroll(this.$el);\n  },\n  beforeUnmount() {\n    if (this.unbindKeyboardScroll) this.unbindKeyboardScroll();\n  },\n  methods: {\n    clearFieldError(field) {\n      this.fieldErrors[field] = '';\n    },\n    validateField(field) {\n      if (field === 'username') {\n        const value = String(this.formData.username || '').trim();\n        if (!value) this.fieldErrors.username = 'Username is required.';else if (value.length < 3) this.fieldErrors.username = 'Username must be at least 3 characters.';else this.fieldErrors.username = '';\n      }\n      if (field === 'email') {\n        const value = String(this.formData.email || '').trim();\n        if (!value) this.fieldErrors.email = 'Email is required.';else if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value)) this.fieldErrors.email = 'Enter a valid email address.';else this.fieldErrors.email = '';\n      }\n      if (field === 'password') {\n        const value = String(this.formData.password || '');\n        if (!value) this.fieldErrors.password = 'Password is required.';else if (value.length < 6) this.fieldErrors.password = 'Password must be at least 6 characters.';else this.fieldErrors.password = '';\n      }\n      if (field === 'full_name') {\n        const value = String(this.formData.full_name || '').trim();\n        if (!value) this.fieldErrors.full_name = 'Full name is required.';else this.fieldErrors.full_name = '';\n      }\n      if (field === 'phone') {\n        const value = String(this.formData.phone || '').trim();\n        if (value && !/^(09|\\+639)\\d{9}$/.test(value.replace(/[\\s-]/g, ''))) {\n          this.fieldErrors.phone = 'Use a valid PH mobile number (e.g. 09XXXXXXXXX).';\n        } else this.fieldErrors.phone = '';\n      }\n      if (field === 'barangay') {\n        if (!this.formData.barangay) this.fieldErrors.barangay = 'Please select your barangay.';else this.fieldErrors.barangay = '';\n      }\n      if (field === 'terms') {\n        if (!this.agreedToTerms) this.fieldErrors.terms = 'Please agree to the Terms and Data Privacy policy.';else this.fieldErrors.terms = '';\n      }\n      return !this.fieldErrors[field];\n    },\n    validateForm() {\n      const fields = ['username', 'email', 'password', 'full_name', 'phone', 'barangay', 'terms'];\n      return fields.every(field => this.validateField(field));\n    },\n    async handleRegister() {\n      this.error = '';\n      this.success = '';\n      if (!this.validateForm()) return;\n      this.loading = true;\n      try {\n        const payload = {\n          username: String(this.formData.username || '').trim(),\n          email: String(this.formData.email || '').trim(),\n          password: this.formData.password,\n          full_name: String(this.formData.full_name || '').trim(),\n          phone: String(this.formData.phone || '').trim() || null,\n          address: joinAddress(this.formData.barangay, this.formData.street)\n        };\n        const response = await api.post('/customer/auth/register', payload);\n        this.success = response.data.message;\n        this.formData = {\n          username: '',\n          email: '',\n          password: '',\n          full_name: '',\n          phone: '',\n          barangay: '',\n          street: ''\n        };\n        this.fieldErrors = emptyErrors();\n        this.agreedToTerms = false;\n        setTimeout(() => {\n          this.$router.push('/customer/login');\n        }, 2000);\n      } catch (err) {\n        let message = err.response?.data?.message;\n        if (!message && Array.isArray(err.response?.data?.errors)) {\n          message = err.response.data.errors.map(error => error.msg).join('; ');\n        }\n        this.error = message || 'Registration failed. Please try again.';\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","bindKeyboardScroll","BARANGAYS","joinAddress","emptyErrors","username","email","password","full_name","phone","barangay","terms","name","data","barangays","formData","street","fieldErrors","showPassword","error","success","loading","agreedToTerms","showTerms","unbindKeyboardScroll","mounted","$el","beforeUnmount","methods","clearFieldError","field","validateField","value","String","trim","length","test","replace","validateForm","fields","every","handleRegister","payload","address","response","post","message","setTimeout","$router","push","err","Array","isArray","errors","map","msg","join"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\Frontend\\src\\views\\CustomerRegister.vue"],"sourcesContent":["<template>\r\n  <div class=\"register-container\">\r\n    <div class=\"register-box\">\r\n      <div class=\"register-header\">\r\n        <router-link class=\"home-link\" to=\"/\">Kadiwa Mart</router-link>\r\n        <h2>Customer Registration</h2>\r\n      </div>\r\n\r\n      <form @submit.prevent=\"handleRegister\" class=\"register-form\" novalidate>\r\n        <div v-if=\"error\" class=\"error-message\">{{ error }}</div>\r\n        <div v-if=\"success\" class=\"success-message\">{{ success }}</div>\r\n\r\n        <div class=\"form-group\" :class=\"{ invalid: fieldErrors.username }\">\r\n          <label for=\"username\">Username *</label>\r\n          <input\r\n            type=\"text\"\r\n            id=\"username\"\r\n            v-model.trim=\"formData.username\"\r\n            placeholder=\"Choose a username\"\r\n            autocomplete=\"username\"\r\n            @blur=\"validateField('username')\"\r\n            @input=\"clearFieldError('username')\"\r\n          />\r\n          <p v-if=\"fieldErrors.username\" class=\"field-error\">{{ fieldErrors.username }}</p>\r\n        </div>\r\n\r\n        <div class=\"form-group\" :class=\"{ invalid: fieldErrors.email }\">\r\n          <label for=\"email\">Email *</label>\r\n          <input\r\n            type=\"email\"\r\n            id=\"email\"\r\n            v-model.trim=\"formData.email\"\r\n            placeholder=\"Enter your email\"\r\n            autocomplete=\"email\"\r\n            @blur=\"validateField('email')\"\r\n            @input=\"clearFieldError('email')\"\r\n          />\r\n          <p v-if=\"fieldErrors.email\" class=\"field-error\">{{ fieldErrors.email }}</p>\r\n        </div>\r\n\r\n        <div class=\"form-group\" :class=\"{ invalid: fieldErrors.password }\">\r\n          <label for=\"password\">Password *</label>\r\n          <div class=\"password-field\">\r\n            <input\r\n              :type=\"showPassword ? 'text' : 'password'\"\r\n              id=\"password\"\r\n              v-model=\"formData.password\"\r\n              placeholder=\"Create a password (min 6 characters)\"\r\n              autocomplete=\"new-password\"\r\n              @blur=\"validateField('password')\"\r\n              @input=\"clearFieldError('password')\"\r\n            />\r\n            <button\r\n              type=\"button\"\r\n              class=\"toggle-password\"\r\n              :aria-label=\"showPassword ? 'Hide password' : 'Show password'\"\r\n              @click=\"showPassword = !showPassword\"\r\n            >\r\n              {{ showPassword ? 'Hide' : 'Show' }}\r\n            </button>\r\n          </div>\r\n          <p v-if=\"fieldErrors.password\" class=\"field-error\">{{ fieldErrors.password }}</p>\r\n        </div>\r\n\r\n        <div class=\"form-group\" :class=\"{ invalid: fieldErrors.full_name }\">\r\n          <label for=\"full_name\">Full Name *</label>\r\n          <input\r\n            type=\"text\"\r\n            id=\"full_name\"\r\n            v-model.trim=\"formData.full_name\"\r\n            placeholder=\"Enter your full name\"\r\n            autocomplete=\"name\"\r\n            @blur=\"validateField('full_name')\"\r\n            @input=\"clearFieldError('full_name')\"\r\n          />\r\n          <p v-if=\"fieldErrors.full_name\" class=\"field-error\">{{ fieldErrors.full_name }}</p>\r\n        </div>\r\n\r\n        <div class=\"form-group\" :class=\"{ invalid: fieldErrors.phone }\">\r\n          <label for=\"phone\">Phone</label>\r\n          <input\r\n            type=\"tel\"\r\n            id=\"phone\"\r\n            v-model.trim=\"formData.phone\"\r\n            placeholder=\"09XXXXXXXXX\"\r\n            autocomplete=\"tel\"\r\n            @blur=\"validateField('phone')\"\r\n            @input=\"clearFieldError('phone')\"\r\n          />\r\n          <p v-if=\"fieldErrors.phone\" class=\"field-error\">{{ fieldErrors.phone }}</p>\r\n        </div>\r\n\r\n        <div class=\"form-group\" :class=\"{ invalid: fieldErrors.barangay }\">\r\n          <label for=\"barangay\">Barangay *</label>\r\n          <select\r\n            id=\"barangay\"\r\n            v-model=\"formData.barangay\"\r\n            @change=\"clearFieldError('barangay')\"\r\n            @blur=\"validateField('barangay')\"\r\n          >\r\n            <option disabled value=\"\">Select barangay</option>\r\n            <option v-for=\"b in barangays\" :key=\"b\" :value=\"b\">{{ b }}</option>\r\n          </select>\r\n          <p v-if=\"fieldErrors.barangay\" class=\"field-error\">{{ fieldErrors.barangay }}</p>\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"street\">Street / landmark (optional)</label>\r\n          <input\r\n            type=\"text\"\r\n            id=\"street\"\r\n            v-model.trim=\"formData.street\"\r\n            placeholder=\"Street, house no., landmark\"\r\n          />\r\n        </div>\r\n\r\n        <div class=\"consent-group\" :class=\"{ invalid: fieldErrors.terms }\">\r\n          <label class=\"consent-label\" for=\"agree_terms\">\r\n            <input\r\n              id=\"agree_terms\"\r\n              type=\"checkbox\"\r\n              v-model=\"agreedToTerms\"\r\n              @change=\"clearFieldError('terms')\"\r\n            />\r\n            <span>\r\n              I agree to the\r\n              <button type=\"button\" class=\"link-btn\" @click=\"showTerms = true\">Terms and Conditions</button>\r\n              and\r\n              <button type=\"button\" class=\"link-btn\" @click=\"showTerms = true\">Data Privacy policy</button>.\r\n            </span>\r\n          </label>\r\n          <p v-if=\"fieldErrors.terms\" class=\"field-error\">{{ fieldErrors.terms }}</p>\r\n        </div>\r\n\r\n        <button type=\"submit\" class=\"register-btn\" :disabled=\"loading\">\r\n          {{ loading ? 'Registering...' : 'Register' }}\r\n        </button>\r\n      </form>\r\n\r\n      <div class=\"links\">\r\n        <p>Already have an account? <router-link to=\"/customer/login\">Login here</router-link></p>\r\n        <p><router-link to=\"/\">← Back to home</router-link></p>\r\n      </div>\r\n\r\n      <div v-if=\"showTerms\">\r\n        <div class=\"modal-backdrop\" @click=\"showTerms = false\"></div>\r\n        <div class=\"terms-modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Terms and Conditions\">\r\n          <h3>Terms and Conditions & Data Privacy</h3>\r\n          <div class=\"terms-body\">\r\n            <p>By creating an account, you agree to use Kadiwa E-Commerce responsibly and provide accurate information.</p>\r\n            <p>Your account credentials are your responsibility. Keep your password secure and do not share access with others.</p>\r\n            <p>We collect the registration details you provide (such as name, email, phone, and address) to create and manage your account and process your orders.</p>\r\n            <p>Your data is used only for platform operations, customer service, and transaction records. We do not sell your personal data.</p>\r\n            <p>You may request updates to your profile details through your account settings or by contacting support.</p>\r\n          </div>\r\n          <div class=\"modal-actions\">\r\n            <button type=\"button\" class=\"register-btn\" @click=\"showTerms = false\">Close</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../services/api'\r\nimport { bindKeyboardScroll } from '../utils/keyboardScroll'\r\nimport { BARANGAYS, joinAddress } from '../constants/barangays'\r\n\r\nconst emptyErrors = () => ({\r\n  username: '',\r\n  email: '',\r\n  password: '',\r\n  full_name: '',\r\n  phone: '',\r\n  barangay: '',\r\n  terms: ''\r\n})\r\n\r\nexport default {\r\n  name: 'CustomerRegister',\r\n  data() {\r\n    return {\r\n      barangays: BARANGAYS,\r\n      formData: {\r\n        username: '',\r\n        email: '',\r\n        password: '',\r\n        full_name: '',\r\n        phone: '',\r\n        barangay: '',\r\n        street: ''\r\n      },\r\n      fieldErrors: emptyErrors(),\r\n      showPassword: false,\r\n      error: '',\r\n      success: '',\r\n      loading: false,\r\n      agreedToTerms: false,\r\n      showTerms: false,\r\n      unbindKeyboardScroll: null\r\n    }\r\n  },\r\n  mounted() {\r\n    this.unbindKeyboardScroll = bindKeyboardScroll(this.$el)\r\n  },\r\n  beforeUnmount() {\r\n    if (this.unbindKeyboardScroll) this.unbindKeyboardScroll()\r\n  },\r\n  methods: {\r\n    clearFieldError(field) {\r\n      this.fieldErrors[field] = ''\r\n    },\r\n    validateField(field) {\r\n      if (field === 'username') {\r\n        const value = String(this.formData.username || '').trim()\r\n        if (!value) this.fieldErrors.username = 'Username is required.'\r\n        else if (value.length < 3) this.fieldErrors.username = 'Username must be at least 3 characters.'\r\n        else this.fieldErrors.username = ''\r\n      }\r\n      if (field === 'email') {\r\n        const value = String(this.formData.email || '').trim()\r\n        if (!value) this.fieldErrors.email = 'Email is required.'\r\n        else if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value)) this.fieldErrors.email = 'Enter a valid email address.'\r\n        else this.fieldErrors.email = ''\r\n      }\r\n      if (field === 'password') {\r\n        const value = String(this.formData.password || '')\r\n        if (!value) this.fieldErrors.password = 'Password is required.'\r\n        else if (value.length < 6) this.fieldErrors.password = 'Password must be at least 6 characters.'\r\n        else this.fieldErrors.password = ''\r\n      }\r\n      if (field === 'full_name') {\r\n        const value = String(this.formData.full_name || '').trim()\r\n        if (!value) this.fieldErrors.full_name = 'Full name is required.'\r\n        else this.fieldErrors.full_name = ''\r\n      }\r\n      if (field === 'phone') {\r\n        const value = String(this.formData.phone || '').trim()\r\n        if (value && !/^(09|\\+639)\\d{9}$/.test(value.replace(/[\\s-]/g, ''))) {\r\n          this.fieldErrors.phone = 'Use a valid PH mobile number (e.g. 09XXXXXXXXX).'\r\n        } else this.fieldErrors.phone = ''\r\n      }\r\n      if (field === 'barangay') {\r\n        if (!this.formData.barangay) this.fieldErrors.barangay = 'Please select your barangay.'\r\n        else this.fieldErrors.barangay = ''\r\n      }\r\n      if (field === 'terms') {\r\n        if (!this.agreedToTerms) this.fieldErrors.terms = 'Please agree to the Terms and Data Privacy policy.'\r\n        else this.fieldErrors.terms = ''\r\n      }\r\n      return !this.fieldErrors[field]\r\n    },\r\n    validateForm() {\r\n      const fields = ['username', 'email', 'password', 'full_name', 'phone', 'barangay', 'terms']\r\n      return fields.every((field) => this.validateField(field))\r\n    },\r\n    async handleRegister() {\r\n      this.error = ''\r\n      this.success = ''\r\n      if (!this.validateForm()) return\r\n\r\n      this.loading = true\r\n      try {\r\n        const payload = {\r\n          username: String(this.formData.username || '').trim(),\r\n          email: String(this.formData.email || '').trim(),\r\n          password: this.formData.password,\r\n          full_name: String(this.formData.full_name || '').trim(),\r\n          phone: String(this.formData.phone || '').trim() || null,\r\n          address: joinAddress(this.formData.barangay, this.formData.street)\r\n        }\r\n        const response = await api.post('/customer/auth/register', payload)\r\n        this.success = response.data.message\r\n\r\n        this.formData = {\r\n          username: '',\r\n          email: '',\r\n          password: '',\r\n          full_name: '',\r\n          phone: '',\r\n          barangay: '',\r\n          street: ''\r\n        }\r\n        this.fieldErrors = emptyErrors()\r\n        this.agreedToTerms = false\r\n\r\n        setTimeout(() => {\r\n          this.$router.push('/customer/login')\r\n        }, 2000)\r\n      } catch (err) {\r\n        let message = err.response?.data?.message\r\n        if (!message && Array.isArray(err.response?.data?.errors)) {\r\n          message = err.response.data.errors.map(error => error.msg).join('; ')\r\n        }\r\n        this.error = message || 'Registration failed. Please try again.'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.register-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: flex-start;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  background: radial-gradient(circle at 15% 15%, rgba(124, 179, 66, 0.3), transparent 45%),\r\n              radial-gradient(circle at 85% 85%, rgba(78, 125, 50, 0.26), transparent 42%),\r\n              linear-gradient(135deg, #edf5e2 0%, #d9e7c7 100%);\r\n  padding: max(20px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom));\r\n  position: relative;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.register-box {\r\n  background: rgba(255, 255, 255, 0.88);\r\n  backdrop-filter: blur(8px);\r\n  -webkit-backdrop-filter: blur(8px);\r\n  padding: 36px;\r\n  border-radius: 18px;\r\n  border: 1px solid rgba(205, 219, 185, 0.9);\r\n  box-shadow: 0 18px 40px rgba(56, 92, 35, 0.18);\r\n  width: 100%;\r\n  max-width: 560px;\r\n  position: relative;\r\n  z-index: 1;\r\n  margin: auto 0;\r\n}\r\n\r\n.register-header {\r\n  text-align: center;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.home-link {\r\n  display: inline-block;\r\n  color: #355e2a;\r\n  text-decoration: none;\r\n  font-size: 30px;\r\n  font-weight: 700;\r\n  line-height: 1.1;\r\n  margin-bottom: 8px;\r\n}\r\n.home-link:hover { text-decoration: underline; }\r\n\r\n.register-header h2 {\r\n  color: #5f7256;\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n}\r\n\r\n.error-message {\r\n  background: #fff0ed;\r\n  color: #a94432;\r\n  padding: 10px;\r\n  border-radius: 8px;\r\n  margin-bottom: 15px;\r\n  text-align: center;\r\n}\r\n\r\n.success-message {\r\n  background: #eaf5df;\r\n  color: #3f762a;\r\n  padding: 10px;\r\n  border-radius: 8px;\r\n  margin-bottom: 15px;\r\n  text-align: center;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n  color: #355e2a;\r\n  font-weight: 500;\r\n}\r\n\r\n.form-group input,\r\n.form-group select,\r\n.form-group textarea {\r\n  width: 100%;\r\n  padding: 12px;\r\n  border: 1px solid #cddbb9;\r\n  border-radius: 10px;\r\n  font-size: 14px;\r\n  transition: border-color 0.3s;\r\n  background: #fff;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.form-group input:focus,\r\n.form-group select:focus,\r\n.form-group textarea:focus {\r\n  outline: none;\r\n  border-color: #7cb342;\r\n  box-shadow: 0 0 0 3px rgba(124, 179, 66, 0.15);\r\n}\r\n\r\n.form-group.invalid input,\r\n.form-group.invalid select,\r\n.consent-group.invalid .consent-label {\r\n  border-color: #e07a6c;\r\n}\r\n\r\n.form-group.invalid input,\r\n.form-group.invalid select {\r\n  box-shadow: 0 0 0 3px rgba(180, 35, 24, 0.12);\r\n}\r\n\r\n.field-error {\r\n  margin: 6px 0 0;\r\n  color: #b42318;\r\n  font-size: 12px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.password-field {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.password-field input {\r\n  width: 100%;\r\n  padding-right: 64px;\r\n}\r\n.toggle-password {\r\n  position: absolute;\r\n  right: 8px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  border: none;\r\n  background: transparent;\r\n  color: #4E7D32;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  padding: 6px 8px;\r\n  border-radius: 8px;\r\n  min-height: 36px;\r\n}\r\n.toggle-password:hover {\r\n  background: rgba(124, 179, 66, 0.12);\r\n}\r\n\r\n.consent-group {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.consent-label {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 8px;\r\n  color: #5f7256;\r\n  font-size: 14px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.consent-label input[type=\"checkbox\"] {\r\n  width: auto;\r\n  margin-top: 2px;\r\n  min-width: 18px;\r\n  min-height: 18px;\r\n}\r\n\r\n.link-btn {\r\n  background: none;\r\n  border: none;\r\n  