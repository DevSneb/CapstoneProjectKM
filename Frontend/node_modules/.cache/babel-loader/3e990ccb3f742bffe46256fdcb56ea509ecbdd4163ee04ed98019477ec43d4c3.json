D */)), _createElementVNode(\"div\", _hoisted_3, [_createElementVNode(\"label\", null, [_cache[8] || (_cache[8] = _createTextVNode(\"Latitude \", -1 /* CACHED */)), _withDirectives(_createElementVNode(\"input\", {\n    class: \"input\",\n    \"onUpdate:modelValue\": _cache[2] || (_cache[2] = $event => $data.latitude = $event),\n    type: \"number\",\n    step: \"0.000001\"\n  }, null, 512 /* NEED_PATCH */), [[_vModelText, $data.latitude, void 0, {\n    number: true\n  }]])]), _createElementVNode(\"label\", null, [_cache[9] || (_cache[9] = _createTextVNode(\"Longitude \", -1 /* CACHED */)), _withDirectives(_createElementVNode(\"input\", {\n    class: \"input\",\n    \"onUpdate:modelValue\": _cache[3] || (_cache[3] = $event => $data.longitude = $event),\n    type: \"number\",\n    step: \"0.000001\"\n  }, null, 512 /* NEED_PATCH */), [[_vModelText, $data.longitude, void 0, {\n    number: true\n  }]])]), _createElementVNode(\"label\", null, [_cache[10] || (_cache[10] = _createTextVNode(\"Address (optional) \", -1 /* CACHED */)), _withDirectives(_createElementVNode(\"input\", {\n    class: \"input\",\n    \"onUpdate:modelValue\": _cache[4] || (_cache[4] = $event => $data.address = $event)\n  }, null, 512 /* NEED_PATCH */), [[_vModelText, $data.address]])]), _createElementVNode(\"button\", {\n    class: \"primary-btn\",\n    onClick: _cache[5] || (_cache[5] = (...args) => $options.save && $options.save(...args))\n  }, \"Save Location\")])]);\n}","map":{"version":3,"names":["class","_createElementBlock","_hoisted_1","_createElementVNode","$data","hasKey","_hoisted_2","mapStyle","$event","onChange","_cache","args","$options","switchStyle","id","_hoisted_3","latitude","type","step","number","longitude","address","onClick","save"],"sources":["C:\\Users\\Admin\\OneDrive\\Documents\\CapstoneProject3.1\\CapstoneProject\\frontend\\src\\views\\store\\AccountLocation.vue"],"sourcesContent":["<template>\r\n  <div class=\"page\">\r\n    <h2>Store Location</h2>\r\n    <p>Set your store's location by clicking on the map or entering coordinates.</p>\r\n    <div v-if=\"hasKey\" class=\"map-style\">\r\n      <label>Basemap\r\n        <select class=\"select\" v-model=\"mapStyle\" @change=\"switchStyle\">\r\n          <option value=\"streets\">Streets</option>\r\n          <option value=\"hybrid\">Hybrid</option>\r\n          <option value=\"satellite\">Satellite</option>\r\n          <option value=\"outdoor\">Outdoor</option>\r\n          <option value=\"topo\">Topo</option>\r\n        </select>\r\n      </label>\r\n    </div>\r\n    <div id=\"ownerMap\" class=\"map\"></div>\r\n    <div class=\"form\">\r\n      <label>Latitude\r\n        <input class=\"input\" v-model.number=\"latitude\" type=\"number\" step=\"0.000001\" />\r\n      </label>\r\n      <label>Longitude\r\n        <input class=\"input\" v-model.number=\"longitude\" type=\"number\" step=\"0.000001\" />\r\n      </label>\r\n      <label>Address (optional)\r\n        <input class=\"input\" v-model=\"address\" />\r\n      </label>\r\n      <button class=\"primary-btn\" @click=\"save\">Save Location</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../../services/api'\r\nimport maplibregl from 'maplibre-gl'\r\nimport 'maplibre-gl/dist/maplibre-gl.css'\r\nimport L from 'leaflet'\r\nimport 'leaflet/dist/leaflet.css'\r\nimport iconUrl from 'leaflet/dist/images/marker-icon.png'\r\nimport iconShadow from 'leaflet/dist/images/marker-shadow.png'\r\nimport getMapStyle from '../../services/mapStyle'\r\n\r\nexport default{\r\n  name:'StoreAccountLocation',\r\n  data(){return{ latitude:null, longitude:null, address:'', mapInstance:null, markerInstance:null, hasKey: !!process.env.VUE_APP_MAPTILER_KEY, mapStyle: process.env.VUE_APP_MAP_STYLE || 'streets' }},\r\n  async mounted(){\r\n    await this.load();\r\n    this.initMap();\r\n  },\r\n  methods:{\r\n    async load(){\r\n      try{\r\n        const { data } = await api.get('/store/account/location')\r\n        this.latitude = data.latitude ?? null\r\n        this.longitude = data.longitude ?? null\r\n        this.address = data.address || ''\r\n      }catch(err){ console.error('Failed to load location', err) }\r\n    },\r\n    async initMap(){\r\n      const hasKey = !!process.env.VUE_APP_MAPTILER_KEY\r\n      if(hasKey){\r\n        const style = getMapStyle(this.mapStyle)\r\n        const center = (Number.isFinite(this.latitude) && Number.isFinite(this.longitude))\r\n          ? [this.longitude, this.latitude] : [120.9842, 14.5995]\r\n        this.mapInstance = new maplibregl.Map({ container: 'ownerMap', style, center, zoom: 12 })\r\n        if(Number.isFinite(this.latitude) && Number.isFinite(this.longitude)){\r\n          this.markerInstance = new maplibregl.Marker().setLngLat([this.longitude, this.latitude]).addTo(this.mapInstance)\r\n        }\r\n        this.mapInstance.on('click', (e) => {\r\n          const { lng, lat } = e.lngLat\r\n          this.latitude = Number(lat.toFixed(6))\r\n          this.longitude = Number(lng.toFixed(6))\r\n          const pos = [this.longitude, this.latitude]\r\n          if(this.markerInstance){ this.markerInstance.setLngLat(pos) } else { this.markerInstance = new maplibregl.Marker().setLngLat(pos).addTo(this.mapInstance) }\r\n        })\r\n        return\r\n      }\r\n      // Leaflet fallback without API key (Carto tiles)\r\n      L.Marker.prototype.options.icon = L.icon({ iconUrl, shadowUrl: iconShadow })\r\n      const centerArr = (Number.isFinite(this.latitude) && Number.isFinite(this.longitude))\r\n        ? [this.latitude, this.longitude] : [14.5995, 120.9842]\r\n      this.mapInstance = L.map('ownerMap').setView(centerArr, 12)\r\n      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', { attribution: '© OpenStreetMap contributors © CARTO' }).addTo(this.mapInstance)\r\n      if(Number.isFinite(this.latitude) && Number.isFinite(this.longitude)){\r\n        this.markerInstance = L.marker(centerArr).addTo(this.mapInstance)\r\n      }\r\n      this.mapInstance.on('click', (e) => {\r\n        const lat = e.latlng.lat\r\n        const lng = e.latlng.lng\r\n        this.latitude = Number(lat.toFixed(6))\r\n        this.longitude = Number(lng.toFixed(6))\r\n        const pos = [this.latitude, this.longitude]\r\n        if(this.markerInstance){ this.markerInstance.setLatLng(pos) } else { this.markerInstance = L.marker(pos).addTo(this.mapInstance) }\r\n      })\r\n    },\r\n    switchStyle(){\r\n      if(!this.hasKey || !this.mapInstance || !this.mapInstance.setStyle) return\r\n      this.mapInstance.setStyle(getMapStyle(this.mapStyle))\r\n    },\r\n    async save(){\r\n      try{\r\n        const payload = { latitude: this.latitude, longitude: this.longitude, address: this.address }\r\n        await api.put('/store/account/location', payload)\r\n        alert('Location saved')\r\n      }catch(err){ alert(err.response?.data?.message || 'Failed to save location') }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.page{ padding:20px }\r\n.map{ height:420px; border:1px solid #d9e5c8; border-radius:10px; overflow:hidden; margin-bottom:12px; box-shadow:0 4px 14px rgba(56,92,35,.08) }\r\n.map-style{ margin-bottom:8px }\r\n.form{ display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:12px; align-items:end }\r\n.input{ padding:8px 10px; border:1px solid #cddbb9; border-radius:6px }\r\n.select{ padding:8px 10px; border:1px solid #cddbb9; border-radius:6px; background:#fff }\r\n.primary-btn{ background:linear-gradient(135deg,#7CB342,#4E7D32); color:#fff; border:none; padding:10px 14px; border-radius:8px; cursor:pointer }\r\n.primary-btn:hover{ filter:brightness(0.95) }\r\n</style>\r\n"],"mappings":";;EACOA,KAAK,EAAC;AAAM;;;EAGIA,KAAK,EAAC;;;EAYpBA,KAAK,EAAC;AAAM;;uBAfnBC,mBAAA,CA2BM,OA3BNC,UA2BM,G,4BA1BJC,mBAAA,CAAuB,YAAnB,gBAAc,qB,4BAClBA,mBAAA,CAAgF,WAA7E,2EAAyE,qBACjEC,KAAA,CAAAC,MAAM,I,cAAjBJ,mBAAA,CAUM,OAVNK,UAUM,GATJH,mBAAA,CAQQ,gB,2CARD,UACL,