      :type=\"showPassword ? 'text' : 'password'\"\r\n              id=\"password\"\r\n              v-model=\"credentials.password\"\r\n              placeholder=\"Enter password\"\r\n              required\r\n            />\r\n            <button\r\n              type=\"button\"\r\n              class=\"toggle-password\"\r\n              :aria-label=\"showPassword ? 'Hide password' : 'Show password'\"\r\n              @click=\"showPassword = !showPassword\"\r\n            >\r\n              {{ showPassword ? 'Hide' : 'Show' }}\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        <button type=\"submit\" class=\"login-btn\" :disabled=\"loading\">\r\n          {{ loading ? 'Logging in...' : 'Login' }}\r\n        </button>\r\n      </form>\r\n\r\n      <div class=\"links\">\r\n        <router-link to=\"/customer/login\">Customer Login</router-link>\r\n        <span> | </span>\r\n        <router-link to=\"/admin/login\">Admin Login</router-link>\r\n        <span> | </span>\r\n        <router-link to=\"/store-owner/login\">Store Owner Login</router-link>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '../services/api'\r\nimport { bindKeyboardScroll } from '../utils/keyboardScroll'\r\n\r\nexport default {\r\n  name: 'PosLogin',\r\n  data() {\r\n    return {\r\n      credentials: {\r\n        email: '',\r\n        password: ''\r\n      },\r\n      showPassword: false,\r\n      error: '',\r\n      loading: false,\r\n      unbindKeyboardScroll: null\r\n    }\r\n  },\r\n  mounted() {\r\n    this.unbindKeyboardScroll = bindKeyboardScroll(this.$el)\r\n  },\r\n  beforeUnmount() {\r\n    if (this.unbindKeyboardScroll) this.unbindKeyboardScroll()\r\n  },\r\n  methods: {\r\n    async handleLogin() {\r\n      this.error = ''\r\n      this.loading = true\r\n\r\n      try {\r\n        const response = await api.post('/pos/auth/login', {\r\n          email: String(this.credentials.email || '').trim().toLowerCase(),\r\n          password: String(this.credentials.password || '')\r\n        })\r\n        this.$store.dispatch('login', {\r\n          user: response.data.user,\r\n          token: response.data.token\r\n        })\r\n        this.$router.push('/pos/dashboard')\r\n      } catch (err) {\r\n        this.error = err.response?.data?.message || 'Login failed. Please try again.'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: flex-start;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  background: radial-gradient(circle at 15% 15%, rgba(124, 179, 66, 0.3), transparent 45%),\r\n              radial-gradient(circle at 85% 85%, rgba(78, 125, 50, 0.26), transparent 42%),\r\n              linear-gradient(135deg, #edf5e2 0%, #d9e7c7 100%);\r\n  padding: max(20px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom));\r\n  position: relative;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.login-container::before,\r\n.login-container::after {\r\n  content: '';\r\n  position: absolute;\r\n  border-radius: 999px;\r\n  pointer-events: none;\r\n}\r\n\r\n.login-container::before {\r\n  width: 300px;\r\n  height: 300px;\r\n  background: rgba(124, 179, 66, 0.16);\r\n  top: -100px;\r\n  left: -90px;\r\n}\r\n\r\n.login-container::after {\r\n  width: 220px;\r\n  height: 220px;\r\n  background: rgba(53, 94, 42, 0.12);\r\n  right: -70px;\r\n  bottom: -60px;\r\n}\r\n\r\n.login-box {\r\n  background: rgba(255, 255, 255, 0.88);\r\n  backdrop-filter: blur(8px);\r\n  -webkit-backdrop-filter: blur(8px);\r\n  padding: 36px;\r\n  border-radius: 18px;\r\n  border: 1px solid rgba(205, 219, 185, 0.9);\r\n  box-shadow: 0 18px 40px rgba(56, 92, 35, 0.18);\r\n  width: 100%;\r\n  max-width: 430px;\r\n  position: relative;\r\n  z-index: 1;\r\n  margin: auto 0;\r\n}\r\n\r\n.login-header {\r\n  text-align: center;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.eyebrow {\r\n  display: inline-block;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: 1px;\r\n  color: #5a7e45;\r\n  text-transform: uppercase;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.login-header h1 {\r\n  margin: 0;\r\n  font-size: 28px;\r\n  color: #2f5f28;\r\n}\r\n\r\n.login-header h2 {\r\n  margin: 12px 0 8px;\r\n  font-size: 20px;\r\n  color: #385e2f;\r\n}\r\n\r\n.subtext {\r\n  margin: 0;\r\n  color: #5f6f55;\r\n}\r\n\r\n.login-form {\r\n  display: grid;\r\n  gap: 18px;\r\n}\r\n\r\n.form-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.form-group label {\r\n  margin-bottom: 6px;\r\n  font-weight: 600;\r\n  color: #465f3d;\r\n}\r\n\r\n.form-group input {\r\n  padding: 12px 14px;\r\n  border: 1px solid #c9d1b9;\r\n  border-radius: 12px;\r\n  font-size: 14px;\r\n  color: #2f3f24;\r\n  background: #f8faf3;\r\n}\r\n\r\n.password-field {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.password-field input {\r\n  width: 100%;\r\n  padding-right: 64px;\r\n}\r\n.toggle-password {\r\n  position: absolute;\r\n  right: 8px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  border: none;\r\n  background: transparent;\r\n  color: #4E7D32;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  padding: 6px 8px;\r\n  border-radius: 8px;\r\n}\r\n.toggle-password:hover {\r\n  background: rgba(124, 179, 66, 0.12);\r\n}\r\n\r\n.login-btn {\r\n  background: linear-gradient(135deg, #5a944a, #3e712e);\r\n  color: #fff;\r\n  width: 100%;\r\n  padding: 14px 18px;\r\n  border: none;\r\n  border-radius: 12px;\r\n  font-size: 15px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n}\r\n\r\n.login-btn:disabled {\r\n  opacity: 0.65;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.links {\r\n  margin-top: 18px;\r\n  display: flex;\r\n  justify-content: center;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.links a,\r\n.links router-link {\r\n  color: #4b783e;\r\n  text-decoration: none;\r\n  font-weight: 600;\r\n}\r\n\r\n.error-message {\r\n  padding: 12px 14px;\r\n  background: #ffe8e3;\r\n  border: 1px solid #f2b0a1;\r\n  color: #8a2e24;\r\n  border-radius: 12px;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .login-container {\r\n    padding: 12px 12px 45vh;\r\n    align-items: flex-start;\r\n  }\r\n  .login-box {\r\n    margin-top: 8px;\r\n    padding: 24px 16px;\r\n  }\r\n  .login-btn { min-height: 44px; }\r\n}\r\n</style>\r\n"],"mappings":";;EACOA,KAAK,EAAC;AAAiB;;EACrBA,KAAK,EAAC;AAAW;;;EASAA,KAAK,EAAC;;;EAEnBA,KAAK,EAAC;AAAY;;EAYlBA,KAAK,EAAC;AAAY;;EAEhBA,KAAK,EAAC;AAAgB;;;;;EAwB1BA,KAAK,EAAC;AAAO;;;uBAlDtBC,mBAAA,CA0DM,OA1DNC,UA0DM,GAzDJC,mBAAA,CAwDM,OAxDNC,UAwDM,G,4BAvDJD,mBAAA,CAKM;IALDH,KAAK,EAAC;EAAc,IACvBG,mBAAA,CAAwC;IAAnCH,KAAK,EAAC;EAAS,GAAC,eAAa,GAClCG,mBAAA,CAA0B,YAAtB,mBAAiB,GACrBA,mBAAA,CAAkB,YAAd,WAAS,GACbA,mBAAA,CAAgE;IAA7DH,KAAK,EAAC;EAAS,GAAC,2CAAyC,E,QAG9DG,mBAAA,CAuCO;IAvCAE,QAAM,EAAAC,MAAA,QAAAA,MAAA,MAAAC,cAAA,KAAAC,IAAA,KAAUC,QAAA,CAAAC,WAAA,IAAAD,QAAA,CAAAC,WAAA,IAAAF,IAAA,CAAW;IAAER,KAAK,EAAC;MAC7BW,KAAA,CAAAC,KAAK,I,cAAhBX,mBAAA,CAAyD,OAAzDY,UAAyD,EAAAC,gBAAA,CAAdH,KAAA,CAAAC,KAAK,S,+BAEhDT,mBAAA,CAUM,OAVNY,UAUM,G,0BATJZ,mBAAA,CAAgC;IAAzBa,GAAG,EAAC;EAAO,GAAC,OAAK,Q,gBACxBb,mBAAA,CAOE;IANAc,IAAI,EAAC,OAAO;IACZC,EAAE,EAAC,OAAO;+DACIP,KAAA,CAAAQ,WAAW,CAACC,KAAK,GAAAC,MAAA;IAC/BC,WAAW,EAAC,iBAAiB;IAC7BC,YAAY,EAAC,UAAU;IACvBC,QAAQ,EAAR;gCAHcb,KAAA,CAAAQ,WAAW,CAACC,KAAK,E;IAAvBK,IAAI,EAAZ;EAAgC,E,MAOpCtB,mBAAA,CAmBM,OAnBNuB,UAmBM,G,0BAlBJvB,mBAAA,CAAsC;IAA/Ba,GAAG,EAAC;EAAU,GAAC,UAAQ,QAC9Bb,mBAAA,CAgBM,OAhBNwB,UAgBM,G,gBAfJxB,mBAAA,CAME;IALCc,IAAI,EAAEN,KAAA,CAAAiB,YAAY;IACnBV,EAAE,EAAC,UAAU;+DACJP,KAAA,CAAAQ,WAAW,CAACU,QAAQ,GAAAR,MAAA;IAC7BC,WAAW,EAAC,gBAAgB;IAC5BE,QAAQ,EAAR;6CAFSb,KAAA,CAAAQ,WAAW,CAACU,QAAQ,E,GAI/B1B,mBAAA,CAOS;IANPc,IAAI,EAAC,QAAQ;IACbjB,KAAK,EAAC,iBAAiB;IACtB,YAAU,EAAEW,KAAA,CAAAiB,YAAY;IACxBE,OAAK,EAAAxB,MAAA,QAAAA,MAAA,MAAAe,MAAA,IAAEV,KAAA,CAAAiB