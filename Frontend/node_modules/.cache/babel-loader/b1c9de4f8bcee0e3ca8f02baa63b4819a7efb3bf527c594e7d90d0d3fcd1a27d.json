"true\"></div>\r\n\r\n    <header class=\"nav\">\r\n      <router-link class=\"brand\" to=\"/\">\r\n        <span class=\"brand-mark\">K</span>\r\n        <span class=\"brand-name\">Kadiwa Mart</span>\r\n      </router-link>\r\n      <nav class=\"nav-links\" aria-label=\"Account\">\r\n        <router-link class=\"link-login\" to=\"/customer/login\">Login</router-link>\r\n        <router-link class=\"link-signup\" to=\"/customer/register\">Sign up</router-link>\r\n      </nav>\r\n    </header>\r\n\r\n    <section class=\"hero\">\r\n      <div class=\"hero-visual\" aria-hidden=\"true\">\r\n        <div class=\"field\"></div>\r\n        <div class=\"glow\"></div>\r\n        <div class=\"produce produce-a\"></div>\r\n        <div class=\"produce produce-b\"></div>\r\n        <div class=\"produce produce-c\"></div>\r\n      </div>\r\n\r\n      <div class=\"hero-content\">\r\n        <p class=\"brand-hero\">Kadiwa Mart</p>\r\n        <h1>Fresh from local stores to your table.</h1>\r\n        <p class=\"support\">\r\n          Browse Calapan Kadiwa stores, order for pickup or delivery, and manage everything in one place.\r\n        </p>\r\n        <div class=\"cta-row\">\r\n          <router-link class=\"cta-primary\" to=\"/customer/register\">Get started</router-link>\r\n          <router-link class=\"cta-secondary\" to=\"/customer/login\">Login</router-link>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"promise\">\r\n      <h2>Built for everyday Kadiwa shopping</h2>\r\n      <p>Simple ordering for customers. Clear tools for store owners.</p>\r\n    </section>\r\n  </main>\r\n</template>\r\n\r\n<script>\r\nimport { readAuth } from '../services/authStorage'\r\n\r\nexport default {\r\n  name: 'LandingPage',\r\n  created() {\r\n    const customer = readAuth('customer')\r\n    if (customer.token && customer.userRole === 'customer') {\r\n      this.$router.replace('/customer/dashboard')\r\n      return\r\n    }\r\n    const store = readAuth('store_owner')\r\n    if (store.token && store.userRole === 'store_owner') {\r\n      this.$router.replace('/store-owner/dashboard')\r\n      return\r\n    }\r\n    const admin = readAuth('admin')\r\n    if (admin.token && admin.userRole === 'admin') {\r\n      this.$router.replace('/admin/dashboard')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Source+Sans+3:wght@400;600;700&display=swap');\r\n\r\n.landing {\r\n  --ink: #1f3318;\r\n  --muted: #5d7352;\r\n  --leaf: #3f7a2c;\r\n  --leaf-deep: #2f5c1d;\r\n  --cream: #eef4e4;\r\n  --sand: #f3ead2;\r\n  position: relative;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  color: var(--ink);\r\n  font-family: 'Source Sans 3', 'Segoe UI', sans-serif;\r\n  background:\r\n    radial-gradient(circle at 12% 18%, rgba(124, 179, 66, 0.28), transparent 42%),\r\n    radial-gradient(circle at 88% 12%, rgba(244, 189, 92, 0.22), transparent 36%),\r\n    linear-gradient(160deg, #f7faF1 0%, #e7f0d8 48%, #dce8cb 100%);\r\n  overflow-x: hidden;\r\n}\r\n\r\n.atmosphere {\r\n  position: absolute;\r\n  inset: 0;\r\n  background-image:\r\n    linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),\r\n    linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);\r\n  background-size: 48px 48px;\r\n  mask-image: linear-gradient(180deg, rgba(0,0,0,0.35), transparent 70%);\r\n  pointer-events: none;\r\n}\r\n\r\n.nav {\r\n  position: relative;\r\n  z-index: 2;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  max-width: 1180px;\r\n  margin: 0 auto;\r\n  padding: 22px 24px;\r\n}\r\n\r\n.brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  text-decoration: none;\r\n  color: var(--ink);\r\n}\r\n\r\n.brand-mark {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 12px;\r\n  display: grid;\r\n  place-items: center;\r\n  color: #fff;\r\n  font-weight: 700;\r\n  background: linear-gradient(135deg, var(--leaf), var(--leaf-deep));\r\n  box-shadow: 0 10px 22px rgba(47, 92, 29, 0.24);\r\n}\r\n\r\n.brand-name {\r\n  font-family: Fraunces, Georgia, serif;\r\n  font-size: 1.25rem;\r\n  font-weight: 700;\r\n}\r\n\r\n.nav-links {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n}\r\n\r\n.link-login,\r\n.link-signup {\r\n  text-decoration: none;\r\n  font-weight: 700;\r\n  padding: 10px 16px;\r\n  border-radius: 999px;\r\n}\r\n\r\n.link-login { color: var(--leaf-deep); }\r\n.link-signup {\r\n  color: #fff;\r\n  background: linear-gradient(135deg, var(--leaf), var(--leaf-deep));\r\n}\r\n\r\n.hero {\r\n  position: relative;\r\n  z-index: 1;\r\n  max-width: 1180px;\r\n  margin: 0 auto;\r\n  min-height: calc(100vh - 180px);\r\n  min-height: calc(100dvh - 180px);\r\n  display: grid;\r\n  align-items: end;\r\n  padding: 24px 24px 48px;\r\n}\r\n\r\n.hero-visual {\r\n  position: absolute;\r\n  inset: 0 0 12% 0;\r\n  border-radius: 0;\r\n  overflow: hidden;\r\n  z-index: 0;\r\n}\r\n\r\n.field {\r\n  position: absolute;\r\n  inset: 0;\r\n  background:\r\n    linear-gradient(180deg, rgba(31, 51, 24, 0.08), rgba(31, 51, 24, 0.35)),\r\n    linear-gradient(120deg, #6ea24a 0%, #9fbf63 38%, #d7b56a 72%, #7aa24f 100%);\r\n  animation: fieldShift 12s ease-in-out infinite alternate;\r\n}\r\n\r\n.glow {\r\n  position: absolute;\r\n  width: 280px;\r\n  height: 280px;\r\n  right: 12%;\r\n  top: 10%;\r\n  border-radius: 50%;\r\n  background: radial-gradient(circle, rgba(255, 214, 120, 0.55), transparent 68%);\r\n  animation: sunPulse 5s ease-in-out infinite;\r\n}\r\n\r\n.produce {\r\n  position: absolute;\r\n  border-radius: 50% 45% 55% 50%;\r\n  filter: blur(0.2px);\r\n  opacity: 0.88;\r\n  animation: floatY 7s ease-in-out infinite;\r\n}\r\n.produce-a {\r\n  width: 84px;\r\n  height: 84px;\r\n  left: 10%;\r\n  bottom: 28%;\r\n  background: radial-gradient(circle at 30% 30%, #f2a33a, #c45d1c);\r\n}\r\n.produce-b {\r\n  width: 62px;\r\n  height: 62px;\r\n  left: 24%;\r\n  bottom: 18%;\r\n  background: radial-gradient(circle at 35% 30%, #8fd45a, #3f7a2c);\r\n  animation-delay: 0.8s;\r\n}\r\n.produce-c {\r\n  width: 70px;\r\n  height: 70px;\r\n  right: 18%;\r\n  bottom: 24%;\r\n  background: radial-gradient(circle at 30% 30%, #f6d56a, #d29a2f);\r\n  animation-delay: 1.4s;\r\n}\r\n\r\n.hero-content {\r\n  position: relative;\r\n  z-index: 1;\r\n  max-width: 640px;\r\n  padding: 28px 28px 30px;\r\n  border-radius: 24px;\r\n  background: rgba(247, 250, 241, 0.88);\r\n  backdrop-filter: blur(10px);\r\n  border: 1px solid rgba(255, 255, 255, 0.55);\r\n  box-shadow: 0 24px 48px rgba(31, 51, 24, 0.14);\r\n  animation: riseIn 0.8s ease both;\r\n}\r\n\r\n.brand-hero {\r\n  margin: 0 0 10px;\r\n  font-family: Fraunces, Georgia, serif;\r\n  font-size: clamp(2.4rem, 7vw, 4.2rem);\r\n  font-weight: 700;\r\n  line-height: 0.95;\r\n  letter-spacing: -0.03em;\r\n  color: var(--leaf-deep);\r\n}\r\n\r\n.hero-content h1 {\r\n  margin: 0;\r\n  font-family: Fraunces, Georgia, serif;\r\n  font-size: clamp(1.45rem, 3.4vw, 2rem);\r\n  font-weight: 600;\r\n  line-height: 1.2;\r\n  color: var(--ink);\r\n}\r\n\r\n.support {\r\n  margin: 14px 0 0;\r\n  color: var(--muted);\r\n  font-size: 1.05rem;\r\n  line-height: 1.55;\r\n  max-width: 34rem;\r\n}\r\n\r\n.cta-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  margin-top: 22px;\r\n}\r\n\r\n.cta-primary,\r\n.cta-secondary {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-height: 48px;\r\n  padding: 0 20px;\r\n  border-radius: 12px;\r\n  text-decoration: none;\r\n  font-weight: 700;\r\n}\r\n\r\n.cta-primary {\r\n  color: #fff;\r\n  background: linear-gradient(135deg, var(--leaf), var(--leaf-deep));\r\n  box-shadow: 0 12px 24px rgba(47, 92, 29, 0.25);\r\n}\r\n\r\n.cta-secondary {\r\n  color: var(--leaf-deep);\r\n  background: rgba(255, 255, 255, 0.75);\r\n  border: 1px solid #c9dbb4;\r\n}\r\n\r\n.promise {\r\n  position: relative;\r\n  z-index: 1;\r\n  max-width: 1180px;\r\n  margin: 0 auto;\r\n  padding: 8px 24px 48px;\r\n}\r\n\r\n.promise h2 {\r\n  margin: 0;\r\n  font-family: Fraunces, Georgia, serif;\r\n  font-size: 1.35rem;\r\n}\r\n\r\n.promise p {\r\n  margin: 8px 0 0;\r\n  color: var(--muted);\r\n  max-width: 36rem;\r\n}\r\n\r\n@keyframes fieldShift {\r\n  from { filter: saturate(1) brightness(1); transform: scale(1); }\r\n  to { filter: saturate(1.08) brightness(1.04); transform: scale(1.03); }\r\n}\r\n@keyframes sunPulse {\r\n  0%, 100% { transform: scale(1); opacity: 0.85; }\r\n  50% { transform: scale(1.08); opacity: 1; }\r\n}\r\n@keyframes floatY {\r\n  0%, 100% { transform: translateY(0); }\r\n  50% { transform: translateY(-12px); }\r\n}\r\n@keyframes riseIn {\r\n  from { opacity: 0; transform: translateY(18px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n@media (max-width: 720px) {\r\n  .nav { padding: 16px; }\r\n  .brand-name { font-size: 1.05rem; }\r\n  .hero {\r\n    min-height: calc(100dvh - 140px);\r\n    align-items: center;\r\n    padding: 12px 16px 28px;\r\n  }\r\n  .hero-content {\r\n    padding: 22px 18px;\r\n  }\r\n  .brand-hero { font-size: clamp(2.2rem, 12vw, 3rem); }\r\n  .cta-row { flex-direction: column; }\r\n  .cta-primary,\r\n  .cta-secondary { width: 100%; }\r\n  .promise { padding: 0 16px 36px; }\r\n}\r\n</style>\r\n"],"mappings":";;EACQA,KAAK,EAAC;AAAS;;EAGXA,KAAK,EAAC;AAAK;;EAKZA,KAAK,EAAC,WAAW;EAAC,YAAU,EAAC;;;EAM3BA,KAAK,EAAC;AAAM;;EASdA,KAAK,EAAC;AAAc;;EAMlBA,KAAK,EAAC;AAAS;;;uBA7B1BC,mBAAA,CAwCO,QAxCPC,UAwCO,G,0BAvCLC,mBAAA,CAAiD;IAA5CH,KAAK,EAAC,YAAY;IAAC,aAAW,EAAC;iBAEpCG,mBAAA,CASS,UATTC,UASS,GARPC,YAAA,CAGcC,sBAAA;IAHDN,KAAK,EAAC,OAAO;IAACO,EAAE,EAAC;;sBAC5B,MAAiC,KAAAC,MAAA,QAAAA,MAAA,OAAjCL,mBAAA,CAAiC;MAA3BH,KAAK,EAAC;IAAY,GAAC,GAAC,OAC1BG,mBAAA,CAA2C;MAArCH,KAAK,EAAC;IAAY,GAAC,aAAW,M;;MAEtCG,mBAAA,CAGM,OAHNM,UAGM,GAFJJ,YAAA,CAAwEC,sBAAA;IAA3DN,KAAK,EAAC,YAAY;IAACO,EAAE,EAAC;;sBAAkB,MAAK,KAAAC,MAAA,QAAAA,MAAA,O